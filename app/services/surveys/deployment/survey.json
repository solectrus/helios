{
  "locale": "de",
  "title": {
    "de": "Betriebsmodus",
    "default": "Deployment mode"
  },
  "description": {
    "de": "Welche Dienste soll HELIOS auf diesem Host betreiben?",
    "default": "Which services should HELIOS run on this host?"
  },
  "pages": [
    {
      "name": "p_mode",
      "elements": [
        {
          "type": "radiogroup",
          "name": "mode",
          "title": {
            "de": "Welche Dienste soll HELIOS auf diesem Host betreiben?",
            "default": "Which services should HELIOS run on this host?"
          },
          "description": {
            "de": "Im Regelfall läuft alles auf einem Host. Dann passt die erste Option. Die beiden anderen Optionen sind Spezialfälle für verteilte Installationen über mehrere Hosts.",
            "default": "In most cases everything runs on a single host. Then the first option fits. The other two options are special cases for distributed setups across multiple hosts."
          },
          "isRequired": true,
          "defaultValue": "full",
          "choices": [
            {
              "value": "full",
              "text": {
                "de": "Dashboard, Datenbanken, Zusatzdienste und Kollektoren (empfohlen)\n\nVollständige Installation auf einem Host. Messwerte werden lokal erfasst, gespeichert und angezeigt.",
                "default": "Dashboard, databases, supporting services and collectors (recommended)\n\nFull single-host installation. Measurements are collected, stored, and displayed locally."
              }
            },
            {
              "value": "collectors_only",
              "text": {
                "de": "Nur Kollektoren (Spezialfall)\n\nVerteilte Installation: Kollektoren laufen hier und pushen ihre Messwerte an eine externe InfluxDB auf einem anderen Host.",
                "default": "Collectors only (special case)\n\nDistributed setup: collectors run here and push measurements to an external InfluxDB on another host."
              }
            },
            {
              "value": "dashboard_only",
              "text": {
                "de": "Nur Dashboard, Datenbanken und Zusatzdienste (Spezialfall)\n\nVerteilte Installation: Messwerte kommen von Kollektoren auf einem anderen Host und werden hier gespeichert und angezeigt.",
                "default": "Dashboard, databases and supporting services only (special case)\n\nDistributed setup: measurements arrive from collectors on another host and are stored and displayed here."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_connection",
      "title": {
        "de": "Verbindung",
        "default": "Connection"
      },
      "description": {
        "de": "Unter dieser Adresse erreicht SOLECTRUS die externe InfluxDB im Netzwerk.",
        "default": "SOLECTRUS reaches the external InfluxDB at this address on the network."
      },
      "visibleIf": "{mode} = 'collectors_only'",
      "elements": [
        {
          "type": "text",
          "name": "host",
          "title": {
            "de": "Hostname",
            "default": "Hostname"
          },
          "isRequired": true,
          "placeholder": "influxdb.example.com"
        },
        {
          "type": "radiogroup",
          "name": "schema",
          "title": {
            "de": "Protokoll",
            "default": "Protocol"
          },
          "isRequired": true,
          "defaultValue": "http",
          "choices": [
            {
              "value": "http",
              "text": "http"
            },
            {
              "value": "https",
              "text": "https"
            }
          ]
        },
        {
          "type": "text",
          "name": "port",
          "title": {
            "de": "Port",
            "default": "Port"
          },
          "isRequired": true,
          "defaultValueExpression": "iif({schema} = 'http', '8086', '443')",
          "inputType": "number",
          "min": 1,
          "max": 65535
        },
        {
          "type": "html",
          "name": "connection_test",
          "html": {
            "de": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"influxdb\" data-test-check=\"reachability\" data-test-fields=\"schema,host,port\">Verbindung testen</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>",
            "default": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"influxdb\" data-test-check=\"reachability\" data-test-fields=\"schema,host,port\">Test connection</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>"
          }
        }
      ]
    },
    {
      "name": "p_credentials",
      "title": {
        "de": "Zugangsdaten",
        "default": "Credentials"
      },
      "description": {
        "de": "Zugangsdaten, mit denen SOLECTRUS sich an der InfluxDB anmeldet und Messwerte schreibt.",
        "default": "Credentials SOLECTRUS uses to authenticate against InfluxDB and write measurements."
      },
      "visibleIf": "{mode} = 'collectors_only'",
      "elements": [
        {
          "type": "text",
          "name": "org",
          "title": {
            "de": "Organisation",
            "default": "Organization"
          },
          "isRequired": true,
          "defaultValue": "solectrus"
        },
        {
          "type": "text",
          "name": "bucket",
          "title": {
            "de": "Bucket",
            "default": "Bucket"
          },
          "isRequired": true,
          "defaultValue": "solectrus"
        },
        {
          "type": "text",
          "name": "token_write",
          "title": {
            "de": "API-Token (Schreibrechte)",
            "default": "API token (write access)"
          },
          "isRequired": true,
          "inputType": "password"
        },
        {
          "type": "html",
          "name": "credentials_test",
          "html": {
            "de": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"influxdb\" data-test-check=\"credentials\" data-test-fields=\"schema,host,port,org,bucket,token_write\">Zugangsdaten prüfen</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>",
            "default": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"influxdb\" data-test-check=\"credentials\" data-test-fields=\"schema,host,port,org,bucket,token_write\">Verify credentials</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>"
          }
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "showCompletePage": false
}
