{
  "locale": "de",
  "title": {
    "de": "MQTT-Zuordnung",
    "default": "MQTT mapping"
  },
  "clearInvisibleValues": "onHidden",
  "pages": [
    {
      "name": "p_kind",
      "title": {
        "de": "Art",
        "default": "Kind"
      },
      "elements": []
    },
    {
      "name": "p_topic",
      "title": {
        "de": "Quelle",
        "default": "Source"
      },
      "description": {
        "de": "Das MQTT-Topic, aus dem der Wert stammt.",
        "default": "The MQTT topic the value comes from."
      },
      "elements": [
        {
          "type": "text",
          "name": "topic",
          "visibleIf": "{kind} = 'topic'",
          "title": {
            "de": "MQTT-Topic",
            "default": "MQTT topic"
          },
          "description": {
            "de": "Das Topic, auf dem der Messwert veröffentlicht wird",
            "default": "The topic where the measurement value is published"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. evcc/site/pv/1/Power",
            "default": "e.g. evcc/site/pv/1/Power"
          }
        }
      ]
    },
    {
      "name": "p_extraction_method",
      "title": {
        "de": "Wertgewinnung",
        "default": "Value extraction"
      },
      "elements": []
    },
    {
      "name": "p_extraction_value",
      "title": {
        "de": "Wertgewinnung, Details",
        "default": "Value extraction, details"
      },
      "elements": []
    },
    {
      "name": "p_filters",
      "title": {
        "de": "Filter (optional)",
        "default": "Filters (optional)"
      },
      "elements": []
    },
    {
      "name": "p_name",
      "title": {
        "de": "Name (optional)",
        "default": "Name (optional)"
      },
      "elements": []
    },
    {
      "name": "p_write",
      "title": {
        "de": "Schreibverhalten (optional)",
        "default": "Write behavior (optional)"
      },
      "elements": []
    },
    {
      "name": "p_target",
      "title": {
        "de": "InfluxDB-Ziel",
        "default": "InfluxDB target"
      },
      "description": {
        "de": "Lege fest, an welche Stelle in InfluxDB der gewonnene Wert geschrieben wird.",
        "default": "Define where in InfluxDB the extracted value is written."
      },
      "elements": [
        {
          "type": "text",
          "name": "measurement",
          "visibleIf": "{skip_write} <> true",
          "title": {
            "de": "InfluxDB Measurement",
            "default": "InfluxDB measurement"
          },
          "isRequired": true,
          "placeholder": "my_measurement"
        },
        {
          "type": "text",
          "name": "field",
          "visibleIf": "{skip_write} <> true",
          "title": {
            "de": "InfluxDB Field",
            "default": "InfluxDB field"
          },
          "isRequired": true,
          "placeholder": "power"
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "showCompletePage": false
}
