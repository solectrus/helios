{
  "locale": "de",
  "title": {
    "de": "Sensor konfigurieren",
    "default": "Configure sensor"
  },
  "clearInvisibleValues": "onHidden",
  "pages": [
    {
      "name": "p_source",
      "title": {
        "de": "Datenquelle",
        "default": "Data source"
      },
      "description": {
        "de": "Lege fest, aus welchem System dieser Sensor seine Messwerte bezieht.",
        "default": "Choose which system this sensor draws its measurements from."
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "source",
          "title": {
            "de": "Woher kommen die Messdaten?",
            "default": "Where does the measurement data come from?"
          },
          "isRequired": true,
          "choices": []
        }
      ]
    },
    {
      "name": "p_shelly_local",
      "visibleIf": "{source} = 'shelly'",
      "title": {
        "de": "Shelly — Lokaler Zugriff",
        "default": "Shelly — Local Access"
      },
      "description": {
        "de": "Adresse des Shelly-Geräts im Heimnetz für den direkten lokalen Zugriff.",
        "default": "Address of the Shelly device on your home network for direct local access."
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_host",
          "title": {
            "de": "IP-Adresse oder Hostname",
            "default": "IP address or host name"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. 192.168.178.43",
            "default": "e.g. 192.168.178.43"
          }
        },
        {
          "type": "text",
          "name": "shelly_password",
          "title": {
            "de": "Passwort (optional)",
            "default": "Password (optional)"
          },
          "description": {
            "de": "Nur erforderlich, falls ein Passwort für den Shelly konfiguriert ist",
            "default": "Only required if a password is configured for the Shelly"
          }
        },
        {
          "type": "html",
          "name": "shelly_connection_test",
          "html": {
            "de": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"shelly\" data-test-check=\"reachability\" data-test-fields=\"shelly_host:host,shelly_password:password\">Verbindung testen</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>",
            "default": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"shelly\" data-test-check=\"reachability\" data-test-fields=\"shelly_host:host,shelly_password:password\">Test connection</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>"
          }
        }
      ]
    },
    {
      "name": "p_shelly_cloud",
      "visibleIf": "{source} = 'shelly'",
      "title": {
        "de": "Shelly — Cloud-Zugriff",
        "default": "Shelly — Cloud Access"
      },
      "description": {
        "de": "Geräte-ID, unter der die Shelly Cloud dieses Gerät führt.",
        "default": "Device ID the Shelly Cloud uses for this device."
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_device_id",
          "title": {
            "de": "Geräte-ID",
            "default": "Device ID"
          },
          "isRequired": true
        }
      ]
    },
    {
      "name": "p_mqtt",
      "visibleIf": "{source} = 'mqtt'",
      "title": {
        "de": "MQTT — Topic",
        "default": "MQTT — Topic"
      },
      "description": {
        "de": "Das MQTT-Topic, auf dem der gewünschte Messwert veröffentlicht wird.",
        "default": "The MQTT topic where the desired measurement is published."
      },
      "elements": [
        {
          "type": "text",
          "name": "mqtt_topic",
          "title": {
            "de": "MQTT-Topic",
            "default": "MQTT topic"
          },
          "description": {
            "de": "Das Topic, auf dem der Messwert veröffentlicht wird",
            "default": "The topic where the measurement value is published"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. sensors/power",
            "default": "e.g. sensors/power"
          }
        }
      ]
    },
    {
      "name": "p_mqtt_extraction",
      "visibleIf": "{source} = 'mqtt'",
      "title": {
        "de": "MQTT — Wertgewinnung",
        "default": "MQTT — Value Extraction"
      },
      "description": {
        "de": "Lege fest, wie aus der empfangenen Nachricht ein Messwert gewonnen wird.",
        "default": "Define how a measurement is derived from the received message."
      },
      "elements": []
    },
    {
      "name": "p_mqtt_extraction_value",
      "visibleIf": "{source} = 'mqtt'",
      "title": {
        "de": "MQTT — Wertgewinnung — Details",
        "default": "MQTT — Value Extraction — Details"
      },
      "description": {
        "de": "Feinheiten der Wertgewinnung — abhängig von der zuvor gewählten Methode.",
        "default": "Details of value extraction — depending on the method chosen before."
      },
      "elements": []
    },
    {
      "name": "p_mqtt_filter",
      "title": {
        "de": "MQTT — Filter (optional)",
        "default": "MQTT — Filters (optional)"
      },
      "description": {
        "de": "Optionale Filter, um Ausreißer oder unplausible Werte vor dem Speichern zu verwerfen.",
        "default": "Optional filters to discard outliers or implausible values before storing."
      },
      "elements": []
    },
    {
      "name": "p_mapping",
      "title": {
        "de": "InfluxDB-Zuordnung",
        "default": "InfluxDB Mapping"
      },
      "description": {
        "de": "Measurement und Field sollten gut überlegt gewählt werden. Sie legen fest, wo die Daten in InfluxDB gespeichert werden. Eine nachträgliche Änderung ist kaum möglich, da bereits geschriebene Daten dauerhaft an diese Bezeichnungen gebunden sind.",
        "default": "Choose measurement and field carefully. They determine where data is stored in InfluxDB. Changing these later is very difficult, as previously written data remains permanently tied to these names."
      },
      "elements": [
        {
          "type": "text",
          "name": "measurement",
          "title": {
            "de": "Measurement",
            "default": "Measurement"
          },
          "description": {
            "de": "Name des InfluxDB-Measurements, in das der Sensor schreibt",
            "default": "Name of the InfluxDB measurement the sensor writes to"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "field",
          "visibleIf": "{source} <> 'shelly'",
          "clearIfInvisible": "none",
          "title": {
            "de": "Field",
            "default": "Field"
          },
          "description": {
            "de": "Name des InfluxDB-Fields innerhalb des Measurements",
            "default": "Name of the InfluxDB field within the measurement"
          },
          "isRequired": true
        }
      ]
    },
    {
      "name": "p_shelly_phase",
      "visibleIf": "{source} = 'shelly'",
      "title": {
        "de": "Shelly — Phase",
        "default": "Shelly — Phase"
      },
      "description": {
        "de": "Bitte beachten: Einige Shelly-Modelle messen nur die Summe",
        "default": "Note: some Shelly models only measure the total"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "field_shelly",
          "valueName": "field",
          "clearIfInvisible": "none",
          "titleLocation": "hidden",
          "isRequired": true,
          "defaultValue": "power",
          "choices": [
            {
              "value": "power",
              "text": {
                "de": "Summe",
                "default": "Total"
              }
            },
            {
              "value": "power_a",
              "text": {
                "de": "Phase A",
                "default": "Phase A"
              }
            },
            {
              "value": "power_b",
              "text": {
                "de": "Phase B",
                "default": "Phase B"
              }
            },
            {
              "value": "power_c",
              "text": {
                "de": "Phase C",
                "default": "Phase C"
              }
            }
          ]
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
