{
  "locale": "de",
  "title": {
    "de": "Shelly-Collector",
    "default": "Shelly-Collector"
  },
  "description": {
    "de": "Liest Messwerte aus Shelly-Stromzählern (Plug, Pro 3EM o.ä.).",
    "default": "Reads measurements from Shelly energy meters (Plug, Pro 3EM, etc.)."
  },
  "pages": [
    {
      "name": "p_shelly",
      "title": {
        "de": "Shelly-Einstellungen",
        "default": "Shelly settings"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "connection",
          "title": {
            "de": "Standard-Verbindungsart",
            "default": "Default connection type"
          },
          "defaultValue": "local",
          "isRequired": true,
          "choices": [
            {
              "value": "local",
              "text": {
                "de": "Lokal (im Heimnetzwerk)",
                "default": "Local (in home network)"
              }
            },
            {
              "value": "cloud",
              "text": {
                "de": "Über Shelly Cloud",
                "default": "Via Shelly Cloud"
              }
            }
          ]
        },
        {
          "type": "text",
          "name": "interval",
          "title": {
            "de": "Standard-Abfrage-Intervall (in Sekunden)",
            "default": "Default query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 1
        }
      ]
    },
    {
      "name": "p_cloud",
      "visibleIf": "{connection} = 'cloud'",
      "title": {
        "de": "Cloud-Zugriff",
        "default": "Cloud access"
      },
      "elements": [
        {
          "type": "text",
          "name": "cloud_server",
          "title": {
            "de": "Cloud-Server-URL",
            "default": "Cloud server URL"
          },
          "isRequired": true,
          "placeholder": "https://shelly-42-eu.shelly.cloud"
        },
        {
          "type": "text",
          "name": "auth_key",
          "title": {
            "de": "Authentifizierungsschlüssel",
            "default": "Authentication key"
          },
          "isRequired": true
        }
      ]
    },
    {
      "name": "p_image",
      "title": {
        "de": "Software-Stand des Collectors",
        "default": "Collector release channel"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "image",
          "title": {
            "de": "Welchen Stand möchtest du verwenden?",
            "default": "Which release should be used?"
          },
          "isRequired": true,
          "choices": []
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "showCompletePage": false
}
