{
  "locale": "de",
  "title": {
    "de": "Backup",
    "default": "Backup"
  },
  "description": {
    "de": "Konfiguration der S3-Datensicherung",
    "default": "Configuration of S3 data backup"
  },
  "pages": [
    {
      "name": "p_backup",
      "elements": [
        {
          "type": "boolean",
          "name": "enabled",
          "title": {
            "de": "Automatisches Backup auf Amazon S3",
            "default": "Automatic backup to Amazon S3"
          },
          "description": {
            "de": "Sichert die Datenbanken regelmäßig in einen S3-Bucket.",
            "default": "Backs up the databases regularly into an S3 bucket."
          },
          "isRequired": true,
          "defaultValue": false,
          "labelTrue": {
            "de": "An",
            "default": "On"
          },
          "labelFalse": {
            "de": "Aus",
            "default": "Off"
          }
        }
      ]
    },
    {
      "name": "p_aws",
      "visibleIf": "{enabled} = true",
      "elements": [
        {
          "type": "text",
          "name": "aws_access_key_id",
          "title": "AWS Access Key ID",
          "isRequired": true
        },
        {
          "type": "text",
          "name": "aws_secret_access_key",
          "title": "AWS Secret Access Key",
          "isRequired": true
        },
        {
          "type": "text",
          "name": "aws_region",
          "title": "AWS Region",
          "isRequired": true,
          "placeholder": {
            "de": "z.B. eu-central-1",
            "default": "e.g. eu-central-1"
          }
        },
        {
          "type": "text",
          "name": "aws_bucket",
          "title": "S3 Bucket",
          "isRequired": true
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "showCompletePage": false
