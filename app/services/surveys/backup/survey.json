{
  "locale": "de",
  "title": {
    "de": "Sicherung",
    "default": "Backup"
  },
  "description": {
    "de": "Wo HELIOS deine Sicherungen ablegt.",
    "default": "Where HELIOS stores your backups."
  },
  "pages": [
    {
      "name": "p_destination",
      "elements": [
        {
          "type": "radiogroup",
          "name": "destination",
          "title": {
            "de": "Ablageort",
            "default": "Destination"
          },
          "isRequired": true,
          "defaultValue": "local",
          "choices": [
            {
              "value": "local",
              "text": {
                "de": "Lokal auf diesem Host",
                "default": "Local on this host"
              }
            },
            {
              "value": "external",
              "text": {
                "de": "Externer Mount (z. B. NAS)",
                "default": "External mount (e.g. NAS)"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_external",
      "visibleIf": "{destination} = 'external'",
      "elements": [
        {
          "type": "text",
          "name": "external_path",
          "title": {
            "de": "Pfad auf dem Host",
            "default": "Host path"
          },
          "description": {
            "de": "Absoluter Pfad zu einem bereits gemounteten Verzeichnis (HELIOS legt den Mount nicht an).",
            "default": "Absolute path to an already-mounted directory (HELIOS does not create the mount)."
          },
          "isRequired": true,
          "placeholder": "/mnt/nas/solectrus-backups",
          "validators": [
            {
              "type": "regex",
              "regex": "^/[A-Za-z0-9_/.\\-]+$",
              "text": {
                "de": "Bitte einen absoluten Pfad ohne Leer- oder Sonderzeichen angeben.",
                "default": "Please enter an absolute path without spaces or special characters."
              }
            }
          ]
        },
        {
          "type": "html",
          "name": "connection_test",
          "html": {
            "de": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"backup\" data-test-check=\"external_path\" data-test-fields=\"external_path\">Pfad prüfen</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>",
            "default": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"backup\" data-test-check=\"external_path\" data-test-fields=\"external_path\">Check path</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>"
          }
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "showCompletePage": false
}
