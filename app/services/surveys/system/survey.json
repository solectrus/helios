{
  "locale": "de",
  "title": {
    "de": "System-Einstellungen",
    "default": "System Settings"
  },
  "description": {
    "de": "Grundlegende Einstellungen für SOLECTRUS",
    "default": "Basic settings for SOLECTRUS"
  },
  "pages": [
    {
      "name": "p_general",
      "title": {
        "de": "Allgemein",
        "default": "General"
      },
      "elements": [
        {
          "type": "text",
          "name": "installation_date",
          "title": {
            "de": "Inbetriebnahme der PV-Anlage",
            "default": "Commissioning date of PV system"
          },
          "description": {
            "de": "Wird für die Zeitraumauswahl benötigt",
            "default": "Required for time range selection"
          },
          "visibleIfMode": "not_collectors_only",
          "isRequired": true,
          "inputType": "date"
        },
        {
          "type": "dropdown",
          "name": "timezone",
          "title": {
            "de": "Zeitzone",
            "default": "Timezone"
          },
          "isRequired": true,
          "defaultValue": "Europe/Berlin",
          "choices": [
            { "value": "Europe/Berlin", "text": "Europe/Berlin" },
            { "value": "Europe/Vienna", "text": "Europe/Vienna" },
            { "value": "Europe/Zurich", "text": "Europe/Zurich" },
            { "value": "Europe/Amsterdam", "text": "Europe/Amsterdam" },
            { "value": "Europe/Paris", "text": "Europe/Paris" },
            { "value": "Europe/Rome", "text": "Europe/Rome" },
            { "value": "Europe/London", "text": "Europe/London" },
            { "value": "America/New_York", "text": "America/New_York" },
            { "value": "America/Los_Angeles", "text": "America/Los_Angeles" },
            { "value": "Asia/Tokyo", "text": "Asia/Tokyo" },
            { "value": "Australia/Sydney", "text": "Australia/Sydney" }
          ]
        }
      ]
    },
    {
      "name": "p_network",
      "title": {
        "de": "Netzwerk",
        "default": "Network"
      },
      "visibleIfMode": "not_collectors_only",
      "elements": [
        {
          "type": "text",
          "name": "app_host",
          "title": {
            "de": "IP-Adresse oder Hostname",
            "default": "IP address or host name"
          },
          "isRequired": true
        }
      ]
    },
    {
      "name": "p_security",
      "title": {
        "de": "Sicherheit",
        "default": "Security"
      },
      "elements": [
        {
          "type": "text",
          "name": "admin_password",
          "title": {
            "de": "Administrator-Passwort",
            "default": "Administrator password"
          },
          "description": {
            "de": "Nur der Admin kann Einstellungen und Strompreise bearbeiten",
            "default": "Only the admin can edit settings and electricity prices"
          },
          "isRequired": true
        }
      ]
    },
    {
      "name": "p_updates",
      "title": {
        "de": "Automatische Updates",
        "default": "Automatic updates"
      },
      "elements": [
        {
          "type": "html",
          "name": "update_interval_info",
          "html": {
            "de": "<p>Neue Versionen der Dienste werden automatisch installiert, sobald sie verfügbar sind.</p>",
            "default": "<p>New versions of the services are installed automatically as soon as they become available.</p>"
          }
        },
        {
          "type": "radiogroup",
          "name": "update_interval",
          "title": {
            "de": "Prüfintervall",
            "default": "Check interval"
          },
          "isRequired": true,
          "defaultValue": "86400",
          "choices": [
            {
              "value": "86400",
              "text": {
                "de": "Täglich (empfohlen)",
                "default": "Daily (recommended)"
              }
            },
            {
              "value": "28800",
              "text": {
                "de": "Alle 8 Stunden",
                "default": "Every 8 hours"
              }
            },
            {
              "value": "3600",
              "text": {
                "de": "Stündlich",
                "default": "Hourly"
              }
            }
          ]
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
