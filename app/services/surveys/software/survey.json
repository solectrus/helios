{
  "locale": "de",
  "title": {
    "de": "Software-Stand",
    "default": "Release channel"
  },
  "description": {
    "de": "Software-Stand der SOLECTRUS-Dienste",
    "default": "Release channel of the SOLECTRUS services"
  },
  "pages": [
    {
      "name": "p_software",
      "elements": [
        {
          "type": "radiogroup",
          "name": "update_mode",
          "title": {
            "de": "Wann soll nach Updates gesucht werden?",
            "default": "When to check for updates?"
          },
          "isRequired": true,
          "defaultValue": "interval",
          "choices": [
            {
              "value": "interval",
              "text": {
                "de": "In regelmäßigen Abständen",
                "default": "At regular intervals"
              }
            },
            {
              "value": "time",
              "text": {
                "de": "Täglich zu einer festen Uhrzeit",
                "default": "Daily at a fixed time"
              }
            }
          ]
        },
        {
          "type": "radiogroup",
          "name": "update_interval",
          "title": {
            "de": "Abstand zwischen den Prüfungen",
            "default": "Time between checks"
          },
          "isRequired": true,
          "defaultValue": "86400",
          "visibleIf": "{update_mode} = 'interval'",
          "clearIfInvisible": "onHidden",
          "choices": [
            {
              "value": "86400",
              "text": {
                "de": "Täglich (empfohlen)",
                "default": "Daily (recommended)"
              }
            },
            {
              "value": "28800",
              "text": {
                "de": "Alle 8 Stunden",
                "default": "Every 8 hours"
              }
            },
            {
              "value": "3600",
              "text": {
                "de": "Stündlich",
                "default": "Hourly"
              }
            }
          ]
        },
        {
          "type": "text",
          "name": "update_time",
          "title": {
            "de": "Uhrzeit",
            "default": "Time of day"
          },
          "isRequired": true,
          "inputType": "time",
          "defaultValue": "04:00",
          "visibleIf": "{update_mode} = 'time'",
          "clearIfInvisible": "onHidden"
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "showCompletePage": false
}
