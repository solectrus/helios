{
  "locale": "de",
  "title": {
    "de": "InfluxDB",
    "default": "InfluxDB"
  },
  "description": {
    "de": "Zeitreihen-Datenbank für die Messwerte.",
    "default": "Time-series database for the measurements."
  },
  "pages": [
    {
      "name": "p_local",
      "title": {
        "de": "Zugriff",
        "default": "Access"
      },
      "description": {
        "de": "Standardmäßig ist InfluxDB nur intern für SOLECTRUS erreichbar.",
        "default": "By default InfluxDB is reachable only internally by SOLECTRUS."
      },
      "visibleIfMode": "full",
      "elements": [
        {
          "type": "boolean",
          "name": "publish_port",
          "title": {
            "de": "InfluxDB im lokalen Netzwerk erreichbar machen",
            "default": "Make InfluxDB reachable on the local network"
          },
          "description": {
            "de": "Gibt den Port auf dem Host frei, sodass die InfluxDB im lokalen Netzwerk (LAN) erreichbar ist, etwa für die eingebaute Weboberfläche von InfluxDB oder externe Tools.",
            "default": "Publishes the port on the host so InfluxDB is reachable on the local network (LAN), for example for the built-in InfluxDB web interface or external tools."
          },
          "defaultValue": false,
          "renderAs": "checkbox"
        },
        {
          "type": "text",
          "name": "host_port",
          "title": {
            "de": "Port",
            "default": "Port"
          },
          "description": {
            "de": "Unter welchem Port soll InfluxDB erreichbar sein? Ändere das beispielsweise, wenn Port 8086 auf deinem Host bereits belegt ist.",
            "default": "Which port should InfluxDB be reachable on? Change this for example when port 8086 is already in use on your host."
          },
          "visibleIf": "{publish_port} = true",
          "defaultValue": "8086",
          "inputType": "number",
          "min": 1,
          "max": 65535
        }
      ]
    },
    {
      "name": "p_connection",
      "title": {
        "de": "Verbindung",
        "default": "Connection"
      },
      "description": {
        "de": "Gib an, unter welcher Adresse SOLECTRUS deine externe InfluxDB im Netzwerk erreicht.",
        "default": "Specify the address where SOLECTRUS reaches your external InfluxDB on the network."
      },
      "visibleIfMode": "collectors_only",
      "elements": [
        {
          "type": "text",
          "name": "host",
          "title": {
            "de": "Hostname",
            "default": "Hostname"
          },
          "isRequired": true,
          "placeholder": "influxdb.example.com"
        },
        {
          "type": "radiogroup",
          "name": "schema",
          "title": {
            "de": "Protokoll",
            "default": "Protocol"
          },
          "isRequired": true,
          "defaultValue": "http",
          "choices": [
            { "value": "http", "text": "http" },
            { "value": "https", "text": "https" }
          ]
        },
        {
          "type": "text",
          "name": "port",
          "title": {
            "de": "Port",
            "default": "Port"
          },
          "isRequired": true,
          "defaultValueExpression": "iif({schema} = 'http', '8086', '443')",
          "inputType": "number",
          "min": 1,
          "max": 65535
        },
        {
          "type": "html",
          "name": "connection_test",
          "html": {
            "de": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"influxdb\" data-test-check=\"reachability\" data-test-fields=\"schema,host,port\">Verbindung testen</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>",
            "default": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"influxdb\" data-test-check=\"reachability\" data-test-fields=\"schema,host,port\">Test connection</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>"
          }
        }
      ]
    },
    {
      "name": "p_credentials",
      "title": {
        "de": "Zugangsdaten",
        "default": "Credentials"
      },
      "description": {
        "de": "Zugangsdaten, mit denen SOLECTRUS sich an der InfluxDB anmeldet und Messwerte schreibt.",
        "default": "Credentials SOLECTRUS uses to authenticate against InfluxDB and write measurements."
      },
      "visibleIfMode": "collectors_only",
      "elements": [
        {
          "type": "text",
          "name": "org",
          "title": {
            "de": "Organisation",
            "default": "Organization"
          },
          "isRequired": true,
          "defaultValue": "solectrus"
        },
        {
          "type": "text",
          "name": "bucket",
          "title": {
            "de": "Bucket",
            "default": "Bucket"
          },
          "isRequired": true,
          "defaultValue": "solectrus"
        },
        {
          "type": "text",
          "name": "token_write",
          "title": {
            "de": "API-Token (Schreibrechte)",
            "default": "API token (write access)"
          },
          "isRequired": true
        },
        {
          "type": "html",
          "name": "credentials_test",
          "html": {
            "de": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"influxdb\" data-test-check=\"credentials\" data-test-fields=\"schema,host,port,org,bucket,token_write\">Zugangsdaten prüfen</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>",
            "default": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"influxdb\" data-test-check=\"credentials\" data-test-fields=\"schema,host,port,org,bucket,token_write\">Verify credentials</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>"
          }
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "showCompletePage": false
}
