{
  "locale": "de",
  "title": {
    "de": "InfluxDB",
    "default": "InfluxDB"
  },
  "description": {
    "de": "Einstellungen für die Zeitreihen-Datenbank, in der SOLECTRUS deine Messwerte speichert.",
    "default": "Settings for the time-series database where SOLECTRUS stores your measurements."
  },
  "pages": [
    {
      "name": "p_local",
      "title": {
        "de": "Zugriff",
        "default": "Access"
      },
      "description": {
        "de": "InfluxDB ist standardmäßig nur intern für SOLECTRUS erreichbar. Auf Wunsch kannst du sie von außen freigeben — etwa für die eigene Web-Oberfläche von InfluxDB oder für andere Anwendungen, die direkt auf die gespeicherten Messwerte zugreifen sollen.",
        "default": "By default InfluxDB is only reachable internally by SOLECTRUS. You can optionally open it to the outside — for the InfluxDB web interface or for other applications that should access the stored measurements directly."
      },
      "visibleIfMode": "full",
      "elements": [
        {
          "type": "boolean",
          "name": "publish_port",
          "title": {
            "de": "InfluxDB von außen erreichbar machen",
            "default": "Make InfluxDB reachable from outside"
          },
          "description": {
            "de": "Aktiviere das beispielsweise, wenn du selbst (im Browser) oder andere Anwendungen (eigene Skripte, Auswertungen, externe Collectoren) direkt auf die InfluxDB zugreifen sollen.",
            "default": "Enable this for example when you (in the browser) or other applications (your own scripts, analyses, external collectors) should access InfluxDB directly."
          },
          "defaultValue": false,
          "renderAs": "checkbox"
        },
        {
          "type": "text",
          "name": "host_port",
          "title": {
            "de": "Port",
            "default": "Port"
          },
          "description": {
            "de": "Unter welchem Port soll InfluxDB erreichbar sein? Ändere das beispielsweise, wenn Port 8086 auf deinem Host bereits belegt ist.",
            "default": "Which port should InfluxDB be reachable on? Change this for example when port 8086 is already in use on your host."
          },
          "visibleIf": "{publish_port} = true",
          "defaultValue": "8086",
          "inputType": "number",
          "min": 1,
          "max": 65535
        }
      ]
    },
    {
      "name": "p_connection",
      "title": {
        "de": "Verbindung",
        "default": "Connection"
      },
      "visibleIfMode": "collectors_only",
      "elements": [
        {
          "type": "text",
          "name": "host",
          "title": {
            "de": "Hostname",
            "default": "Hostname"
          },
          "isRequired": true,
          "placeholder": "influxdb.example.com"
        },
        {
          "type": "text",
          "name": "port",
          "title": {
            "de": "Port",
            "default": "Port"
          },
          "isRequired": true,
          "defaultValue": "443",
          "inputType": "number",
          "min": 1,
          "max": 65535
        },
        {
          "type": "dropdown",
          "name": "schema",
          "title": {
            "de": "Protokoll",
            "default": "Protocol"
          },
          "isRequired": true,
          "defaultValue": "https",
          "choices": [
            { "value": "https", "text": "https" },
            { "value": "http", "text": "http" }
          ]
        }
      ]
    },
    {
      "name": "p_credentials",
      "title": {
        "de": "Zugangsdaten",
        "default": "Credentials"
      },
      "visibleIfMode": "collectors_only",
      "elements": [
        {
          "type": "text",
          "name": "org",
          "title": {
            "de": "Organisation",
            "default": "Organization"
          },
          "isRequired": true,
          "defaultValue": "solectrus"
        },
        {
          "type": "text",
          "name": "bucket",
          "title": {
            "de": "Bucket",
            "default": "Bucket"
          },
          "isRequired": true,
          "defaultValue": "solectrus"
        },
        {
          "type": "text",
          "name": "token_write",
          "title": {
            "de": "API-Token (Schreibrechte)",
            "default": "API token (write access)"
          },
          "isRequired": true
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
