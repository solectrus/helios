{
  "locale": "de",
  "title": {
    "de": "MQTT",
    "default": "MQTT"
  },
  "description": {
    "de": "Liest Messwerte, die Geräte über einen Broker veröffentlichen.",
    "default": "Reads measurements that devices publish over a broker."
  },
  "pages": [
    {
      "name": "p_mqtt_broker",
      "title": {
        "de": "MQTT-Broker",
        "default": "MQTT broker"
      },
      "description": {
        "de": "Ein Broker nimmt die Nachrichten der Geräte entgegen. Home Assistant und ioBroker bringen meist schon einen mit, andernfalls stellt HELIOS einen bereit.",
        "default": "A broker receives the messages sent by the devices. Home Assistant and ioBroker usually bring one along, otherwise HELIOS provides one."
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "broker_external",
          "titleLocation": "hidden",
          "choices": [
            {
              "value": false,
              "text": {
                "de": "Interner Broker (Mosquitto, von HELIOS betrieben)",
                "default": "Internal broker (Mosquitto, run by HELIOS)"
              }
            },
            {
              "value": true,
              "text": {
                "de": "Externer Broker (bereits vorhanden)",
                "default": "External broker (already in place)"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_mqtt_broker_settings",
      "title": {
        "de": "Internen Broker einrichten",
        "default": "Set up the internal broker"
      },
      "description": {
        "de": "Diese Zugangsdaten werden hier neu festgelegt. Die Geräte brauchen sie, um Nachrichten an SOLECTRUS zu senden.",
        "default": "These credentials are defined here. The devices need them to send messages to SOLECTRUS."
      },
      "visibleIf": "{broker_external} <> true",
      "elements": [
        {
          "type": "text",
          "name": "port",
          "title": {
            "de": "Port",
            "default": "Port"
          },
          "inputType": "number",
          "isRequired": true,
          "defaultValue": 1883,
          "min": 1,
          "max": 65535
        },
        {
          "type": "text",
          "name": "username",
          "title": {
            "de": "Benutzername",
            "default": "Username"
          },
          "defaultValue": "solectrus",
          "validators": [
            {
              "type": "regex",
              "regex": "^[^:]*$",
              "text": {
                "de": "Ein Doppelpunkt ist im Benutzernamen nicht erlaubt.",
                "default": "A colon is not allowed in the username."
              }
            }
          ],
          "isRequired": true
        },
        {
          "type": "text",
          "name": "password",
          "title": {
            "de": "Passwort",
            "default": "Password"
          },
          "visibleIf": "{username} notempty",
          "clearIfInvisible": "onHidden",
          "inputType": "password",
          "description": {
            "de": "Schützt den Broker davor, Nachrichten von jedem anzunehmen, der ihn erreicht. Manche Geräte erwarten es als Teil der Broker-Adresse und scheitern dort an Sonderzeichen, Buchstaben und Ziffern gehen überall.",
            "default": "Keeps the broker from accepting messages from anyone who can reach it. Some devices expect it as part of the broker address and fail on special characters there, so letters and digits work everywhere."
          },
          "isRequired": true
        }
      ]
    },
    {
      "name": "p_mqtt_connection",
      "title": {
        "de": "Verbindung zum externen Broker",
        "default": "Connection to the external broker"
      },
      "description": {
        "de": "So erreicht SOLECTRUS den vorhandenen MQTT-Broker.",
        "default": "How SOLECTRUS reaches the existing MQTT broker."
      },
      "elements": [
        {
          "type": "text",
          "name": "mqtt_host",
          "title": {
            "de": "Hostname oder IP-Adresse",
            "default": "Hostname or IP address"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. mqtt.fritz.box",
            "default": "e.g. mqtt.fritz.box"
          }
        },
        {
          "type": "text",
          "name": "mqtt_port",
          "title": {
            "de": "Port",
            "default": "Port"
          },
          "description": {
            "de": "Üblich: 1883, bei SSL 8883",
            "default": "Typically 1883, or 8883 with SSL"
          },
          "inputType": "number",
          "isRequired": true,
          "defaultValue": 1883
        },
        {
          "type": "boolean",
          "name": "mqtt_ssl",
          "title": {
            "de": "SSL/TLS verwenden",
            "default": "Use SSL/TLS"
          },
          "defaultValue": false
        },
        {
          "type": "html",
          "name": "connection_test",
          "html": {
            "de": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"mqtt\" data-test-check=\"reachability\" data-test-fields=\"mqtt_host,mqtt_port,mqtt_ssl\">Verbindung testen</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>",
            "default": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"mqtt\" data-test-check=\"reachability\" data-test-fields=\"mqtt_host,mqtt_port,mqtt_ssl\">Test connection</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>"
          }
        }
      ],
      "visibleIf": "{broker_external} = true"
    },
    {
      "name": "p_mqtt_auth",
      "title": {
        "de": "Anmeldung am externen Broker",
        "default": "Login at the external broker"
      },
      "description": {
        "de": "Die vorhandenen Zugangsdaten des Brokers, leer lassen, wenn er ohne Anmeldung erreichbar ist.",
        "default": "The existing credentials of the broker, leave empty if it is reachable without a login."
      },
      "elements": [
        {
          "type": "text",
          "name": "mqtt_username",
          "title": {
            "de": "Benutzername (optional)",
            "default": "Username (optional)"
          }
        },
        {
          "type": "text",
          "name": "mqtt_password",
          "title": {
            "de": "Passwort (optional)",
            "default": "Password (optional)"
          },
          "inputType": "password"
        },
        {
          "type": "html",
          "name": "credentials_test",
          "html": {
            "de": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"mqtt\" data-test-check=\"credentials\" data-test-fields=\"mqtt_host,mqtt_port,mqtt_ssl,mqtt_username,mqtt_password\">Zugangsdaten prüfen</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>",
            "default": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"mqtt\" data-test-check=\"credentials\" data-test-fields=\"mqtt_host,mqtt_port,mqtt_ssl,mqtt_username,mqtt_password\">Verify credentials</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>"
          }
        }
      ],
      "visibleIf": "{broker_external} = true"
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "showCompletePage": false
}
