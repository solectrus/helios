{
  "locale": "de",
  "title": {
    "de": "MQTT-Collector",
    "default": "MQTT Collector"
  },
  "description": {
    "de": "Liest Messwerte von Topics eines MQTT-Brokers.",
    "default": "Reads measurements from topics on an MQTT broker."
  },
  "pages": [
    {
      "name": "p_mqtt_connection",
      "title": {
        "de": "Verbindung zum MQTT-Broker",
        "default": "Connection to the MQTT broker"
      },
      "description": {
        "de": "So erreicht SOLECTRUS deinen MQTT-Broker.",
        "default": "How SOLECTRUS reaches your MQTT broker."
      },
      "elements": [
        {
          "type": "text",
          "name": "mqtt_host",
          "title": {
            "de": "Hostname oder IP-Adresse",
            "default": "Hostname or IP address"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. mqtt.fritz.box",
            "default": "e.g. mqtt.fritz.box"
          }
        },
        {
          "type": "text",
          "name": "mqtt_port",
          "title": {
            "de": "Port (optional)",
            "default": "Port (optional)"
          },
          "description": {
            "de": "Standard: 1883 (oder 8883 bei SSL)",
            "default": "Default: 1883 (or 8883 with SSL)"
          },
          "inputType": "number"
        },
        {
          "type": "boolean",
          "name": "mqtt_ssl",
          "title": {
            "de": "SSL/TLS verwenden",
            "default": "Use SSL/TLS"
          },
          "defaultValue": false
        },
        {
          "type": "html",
          "name": "connection_test",
          "html": {
            "de": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"mqtt\" data-test-check=\"reachability\" data-test-fields=\"mqtt_host,mqtt_port,mqtt_ssl\">Verbindung testen</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>",
            "default": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"mqtt\" data-test-check=\"reachability\" data-test-fields=\"mqtt_host,mqtt_port,mqtt_ssl\">Test connection</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>"
          }
        }
      ]
    },
    {
      "name": "p_mqtt_auth",
      "title": {
        "de": "Authentifizierung beim MQTT-Broker",
        "default": "Authentication with the MQTT broker"
      },
      "description": {
        "de": "Zugangsdaten für den Broker — leer lassen, wenn er ohne Anmeldung erreichbar ist.",
        "default": "Credentials for the broker — leave empty if it is reachable without a login."
      },
      "elements": [
        {
          "type": "text",
          "name": "mqtt_username",
          "title": {
            "de": "Benutzername (optional)",
            "default": "Username (optional)"
          }
        },
        {
          "type": "text",
          "name": "mqtt_password",
          "title": {
            "de": "Passwort (optional)",
            "default": "Password (optional)"
          },
          "inputType": "password"
        },
        {
          "type": "html",
          "name": "credentials_test",
          "html": {
            "de": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"mqtt\" data-test-check=\"credentials\" data-test-fields=\"mqtt_host,mqtt_port,mqtt_ssl,mqtt_username,mqtt_password\">Zugangsdaten prüfen</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>",
            "default": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"mqtt\" data-test-check=\"credentials\" data-test-fields=\"mqtt_host,mqtt_port,mqtt_ssl,mqtt_username,mqtt_password\">Verify credentials</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>"
          }
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "showCompletePage": false
}
