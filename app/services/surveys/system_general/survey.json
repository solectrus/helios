{
  "locale": "de",
  "title": {
    "de": "Grundeinstellungen",
    "default": "Basic settings"
  },
  "description": {
    "de": "Inbetriebnahme, Land, Zeitzone und Währung",
    "default": "Commissioning date, country, timezone and currency"
  },
  "pages": [
    {
      "name": "p_installation",
      "visibleIfMode": "not_collectors_only",
      "elements": [
        {
          "type": "text",
          "name": "installation_date",
          "title": {
            "de": "Inbetriebnahme der PV-Anlage",
            "default": "Commissioning date of PV system"
          },
          "description": {
            "de": "Der Tag, an dem die Module zum ersten Mal Strom erzeugt haben",
            "default": "The day the solar modules first produced power"
          },
          "isRequired": true,
          "inputType": "date"
        }
      ]
    },
    {
      "name": "p_country",
      "visibleIfMode": "not_collectors_only",
      "elements": [
        {
          "type": "dropdown",
          "name": "country",
          "title": {
            "de": "Land",
            "default": "Country"
          },
          "description": {
            "de": "Für öffentliche Energiepreise und Vergleichswerte, die es nur für EU-Staaten gibt",
            "default": "For public energy prices and reference values, which exist for EU member states only"
          },
          "choices": [
            {
              "value": "other",
              "text": {
                "de": "Außerhalb der EU",
                "default": "Outside the EU"
              }
            }
          ],
          "isRequired": true
        }
      ]
    },
    {
      "name": "p_timezone",
      "elements": [
        {
          "type": "dropdown",
          "name": "timezone",
          "title": {
            "de": "Zeitzone",
            "default": "Timezone"
          },
          "isRequired": true,
          "defaultValue": "Europe/Berlin"
        }
      ]
    },
    {
      "name": "p_currency",
      "elements": [
        {
          "type": "dropdown",
          "name": "currency_preset",
          "title": {
            "de": "Währung",
            "default": "Currency"
          },
          "description": {
            "de": "Für die Anzeige von Geldbeträgen im Dashboard",
            "default": "For displaying monetary values in the dashboard"
          },
          "isRequired": true,
          "searchEnabled": false,
          "defaultValueExpression": "iif({currency} = 'CHF' or {currency} = 'USD' or {currency} = 'GBP', {currency}, iif({currency} = 'EUR' or {currency} empty, 'EUR', 'other'))",
          "choices": [
            {
              "value": "EUR",
              "text": {
                "de": "Euro (€)",
                "default": "Euro (€)"
              }
            },
            {
              "value": "CHF",
              "text": {
                "de": "Schweizer Franken (CHF)",
                "default": "Swiss franc (CHF)"
              }
            },
            {
              "value": "USD",
              "text": {
                "de": "US-Dollar ($)",
                "default": "US dollar ($)"
              }
            },
            {
              "value": "GBP",
              "text": {
                "de": "Pfund Sterling (£)",
                "default": "Pound sterling (£)"
              }
            },
            {
              "value": "other",
              "text": {
                "de": "Andere Währung …",
                "default": "Other currency …"
              }
            }
          ]
        },
        {
          "type": "text",
          "name": "currency",
          "title": {
            "de": "ISO-4217-Währungscode",
            "default": "ISO 4217 currency code"
          },
          "description": {
            "de": "Dreistelliger Code, z. B. SEK, NOK, PLN, JPY",
            "default": "Three-letter code, e.g. SEK, NOK, PLN, JPY"
          },
          "defaultValue": "EUR",
          "visibleIf": "{currency_preset} = 'other'",
          "requiredIf": "{currency_preset} = 'other'",
          "clearIfInvisible": "none",
          "setValueIf": "{currency_preset} notempty and {currency_preset} != 'other'",
          "setValueExpression": "{currency_preset}",
          "placeholder": "SEK",
          "maxLength": 3,
          "validators": [
            {
              "type": "regex",
              "regex": "^[A-Za-z]{3}$",
              "text": {
                "de": "Bitte einen dreistelligen ISO-4217-Code angeben (z. B. SEK).",
                "default": "Please enter a three-letter ISO 4217 code (e.g. SEK)."
              }
            }
          ]
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "showCompletePage": false
}
