{
  "locale": "de",
  "title": {
    "de": "PV-Anlage",
    "default": "PV system"
  },
  "description": {
    "de": "Inbetriebnahme, Zeitzone und Währung",
    "default": "Commissioning date, timezone and currency"
  },
  "pages": [
    {
      "name": "p_general",
      "elements": [
        {
          "type": "text",
          "name": "installation_date",
          "title": {
            "de": "Inbetriebnahme der PV-Anlage",
            "default": "Commissioning date of PV system"
          },
          "description": {
            "de": "Wird für die Zeitraumauswahl benötigt",
            "default": "Required for time range selection"
          },
          "visibleIfMode": "not_collectors_only",
          "isRequired": true,
          "inputType": "date"
        },
        {
          "type": "dropdown",
          "name": "timezone",
          "title": {
            "de": "Zeitzone",
            "default": "Timezone"
          },
          "isRequired": true,
          "defaultValue": "Europe/Berlin",
          "choices": [
            { "value": "Europe/Berlin", "text": "Europe/Berlin" },
            { "value": "Europe/Vienna", "text": "Europe/Vienna" },
            { "value": "Europe/Zurich", "text": "Europe/Zurich" },
            { "value": "Europe/Amsterdam", "text": "Europe/Amsterdam" },
            { "value": "Europe/Paris", "text": "Europe/Paris" },
            { "value": "Europe/Rome", "text": "Europe/Rome" },
            { "value": "Europe/London", "text": "Europe/London" },
            { "value": "America/New_York", "text": "America/New_York" },
            { "value": "America/Los_Angeles", "text": "America/Los_Angeles" },
            { "value": "Asia/Tokyo", "text": "Asia/Tokyo" },
            { "value": "Australia/Sydney", "text": "Australia/Sydney" }
          ]
        }
      ]
    },
    {
      "name": "p_currency",
      "elements": [
        {
          "type": "dropdown",
          "name": "currency_preset",
          "title": {
            "de": "Währung",
            "default": "Currency"
          },
          "description": {
            "de": "Für die Anzeige von Geldbeträgen im Dashboard",
            "default": "For displaying monetary values in the dashboard"
          },
          "isRequired": true,
          "searchEnabled": false,
          "defaultValueExpression": "iif({currency} = 'CHF' or {currency} = 'USD' or {currency} = 'GBP', {currency}, iif({currency} = 'EUR' or {currency} empty, 'EUR', 'other'))",
          "choices": [
            {
              "value": "EUR",
              "text": { "de": "Euro (€)", "default": "Euro (€)" }
            },
            {
              "value": "CHF",
              "text": {
                "de": "Schweizer Franken (CHF)",
                "default": "Swiss franc (CHF)"
              }
            },
            {
              "value": "USD",
              "text": { "de": "US-Dollar ($)", "default": "US dollar ($)" }
            },
            {
              "value": "GBP",
              "text": {
                "de": "Pfund Sterling (£)",
                "default": "Pound sterling (£)"
              }
            },
            {
              "value": "other",
              "text": {
                "de": "Andere Währung …",
                "default": "Other currency …"
              }
            }
          ]
        },
        {
          "type": "text",
          "name": "currency",
          "title": {
            "de": "ISO-4217-Währungscode",
            "default": "ISO 4217 currency code"
          },
          "description": {
            "de": "Dreistelliger Code, z. B. SEK, NOK, PLN, JPY",
            "default": "Three-letter code, e.g. SEK, NOK, PLN, JPY"
          },
          "defaultValue": "EUR",
          "visibleIf": "{currency_preset} = 'other'",
          "requiredIf": "{currency_preset} = 'other'",
          "clearIfInvisible": "none",
          "setValueIf": "{currency_preset} notempty and {currency_preset} != 'other'",
          "setValueExpression": "{currency_preset}",
          "placeholder": "SEK",
          "maxLength": 3,
          "validators": [
            {
              "type": "regex",
              "regex": "^[A-Za-z]{3}$",
              "text": {
                "de": "Bitte einen dreistelligen ISO-4217-Code angeben (z. B. SEK).",
                "default": "Please enter a three-letter ISO 4217 code (e.g. SEK)."
              }
            }
          ]
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "showCompletePage": false
}
