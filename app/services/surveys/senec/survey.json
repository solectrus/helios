{
  "locale": "de",
  "title": {
    "de": "SENEC-Collector",
    "default": "SENEC-Collector"
  },
  "description": {
    "de": "Liest Messwerte von deinem SENEC-Speicher. Unterstützt SENEC.Home V2.1, V3 und Home 4.",
    "default": "Reads measurements from your SENEC battery. Supports SENEC.Home V2.1, V3 and Home 4."
  },
  "pages": [
    {
      "name": "p_version",
      "title": {
        "de": "SENEC-Typ",
        "default": "SENEC type"
      },
      "description": {
        "de": "Die Modellreihe bestimmt, welche Zugriffsarten und Optionen anschließend zur Verfügung stehen.",
        "default": "The model series determines which access types and options become available next."
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "version",
          "title": {
            "de": "Welches SENEC-System hast du?",
            "default": "Which SENEC system do you have?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "v3",
              "text": {
                "de": "SENEC.Home V3 oder V2.1",
                "default": "SENEC.Home V3 or V2.1"
              }
            },
            {
              "value": "v4",
              "text": {
                "de": "SENEC.Home 4",
                "default": "SENEC.Home 4"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_adapter",
      "visibleIf": "{version} = 'v3'",
      "title": {
        "de": "Zugriffsart",
        "default": "Access type"
      },
      "description": {
        "de": "Lokaler Zugriff liest direkt im Heimnetz, Cloud-Zugriff läuft über mein-senec.de.",
        "default": "Local access reads directly on your home network, cloud access goes via mein-senec.de."
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "adapter",
          "title": {
            "de": "Wie möchtest du auf dein SENEC-System zugreifen?",
            "default": "How would you like to access your SENEC system?"
          },
          "isRequired": true,
          "defaultValue": "local",
          "setValueIf": "{version} = 'v4'",
          "setValueExpression": "'cloud'",
          "choices": [
            {
              "value": "local",
              "text": {
                "de": "Lokaler Zugriff (im Heimnetz)",
                "default": "Local access (home network)"
              }
            },
            {
              "value": "cloud",
              "text": {
                "de": "Cloud-Zugriff (mein-senec.de)",
                "default": "Cloud access (mein-senec.de)"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_local",
      "visibleIf": "{adapter} = 'local'",
      "title": {
        "de": "Lokaler Zugriff",
        "default": "Local access"
      },
      "description": {
        "de": "So erreicht der Collector dein SENEC-Gerät im Heimnetz.",
        "default": "How the collector reaches your SENEC device on the home network."
      },
      "elements": [
        {
          "type": "text",
          "name": "host",
          "title": {
            "de": "Lokale IP-Adresse oder Hostname",
            "default": "Local IP address or host name"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. 192.168.178.42",
            "default": "e.g. 192.168.178.42"
          }
        },
        {
          "type": "radiogroup",
          "name": "schema",
          "title": {
            "de": "Zugriffsprotokoll",
            "default": "Protocol"
          },
          "defaultValue": "https",
          "isRequired": true,
          "choices": ["https", "http"]
        },
        {
          "type": "radiogroup",
          "name": "language",
          "title": {
            "de": "Sprache des SENEC-Geräts",
            "default": "Language of SENEC device"
          },
          "defaultValue": "de",
          "isRequired": true,
          "choices": [
            {
              "value": "de",
              "text": {
                "de": "Deutsch",
                "default": "German"
              }
            },
            {
              "value": "en",
              "text": {
                "de": "Englisch",
                "default": "English"
              }
            },
            {
              "value": "it",
              "text": {
                "de": "Italienisch",
                "default": "Italian"
              }
            }
          ]
        },
        {
          "type": "html",
          "name": "connection_test",
          "html": {
            "de": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"senec\" data-test-check=\"reachability\" data-test-fields=\"schema,host\">Verbindung testen</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>",
            "default": "<div class=\"connection-test\"><button type=\"button\" class=\"connection-test__button\" data-test-target=\"senec\" data-test-check=\"reachability\" data-test-fields=\"schema,host\">Test connection</button><span class=\"connection-test__status\" aria-live=\"polite\"></span></div>"
          }
        }
      ]
    },
    {
      "name": "p_cloud",
      "visibleIf": "{adapter} = 'cloud'",
      "title": {
        "de": "Cloud-Zugriff",
        "default": "Cloud access"
      },
      "description": {
        "de": "Zugangsdaten deines mein-senec.de-Kontos, über das der Collector die Messwerte abruft.",
        "default": "Credentials for your mein-senec.de account the collector uses to fetch measurements."
      },
      "elements": [
        {
          "type": "text",
          "name": "username",
          "title": {
            "de": "E-Mail-Adresse",
            "default": "Email address"
          },
          "isRequired": true,
          "inputType": "email"
        },
        {
          "type": "text",
          "name": "password",
          "title": {
            "de": "Passwort",
            "default": "Password"
          },
          "isRequired": true,
          "inputType": "password"
        },
        {
          "type": "text",
          "name": "totp_uri",
          "title": {
            "de": "TOTP-URI (optional)",
            "default": "TOTP URI (optional)"
          },
          "description": {
            "de": "Nur erforderlich bei aktivierter Zwei-Faktor-Authentifizierung",
            "default": "Only required when two-factor authentication is enabled"
          }
        },
        {
          "type": "text",
          "name": "system_id",
          "title": {
            "de": "System-ID (optional)",
            "default": "System ID (optional)"
          },
          "description": {
            "de": "Nur erforderlich, wenn mehrere Systeme mit dem Konto verknüpft sind",
            "default": "Only required when multiple systems are linked to the account"
          }
        },
        {
          "type": "radiogroup",
          "name": "request_mode",
          "title": {
            "de": "Abfragemodus",
            "default": "Request mode"
          },
          "description": {
            "de": "\"Minimal\" ruft nur einen Endpunkt mit den wichtigsten Feldern ab und ist der empfohlene Standard. \"Voll\" fragt zusätzlich case_temp, application_version sowie current_state/_ok ab (nicht bei Home 4) und erzeugt mehr Last auf den SENEC-Servern.",
            "default": "\"Minimal\" queries only one endpoint with the essential fields and is the recommended default. \"Full\" additionally fetches case_temp, application_version and current_state/_ok (not available on Home 4) and creates more load on the SENEC servers."
          },
          "defaultValue": "minimal",
          "choices": [
            {
              "value": "minimal",
              "text": {
                "de": "Minimal (empfohlen)",
                "default": "Minimal (recommended)"
              }
            },
            {
              "value": "full",
              "text": {
                "de": "Voll",
                "default": "Full"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_common",
      "title": {
        "de": "Allgemein",
        "default": "General"
      },
      "description": {
        "de": "Grundlegende Einstellungen des Collectors.",
        "default": "Basic settings for the collector."
      },
      "elements": [
        {
          "type": "text",
          "name": "interval",
          "title": {
            "de": "Abfrage-Intervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 5
        },
        {
          "type": "text",
          "name": "measurement",
          "title": {
            "de": "InfluxDB-Measurement",
            "default": "InfluxDB measurement"
          },
          "description": {
            "de": "Alle SENEC-Sensoren verwenden dasselbe Measurement. Eine nachträgliche Änderung ist kaum möglich, da bereits geschriebene Daten dauerhaft an diesen Namen gebunden sind.",
            "default": "All SENEC sensors use the same measurement. Changing this later is very difficult, as previously written data remains permanently tied to this name."
          },
          "defaultValue": "SENEC",
          "isRequired": true
        },
        {
          "type": "text",
          "name": "ignore",
          "title": {
            "de": "Felder ignorieren (optional)",
            "default": "Ignore fields (optional)"
          },
          "description": {
            "de": "Kommaseparierte Liste von Messfeldern, die nicht an InfluxDB gesendet werden sollen",
            "default": "Comma-separated list of measurement fields to exclude from InfluxDB"
          }
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
