<div class="hero min-h-screen">
  <div class="hero-content flex-col">
    <div class="text-center">
      <h1 class="text-4xl font-bold">Setup SOLECTRUS</h1>
      <p class="py-6">Just a few settings to get started.</p>
    </div>

    <div class="card bg-base-100 w-full max-w-md shadow-2xl">
      <div class="card-body">
        <%= form_with url: setup_path, method: :post, class: "space-y-4" do %>
          <div class="form-control">
            <label class="label"><span class="label-text">Installation Date</span></label>

            <input
              type="date"
              name="installation_date"
              class="input input-bordered"
              value="<%= @configuration.installation_date || Date.today %>"
              required
              autocomplete="off"
            >

            <label class="label"><span class="label-text-alt">When was your PV system installed?</span></label>
          </div>

          <div class="form-control">
            <label class="label"><span class="label-text">Timezone</span></label>

            <select name="timezone" class="select select-bordered w-full" required>
              <option value="">Select timezone...</option>
              <%= options_for_select(timezone_options, @configuration.timezone || 'Europe/Berlin') %>
            </select>
          </div>

          <div class="form-control mt-6">
            <button type="submit" class="btn btn-primary">
              Complete Setup
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
