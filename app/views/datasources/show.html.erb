<% content_for :title, t('.title') %>

<%= render "shared/configuration_page", active_tab: :datasources do %>
  <%#
    Every source the mode allows gets a card, in use or not, so setting one up
    starts here instead of on the sensors screen. A card that nothing reads
    through is dimmed (see SettingSection::Component#dimmed?).
  %>
  <% nothing_in_use = !@configuration.collectors_only? && @configuration.active_sources.empty? %>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <% @configuration.offered_sources.each do |source| %>
      <% if source == "external" %>
        <%= render ExternalInputInfo::Component.new(configuration: @configuration) %>
      <% else %>
        <%= render SettingSection::Component.new(setting: source, configuration: @configuration) %>
      <% end %>
    <% end %>

    <%# A CSV import fills sensors that exist, so it is dimmed until some do. %>
    <%= render "csv_import_link", dimmed: nothing_in_use %>
  </div>
<% end %>
