<%= turbo_frame_tag "log-modal-content" do %>
  <div data-controller="log-viewer" data-log-viewer-service-value="<%= params[:service_id] %>">
    <h3 class="mb-4 text-lg font-bold"><%= @service_display_name %> — Logs</h3>

    <pre
      data-log-viewer-target="output"
      class="bg-base-300 max-h-[70vh] overflow-auto rounded-lg p-4 font-mono text-xs leading-relaxed"
    ><%= @log_html %></pre>

    <div class="mt-3 flex items-center text-xs">
      <span class="text-base-content/50 flex items-center gap-2">
        <span data-log-viewer-target="streamingDot" class="inline-block h-2 w-2 rounded-full bg-current"></span>
        <span data-log-viewer-target="streamingLabel">Connecting…</span>
      </span>
    </div>
  </div>
<% end %>
