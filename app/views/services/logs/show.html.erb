<%#
  Stimulus attributes must live on an inner element: Turbo replaces frame
  contents but keeps the outer turbo-frame attributes from the layout.
%>

<%= turbo_frame_tag "log-modal-content", class: "flex h-full flex-col" do %>
  <%= render LogViewer::Component.new(
        service_id: params[:service_id],
        service_display_name: @service_display_name,
        log_html: @log_html,
      ) %>
<% end %>
