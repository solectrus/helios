<%= turbo_frame_tag "log-modal-content" do %>
  <div data-controller="log-viewer" data-log-viewer-service-value="<%= params[:service_id] %>">
    <h3 class="mb-4 text-lg font-bold"><%= t('.title', name: @service_display_name) %></h3>

    <div data-log-viewer-target="scrollContainer" class="bg-base-300 max-h-[70vh] overflow-auto rounded-lg p-4">
      <span data-log-viewer-target="loader" class="text-base-content/50 mb-2 hidden text-center">
        <span class="loading loading-dots loading-xs"></span>
      </span>

      <pre data-log-viewer-target="output" class="font-mono text-xs leading-relaxed"><%= @log_html %></pre>
    </div>

    <div class="mt-3 flex items-center text-xs">
      <span class="text-base-content/50 flex items-center gap-2">
        <span data-log-viewer-target="streamingDot" class="inline-block h-2 w-2 rounded-full bg-current"></span>
        <span data-log-viewer-target="streamingLabel"><%= t('.connecting') %></span>
      </span>
    </div>
  </div>
<% end %>
