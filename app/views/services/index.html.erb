<% content_for :title, t('.title') %>

<div class="min-h-screen">
  <%= turbo_frame_tag "tab-content", data: { controller: "visibility" } do %>
    <%= render Header::Component.new(active_tab: :services) %>

    <div class="mx-auto max-w-4xl p-8">
      <%= turbo_stream_from "services" %>

      <div class="space-y-3">
        <% @compose_services.each do |compose_service| %>
          <%= render ServiceRow::Component.new(
            compose_service:,
            container: @containers&.dig(compose_service.name),
            lazy: @containers.nil?,
          ) %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
