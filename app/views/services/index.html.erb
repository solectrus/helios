<% content_for :title, t('.title') %>
<% content_for :active_tab, "services" %>

<div>
  <%= turbo_frame_tag "tab-content", data: { controller: "visibility" } do %>
    <div class="mx-auto max-w-6xl py-4 md:p-8">
      <% if @setup_completed %>
        <%= turbo_stream_from "services" %>
        <% regular, tail = @compose_services.partition { |s| !s.helios? } %>
        <div class="space-y-3">
          <% regular.each do |compose_service| %>
            <%= render ServiceRow::Component.new(
              compose_service:,
              container: @containers&.dig(compose_service.name),
              lazy: @containers.nil?,
            ) %>
          <% end %>

          <% @orphaned_containers&.each do |container| %>
            <%= render OrphanedServiceRow::Component.new(container:) %>
          <% end %>

          <% tail.each do |compose_service| %>
            <%= render ServiceRow::Component.new(
              compose_service:,
              container: @containers&.dig(compose_service.name),
              lazy: @containers.nil?,
            ) %>
          <% end %>
        </div>
      <% else %>
        <%= render EmptyState::Component.new(
          icon: "fa-solid fa-server",
          title: t('.empty_title'),
          description: t('.empty_description'),
          cta: { label: t('.empty_cta'), path: sensors_path },
        ) %>
      <% end %>
    </div>

    <% if @setup_completed %>
      <%= render "shared/log_modal",
                 id: "log-modal",
                 turbo_frame: "log-modal-content",
                 box_classes: "overflow-hidden sm:w-[95vw]! sm:max-w-[95vw]! sm:overflow-y-auto" %>
    <% end %>
  <% end %>
</div>
