<div class="min-h-screen p-8" data-controller="visibility">
  <div class="mx-auto max-w-4xl">
    <div class="mb-8 flex items-center justify-between">
      <h1 class="text-4xl font-bold">HELIOS</h1>

      <div class="flex items-center gap-2">
        <%= render ThemeToggle::Component.new %>
        <%= button_to "Logout", session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
      </div>
    </div>

    <%= turbo_stream_from "services" %>

    <div class="mb-8 flex justify-center"><%= render GlobalActions::Component.new %></div>

    <div class="space-y-3">
      <% @compose_services.each do |compose_service| %>
        <%= render ServiceRow::Component.new(compose_service:, container: nil) %>
      <% end %>
    </div>
  </div>
</div>
