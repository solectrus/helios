<% helios_service = compose_services.find { |s| s.name == "helios" } %>
<% other_services = compose_services.reject { |s| s.name == "helios" } %>

<div class="space-y-3">
  <% other_services.each do |compose_service| %>
    <%= render ServiceRow::Component.new(
      compose_service:,
      container: containers_by_service[compose_service.name],
      host:,
      pending: false
    ) %>
  <% end %>
</div>

<% if helios_service %>
  <div class="mt-8">
    <%= render ServiceRow::Component.new(
      compose_service: helios_service,
      container: containers_by_service[helios_service.name],
      host:,
      pending: false
    ) %>
  </div>
<% end %>
