<% @configuration.effective_sensor_mappings.each do |name, _mapping| %>
  <% sensor_row = SensorRow::Component.new(
       sensor_name: name,
       configuration: @configuration,
       reading: @readings[name],
     ) %>

  <%= turbo_stream.replace "sensor-value-#{name.parameterize}", method: :morph do %>
    <%= render SensorRow::ValueCell::Component.new(sensor_row:) %>
  <% end %>
<% end %>
