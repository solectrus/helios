<% @sensor_mappings.each do |name, _mapping| %>
  <% reading = @readings[name] %>

  <%= turbo_stream.replace "sensor-value-#{name.parameterize}" do %>
    <%= sensor_value_cell(name, reading) %>
  <% end %>

  <%= turbo_stream.replace "sensor-time-#{name.parameterize}" do %>
    <%= sensor_time_cell(name, reading) %>
  <% end %>
<% end %>
