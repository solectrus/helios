<% content_for :title, t('.title') %>

<div class="min-h-screen p-8">
  <div class="mx-auto max-w-4xl">
    <%= render Header::Component.new %>

    <%= turbo_frame_tag "tab-content" do %>
      <div class="mb-8"><%= render MainNav::Component.new(active_tab: :sensors) %></div>

      <div data-controller="sensors-polling" data-sensors-polling-url-value="<%= sensors_readings_path %>">
        <%= render SensorTable::Component.new(
              sensor_mappings: @sensor_mappings,
              device_names: @device_names,
              readings: @readings,
              influxdb_running: @influxdb_running,
              influxdb_error: @influxdb_error,
            ) %>
      </div>
    <% end %>
  </div>
</div>
