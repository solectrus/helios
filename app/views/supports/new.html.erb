<%= turbo_frame_tag "support-modal-content" do %>
  <div class="space-y-7 p-4 sm:p-2">
    <header>
      <h3 class="text-xl font-semibold tracking-tight"><%= t(".title") %></h3>
      <p class="text-base-content/70 mt-1 text-sm"><%= t(".subtitle") %></p>
    </header>

    <ol class="space-y-6">
      <li class="flex gap-4">
        <span
          class="
            bg-primary/15 text-primary flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-mono
            text-xs font-semibold
          "
        >
          1
        </span>

        <div class="flex-1 space-y-3">
          <div>
            <p class="font-semibold"><%= t(".step_download.title") %></p>
            <p class="text-base-content/70 text-sm"><%= t(".step_download.description") %></p>
          </div>

          <%= form_with url: support_path, method: :post, data: { turbo: false, turbo_frame: "_top" } do %>
            <button
              type="submit"
              class="btn btn-primary btn-sm"
              data-controller="loading"
              data-action="click->loading#click"
              data-loading-text-value="<%= t(".downloading") %>"
              data-loading-success-text-value="<%= t(".downloaded") %>"
            >
              <i class="fa-solid fa-download"></i>
              <%= t(".download") %>
            </button>
          <% end %>
        </div>
      </li>

      <li class="flex gap-4">
        <span
          class="
            bg-primary/15 text-primary flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-mono
            text-xs font-semibold
          "
        >
          2
        </span>

        <div class="flex-1 space-y-4">
          <div>
            <p class="font-semibold"><%= t(".step_post.title") %></p>
            <p class="text-base-content/70 text-sm"><%= t(".step_post.description") %></p>
          </div>

          <div class="space-y-3">
            <div class="space-y-1">
              <p class="text-sm font-medium"><%= t(".step_post.discussion.label") %></p>

              <a
                href="https://github.com/orgs/solectrus/discussions/new?category=q-a"
                target="_blank"
                rel="noopener"
                class="
                  link link-primary inline-flex max-w-full items-center gap-1.5 font-mono text-xs wrap-anywhere
                  sm:text-sm
                "
              >
                <span>github.com/orgs/solectrus/discussions/new</span>
                <i class="fa-solid fa-arrow-up-right-from-square shrink-0 text-[0.65rem]"></i>
              </a>
            </div>

            <div class="space-y-1">
              <p class="text-sm font-medium"><%= t(".step_post.issue.label") %></p>

              <a
                href="https://github.com/solectrus/helios/issues/new/choose"
                target="_blank"
                rel="noopener"
                class="
                  link link-primary inline-flex max-w-full items-center gap-1.5 font-mono text-xs wrap-anywhere
                  sm:text-sm
                "
              >
                <span>github.com/solectrus/helios/issues</span>
                <i class="fa-solid fa-arrow-up-right-from-square shrink-0 text-[0.65rem]"></i>
              </a>
            </div>
          </div>

          <p class="text-base-content/60 text-xs"><%= t(".step_post.account_hint") %></p>
        </div>
      </li>
    </ol>
  </div>
<% end %>
