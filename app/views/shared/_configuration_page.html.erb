<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<% content_for :active_tab, "configuration" %>

<%= turbo_frame_tag "tab-content" do %>
  <div class="md:flex md:items-start">
    <aside
      class="
        bg-base-200/40 border-base-content/10 hidden md:sticky md:top-16 md:block md:w-72 md:shrink-0 md:self-start
        md:border-r
      "
    >
      <div class="p-8">
        <%= render ConfigNav::Component.new(active_tab:) %>
      </div>
    </aside>

    <div class="min-w-0 flex-1 p-4 md:p-8">
      <div class="mx-auto max-w-4xl">
        <%= yield %>

        <%= render DialogModal::Component.new(id: "setting-modal", turbo_frame: "setting-modal-content") %>
      </div>
    </div>
  </div>
<% end %>
