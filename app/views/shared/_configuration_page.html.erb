<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<% content_for :active_tab, "configuration" %>

<%= turbo_frame_tag "tab-content" do %>
  <div class="mx-auto max-w-6xl lg:flex lg:items-start">
    <aside
      class="
        border-base-content/10 hidden lg:sticky lg:top-16 lg:block lg:h-[calc(100vh-7rem)] lg:w-64 lg:shrink-0
        lg:border-r
      "
    >
      <div class="flex h-full flex-col px-4 py-6">
        <%= render ConfigNav::Component.new(active_tab:) %>
      </div>
    </aside>

    <div class="min-w-0 flex-1 py-4 md:p-8">
      <%= yield %>

      <%= render DialogModal::Component.new(id: "setting-modal", turbo_frame: "setting-modal-content") %>
    </div>
  </div>

  <%= render ResetDialogs::Component.new %>
<% end %>
