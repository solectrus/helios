<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<%= turbo_frame_tag "tab-content" do %>
  <%= render Header::Component.new(active_tab: :configuration) %>

  <div class="flex items-start">
    <%= render ConfigNav::Component.new(active_tab:) %>

    <div class="min-w-0 flex-1 p-8">
      <div class="mx-auto max-w-4xl">
        <%= yield %>

        <%= render DialogModal::Component.new(id: "setting-modal", turbo_frame: "setting-modal-content") %>
      </div>
    </div>
  </div>

  <dialog id="file-modal" class="modal" data-controller="log-modal">
    <div class="modal-box relative max-h-[95vh] w-[95vw] max-w-[95vw] overflow-y-auto p-6">
      <%= turbo_frame_tag "file-modal-content", data: { log_modal_target: "frame" } do %>
        <div class="flex justify-center py-8"><span class="loading loading-spinner loading-lg"></span></div>
      <% end %>

      <form method="dialog" class="absolute top-2 right-2">
        <button class="btn btn-circle btn-ghost btn-sm"><i class="fa-solid fa-xmark"></i></button>
      </form>
    </div>

    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
<% end %>
