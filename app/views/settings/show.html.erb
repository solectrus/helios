<% content_for :title, t('.title') %>

<%= render "shared/configuration_page", active_tab: :settings do %>
  <%# Nothing on this page is full-bleed, so the whole list carries the mobile inset %>
  <div class="flex flex-col gap-8 px-6 md:px-0">
    <%#
      Two tiers, told by position alone: what HELIOS cannot fill in by itself
      stands above the rule, the fine-tuning below it. Without that split a new
      installation sees a dozen equal-looking chips and no hint which of them
      it has to visit. The chips above carry their own state, so the tier needs
      no heading to explain itself.
    %>

    <section>
      <div class="flex flex-wrap gap-3">
        <% @configuration.required_settings.each do |setting| %>
          <%= render SettingLink::Component.new(setting:, configuration: @configuration, required: true) %>
        <% end %>
      </div>
    </section>

    <section class="border-base-content/10 flex flex-col gap-7 border-t pt-7">
      <% @configuration.optional_groups.each do |group, settings| %>
        <div>
          <h2 class="text-base-content/55 mb-3 text-xs font-medium tracking-wider uppercase">
            <%= t("settings.show.groups.#{group}") %>
          </h2>

          <div class="flex flex-wrap gap-3">
            <% settings.each do |setting| %>
              <%= render SettingLink::Component.new(setting:, configuration: @configuration) %>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  </div>
<% end %>
