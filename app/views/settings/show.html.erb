<% content_for :title, t('.title') %>

<%= render "shared/configuration_page", active_tab: :settings do %>
  <%# Nothing on this page is full-bleed, so the whole list carries the mobile inset %>
  <div class="flex flex-col gap-7 px-6 md:px-0">
    <%#
      One tier: nothing on this screen has to be visited. The basics are asked
      for before any screen opens, and the external database comes with the
      mode that needs one, so no chip stands ahead of the rest any more (see
      Configuration::SETTINGS_BY_GROUP).
    %>

    <% @configuration.grouped_settings.each do |group, settings| %>
      <div>
        <h2 class="text-base-content/55 mb-3 text-xs font-medium tracking-wider uppercase">
          <%= t("settings.show.groups.#{group}") %>
        </h2>

        <div class="flex flex-wrap gap-3">
          <% settings.each do |setting| %>
            <%= render SettingLink::Component.new(setting:, configuration: @configuration) %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
