<%= turbo_frame_tag "chapter-modal-content" do %>
  <%= form_with url: configuration_chapter_path(chapter_name),
                method: :patch,
                id: "chapter-form",
                data: { turbo_frame: "_top" } do |f| %>
    <div
      data-controller="survey"
      data-survey-url-value="<%= configuration_chapter_path(chapter_name, format: :json) %>"
      data-survey-form-id-value="chapter-form"
      data-survey-field-name-value="chapter"
    >
      <script type="application/json" data-survey-target="initialData"><%= @chapter_data.to_json.html_safe %></script>

      <div data-survey-target="container" class="bg-base-100 rounded-lg"></div>
    </div>
  <% end %>
<% end %>
