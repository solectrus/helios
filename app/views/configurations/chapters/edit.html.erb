<% content_for :title, t("configurations.chapters.#{chapter_name}.title") %>

<div class="container mx-auto max-w-4xl p-4">
  <div class="mb-6">
    <%= link_to configuration_path, class: "btn btn-ghost btn-sm gap-2" do %>
      <i class="fa-solid fa-arrow-left"></i>
      <%= t('common.back') %>
    <% end %>
  </div>

  <%= form_with url: configuration_chapter_path(chapter_name),
                method: :patch,
                id: "chapter-form",
                data: { turbo: false } do |f| %>
    <div
      data-controller="survey"
      data-survey-url-value="<%= configuration_chapter_path(chapter_name, format: :json) %>"
      data-survey-form-id-value="chapter-form"
      data-survey-field-name-value="chapter"
    >
      <script type="application/json" data-survey-target="initialData"><%= @chapter_data.to_json.html_safe %></script>

      <div data-survey-target="container" class="bg-base-100 rounded-lg p-4 shadow-lg"></div>
    </div>
  <% end %>
</div>
