<% @configuration.effective_sensor_mappings.each do |name, _mapping| %>
  <% component = SensorRow::Component.new(
       sensor_name: name,
       configuration: @configuration,
       reading: @readings[name],
     ) %>

  <%= turbo_stream.replace "sensor-value-#{name.parameterize}" do %>
    <td
      id="sensor-value-<%= name.parameterize %>"
      class="text-right font-mono text-sm <%= component.freshness_class %>"
    >
      <% if component.enabled? %>
        <%= component.formatted_value %>
        <% if @readings[name]&.dig(:value) && component.unit.present? %>
          <span class="text-base-content/50"><%= component.unit %></span>
        <% end %>
      <% end %>
    </td>
  <% end %>
<% end %>
