<% content_for :title, t('.title') %>

<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<div class="min-h-screen">
  <%= turbo_frame_tag "tab-content" do %>
    <%= render Header::Component.new(active_tab: :configuration) %>

    <div class="mx-auto max-w-4xl p-8">
      <%= render SensorTable::Component.new(
            configuration: @configuration,
            readings: @readings,
          ) %>

      <%# Source settings section (shown when sources are in use) %>
      <% active_sources = Configuration::ALL_SOURCES.select { |s| @configuration.sensors_with_source(s).any? } %>

      <% if active_sources.any? %>
        <h3 class="text-base-content/50 mb-3 text-sm font-semibold tracking-wide uppercase">
          <%= t('.source_settings') %>
        </h3>
        <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <% active_sources.each do |source| %>
            <% if source == 'external' %>
              <%= render ExternalInputInfo::Component.new(configuration: @configuration) %>
            <% else %>
              <%= render SettingSection::Component.new(setting: source, configuration: @configuration) %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%# Settings section %>
      <h3 class="text-base-content/50 mb-3 text-sm font-semibold tracking-wide uppercase"><%= t('.settings') %></h3>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <% Configuration::SETTINGS.each do |setting| %>
          <%= render SettingSection::Component.new(setting:, configuration: @configuration) %>
        <% end %>
      </div>

      <%= render DialogModal::Component.new(id: "setting-modal", turbo_frame: "setting-modal-content") %>
    </div>
  <% end %>
</div>
