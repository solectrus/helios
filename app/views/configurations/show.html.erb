<% content_for :title, t('.title') %>

<div class="min-h-screen p-8">
  <div class="mx-auto max-w-4xl">
    <%= render Header::Component.new %>

    <%= turbo_frame_tag "tab-content" do %>
      <div class="mb-8"><%= render MainNav::Component.new(active_tab: :configuration) %></div>

      <div class="space-y-4">
        <% Chapter::KINDS.each do |kind| %>
          <%= render KindSection::Component.new(
                kind:,
                chapters: @configuration.chapters_of_kind(kind)
              ) %>
        <% end %>
      </div>

      <%= render DialogModal::Component.new(id: "chapter-modal", turbo_frame: "chapter-modal-content") %>
    <% end %>
  </div>
</div>
