<% content_for :title, t('.title') %>

<div class="min-h-screen p-8">
  <div class="mx-auto max-w-4xl">
    <%= render Header::Component.new %>

    <%= turbo_frame_tag "tab-content" do %>
      <div class="mb-8"><%= render MainNav::Component.new(active_tab: :configuration) %></div>

      <%# Devices section %>
      <h3 class="text-base-content/50 mb-3 text-sm font-semibold uppercase tracking-wide"><%= t('.devices') %></h3>
      <div class="mb-8 space-y-4">
        <% Configuration::DEVICES.each do |setting| %>
          <%= render SettingSection::Component.new(setting:, configuration: @configuration) %>
        <% end %>
      </div>

      <%# Settings section %>
      <h3 class="text-base-content/50 mb-3 text-sm font-semibold uppercase tracking-wide"><%= t('.settings') %></h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <% Configuration::SETTINGS.each do |setting| %>
          <%= render SettingSection::Component.new(setting:, configuration: @configuration) %>
        <% end %>
      </div>

      <%= render DialogModal::Component.new(id: "setting-modal", turbo_frame: "setting-modal-content") %>
    <% end %>
  </div>
</div>
