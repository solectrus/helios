<% content_for :title, t('.title') %>

<div class="min-h-screen p-8">
  <div class="mx-auto max-w-4xl">
    <%= render Header::Component.new %>

    <div class="mb-8"><%= render MainNav::Component.new(active_tab: :configuration) %></div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <%= render ChapterCard::Component.with_collection(@chapters, configuration: @configuration) %>
    </div>
  </div>
</div>

<%= render DialogModal::Component.new(id: "chapter-modal", turbo_frame: "chapter-modal-content") %>
