<!DOCTYPE html>

<html lang="<%= I18n.locale %>" data-theme="<%= preferences.theme %>">
  <head>
    <title><%= content_for(:title) || "HELIOS" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="HELIOS">
    <meta name="git-commit-version" content="<%= Rails.configuration.x.git.commit_version %>">
    <meta name="git-commit-time" content="<%= Rails.configuration.x.git.commit_time %>">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= vite_typescript_tag 'application' %>
    <%= vite_stylesheet_tag 'application.css', media: 'all' %>
  </head>

  <body class="bg-base-200 min-h-screen pb-10">
    <% if flash[:alert] %>
      <div class="toast toast-top toast-center z-50">
        <div class="alert alert-error"><span><%= flash[:alert] %></span></div>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="toast toast-top toast-center z-50">
        <div class="alert alert-success"><span><%= flash[:notice] %></span></div>
      </div>
    <% end %>

    <%= yield %>

    <dialog id="turbo-confirm-dialog" class="modal modal-middle">
      <form method="dialog" class="modal-box max-w-sm text-center">
        <p class="text-base" data-confirm-message></p>

        <div class="modal-action justify-center">
          <button class="btn" value="cancel" data-confirm-cancel><%= t('common.cancel') %></button>
          <button class="btn btn-warning" value="confirm" data-confirm-accept><%= t('common.confirm') %></button>
        </div>
      </form>

      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <% if authenticated? && config_yaml_exists? %>
      <%= turbo_stream_from "status_bar" %>
      <%= render StatusBar::Component.new %>
    <% end %>
  </body>
</html>
