<!DOCTYPE html>

<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">

    <title><%= content_for?(:title) ? "#{content_for(:title)} – HELIOS" : "HELIOS" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="HELIOS">
    <meta name="robots" content="noindex, nofollow, noarchive">

    <%# Don't auto-link numeric strings (IPs, ports, versions) as phone numbers on iOS %>
    <meta name="format-detection" content="telephone=no">

    <%# Run standalone (no browser URL bar) when added to the iOS/Android home screen %>
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="HELIOS">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="theme-color" content="#201c55">

    <meta name="git-commit-version" content="<%= Rails.configuration.x.git.commit_version %>">
    <meta name="git-commit-time" content="<%= Rails.configuration.x.git.commit_time %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">

    <%= vite_typescript_tag 'application', data: { turbo_track: 'reload' } %>
    <%= vite_stylesheet_tag 'application.css', data: { turbo_track: 'reload' } %>
  </head>

  <body class="bg-base-200 min-h-dvh pb-16 lg:pb-14">
    <%= render Flash::Component.new(flash:) %>

    <% if show_app_chrome? %>
      <%= render Header::Component.new(active_tab: content_for(:active_tab).presence&.to_sym) %>
      <%# Spacer for fixed navbar (always) and mobile fixed status bar %>
      <div class="h-16" aria-hidden="true"></div>
      <div class="h-12 lg:hidden" aria-hidden="true"></div>
    <% end %>

    <%= yield %>

    <dialog id="turbo-confirm-dialog" class="modal modal-middle">
      <form method="dialog" class="modal-box max-w-md text-center">
        <div class="mb-3 hidden" data-confirm-icon>
          <i class="fa-solid fa-triangle-exclamation text-error text-5xl"></i>
        </div>

        <p class="mb-2 hidden text-lg font-bold" data-confirm-title></p>

        <p class="text-base" data-confirm-message></p>

        <div class="modal-action flex-wrap justify-center gap-2">
          <button class="btn" value="cancel" data-confirm-cancel><%= t('common.cancel') %></button>

          <button class="btn btn-warning" value="confirm" data-confirm-accept>
            <%= t('common.confirm') %>
          </button>
        </div>
      </form>

      <form method="dialog" class="modal-backdrop">
        <button value="cancel">close</button>
      </form>
    </dialog>

    <% if show_app_chrome? %>
      <%= render MobileDock::Component.new(active_tab: content_for(:active_tab).presence&.to_sym) %>
      <div data-controller="visibility">
        <%= turbo_stream_from "status_bar" %>
        <%= render StatusBar::Component.new %>
      </div>
      <%= render "shared/frame_modal",
                 id: "support-modal",
                 turbo_frame: "support-modal-content",
                 box_classes: "overflow-y-auto sm:max-w-2xl!" %>
      <%= render "shared/frame_modal",
                 id: "file-modal",
                 turbo_frame: "file-modal-content",
                 box_classes: "overflow-hidden sm:w-[95vw]! sm:max-w-[95vw]! sm:overflow-y-auto" %>
    <% end %>

    <%# Cloned by Stimulus controllers to show a spinner while a frame loads %>
    <template id="loading-spinner"><%= render LoadingSpinner::Component.new %></template>
  </body>
</html>
