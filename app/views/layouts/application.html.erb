<!DOCTYPE html>

<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">

    <title><%= content_for?(:title) ? "#{content_for(:title)} – HELIOS" : "HELIOS" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="HELIOS">
    <meta name="git-commit-version" content="<%= Rails.configuration.x.git.commit_version %>">
    <meta name="git-commit-time" content="<%= Rails.configuration.x.git.commit_time %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= vite_typescript_tag 'application' %>
    <%= vite_stylesheet_tag 'application.css' %>
  </head>

  <body class="bg-base-200 min-h-screen pb-10">
    <% { alert: "alert-error", notice: "alert-success" }.each do |key, alert_class| %>
      <% if flash[key] %>
        <div class="toast toast-top toast-center z-50">
          <div class="alert <%= alert_class %>"><span><%= flash[key] %></span></div>
        </div>
      <% end %>
    <% end %>

    <%= yield %>

    <dialog id="turbo-confirm-dialog" class="modal modal-middle">
      <form method="dialog" class="modal-box max-w-sm text-center">
        <p class="text-base" data-confirm-message></p>

        <div class="modal-action justify-center">
          <button class="btn" value="cancel" data-confirm-cancel><%= t('common.cancel') %></button>
          <button class="btn btn-warning" value="confirm" data-confirm-accept><%= t('common.confirm') %></button>
        </div>
      </form>

      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <% if authorized? && config_yaml_exists? %>
      <%= turbo_stream_from "status_bar" %>
      <%= render StatusBar::Component.new %>
    <% end %>
  </body>
</html>
