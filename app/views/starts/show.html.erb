<% content_for(:title) { t('.title') } %>

<div class="hero relative min-h-dvh overflow-hidden">
  <div class="absolute top-4 right-4 z-20 flex items-center gap-1">
    <%= render LanguageSelect::Component.new %>
  </div>

  <div class="hero-content z-10 w-full flex-col px-0 md:px-4 <%= @compose_error.present? || @unsupported_services.present? ? 'max-w-2xl' : 'max-w-lg' %>">
    <div class="mb-6 text-center">
      <img src="/logo.svg" class="mx-auto mb-3 h-12" alt="HELIOS">
      <p class="text-base-content/65 text-lg"><%= t('.subtitle') %></p>
    </div>

    <div class="bg-base-100 border-base-content/10 w-full border-y md:rounded-2xl md:border">
      <div class="flex flex-col gap-6 p-7 sm:p-8">
        <% if @compose_error.present? || @unsupported_services.present? %>
          <div class="border-base-content/10 bg-base-200 flex flex-col gap-4 rounded-xl border p-5" role="alert">
            <div class="flex items-start gap-3">
              <i aria-hidden="true" class="fa-solid fa-triangle-exclamation text-error mt-1 text-lg"></i>
              <p class="leading-snug font-semibold"><%= t('.unsupported_heading') %></p>
            </div>

            <div class="flex flex-col gap-2">
              <p class="text-base-content/60 text-sm">
                <%= @compose_error.present? ? t('.invalid_reason_html') : t('.unsupported_reason') %>
              </p>

              <% if @compose_error.present? %>
                <pre
                  class="
                    bg-base-100 border-base-content/10 overflow-x-auto rounded-lg border p-3 font-mono text-xs
                    whitespace-pre-wrap
                  "
                ><%= @compose_error %></pre>
              <% else %>
                <ul
                  class="
                    border-base-content/10 divide-base-content/10 bg-base-100 divide-y overflow-hidden rounded-lg
                    border
                  "
                >
                  <% @unsupported_services.each do |service| %>
                    <li class="flex flex-col gap-0.5 px-3.5 py-2.5">
                      <span class="font-mono text-sm font-medium"><%= service['service'] %></span>

                      <span class="text-base-content/50 font-mono text-xs">
                        <%= service['image'].presence || t('.unsupported_no_image') %>
                      </span>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>

            <p class="text-base-content/70 text-sm leading-relaxed">
              <%= @compose_error.present? ? t('.invalid_hint') : t('.unsupported_hint_html') %>
            </p>
          </div>
        <% else %>
          <h2 class="text-2xl leading-tight font-semibold tracking-tight"><%= t('.heading') %></h2>
          <ul class="text-base-content/85 space-y-4 text-sm leading-relaxed">
            <li class="flex gap-3">
              <i
                aria-hidden="true"
                class="fa-solid fa-arrow-up-from-bracket text-primary mt-1 w-5 shrink-0 text-center"
              ></i>

              <p><%= t('.step_import_html') %></p>
            </li>

            <li class="flex gap-3">
              <i aria-hidden="true" class="fa-solid fa-shield-halved text-primary mt-1 w-5 shrink-0 text-center"></i>
              <p><%= t('.step_backup_html') %></p>
            </li>

            <li class="flex gap-3">
              <i aria-hidden="true" class="fa-solid fa-sliders text-primary mt-1 w-5 shrink-0 text-center"></i>
              <p><%= t('.step_manage') %></p>
            </li>
          </ul>
          <div class="border-base-content/10 border-t"></div>
          <p class="text-base-content/55 text-xs leading-relaxed"><%= t('.hint_exclusive_html') %></p>
          <%= form_with url: start_path, method: :post do %>
            <button type="submit" class="btn btn-primary w-full"><%= t('.agree') %></button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
