<% content_for :title, t('.title') %>

<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<div>
  <%= turbo_frame_tag "tab-content" do %>
    <%= render Header::Component.new(active_tab: :advanced) %>

    <div class="mx-auto max-w-4xl p-8">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <% Configuration::SETTINGS.each do |setting| %>
          <%= render SettingSection::Component.new(setting:, configuration: @configuration) %>
        <% end %>
      </div>

      <%= render DialogModal::Component.new(id: "setting-modal", turbo_frame: "setting-modal-content") %>
    </div>
  <% end %>
</div>
