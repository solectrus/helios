<% content_for :title, t('.title') %>

<%= render "shared/configuration_page", active_tab: :advanced do %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <% Configuration::SETTINGS.each do |setting| %>
      <%= render SettingSection::Component.new(setting:, configuration: @configuration) %>
    <% end %>
  </div>
<% end %>
