<% content_for(:title) { t('.title') } %>

<div class="hero relative min-h-dvh overflow-hidden">
  <div class="absolute top-4 right-4 z-20 flex items-center gap-1">
    <%= render LanguageSelect::Component.new %>
  </div>

  <div class="hero-content z-10 w-full max-w-md flex-col px-0 md:px-4">
    <div class="mb-6 text-center">
      <img src="/logo.svg" class="mx-auto mb-3 h-9" alt="HELIOS">
      <p class="text-base-content/65 text-lg"><%= t('.subtitle') %></p>
    </div>

    <div class="bg-base-100 border-base-content/10 w-full border-y md:rounded-2xl md:border">
      <div class="flex flex-col gap-5 p-7 sm:p-8">
        <%= form_with url: session_path, method: :post, class: "flex flex-col gap-2" do %>
          <label class="text-base-content/85 text-sm font-medium" for="password"><%= t('.password_label') %></label>

          <input
            id="password"
            type="password"
            name="password"
            class="input input-bordered w-full"
            placeholder="<%= t('.password_placeholder') %>"
            required
            autofocus
            autocomplete="off"
          >

          <p class="text-base-content/55 mt-1 text-xs leading-relaxed">
            <%= t('.password_hint_html') %>
          </p>

          <button type="submit" class="btn btn-primary mt-5 w-full"><%= t('.login') %></button>
        <% end %>
      </div>
    </div>
  </div>
</div>
