<% content_for(:title) { t('.title') } %>

<div class="hero relative min-h-screen overflow-hidden">
  <div class="absolute top-4 right-4 z-20 flex items-center gap-1">
    <%= render LanguageSelect::Component.new %>
  </div>

  <div class="hero-content z-10 w-full max-w-md flex-col">
    <div class="mb-4 text-center">
      <img src="/logo.svg" class="mx-auto mb-3 h-12" alt="HELIOS">
      <p class="text-base-content/60 text-lg"><%= t('.subtitle') %></p>
    </div>

    <div class="card bg-base-100 w-full shadow-2xl">
      <div class="card-body gap-6">
        <%= form_with url: session_path, method: :post do %>
          <fieldset class="fieldset">
            <label class="label font-medium"><%= t('.password_label') %></label>

            <input
              type="password"
              name="password"
              class="input input-bordered w-full"
              placeholder="<%= t('.password_placeholder') %>"
              required
              autofocus
              autocomplete="off"
            >

            <button type="submit" class="btn btn-primary mt-6 w-full"><%= t('.login') %></button>
          </fieldset>
        <% end %>
      </div>
    </div>
  </div>
</div>
