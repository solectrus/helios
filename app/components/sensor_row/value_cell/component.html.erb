<td
  id="sensor-value-<%= sensor_name.parameterize %>"
  class="text-right font-mono text-sm <%= freshness_class %>"
  data-controller="value-flash"
  data-value-flash-timestamp-value="<%= timestamp_iso %>"
>
  <% if value? %>
    <%#
      A hint, not a tooltip: the age of the reading stands nowhere else on the
      screen, and a phone is where it is asked for most.
    %>

    <%= render Hint::Component.new(text: age_hint, wrapper_class: "dropdown-left", trigger_class: "cursor-default") do %>
      <% if boolean_value? %>
        <span class="badge badge-sm badge-outline"><%= boolean_label %></span>
      <% else %>
        <%= formatted_value %>
        <% if unit.present? %>
          <span class="text-base-content/50"><%= unit %></span>
        <% end %>
      <% end %>
    <% end %>
  <% elsif unit_label.present? %>
    <%# No live value yet: show the expected input unit as a hint. %>
    <span class="text-base-content/40"><%= unit_label %></span>
  <% end %>
</td>
