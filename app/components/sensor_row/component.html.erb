<tr class="sensor-row" data-sensor-enabled="<%= enabled? %>">
  <%# Sensor name %>
  <td class="pl-4 text-sm <%= 'opacity-60' unless enabled? %>">
    <div class="flex items-start gap-2">
      <i class="fa-solid fa-microchip text-base-content/70 mt-1 w-4 text-center text-xs leading-5"></i>

      <div>
        <div class="font-semibold">
          <%= display_label %>

          <% if house_power_exclusions? %>
            <span
              class="tooltip tooltip-right before:text-xs before:normal-case"
              data-tip="<%= house_power_exclusion_tooltip %>"
            >
              <i class="fa-solid fa-calculator text-info text-xs"></i>
            </span>
          <% end %>
        </div>

        <div class="text-base-content/50 font-mono text-xs uppercase"><%= sensor_name %></div>
      </div>
    </div>
  </td>

  <%# Source badge %>
  <td>
    <% if enabled? && source_badge_css %>
      <span class="badge badge-sm uppercase <%= source_badge_css %>"><%= source_badge_label %></span>
    <% end %>
  </td>

  <%# Live value %>
  <%= render SensorRow::ValueCell::Component.new(sensor_row: self) %>

  <%# Actions %>
  <td class="text-right">
    <% if enabled? %>
      <div class="flex items-center justify-end gap-1">
        <%= link_to edit_path,
                    class: "btn btn-ghost btn-sm btn-square",
                    data: { turbo_frame: "setting-modal-content" } do %>
          <i class="fa-solid fa-pen-to-square"></i>
        <% end %>

        <%= button_to destroy_path, method: :delete, class: "btn btn-ghost btn-sm btn-square hover:text-error", data: { turbo_confirm: t('configurations.settings.delete_confirm'), turbo_frame: "_top" } do %>
          <i class="fa-solid fa-trash-can"></i>
        <% end %>
      </div>
    <% else %>
      <%= link_to new_path,
                  class: "btn btn-soft btn-primary btn-sm btn-square",
                  data: { turbo_frame: "setting-modal-content" } do %>
        <i class="fa-solid fa-plus"></i>
      <% end %>
    <% end %>
  </td>
</tr>
