<tr class="<%= enabled? ? '' : 'opacity-40' %>" data-sensor-enabled="<%= enabled? %>">
  <%# Sensor name %>
  <td class="pl-4 font-mono text-sm font-semibold uppercase">
    <% if custom_sensor? %>
      <i class="fa-solid fa-microchip text-base-content/70 text-xs"></i>
      <%= sensor_name %>
      <% if enabled? && custom_name.present? %>
        <span class="text-base-content/50 text-xs font-normal normal-case"><%= custom_name %></span>
      <% end %>
    <% else %>
      <% tip = enabled? && custom_name.present? ? custom_name : description %>
      <% if tip.present? %>
        <span class="tooltip tooltip-left before:text-xs before:normal-case" data-tip="<%= tip %>">
          <i class="fa-solid fa-microchip text-base-content/70 text-xs"></i>
        </span>
      <% end %>
      <%= sensor_name %>
    <% end %>

    <% if house_power_exclusions? %>
      <span
        class="tooltip tooltip-right before:text-xs before:normal-case"
        data-tip="<%= house_power_exclusion_tooltip %>"
      >
        <i class="fa-solid fa-calculator text-info text-xs"></i>
      </span>
    <% end %>
  </td>

  <%# Source badge %>
  <td>
    <% if enabled? && source_badge_css %>
      <span class="badge badge-sm <%= source_badge_css %>"><%= source_badge_label %></span>
    <% end %>
  </td>

  <%# Live value %>
  <%= render SensorRow::ValueCell::Component.new(sensor_row: self) %>

  <%# Actions %>
  <td class="text-right">
    <% if enabled? %>
      <div class="flex items-center justify-end gap-1" data-controller="confirm-delete">
        <%= link_to edit_path,
                    class: "btn btn-ghost btn-sm btn-square",
                    data: { turbo_frame: "setting-modal-content" } do %>
          <i class="fa-solid fa-pen-to-square"></i>
        <% end %>

        <button class="btn btn-ghost btn-sm btn-square hover:text-error" data-action="confirm-delete#requestDelete">
          <i class="fa-solid fa-trash-can"></i>
        </button>

        <%= form_with url: destroy_path, method: :delete,
                     class: "hidden",
                     data: { confirm_delete_target: "form", turbo_frame: "_top" } do %>
          <%# Submitted programmatically via confirm-delete controller %>
        <% end %>

        <dialog data-confirm-delete-target="dialog" class="modal modal-middle">
          <div class="modal-box max-w-sm text-center">
            <p class="text-base"><%= t('configurations.settings.delete_confirm') %></p>

            <div class="modal-action justify-center">
              <button class="btn" data-action="confirm-delete#cancel"><%= t('common.cancel') %></button>

              <button class="btn btn-error" data-action="confirm-delete#confirm">
                <%= t('configurations.settings.delete_confirm_yes') %>
              </button>
            </div>
          </div>

          <form method="dialog" class="modal-backdrop">
            <button>close</button>
          </form>
        </dialog>
      </div>
    <% else %>
      <%= link_to new_path,
                  class: "btn btn-ghost btn-sm btn-square",
                  data: { turbo_frame: "setting-modal-content" } do %>
        <i class="fa-solid fa-plus text-base-content/30"></i>
      <% end %>
    <% end %>
  </td>
</tr>
