<div
  class="
    bg-base-100 border-base-content/10 hover:border-base-content/20 group relative flex h-full flex-col rounded-2xl
    border shadow-xs transition-colors duration-200
  "
>
  <div class="flex flex-1 items-start gap-4 p-6">
    <%# Icon tile %>
    <div
      class="
        bg-primary/10 text-primary group-hover:bg-primary/15 flex size-12 shrink-0 items-center justify-center
        rounded-xl transition-colors duration-200
      "
    >
      <i aria-hidden="true" class="fa-solid fa-house-signal text-xl"></i>
    </div>

    <%# Content %>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <h2 class="text-base-content text-lg leading-snug font-semibold tracking-tight">
          <button
            type="button"
            class="
              focus-visible:before:ring-primary/40 before:absolute before:inset-0 before:z-10 before:rounded-2xl
              focus:outline-none focus-visible:before:ring-2
            "
            data-controller="modal-opener"
            data-action="modal-opener#open"
            data-modal-opener-id-param="external_input_info_modal"
          >
            <%= t('.title') %>
          </button>
        </h2>

        <i
          aria-hidden="true"
          class="
            fa-solid fa-circle-info text-base-content/30 group-hover:text-primary mt-1.5 shrink-0 text-sm
            transition-colors duration-200
          "
        ></i>
      </div>

      <p class="text-base-content/65 mt-1.5 text-sm leading-relaxed"><%= t('.description') %></p>
    </div>
  </div>

  <%# Footer: status %>
  <div
    class="
      border-base-content/10 bg-base-200/40 text-base-content/70 flex items-center gap-2 rounded-b-2xl border-t px-6
      py-3 text-sm font-medium
    "
  >
    <span aria-hidden="true" class="bg-success size-2.5 rounded-full"></span>
    <%= t('.sensor_count', count: sensor_count) %>
  </div>
</div>

<dialog id="external_input_info_modal" class="modal">
  <div class="modal-box max-w-lg">
    <h3 class="text-lg font-bold"><%= t('.modal.title') %></h3>

    <p class="text-base-content/70 mt-2"><%= t('.modal.description') %></p>

    <div class="divider"></div>

    <div class="space-y-4">
      <div>
        <h4 class="font-semibold"><%= t('.modal.iobroker.title') %></h4>
        <p class="text-base-content/70 mt-1 text-sm"><%= t('.modal.iobroker.description') %></p>

        <a
          href="https://github.com/patricknitsch/ioBroker.solectrus-influxdb"
          target="_blank"
          rel="noopener noreferrer"
          class="link link-primary mt-1 inline-flex items-center gap-1 text-sm"
        >
          <i class="fa-brands fa-github"></i>
          <%= t('.modal.iobroker.link') %>
        </a>
      </div>

      <div>
        <h4 class="font-semibold"><%= t('.modal.home_assistant.title') %></h4>
        <p class="text-base-content/70 mt-1 text-sm"><%= t('.modal.home_assistant.description') %></p>

        <a
          href="https://github.com/solectrus/ha-integration"
          target="_blank"
          rel="noopener noreferrer"
          class="link link-primary mt-1 inline-flex items-center gap-1 text-sm"
        >
          <i class="fa-brands fa-github"></i>
          <%= t('.modal.home_assistant.link') %>
        </a>
      </div>
    </div>

    <div class="modal-action">
      <form method="dialog">
        <button class="btn"><%= t('.modal.close') %></button>
      </form>
    </div>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
