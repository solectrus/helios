<article
  <%# Nothing on a dimmed card reacts, the info dialog included. %>
  <% if dimmed? %>
    inert
  <% end %>
  class="
      bg-base-100 border-base-content/10 hover:border-primary/40 group relative flex h-full flex-col border-y transition duration-300 md:rounded-2xl md:border
      <%= "opacity-55" if dimmed? %>
    "
>
  <div class="flex flex-1 flex-col p-7">
    <div class="flex items-start justify-between">
      <i aria-hidden="true" class="fa-solid fa-house-signal text-primary text-2xl"></i>

      <i
        aria-hidden="true"
        class="
          fa-solid fa-circle-info text-base-content/25 group-hover:text-primary text-sm transition-colors
          duration-200
        "
      ></i>
    </div>

    <h2 class="text-base-content mt-6 text-xl leading-tight font-semibold tracking-tight text-balance">
      <button
        type="button"
        class="
          focus-visible:ring-primary/40 before:absolute before:inset-0 focus:outline-none focus-visible:ring-2
          md:before:rounded-2xl
        "
        data-controller="modal-opener"
        data-action="modal-opener#open"
        data-modal-opener-id-param="external_input_info_modal"
      >
        <%= t('.title') %>
      </button>
    </h2>

    <p class="text-base-content/65 mt-2 max-w-[42ch] text-base leading-relaxed"><%= t('.description') %></p>
  </div>

  <%#
    The footer every source card carries, down to the empty cell on the left:
    this source is set to nothing, the sensors alone say it is in use. The
    card dims as a whole, so the footer is not dimmed a second time.
  %>

  <%= render SourceCardFooter::Component.new(sensor_count:) do %>
    <div class="flex-1"></div>
  <% end %>
</article>

<dialog id="external_input_info_modal" class="modal">
  <div class="modal-box max-w-lg">
    <h3 class="text-lg font-bold"><%= t('.modal.title') %></h3>

    <p class="text-base-content/70 mt-2"><%= t('.modal.description') %></p>

    <div class="divider"></div>

    <div class="space-y-4">
      <div>
        <h4 class="font-semibold"><%= t('.modal.iobroker.title') %></h4>
        <p class="text-base-content/70 mt-1 text-sm"><%= t('.modal.iobroker.description') %></p>

        <a
          href="https://github.com/patricknitsch/ioBroker.solectrus-influxdb"
          target="_blank"
          rel="noopener noreferrer"
          class="link link-primary mt-1 inline-flex items-center gap-1 text-sm"
        >
          <i class="fa-brands fa-github"></i>
          <%= t('.modal.iobroker.link') %>
        </a>
      </div>

      <div>
        <h4 class="font-semibold"><%= t('.modal.home_assistant.title') %></h4>
        <p class="text-base-content/70 mt-1 text-sm"><%= t('.modal.home_assistant.description') %></p>

        <a
          href="https://github.com/solectrus/ha-integration"
          target="_blank"
          rel="noopener noreferrer"
          class="link link-primary mt-1 inline-flex items-center gap-1 text-sm"
        >
          <i class="fa-brands fa-github"></i>
          <%= t('.modal.home_assistant.link') %>
        </a>
      </div>
    </div>

    <div class="modal-action">
      <form method="dialog">
        <button class="btn"><%= t('.modal.close') %></button>
      </form>
    </div>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
