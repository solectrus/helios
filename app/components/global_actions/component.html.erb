<div
  class="flex items-center justify-center gap-4"
  data-controller="global-actions--component"
  data-global-actions--component-service-row--component-outlet="[data-controller='service-row--component']"
>
      <button
        type="button"
        class="btn btn-success gap-2"
        data-global-actions--component-target="startButton"
        data-action="click->global-actions--component#startAll"
        <%= 'disabled' if start_disabled? %>
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="h-5 w-5"
        >
          <path
            d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.841Z"
          />
        </svg>
        Start
      </button>

      <button
        type="button"
        class="btn btn-error gap-2"
        data-global-actions--component-target="stopButton"
        data-action="click->global-actions--component#stopAll"
        <%= 'disabled' if stop_disabled? %>
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="h-5 w-5"
        >
          <path
            d="M5.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75V3.75a.75.75 0 0 0-.75-.75h-8.5Z"
          />
        </svg>
        Stop
      </button>

      <button
        type="button"
        class="btn btn-warning gap-2"
        data-global-actions--component-target="restartButton"
        data-action="click->global-actions--component#restartAll"
        <%= 'disabled' if restart_disabled? %>
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="h-5 w-5"
        >
          <path
            fill-rule="evenodd"
            d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0v-2.43l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Zm1.23-3.723a.75.75 0 0 0 .219-.53V2.929a.75.75 0 0 0-1.5 0v2.43l-.31-.31A7 7 0 0 0 3.239 8.188a.75.75 0 1 0 1.448.389 5.5 5.5 0 0 1 9.2-2.466l.312.311h-2.433a.75.75 0 0 0 0 1.5h4.243a.75.75 0 0 0 .53-.219Z"
            clip-rule="evenodd"
          />
        </svg>
        Restart
      </button>
</div>
