<%= helpers.turbo_frame_tag "batch-actions", class: "flex items-center justify-center gap-4",
    data: {
      controller: "global-actions--component",
      global_actions__component_service_row__component_outlet: "[data-controller='service-row--component']"
    } do %>
  <%= button_to batch_path, method: :post, class: "btn btn-lg btn-info gap-2",
      data: { global_actions__component_target: "startButton" }, disabled: true do %>
    <i class="fa-solid fa-play"></i>
    Start
  <% end %>

  <%= button_to batch_path, method: :delete, class: "btn btn-lg btn-info gap-2",
      data: { global_actions__component_target: "stopButton" }, disabled: true do %>
    <i class="fa-solid fa-stop"></i>
    Stop
  <% end %>
<% end %>
