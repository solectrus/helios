<article
  class="
    bg-base-100 border-base-content/10 hover:border-primary/40 group relative flex h-full flex-col rounded-2xl
    border transition-colors duration-300
  "
>
  <div class="flex flex-1 flex-col p-7">
    <div class="flex items-start justify-between">
      <i aria-hidden="true" class="fa-solid text-primary text-2xl <%= icon %>"></i>

      <i
        aria-hidden="true"
        class="
          fa-solid fa-pen-to-square text-base-content/25 group-hover:text-primary text-sm transition-colors
          duration-200
        "
      ></i>
    </div>

    <h2 class="text-base-content mt-6 text-xl leading-tight font-semibold tracking-tight text-balance">
      <%= link_to title, link_path,
                  data: { turbo_frame: "setting-modal-content" },
                  class: "before:absolute before:inset-0 before:rounded-2xl focus:outline-none focus-visible:before:ring-2 focus-visible:before:ring-primary/40" %>
    </h2>

    <% if description.present? %>
      <p class="text-base-content/65 mt-2 max-w-[42ch] text-base leading-relaxed"><%= description %></p>
    <% end %>
  </div>

  <% if (link = drill_down) %>
    <div
      class="
        border-base-content/10 bg-base-content/4 divide-base-content/10 relative z-20 flex items-stretch divide-x
        border-t
      "
    >
      <% if incomplete? %>
        <%= link_to link_path,
                    data: { turbo_frame: "setting-modal-content" },
                    class: "text-warning hover:bg-warning/10 focus-visible:ring-warning/40 flex flex-1 items-center gap-2.5 px-7 py-3.5 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset" do %>
          <span aria-hidden="true" class="bg-warning size-1.5 rounded-full"></span>
          <%= status_text %>
        <% end %>
      <% else %>
        <div class="flex flex-1 items-center gap-2.5 px-7 py-3.5 text-sm font-medium <%= status_text_class %>">
          <span aria-hidden="true" class="size-1.5 rounded-full <%= status_dot_class %>"></span>
          <%= status_text %>
        </div>
      <% end %>

      <%= link_to link[:path],
                  data: { turbo_frame: "_top" },
                  class: "group/foot text-base-content/70 hover:text-primary hover:bg-base-content/6 focus-visible:ring-primary/40 flex items-center gap-2 px-7 py-3.5 text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset" do %>
        <span class="font-mono tabular-nums"><%= link[:count_text] %></span>

        <i
          aria-hidden="true"
          class="fa-solid fa-chevron-right text-[10px] transition-transform duration-200 group-hover/foot:translate-x-0.5"
        ></i>
      <% end %>
    </div>
  <% else %>
    <div class="border-base-content/10 flex items-center gap-2.5 border-t px-7 py-4 text-sm font-medium <%= status_text_class %>">
      <span aria-hidden="true" class="size-1.5 rounded-full <%= status_dot_class %>"></span>
      <%= status_text %>
    </div>
  <% end %>
</article>
