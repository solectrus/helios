<div class="card bg-base-100 shadow-md">
  <div class="card-body flex-row items-start gap-4 p-5">
    <%# Icon spanning full height %>
    <div class="text-primary flex items-center self-stretch px-2 text-5xl"><i class="fa-solid <%= icon %>"></i></div>

    <%# Content area %>
    <div class="min-w-0 flex-1">
      <%# Header: Title %>
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold"><%= title %></h2>
      </div>

      <%# Singleton status %>
      <div class="flex items-center justify-between py-2">
        <% if incomplete? %>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation text-warning text-xs"></i>
            <span class="text-warning text-sm"><%= t('configurations.show.incomplete') %></span>
          </div>
        <% elsif singleton_configured? %>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-check text-success text-xs"></i>
            <span class="text-base-content/70 text-sm"><%= t('configurations.show.configured') %></span>
          </div>
        <% else %>
          <span class="text-base-content/50 text-sm"><%= t('configurations.settings.not_configured') %></span>
        <% end %>

        <% if singleton_configured? %>
          <%= link_to helpers.edit_configuration_setting_path(setting:, name: setting),
                      class: "btn btn-ghost btn-lg btn-square",
                      data: { turbo_frame: "setting-modal-content" } do %>
            <i class="fa-solid fa-pen-to-square text-xl"></i>
          <% end %>
        <% else %>
          <%= link_to helpers.new_configuration_setting_path(setting:),
                      class: "btn btn-ghost btn-lg btn-square",
                      data: { turbo_frame: "setting-modal-content" } do %>
            <i class="fa-solid fa-pen-to-square text-xl"></i>
          <% end %>
        <% end %>
      </div>

      <% if show_mqtt_topics_link? %>
        <%= link_to helpers.datasources_mqtt_topics_path,
                    data: { turbo_frame: "_top" },
                    class: "group border-base-content/10 text-base-content/70 hover:text-primary focus-visible:text-primary mt-2 flex items-center justify-between gap-2 border-t py-3 text-sm" do %>
          <span><%= t('datasources.mqtt_topics.inline.label') %></span>

          <span class="flex items-center gap-2">
            <span class="text-base-content/50 group-hover:text-primary/80 group-focus-visible:text-primary/80 tabular-nums">
              <%= t('datasources.mqtt_topics.inline.count', count: mqtt_topics_count) %>
            </span>

            <i class="fa-solid fa-chevron-right text-xs transition-transform duration-150 group-hover:translate-x-0.5"></i>
          </span>
        <% end %>
      <% end %>

      <% if show_shelly_devices_link? %>
        <%= link_to helpers.datasources_shelly_devices_path,
                    data: { turbo_frame: "_top" },
                    class: "group border-base-content/10 text-base-content/70 hover:text-primary focus-visible:text-primary mt-2 flex items-center justify-between gap-2 border-t py-3 text-sm" do %>
          <span><%= t('datasources.shelly_devices.inline.label') %></span>

          <span class="flex items-center gap-2">
            <span class="text-base-content/50 group-hover:text-primary/80 group-focus-visible:text-primary/80 tabular-nums">
              <%= t('datasources.shelly_devices.inline.count', count: shelly_devices_count) %>
            </span>

            <i class="fa-solid fa-chevron-right text-xs transition-transform duration-150 group-hover:translate-x-0.5"></i>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
