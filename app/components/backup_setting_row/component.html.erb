<%= link_to @path,
        data: { turbo_frame: "setting-modal-content" },
        class: "group hover:bg-base-content/5 focus-visible:bg-base-content/5 flex items-center gap-4 px-5 py-3 outline-none transition-colors" do %>
  <span class="flex size-10 shrink-0 items-center justify-center rounded-xl <%= @icon_class %>">
    <i class="fa-solid <%= @icon %>" aria-hidden="true"></i>
  </span>

  <span class="min-w-0 flex-1 text-left">
    <span class="text-base-content/50 block text-xs font-medium tracking-wider uppercase"><%= @label %></span>

    <span class="block truncate text-sm font-semibold"><%= @value %></span>
  </span>

  <i
    class="fa-solid fa-chevron-right text-base-content/30 text-xs transition-transform group-hover:translate-x-0.5"
    aria-hidden="true"
  ></i>
<% end %>
