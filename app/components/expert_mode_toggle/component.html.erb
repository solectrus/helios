<label
  class="btn btn-ghost btn-xs swap"
  data-controller="preference-toggle"
  data-preference-toggle-key-value="expert_mode"
>
  <input
    type="checkbox"
    data-preference-toggle-target="checkbox"
    data-action="change->preference-toggle#toggle"
    <% if preferences.expert_mode? %>
      checked
    <% end %>
  >

  <span class="swap-on"><%= t(".expert") %> <span class="badge badge-xs badge-info"><%= t(".on") %></span></span>
  <span class="swap-off"><%= t(".expert") %> <span class="badge badge-xs badge-neutral"><%= t(".off") %></span></span>
</label>
