<label
  class="swap"
  data-controller="preference-toggle"
  data-preference-toggle-key-value="expert_mode"
>
  <input
    type="checkbox"
    data-preference-toggle-target="checkbox"
    data-action="change->preference-toggle#toggle"
    <% if preferences.expert_mode? %>
      checked
    <% end %>
  >

  <span class="swap-on badge badge-sm badge-info cursor-pointer"><%= t(".expert") %></span>
  <span class="swap-off badge badge-sm badge-neutral cursor-pointer"><%= t(".simple") %></span>
</label>
