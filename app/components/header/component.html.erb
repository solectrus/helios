<%#
  Top navbar (fixed) — must come BEFORE the drawer aside in DOM order, otherwise
  Safari/WebKit can trap the fixed nav inside the drawer's transform-induced
  containing block (https://bugs.webkit.org/show_bug.cgi?id=199501).
%>

<nav class="navbar bg-base-300 fixed top-0 right-0 left-0 z-40 h-16 min-h-0 gap-3 px-4 py-0 shadow-sm md:gap-8 md:px-8">
  <label for="main-drawer-toggle" class="btn btn-ghost btn-sm btn-square md:hidden" aria-label="<%= t(".menu") %>">
    <i class="fa-solid fa-bars text-lg"></i>
  </label>

  <h1 class="hidden sm:block">
    <img
      src="/logo.svg"
      alt="HELIOS Logo"
      class="h-8"
      aria-hidden="true"
    >

    <span class="sr-only">HELIOS</span>
  </h1>

  <div class="hidden items-center gap-1 md:flex">
    <% tabs.each do |tab| %>
      <%= link_to tab[:path], class: tab_classes(tab), data: { turbo_frame: "_top" } do %>
        <i class="<%= tab[:icon] %>"></i>
        <%= tab[:label] %>
      <% end %>
    <% end %>
  </div>

  <div class="ml-auto flex items-center gap-1">
    <a
      href="<%= helpers.new_support_path %>"
      data-turbo-frame="support-modal-content"
      class="btn btn-ghost btn-sm max-sm:btn-square gap-2"
      title="<%= t(".support") %>"
    >
      <i class="fa-solid fa-life-ring"></i>
      <span class="hidden sm:inline"><%= t(".support") %></span>
    </a>

    <%= render LanguageSelect::Component.new %>

    <% if helpers.password_required? %>
      <%= button_to session_path, method: :delete, class: "btn btn-ghost btn-sm btn-square", title: t('.logout') do %>
        <i class="fa-solid fa-right-from-bracket"></i>
      <% end %>
    <% end %>
  </div>
</nav>

<%# Drawer toggle (mobile) %>
<input type="checkbox" id="main-drawer-toggle" class="peer/drawer sr-only">

<%# Drawer backdrop %>
<label
  for="main-drawer-toggle"
  class="bg-base-content/40 fixed inset-0 z-40 hidden peer-checked/drawer:block md:hidden"
  aria-label="<%= t('.close_menu') %>"
></label>

<%# Drawer aside (mobile only) %>
<aside
  class="
    bg-base-200 fixed top-0 bottom-0 left-0 z-50 flex w-72 max-w-[80vw] -translate-x-full flex-col overflow-hidden
    transition-transform peer-checked/drawer:translate-x-0 md:hidden
  "
>
  <div class="border-base-content/10 flex items-center justify-between border-b p-4">
    <img
      src="/logo.svg"
      alt="HELIOS"
      class="h-7"
      aria-hidden="true"
    >

    <label for="main-drawer-toggle" class="btn btn-ghost btn-sm btn-square" aria-label="<%= t('.close_menu') %>">
      <i class="fa-solid fa-xmark text-lg"></i>
    </label>
  </div>

  <nav class="flex flex-1 flex-col gap-1 overflow-y-auto p-4">
    <% tabs.each do |tab| %>
      <%= link_to tab[:path], class: drawer_item_classes(tab), data: { turbo_frame: "_top" } do %>
        <i class="w-5 text-center <%= tab[:icon] %>"></i>
        <span><%= tab[:label] %></span>
      <% end %>

      <% if tab[:id] == :configuration %>
        <div class="border-base-content/20 mt-1 mb-2 ml-5 border-l pl-3">
          <%= render ConfigNav::Component.new(compact: true, only: :tabs) %>
        </div>
      <% end %>
    <% end %>
  </nav>

  <div class="border-base-content/10 border-t p-4">
    <%= render ConfigNav::Component.new(compact: true, only: :files) %>
  </div>
</aside>
