<%#
  Top navbar (fixed) — must come BEFORE the drawer aside in DOM order, otherwise
  Safari/WebKit can trap the fixed nav inside the drawer's transform-induced
  containing block (https://bugs.webkit.org/show_bug.cgi?id=199501).
%>

<nav class="navbar bg-base-300 fixed top-0 right-0 left-0 z-40 h-16 min-h-0 px-0 py-0 shadow-sm">
  <div class="mx-auto flex h-full w-full max-w-6xl items-center gap-3 px-4 md:gap-8 md:px-8">
    <%# Cached: changes only on locale/active_tab/collectors_only toggle. %>
    <% cache tabs_cache_key do %>
      <label for="main-drawer-toggle" class="btn btn-ghost btn-sm btn-square lg:hidden" aria-label="<%= t(".menu") %>">
        <i class="fa-solid fa-bars text-lg"></i>
      </label>

      <h1 class="hidden shrink-0 sm:block">
        <%= render SolectrusLogo::Component.new(css_class: "block h-6 w-auto") %>
      </h1>

      <div class="hidden items-center gap-1 lg:flex">
        <% tabs.each do |tab| %>
          <%= link_to tab[:path], class: tab_classes(tab), data: { turbo_frame: "_top" } do %>
            <i class="<%= tab[:icon] %>"></i>
            <%= tab[:label] %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# Uncached: HostStats polls live, dropdown's logout button needs a per-request CSRF token. %>
    <div class="ml-auto flex items-center gap-3">
      <%= render HostStats::Component.new %>

      <div class="dropdown dropdown-end" data-controller="locale-switcher">
        <div
          tabindex="0"
          role="button"
          class="btn btn-ghost btn-sm btn-square"
          aria-label="<%= t(".more_menu") %>"
          title="<%= t(".more_menu") %>"
        >
          <i class="text-base-content/80 fa-solid fa-ellipsis-vertical text-lg"></i>
        </div>

        <ul tabindex="-1" class="dropdown-content menu bg-base-100 rounded-box z-10 mt-1 w-56 p-2 shadow-2xl">
          <li>
            <a href="<%= helpers.new_support_path %>" data-turbo-frame="support-modal-content">
              <i class="fa-solid fa-life-ring fa-fw"></i>
              <%= t(".support") %>
            </a>
          </li>

          <li class="border-base-content/10 mt-2 border-t pt-2">
            <button
              type="button"
              class="<%= 'font-semibold' if I18n.locale == :de %>"
              data-action="click->locale-switcher#select"
              data-locale-switcher-locale-param="de"
            >
              <span class="w-4"><% if I18n.locale == :de %><i class="fa-solid fa-check"></i><% end %></span> Deutsch
            </button>
          </li>

          <li>
            <button
              type="button"
              class="<%= 'font-semibold' if I18n.locale == :en %>"
              data-action="click->locale-switcher#select"
              data-locale-switcher-locale-param="en"
            >
              <span class="w-4"><% if I18n.locale == :en %><i class="fa-solid fa-check"></i><% end %></span> English
            </button>
          </li>

          <li class="border-base-content/10 mt-2 border-t pt-2">
            <a href="<%= helpers.about_path %>" data-turbo-frame="_top">
              <i class="fa-solid fa-id-card fa-fw"></i>
              <%= t(".about") %>
            </a>
          </li>

          <% if helpers.password_required? %>
            <li>
              <%= button_to session_path,
                            method: :delete,
                            form: { class: "contents" },
                            class: "flex w-full cursor-pointer items-center gap-2 px-3 py-1.5 rounded-field hover:bg-base-content/10" do %>
                <i class="fa-solid fa-right-from-bracket fa-fw"></i>
                <%= t('.logout') %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</nav>

<%# Cached: drawer markup is locale/config-driven. ConfigNav nested inside is rendered fresh on cache miss. %>
<% cache drawer_cache_key do %>
  <%# Drawer toggle (mobile) %>
  <input type="checkbox" id="main-drawer-toggle" class="peer/drawer sr-only">

  <%# Drawer backdrop %>
  <label
    for="main-drawer-toggle"
    class="bg-base-content/40 fixed inset-0 z-40 hidden peer-checked/drawer:block lg:hidden"
    aria-label="<%= t('.close_menu') %>"
  ></label>

  <%# Drawer aside (mobile only) %>
  <aside
    class="
      bg-base-200 fixed top-0 bottom-0 left-0 z-50 flex w-72 max-w-[80vw] -translate-x-full flex-col overflow-hidden
      transition-transform peer-checked/drawer:translate-x-0 lg:hidden
    "
  >
    <div class="border-base-content/10 flex items-center justify-between border-b p-4">
      <%= render SolectrusLogo::Component.new(css_class: "block h-5 w-auto") %>

      <label for="main-drawer-toggle" class="btn btn-ghost btn-sm btn-square" aria-label="<%= t('.close_menu') %>">
        <i class="fa-solid fa-xmark text-lg"></i>
      </label>
    </div>

    <div class="flex flex-1 flex-col overflow-y-auto p-4">
      <%= render ConfigNav::Component.new(compact: true, only: :files) %>
    </div>
  </aside>
<% end %>
