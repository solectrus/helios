<nav class="navbar bg-base-300 sticky top-0 z-50 mb-8 gap-8 px-8 py-1 shadow-sm">
  <h1>
    <img
      src="/logo.svg"
      alt="HELIOS Logo"
      class="h-8"
      aria-hidden="true"
    >

    <span class="sr-only">HELIOS</span>
  </h1>

  <div class="flex gap-1">
    <% tabs.each do |tab| %>
      <%= link_to tab[:path], class: tab_classes(tab), data: { turbo_frame: "_top" } do %>
        <i class="mr-1 <%= tab[:icon] %>"></i>
        <%= tab[:label] %>
      <% end %>
    <% end %>
  </div>

  <div class="ml-auto flex items-center gap-1">
    <%= render ExpertModeToggle::Component.new %>
    <%= render LanguageSelect::Component.new %>

    <% if helpers.password_required? %>
      <%= button_to session_path, method: :delete, class: "btn btn-ghost btn-sm btn-square", title: t('.logout') do %>
        <i class="fa-solid fa-right-from-bracket"></i>
      <% end %>
    <% end %>
  </div>
</nav>
