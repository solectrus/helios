<div class="flex justify-center">
  <div role="tablist" class="tabs tabs-border tabs-xl">
    <% tabs.each do |tab| %>
      <%= link_to tab[:path], role: "tab", class: tab_classes(tab), data: { turbo_frame: "tab-content", turbo_action: "advance" } do %>
        <i class="mr-2 <%= tab[:icon] %>"></i>
        <%= tab[:label] %>
      <% end %>
    <% end %>
  </div>
</div>
