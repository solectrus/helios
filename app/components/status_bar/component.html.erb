<%= helpers.turbo_frame_tag "status-bar",
                             data: {
                               src: helpers.status_bar_path,
                               visibility_target: "frame",
                             } do %>
  <div class="fixed top-16 right-0 left-0 z-30 lg:top-auto lg:bottom-0 <%= bar_class %>">
    <div
      class="
        mx-auto grid min-h-12 max-w-6xl grid-cols-[auto_1fr_auto] items-center gap-3 px-4 py-2 text-sm font-medium
        sm:grid-cols-3 md:px-8
      "
    >
      <div class="hidden font-mono text-[11px] tracking-tight whitespace-nowrap sm:block">
        <span
          class="tooltip tooltip-top cursor-default before:font-sans"
          data-controller="relative-time"
          data-relative-time-datetime-value="<%= Rails.configuration.x.git.commit_time %>"
        >
          <%= Rails.configuration.x.git.commit_version %>
        </span>
      </div>

      <div class="flex min-w-0 items-center justify-start gap-3 sm:justify-center">
        <i class="<%= icon_class %>"></i>

        <% labels.each do |locale, text| %>
          <span data-locale="<%= locale %>" class="status-bar-label truncate"><%= text %></span>
        <% end %>
      </div>

      <div class="flex items-center justify-end gap-2">
        <% if backup_hint_labels %>
          <span class="badge badge-sm badge-soft gap-1.5 tabular-nums">
            <span class="loading loading-spinner loading-xs"></span>

            <% backup_hint_labels.each do |locale, text| %>
              <span data-locale="<%= locale %>" class="status-bar-label"><%= text %></span>
            <% end %>
          </span>
        <% end %>

        <% if (incomplete_labels = configuration_incomplete_labels) %>
          <%= link_to helpers.advanced_path,
                      data: { turbo_frame: "_top" },
                      class: "badge badge-sm badge-warning gap-1.5 font-medium" do %>
            <i class="fa-solid fa-triangle-exclamation"></i>

            <% incomplete_labels.each do |locale, text| %>
              <span data-locale="<%= locale %>" class="status-bar-label"><%= text %></span>
            <% end %>
          <% end %>
        <% end %>

        <% if primary_action %>
          <% if dropdown_actions.any? %>
            <%# Split button: primary action plus a dropdown holding the rest. %>
            <div class="flex">
              <%= action_button(primary_action, "btn btn-outline btn-sm gap-1.5 rounded-e-none", icon_only_mobile: true) %>

              <div class="dropdown dropdown-end">
                <div
                  tabindex="0"
                  role="button"
                  aria-label="<%= t('.more_actions') %>"
                  class="btn btn-outline btn-sm -ms-px rounded-s-none px-2"
                >
                  <i class="fa-solid fa-chevron-down"></i>
                </div>

                <ul
                  tabindex="0"
                  class="
                    dropdown-content menu bg-base-100 text-base-content rounded-box top-full z-10 mt-1 w-56 gap-1
                    p-2 shadow-2xl lg:top-auto lg:bottom-full lg:mt-0 lg:mb-1
                  "
                >
                  <% dropdown_actions.each do |key| %>
                    <li><%= action_button(key, "btn btn-ghost btn-sm w-full justify-start gap-3", long: true) %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% else %>
            <%= action_button(primary_action, "btn btn-outline btn-sm gap-1.5", long: true, icon_only_mobile: true) %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
