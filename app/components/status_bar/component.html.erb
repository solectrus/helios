<%= helpers.turbo_frame_tag "status-bar",
                             data: {
                               src: helpers.status_bar_path,
                               visibility_target: "frame",
                             } do %>
  <div class="fixed top-16 right-0 left-0 z-30 lg:top-auto lg:bottom-0 <%= bar_class %>">
    <div
      class="
        mx-auto grid min-h-12 max-w-6xl grid-cols-[auto_1fr_auto] items-center gap-3 px-4 py-2 text-sm font-medium
        sm:grid-cols-3 md:px-8
      "
    >
      <div class="hidden cursor-default font-mono text-[11px] tracking-tight whitespace-nowrap sm:block">
        <%= Rails.configuration.x.git.commit_version %>

        <span class="hidden opacity-60 lg:inline">
          /
          <span
            data-controller="relative-time"
            data-relative-time-datetime-value="<%= Rails.configuration.x.git.commit_time %>"
            data-relative-time-target-value="text"
          ></span>
        </span>
      </div>

      <div class="flex min-w-0 items-center justify-start gap-3 sm:justify-center">
        <i class="<%= icon_class %>"></i>

        <% labels.each do |locale, text| %>
          <span data-locale="<%= locale %>" class="status-bar-label truncate"><%= text %></span>
        <% end %>
      </div>

      <div class="flex items-center justify-end gap-2">
        <% if backup_hint_labels %>
          <span class="badge badge-sm badge-soft gap-1.5 tabular-nums">
            <span class="loading loading-spinner loading-xs"></span>

            <% backup_hint_labels.each do |locale, text| %>
              <span data-locale="<%= locale %>" class="status-bar-label"><%= text %></span>
            <% end %>
          </span>
        <% end %>

        <% if (incomplete_labels = configuration_incomplete_labels) %>
          <%= link_to helpers.advanced_path,
                      data: { turbo_frame: "_top" },
                      class: "badge badge-sm badge-warning gap-1.5 font-medium" do %>
            <i class="fa-solid fa-triangle-exclamation"></i>

            <% incomplete_labels.each do |locale, text| %>
              <span data-locale="<%= locale %>" class="status-bar-label"><%= text %></span>
            <% end %>
          <% end %>
        <% end %>

        <% if show_start? %>
          <%= button_to batch_path, method: :post, class: "btn btn-outline btn-sm" do %>
            <i class="fa-solid fa-play"></i>
            <span class="hidden sm:inline"><%= t(".start") %></span>
          <% end %>
        <% end %>

        <% if show_restart? %>
          <%= button_to batch_path, method: :post, class: "btn btn-outline btn-sm" do %>
            <i class="fa-solid fa-arrows-rotate"></i>
            <span class="hidden sm:inline"><%= t(".restart") %></span>
          <% end %>
        <% elsif show_stop? %>
          <%= button_to batch_path, method: :delete, class: "btn btn-outline btn-sm" do %>
            <i class="fa-solid fa-stop"></i>
            <span class="hidden sm:inline"><%= t(".stop") %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
