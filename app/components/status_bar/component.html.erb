<%= helpers.turbo_frame_tag "status-bar" do %>
  <div class="fixed right-0 bottom-0 left-0 z-40">
    <div class="flex items-center px-4 py-2 text-sm font-medium <%= bar_class %>">
      <div class="flex flex-1 items-center justify-center gap-3">
        <i class="<%= icon_class %>"></i>

        <% labels.each do |locale, text| %>
          <span data-locale="<%= locale %>" class="status-bar-label"><%= text %></span>
        <% end %>
      </div>

      <div class="flex items-center gap-2">
        <% if show_start? %>
          <%= button_to batch_path, method: :post, class: "btn btn-outline btn-sm" do %>
            <i class="fa-solid fa-play"></i>
            <%= t(".start") %>
          <% end %>
        <% end %>

        <% if show_restart? %>
          <%= button_to batch_path, method: :post, class: "btn btn-outline btn-sm" do %>
            <i class="fa-solid fa-arrows-rotate"></i>
            <%= t(".restart") %>
          <% end %>
        <% elsif show_stop? %>
          <%= button_to batch_path, method: :delete, class: "btn btn-outline btn-sm" do %>
            <i class="fa-solid fa-stop"></i>
            <%= t(".stop") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
