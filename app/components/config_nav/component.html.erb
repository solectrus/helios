<nav class="flex h-full flex-col <%= compact? ? 'gap-1' : 'gap-2' %>">
  <% if show_tabs? %>
    <% tabs.each do |tab| %>
      <%= link_to tab[:path], class: item_classes(tab), data: { turbo_frame: "_top" } do %>
        <% if compact? %>
          <i class="<%= icon_box_classes(tab) %> <%= tab[:icon] %>"></i>
        <% else %>
          <span class="<%= icon_box_classes(tab) %>">
            <i class="<%= tab[:icon] %>"></i>
          </span>
        <% end %>

        <span class="<%= compact? ? 'font-medium' : 'text-base font-medium' %>"><%= tab[:label] %></span>

        <% if show_warning?(tab) %>
          <span
            class="tooltip tooltip-right tooltip-warning ml-auto"
            data-tip="<%= t('configurations.show.incomplete') %>"
          >
            <i class="fa-solid fa-triangle-exclamation text-warning"></i>
          </span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if show_tabs? && show_files? %>
    <div class="divider <%= compact? ? 'my-1' : 'my-2' %>"></div>
  <% end %>

  <% if show_files? %>
    <a
      href="<%= helpers.file_path('compose') %>"
      data-turbo-frame="file-modal-content"
      class="<%= file_link_classes %>"
    >
      <i class="fa-solid fa-file-code <%= compact? ? 'w-5 text-center text-base-content/60' : 'opacity-70' %>"></i>
      <span class="<%= compact? ? 'font-mono text-base' : '' %>">compose.yaml</span>
    </a>
    <a href="<%= helpers.file_path('env') %>" data-turbo-frame="file-modal-content" class="<%= file_link_classes %>">
      <i class="fa-solid fa-file-lines <%= compact? ? 'w-5 text-center text-base-content/60' : 'opacity-70' %>"></i>
      <span class="<%= compact? ? 'font-mono text-base' : '' %>">.env</span>
    </a>
  <% end %>

  <% if show_reset? %>
    <div class="flex flex-col gap-1 pt-4 <%= 'mt-auto' unless compact? %>" data-controller="modal-opener">
      <% reset_actions.each do |action| %>
        <button
          type="button"
          data-action="modal-opener#open"
          data-modal-opener-id-param="<%= action[:id] %>"
          class="<%= reset_link_classes %>"
        >
          <i class="fa-solid w-5 text-center <%= action[:icon] %>"></i>
          <span class="truncate font-medium"><%= t(".#{action[:key]}") %></span>
        </button>
      <% end %>
    </div>
  <% end %>
</nav>
