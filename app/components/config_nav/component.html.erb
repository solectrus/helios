<nav class="flex h-full flex-col <%= compact? ? 'gap-1' : 'gap-2' %>">
  <% if show_tabs? %>
    <% tabs.each do |tab| %>
      <%= link_to tab[:path], class: item_classes(tab), data: { turbo_frame: "_top" } do %>
        <i class="<%= icon_box_classes(tab) %> <%= tab[:icon] %>" aria-hidden="true"></i>

        <span><%= tab[:label] %></span>

        <% if show_warning?(tab) %>
          <span
            class="tooltip tooltip-right tooltip-warning ml-auto"
            data-tip="<%= t('configurations.show.incomplete') %>"
          >
            <i class="fa-solid fa-triangle-exclamation text-warning"></i>
          </span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if show_files? || show_reset? %>
    <div class="mt-20">
      <% if show_files? %>
        <div class="border-base-content/10 mb-3 border-t"></div>
        <h3 class="text-base-content/50 mb-2 px-3 text-[0.7rem] font-semibold tracking-[0.14em] uppercase">
          <%= t('.files_label') %>
        </h3>
        <% docker_file_links.each do |link| %>
          <a
            href="<%= helpers.file_path(link[:key]) %>"
            data-turbo-frame="file-modal-content"
            class="<%= file_link_classes %>"
          >
            <i class="fa-solid text-base-content/55 w-5 shrink-0 text-center <%= link[:icon] %>" aria-hidden="true"></i>
            <span><%= link[:label] %></span>
          </a>
        <% end %>
        <% if show_traefik_file? %>
          <h3 class="text-base-content/50 mt-5 mb-2 px-3 text-[0.7rem] font-semibold tracking-[0.14em] uppercase">
            <%= t('.traefik_files_label') %>
          </h3>
          <a
            href="<%= helpers.file_path('traefik') %>"
            data-turbo-frame="file-modal-content"
            class="<%= file_link_classes %>"
          >
            <i class="fa-solid fa-route text-base-content/55 w-5 shrink-0 text-center" aria-hidden="true"></i>
            <span>traefik.yml</span>
          </a>
        <% end %>
      <% end %>

      <% if show_reset? %>
        <div class="bg-base-content/4 border-base-content/10 rounded-xl border p-2.5 <%= show_files? ? 'mt-6' : '' %>">
          <h3 class="text-base-content/55 mb-1.5 px-2 pt-1 text-[0.7rem] font-semibold tracking-[0.14em] uppercase">
            <%= t('.reset_label') %>
          </h3>

          <div class="flex flex-col gap-0.5" data-controller="modal-opener">
            <% reset_actions.each do |action| %>
              <button
                type="button"
                data-action="modal-opener#open"
                data-modal-opener-id-param="<%= action[:id] %>"
                class="<%= reset_link_classes %>"
              >
                <i
                  aria-hidden="true"
                  class="fa-solid text-error/80 group-hover/reset:text-error w-5 text-center transition-colors <%= action[:icon] %>"
                ></i>

                <span class="truncate"><%= t(".#{action[:key]}") %></span>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</nav>
