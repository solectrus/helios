<aside class="bg-base-200/40 border-base-content/10 sticky top-16 min-h-[calc(100dvh-6.5rem)] w-72 shrink-0 self-start border-r">
  <nav class="flex flex-col gap-2 p-8">
    <% tabs.each do |tab| %>
      <%= link_to tab[:path], class: item_classes(tab), data: { turbo_frame: "_top" } do %>
        <span class="<%= icon_box_classes(tab) %>">
          <i class="<%= tab[:icon] %>"></i>
        </span>

        <span class="text-base font-medium"><%= tab[:label] %></span>
      <% end %>
    <% end %>

    <% if helpers.preferences.expert_mode? %>
      <div class="divider my-2"></div>
      <a
        href="<%= helpers.file_path('compose') %>"
        data-turbo-frame="file-modal-content"
        class="btn btn-ghost btn-block bg-base-content/5 hover:bg-base-content/10 justify-start gap-3 font-mono"
      >
        <i class="fa-solid fa-file-code opacity-70"></i>
        compose.yaml
      </a>
      <a
        href="<%= helpers.file_path('env') %>"
        data-turbo-frame="file-modal-content"
        class="btn btn-ghost btn-block bg-base-content/5 hover:bg-base-content/10 justify-start gap-3 font-mono"
      >
        <i class="fa-solid fa-file-lines opacity-70"></i>
        .env
      </a>
    <% end %>
  </nav>
</aside>
