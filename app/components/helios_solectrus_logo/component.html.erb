<%#
  Combined brand lockup, two stacked lines of exactly equal width:
    1. Eyebrow: HELIOS wordmark (gold) + localized "configures"
    2. SOLECTRUS wordmark (currentColor), the dominant line
  Everything lives in a single SVG, so the whole lockup (line gap included)
  scales proportionally with whatever width/height css_class sets. The
  localized word is stretched to the right edge via textLength, which
  distributes the surplus as letter spacing, keeping both lines pixel-exact
  equal in width for any locale. Screen readers get the single phrase from
  the aria-label.
%>

<svg
  role="img"
  aria-label="<%= t('.label') %>"
  class="<%= css_class %>"
  viewBox="0 14 1626 351"
>
  <g transform="scale(0.45)" fill="#D4A855">
    <path
      d="M0,226v-192h41v77h59v-77h41v192h-41v-80h-59v80zM173,226h136v-36h-95v-44h93v-35h-93v-42h95v-35h-136zM341,226h122v-36h-81v-156h-41zM495,34h41v192h-41zM695,33a100 100 0 0 1-24 197l66-135c1-2 0-2-1-4-3-3-2-3-36 5l-31 7zM631,37l-30 116c0 2 3 5 6 5l64-14-21 84a100 100 0 0 1-19-191zM806,199c18 18 45 30 82 30 51 0 77-26 77-61 0-43-41-53-72-60-23-5-39-9-39-22 0-11 10-19 28-19 19 0 40 6 55 21l23-30c-19-18-44-27-75-27-45 0-73 26-73 58 0 43 41 51 72 58 22 6 39 11 39 25 0 11-11 22-33 22-27 0-48-12-61-26z"
    />
  </g>

  <text
    x="500"
    y="101.7"
    textLength="1126"
    lengthAdjust="spacing"
    font-size="120"
    font-weight="600"
    fill="currentColor"
    opacity="0.6"
  >
    <%= t('.configures').upcase %>
  </text>

  <g transform="translate(0 132)" fill="currentColor">
    <path d="<%= SolectrusLogo::Component::WORDMARK_PATH %>" />
  </g>
</svg>
