<%= link_to path,
            class: "card bg-base-100 shadow-md hover:shadow-lg hover:brightness-105 transition-all",
            data: { turbo_frame: "chapter-modal-content" } do %>
  <div class="card-body relative">
    <% if completed? %>
      <span class="badge badge-success absolute top-4 right-4 gap-1">
        <i class="fa-solid fa-check"></i>
        <%= t('configurations.show.configured') %>
      </span>
    <% else %>
      <span class="badge badge-ghost absolute top-4 right-4"><%= t('configurations.show.pending') %></span>
    <% end %>

    <div class="text-primary mb-2 text-3xl"><i class="fa-solid <%= icon %>"></i></div>

    <h2 class="card-title"><%= title %></h2>

    <p class="text-base-content/70 text-sm"><%= description %></p>
  </div>
<% end %>
