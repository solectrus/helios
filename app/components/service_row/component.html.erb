<%= helpers.turbo_frame_tag dom_id,
                             src: (helpers.service_row_path(service_name) if lazy),
                             loading: (:lazy if lazy),
                             class: row_class,
                             data: {
                               controller: "service-row--component",
                               service_row__component_name_value: service_name,
                               service_row__component_status_value: status_value,
                               visibility_target: "frame",
                               src: helpers.service_row_path(service_name),
                             } do %>
  <div class="flex items-center justify-between gap-2 sm:gap-4">
    <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
      <% if lazy %>
        <%# Skeleton placeholder for lazy loading %>
        <div class="flex size-4 items-center justify-center">
          <span class="loading loading-spinner loading-xs"></span>
        </div>
      <% else %>
        <%# Full content %>
        <div id="<%= dom_id %>-status" class="<%= tooltip_class %>" data-tip="<%= status_label %>">
          <div class="flex size-4 items-center justify-center">
            <% if healthcheck_passing? %>
              <span class="bg-success flex size-4 items-center justify-center rounded-full">
                <i class="fa-solid fa-check text-success-content text-[10px]"></i>
              </span>
            <% else %>
              <span class="<%= status_indicator_class %>"></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-baseline gap-x-2 text-base font-semibold sm:flex-nowrap sm:truncate">
          <span class="truncate"><%= compose_service.display_name %></span>

          <% if show_version? %>
            <span class="text-base-content/50 text-sm font-normal wrap-anywhere tabular-nums sm:text-base">
              <%= version %>
            </span>
          <% end %>

          <% if !lazy && incomplete_source? %>
            <span
              class="tooltip tooltip-right tooltip-warning font-normal"
              data-tip="<%= t('configurations.show.incomplete') %>"
            >
              <a href="<%= datasources_path %>" class="hover:underline">
                <i class="fa-solid fa-triangle-exclamation text-warning"></i>
              </a>
            </span>
          <% end %>
        </div>

        <div class="text-base-content/60 hidden min-h-6 text-xs sm:flex sm:items-center sm:gap-1">
          <span class="min-w-0 truncate font-mono"><%= compose_service.image %></span>

          <% if !lazy && legacy_image? %>
            <span
              class="tooltip tooltip-right tooltip-warning shrink-0"
              data-tip="<%= t('.legacy_image', image: recommended_image) %>"
            >
              <%= button_to service_image_path(service_name),
                            method: :patch,
                            disabled: pending,
                            class: "btn btn-ghost btn-xs btn-circle text-warning",
                            form: { class: "inline-block align-middle", data: { turbo_confirm: t('.legacy_image_confirm', image: recommended_image) } } do %>
                <i class="fa-solid fa-circle-up"></i>
              <% end %>
            </span>
          <% end %>

          <% if !lazy && postgresql_upgrade_available? %>
            <span
              class="tooltip tooltip-right tooltip-warning shrink-0"
              data-tip="<%= t('.postgresql_upgrade', major: postgresql_target_major) %>"
            >
              <%= button_to service_upgrade_path(service_name),
                            method: :post,
                            disabled: pending,
                            class: "btn btn-ghost btn-xs btn-circle text-warning",
                            form: {
                              class: "inline-block align-middle",
                              data: {
                                turbo_confirm: t('.postgresql_upgrade_confirm.body', major: postgresql_target_major),
                                turbo_confirm_title: t('.postgresql_upgrade_confirm.title', major: postgresql_target_major),
                                turbo_confirm_button: t('.postgresql_upgrade_confirm.button'),
                              },
                            } do %>
                <i class="fa-solid fa-circle-up"></i>
              <% end %>
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="flex shrink-0 items-center gap-1 sm:gap-4">
      <% unless helios? %>
        <%#
          Redis-only: kept at the left of the cluster so the start/stop/recreate
          group stays aligned with the other service rows.
        %>
        <% if service_name == "redis" %>
          <div id="<%= dom_id %>-cache" class="tooltip tooltip-info" data-tip="<%= t('.clear_cache') %>">
            <%= button_to service_cache_path(service_name),
                          method: :delete,
                          disabled: !clear_cache_enabled?,
                          class: "btn btn-ghost btn-sm btn-square",
                          data: {
                            turbo_confirm: t('.clear_cache_confirm.body'),
                            turbo_confirm_title: t('.clear_cache_confirm.title'),
                            turbo_confirm_button: t('.clear_cache_confirm.button'),
                            turbo_frame: "_top",
                          } do %>
              <i class="fa-solid fa-trash-can"></i>
            <% end %>
          </div>
        <% end %>
        <% if public_port %>
          <button
            type="button"
            data-action="click->service-row--component#open"
            data-port="<%= public_port %>"
            aria-label="<%= t('.open') %>"
            class="btn btn-sm max-sm:btn-square"
            <% unless open_button_enabled? %>
              disabled
            <% end %>
          >
            <i class="fa-solid fa-up-right-from-square"></i>
            <span class="hidden sm:inline"><%= t('.open') %></span>
          </button>
        <% end %>
        <div id="<%= dom_id %>-logs" class="tooltip tooltip-info" data-tip="<%= t('.logs') %>">
          <% if logs_available? %>
            <a
              href="<%= service_log_path(service_name) %>"
              data-turbo-frame="log-modal-content"
              class="btn btn-ghost btn-sm btn-square"
            >
              <i class="fa-solid fa-file-lines"></i>
            </a>
          <% else %>
            <span class="btn btn-ghost btn-sm btn-square btn-disabled" aria-disabled="true" tabindex="-1">
              <i class="fa-solid fa-file-lines"></i>
            </span>
          <% end %>
        </div>
        <div class="join">
          <div
            id="<%= dom_id %>-start"
            class="tooltip join-item <%= start_pending? ? 'tooltip-warning' : 'tooltip-info' %>"
            data-tip="<%= start_pending? ? t('.start_pending') : t('.start') %>"
          >
            <%= button_to service_task_path(service_name), method: :post, disabled: start_disabled?, class: "btn btn-ghost btn-sm btn-square", data: { service_row__component_target: "startButton" } do %>
              <i class="fa-solid fa-play <%= 'text-warning' if start_pending? %>"></i>
            <% end %>
          </div>

          <div id="<%= dom_id %>-stop" class="tooltip tooltip-info join-item" data-tip="<%= t('.stop') %>">
            <%= button_to service_task_path(service_name), method: :delete, disabled: stop_disabled?, class: "btn btn-ghost btn-sm btn-square", data: { service_row__component_target: "stopButton" } do %>
              <i class="fa-solid fa-stop"></i>
            <% end %>
          </div>

          <div
            id="<%= dom_id %>-recreate"
            class="tooltip join-item <%= recreate_warning? ? 'tooltip-warning' : 'tooltip-info' %>"
            data-tip="<%= recreate_warning? ? t('.recreate_pending') : t('.recreate') %>"
          >
            <%= button_to service_task_path(service_name), method: :patch, disabled: recreate_disabled?, class: "btn btn-ghost btn-sm btn-square", data: { service_row__component_target: "recreateButton" } do %>
              <i class="fa-solid fa-arrows-rotate <%= 'text-warning' if recreate_warning? %>"></i>
            <% end %>
          </div>
        </div>
      <% else %>
        <div id="<%= dom_id %>-recreate" class="tooltip tooltip-info" data-tip="<%= t('.recreate') %>">
          <%= button_to service_task_path(service_name), method: :patch, disabled: recreate_disabled?, class: "btn btn-ghost btn-sm btn-square", data: { turbo_confirm: t('.self_recreate_confirm'), turbo_frame: "_top", service_row__component_target: "recreateButton" } do %>
            <i class="fa-solid fa-arrows-rotate"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
