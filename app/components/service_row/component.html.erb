<%= helpers.turbo_frame_tag dom_id,
                             src: (helpers.service_row_path(service_name) if lazy),
                             loading: (:lazy if lazy),
                             class: row_class,
                             data: {
                               controller: "service-row--component",
                               service_row__component_name_value: service_name,
                               service_row__component_status_value: status_value,
                               visibility_target: "frame",
                               src: helpers.service_row_path(service_name),
                             } do %>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <% if lazy %>
        <%# Skeleton placeholder for lazy loading %>
        <div class="flex h-3 w-3 items-center justify-center">
          <span class="loading loading-spinner loading-xs"></span>
        </div>
      <% else %>
        <%# Full content %>
        <div class="<%= tooltip_class %>" data-tip="<%= status_label %>">
          <div class="flex h-3 w-3 items-center justify-center">
            <span class="<%= status_indicator_class %>"></span>
          </div>
        </div>
      <% end %>

      <div>
        <div class="text-base font-semibold">
          <%= compose_service.display_name %>

          <% if !lazy && version %>
            <span class="text-base-content/50 ml-1 font-normal"><%= version %></span>
          <% end %>
        </div>

        <div class="text-base-content/50 text-xs">
          <span class="truncate"><%= compose_service.image %></span>

          <% if !lazy && image_mismatch? %>
            <span
              class="tooltip tooltip-right tooltip-warning"
              data-tip="<%= t('.image_mismatch', image: container.image) %>"
            >
              <i class="fa-solid fa-triangle-exclamation text-warning"></i>
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <% unless helios? %>
        <% if public_port %>
          <button
            type="button"
            data-action="click->service-row--component#open"
            data-port="<%= public_port %>"
            class="btn btn-sm"
            <% unless open_button_enabled? %>
              disabled
            <% end %>
          >
            <i class="fa-solid fa-up-right-from-square"></i>
            <%= t('.open') %>
          </button>
        <% end %>
        <div class="tooltip tooltip-info" data-tip="<%= t('.logs') %>">
          <% if container %>
            <a
              href="<%= service_log_path(service_name) %>"
              data-turbo-frame="log-modal-content"
              class="btn btn-ghost btn-sm btn-square"
            >
              <i class="fa-solid fa-file-lines"></i>
            </a>
          <% else %>
            <span class="btn btn-ghost btn-sm btn-square btn-disabled" aria-disabled="true" tabindex="-1">
              <i class="fa-solid fa-file-lines"></i>
            </span>
          <% end %>
        </div>
        <div class="join">
          <div class="tooltip tooltip-info join-item" data-tip="<%= t('.start') %>">
            <%= button_to service_task_path(service_name), method: :post, disabled: start_disabled?, class: "btn btn-ghost btn-sm btn-square", data: { service_row__component_target: "startButton" } do %>
              <i class="fa-solid fa-play"></i>
            <% end %>
          </div>

          <div class="tooltip tooltip-info join-item" data-tip="<%= t('.stop') %>">
            <%= button_to service_task_path(service_name), method: :delete, disabled: stop_disabled?, class: "btn btn-ghost btn-sm btn-square", data: { service_row__component_target: "stopButton" } do %>
              <i class="fa-solid fa-stop"></i>
            <% end %>
          </div>

          <div class="tooltip tooltip-info join-item" data-tip="<%= t('.recreate') %>">
            <%= button_to service_task_path(service_name), method: :patch, disabled: recreate_disabled?, class: "btn btn-ghost btn-sm btn-square", data: { service_row__component_target: "recreateButton" } do %>
              <i class="fa-solid fa-arrows-rotate"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
