<div
  id="service-<%= service_name %>"
  data-controller="service-row--component"
  data-service-row--component-name-value="<%= service_name %>"
  data-service-row--component-status-value="<%= status_value %>"
  class="<%= row_class %>"
>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <%= helpers.turbo_frame_tag "service-#{service_name}-status",
                                   src: (helpers.service_status_path(service_name) unless pending || error?),
                                   loading: :lazy do %>
        <div class="<%= basic_tooltip_class %>" data-tip="<%= basic_status_label %>">
          <div class="w-3 h-3 flex items-center justify-center">
            <span class="<%= basic_status_indicator_class %>"></span>
          </div>
        </div>
      <% end %>

      <div>
        <div class="font-semibold text-base">
          <%= compose_service.display_name %>

          <%= helpers.turbo_frame_tag "service-#{service_name}-version",
                                   src: (helpers.service_version_path(service_name) unless pending || error?),
                                   loading: :lazy %>
        </div>

        <div class="text-xs text-base-content/50"><span class="truncate"><%= compose_service.image %></span></div>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <% unless helios? %>
        <% if public_port %>
          <a
            href="http://<%= host %>:<%= public_port %>"
            target="_blank"
            class="btn btn-sm <%= 'btn-disabled' unless open_button_enabled? %>"
            <%= 'aria-disabled="true" tabindex="-1"'.html_safe unless open_button_enabled? %>
          >
            <i class="fa-solid fa-up-right-from-square"></i>
            Open
          </a>
        <% end %>
        <div class="join">
          <%= button_to service_task_path(service_name), method: :post, disabled: start_disabled?, class: "btn btn-ghost btn-sm btn-square join-item", title: "Start", data: { service_row__component_target: "startButton" } do %>
            <i class="fa-solid fa-play"></i>
          <% end %>

          <%= button_to service_task_path(service_name), method: :delete, disabled: stop_disabled?, class: "btn btn-ghost btn-sm btn-square join-item", title: "Stop", data: { service_row__component_target: "stopButton" } do %>
            <i class="fa-solid fa-stop"></i>
          <% end %>

          <%= button_to service_task_path(service_name), method: :patch, disabled: recreate_disabled?, class: "btn btn-ghost btn-sm btn-square join-item", title: "Recreate", data: { service_row__component_target: "recreateButton" } do %>
            <i class="fa-solid fa-arrows-rotate"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
