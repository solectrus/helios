<div
  id="service-<%= service_name %>"
  data-controller="service-row--component"
  data-service-row--component-name-value="<%= service_name %>"
  data-service-row--component-status-value="<%= status_value %>"
  class="<%= row_class %>"
>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <%= helpers.turbo_frame_tag "service-#{service_name}-status",
                                   src: (helpers.service_status_path(service_name) unless pending || error?),
                                   loading: :lazy do %>
        <div class="<%= basic_tooltip_class %>" data-tip="<%= basic_status_label %>">
          <div class="w-3 h-3 flex items-center justify-center">
            <span class="<%= basic_status_indicator_class %>"></span>
          </div>
        </div>
      <% end %>

      <div>
        <div class="font-semibold text-base">
          <%= compose_service.display_name %>

          <%= helpers.turbo_frame_tag "service-#{service_name}-version",
                                   src: (helpers.service_version_path(service_name) unless pending || error?),
                                   loading: :lazy %>
        </div>

        <div class="text-xs text-base-content/50"><span class="truncate"><%= compose_service.image %></span></div>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <% unless helios? %>
        <% if public_port %>
          <a
            href="http://<%= host %>:<%= public_port %>"
            target="_blank"
            class="btn btn-sm <%= 'btn-disabled' unless open_button_enabled? %>"
            <%= 'aria-disabled="true" tabindex="-1"'.html_safe unless open_button_enabled? %>
          >
            Open
          </a>
        <% end %>
        <div class="join">
          <%= button_to service_task_path(service_name), method: :post, disabled: start_disabled?, class: "btn btn-ghost btn-sm btn-square join-item", title: "Start", data: { service_row__component_target: "startButton" } do %>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-4 w-4"
            >
              <path
                d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.841Z"
              />
            </svg>
          <% end %>

          <%= button_to service_task_path(service_name), method: :delete, disabled: stop_disabled?, class: "btn btn-ghost btn-sm btn-square join-item", title: "Stop", data: { service_row__component_target: "stopButton" } do %>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-4 w-4"
            >
              <path
                d="M5.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75V3.75a.75.75 0 0 0-.75-.75h-8.5Z"
              />
            </svg>
          <% end %>

          <%= button_to service_task_path(service_name), method: :patch, disabled: recreate_disabled?, class: "btn btn-ghost btn-sm btn-square join-item", title: "Recreate", data: { service_row__component_target: "recreateButton" } do %>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-4 w-4"
            >
              <path
                fill-rule="evenodd"
                d="M10 4.5c1.215 0 2.417.055 3.604.162a.68.68 0 0 1 .615.597c.124 1.038.208 2.088.25 3.15l-1.689-1.69a.75.75 0 0 0-1.06 1.061l2.999 3a.75.75 0 0 0 1.06 0l3.001-3a.75.75 0 0 0-1.06-1.06l-1.748 1.747a41.31 41.31 0 0 0-.264-3.386 2.18 2.18 0 0 0-1.97-1.913 41.512 41.512 0 0 0-7.477 0 2.18 2.18 0 0 0-1.969 1.913 41.16 41.16 0 0 0-.16 1.61.75.75 0 1 0 1.495.12c.041-.52.093-1.038.154-1.552a.68.68 0 0 1 .615-.597A40.012 40.012 0 0 1 10 4.5ZM5.281 9.22a.75.75 0 0 0-1.06 0l-3.001 3a.75.75 0 1 0 1.06 1.06l1.748-1.747c.042 1.141.13 2.27.264 3.386a2.18 2.18 0 0 0 1.97 1.913 41.533 41.533 0 0 0 7.477 0 2.18 2.18 0 0 0 1.969-1.913c.064-.534.117-1.071.16-1.61a.75.75 0 1 0-1.495-.12c-.041.52-.093 1.037-.154 1.552a.68.68 0 0 1-.615.597 40.013 40.013 0 0 1-7.208 0 .68.68 0 0 1-.615-.597 39.785 39.785 0 0 1-.25-3.15l1.689 1.69a.75.75 0 0 0 1.06-1.061l-2.999-3Z"
                clip-rule="evenodd"
              />
            </svg>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
