<div
  id="service-<%= service_name %>"
  data-controller="service-row--component"
  data-service-row--component-name-value="<%= service_name %>"
  data-service-row--component-status-value="<%= status_value %>"
  class="
    bg-base-100 rounded-lg border border-base-300 p-4 shadow-sm hover:shadow-md
    transition-shadow
  "
>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <div class="tooltip tooltip-left tooltip-info" data-tip="<%= status_label %>">
        <div class="w-3 h-3 flex items-center justify-center">
          <% if show_spinner? %>
            <span class="loading loading-spinner loading-xs text-primary"></span>
          <% else %>
            <div class="w-3 h-3 rounded-full <%= indicator_class %>"></div>
          <% end %>
        </div>
      </div>

      <div>
        <div class="font-semibold text-base">
          <%= compose_service.display_name %>

          <% if image_version %>
            <span class="text-base-content/50 ml-1"><%= image_version %></span>
          <% end %>
        </div>

        <div class="text-xs text-base-content/50"><span class="truncate"><%= compose_service.image %></span></div>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <% if public_port %>
        <a
          href="http://<%= host %>:<%= public_port %>"
          target="_blank"
          class="btn btn-sm <%= 'btn-disabled' unless open_button_enabled? %>"
          <%= 'aria-disabled="true" tabindex="-1"'.html_safe unless open_button_enabled? %>
        >
          Open
        </a>
      <% end %>

      <div class="join">
        <%= button_to start_service_path(service_name), method: :post, disabled: start_disabled?, class: "btn btn-ghost btn-sm btn-square join-item", title: "Start", data: { service_row__component_target: "startButton" } do %>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-4 w-4"
          >
            <path
              d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.841Z"
            />
          </svg>
        <% end %>

        <%= button_to stop_service_path(service_name), method: :post, disabled: stop_disabled?, class: "btn btn-ghost btn-sm btn-square join-item", title: "Stop", data: { service_row__component_target: "stopButton" } do %>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-4 w-4"
          >
            <path
              d="M5.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75V3.75a.75.75 0 0 0-.75-.75h-8.5Z"
            />
          </svg>
        <% end %>

        <%= button_to restart_service_path(service_name), method: :post, disabled: restart_disabled?, class: "btn btn-ghost btn-sm btn-square join-item", title: "Restart", data: { service_row__component_target: "restartButton" } do %>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-4 w-4"
          >
            <path
              fill-rule="evenodd"
              d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0v-2.43l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Zm1.23-3.723a.75.75 0 0 0 .219-.53V2.929a.75.75 0 0 0-1.5 0v2.43l-.31-.31A7 7 0 0 0 3.239 8.188a.75.75 0 1 0 1.448.389 5.5 5.5 0 0 1 9.2-2.466l.312.311h-2.433a.75.75 0 0 0 0 1.5h4.243a.75.75 0 0 0 .53-.219Z"
              clip-rule="evenodd"
            />
          </svg>
        <% end %>
      </div>
    </div>
  </div>
</div>
