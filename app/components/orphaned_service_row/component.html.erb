<%= helpers.turbo_frame_tag dom_id,
                             class: "block border-y border-warning/50 p-3 sm:p-4 bg-base-100 md:rounded-xl md:border" do %>
  <div class="flex flex-wrap items-center justify-between gap-y-3">
    <div class="flex min-w-0 flex-1 items-center gap-4">
      <%#
        A hint, not a tooltip: on a phone the dot is the only thing that
        carries the state, and a tooltip there has no way to open.
      %>

      <%= render Hint::Component.new(
            text: status_hint_text,
            wrapper_class: "dropdown-left",
            variant: :warning,
          ) do %>
        <div class="flex size-4 items-center justify-center">
          <span class="<%= status_indicator_class %>"></span>
        </div>
      <% end %>

      <div class="min-w-0 flex-1">
        <div class="truncate text-base font-semibold">
          <%= display_name %>
          <span class="badge badge-warning badge-sm ml-2"><%= t('.orphaned_badge') %></span>
        </div>

        <div class="text-base-content/50 truncate text-xs">
          <span><%= container.configured_image %></span>
        </div>
      </div>
    </div>

    <div class="flex shrink-0 items-center gap-4">
      <div class="tooltip tooltip-info" data-tip="<%= t('.stop') %>">
        <%= helpers.button_to helpers.service_path(service_name),
              method: :delete,
              disabled: stop_disabled?,
              aria: { label: t('.stop') },
              class: "btn btn-ghost btn-sm btn-square text-warning" do %>
          <i class="fa-solid fa-stop"></i>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
