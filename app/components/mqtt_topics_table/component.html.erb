<% if empty? %>
  <div
    class="
      border-base-content/10 flex flex-col items-center gap-4 border-y border-dashed px-6 py-16 text-center
      md:rounded-2xl md:border
    "
  >
    <div class="bg-base-200 text-base-content/60 flex h-12 w-12 items-center justify-center rounded-full">
      <i aria-hidden="true" class="fa-solid fa-tower-broadcast text-lg"></i>
    </div>

    <p class="text-base-content/70 max-w-sm text-sm"><%= t('datasources.mqtt_topics.index.empty') %></p>
  </div>
<% else %>
  <%#
    When no readings are available (e.g. collectors_only or InfluxDB down)
    we skip the polling controller entirely so it does not even initialize.
  %>
  <ul
    class="border-base-content/10 divide-base-content/15 divide-y overflow-hidden border-y md:rounded-2xl md:border"
    <% if polling_enabled? %>
      data-controller="sensors-polling"
      data-sensors-polling-url-value="<%= helpers.datasources_mqtt_topics_readings_path %>"
    <% end %>
  >
    <% topics.each_with_index do |topic, index| %>
      <% blockers = blockers_for(topic) %>

      <li class="group bg-base-100/40 hover:bg-base-100/80 transition-colors">
        <div class="space-y-3 px-6 py-5">
          <div class="flex items-start justify-between gap-4">
            <h2 class="min-w-0 flex-1 font-mono text-base leading-tight font-medium break-all">
              <% if computed?(topic) %>
                <span class="badge badge-ghost badge-sm mr-1.5 align-middle font-sans">
                  <%= t('datasources.mqtt_topics.computed.label') %>
                </span>
              <% end %>

              <%= headline_for(topic) %>
            </h2>

            <div
              class="
                text-base-content/40 group-hover:text-base-content/80 flex shrink-0 items-center gap-0.5
                transition-opacity
              "
            >
              <%= link_to helpers.edit_datasources_mqtt_topic_path(index),
                          class: "btn btn-ghost btn-xs btn-square",
                          aria: { label: t('datasources.mqtt_topics.table.edit') },
                          data: { turbo_frame: "setting-modal-content" } do %>
                <i aria-hidden="true" class="fa-solid fa-pen-to-square"></i>
              <% end %>

              <%#
                A name another formula reads cannot go away, so the removal is
                refused before it is attempted, with the reason in the tooltip.
              %>

              <div
                class="tooltip tooltip-left <%= delete_tooltip_class(blockers) %>"
                data-tip="<%= delete_tip(blockers) %>"
              >
                <%= button_to helpers.datasources_mqtt_topic_path(index),
                              method: :delete,
                              disabled: blockers.any?,
                              class: "btn btn-ghost btn-xs btn-square hover:text-error",
                              aria: { label: t('datasources.mqtt_topics.table.delete') },
                              data: { turbo_confirm: t('datasources.mqtt_topics.index.delete_confirm'), turbo_frame: "_top" } do %>
                  <i aria-hidden="true" class="fa-solid fa-trash-can"></i>
                <% end %>
              </div>
            </div>
          </div>

          <% badges = badges_for(topic) %>

          <% if badges.any? %>
            <div class="flex flex-wrap items-center gap-1.5">
              <% badges.each do |badge| %>
                <%= render badge %>
              <% end %>
            </div>
          <% end %>

          <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
            <i aria-hidden="true" class="fa-solid fa-arrow-right text-primary"></i>

            <% if stored? topic %>
              <span class="text-base-content font-mono text-sm font-medium break-all">
                <%= topic['measurement'] %><span class="text-base-content/40">:</span><%= topic['field'] %>
              </span>
            <% else %>
              <%= render skip_write_badge %>
            <% end %>

            <% if (type = type_badge(topic)) %>
              <%= render type %>
            <% end %>

            <% if polling_enabled? %>
              <div class="ml-auto">
                <%= render MqttTopicsTable::ValueCell::Component.new(index: index, reading: reading_for(index)) %>
              </div>
            <% end %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
