<dialog id="<%= id %>" class="modal" data-controller="dialog-modal">
  <div class="modal-box relative max-h-[95vh] max-w-5xl overflow-y-auto p-6">
    <%= helpers.turbo_frame_tag turbo_frame, data: { dialog_modal_target: "frame" } do %>
      <div class="flex justify-center py-8"><span class="loading loading-spinner loading-lg"></span></div>
    <% end %>

    <form method="dialog" class="absolute top-8 right-8">
      <button class="btn btn-circle btn-ghost"><i class="fa-solid fa-xmark"></i></button>
    </form>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
