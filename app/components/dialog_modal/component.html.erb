<dialog id="<%= id %>" class="modal" data-controller="dialog-modal">
  <div
    class="
      modal-box bg-base-300 sm:bg-base-200 relative h-dvh! w-full! max-w-none! overflow-y-auto rounded-none p-0
      [view-transition-name:dialog-modal-box] sm:h-auto! sm:max-h-[95vh] sm:w-11/12! sm:max-w-3xl! sm:rounded-2xl
      sm:px-6 sm:py-4
    "
    tabindex="-1"
    data-dialog-modal-target="box"
  >
    <%= helpers.turbo_frame_tag turbo_frame, data: { dialog_modal_target: "frame" } do %>
      <%= render LoadingSpinner::Component.new %>
    <% end %>

    <form method="dialog" class="fixed top-2 right-2 z-10 sm:absolute sm:top-6 sm:right-8">
      <button class="btn btn-circle btn-ghost"><i class="fa-solid fa-xmark"></i></button>
    </form>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>

  <dialog class="modal" data-dialog-modal-target="confirm">
    <div class="modal-box max-w-sm">
      <p class="text-base"><%= t('configurations.settings.discard_confirm') %></p>

      <div class="modal-action">
        <button class="btn" data-action="dialog-modal#confirmCancel">
          <%= t('configurations.settings.discard_cancel') %>
        </button>

        <button class="btn btn-error" data-action="dialog-modal#confirmDiscard">
          <%= t('configurations.settings.discard_discard') %>
        </button>
      </div>
    </div>
  </dialog>
</dialog>
