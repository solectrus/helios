<div
  class="mb-8"
  data-controller="sensors-polling preference-toggle"
  data-sensors-polling-url-value="<%= helpers.sensors_readings_path %>"
  data-sensors-polling-enabled-value="<%= polling_enabled? %>"
  data-preference-toggle-key-value="hide_unused"
>
  <%#
    overflow-clip (not overflow-hidden) clips the square corners of the sticky
    group-header cells so they don't poke out over the rounded container
    corners, while still allowing the headers to stick to the viewport —
    overflow-hidden would turn the card into a scroll container and break that.
  %>

  <div class="bg-base-100 border-base-content/10 border-y md:overflow-clip md:rounded-2xl md:border">
    <div class="p-0">
      <table
        class="table-sm table md:table-fixed"
        data-preference-toggle-target="container"
        data-hide-unused="<%= hide_unused? %>"
      >
        <%#
          Fixed column widths keep the layout stable: with the default
          auto-layout the value column resizes once live values morph in
          (short unit hint → full reading), shifting the whole row. Only from
          md upward, where the real table layout applies — below md the rows
          collapse into a stacked grid (see component.css) that must not be
          constrained by these column widths.
        %>

        <colgroup>
          <col class="md:w-5/12"><%# Sensor name %>
          <col class="md:w-1/6"><%# Source badge %>
          <col class="md:w-1/4"><%# Live value %>
          <col class="md:w-1/6"><%# Actions %>
        </colgroup>

        <% all_groups.each do |group, sensor_names| %>
          <tbody>
            <tr>
              <td
                colspan="4"
                class="
                  border-base-content/8 bg-base-100 sticky top-28 z-1 pt-8 pr-4 pb-4 pl-4 not-first:border-t
                  lg:top-16
                "
              >
                <span class="text-primary inline-flex items-center gap-3 text-base font-semibold tracking-wide uppercase">
                  <i aria-hidden="true" class="fa-solid text-xl <%= group_icon(group) %>"></i>
                  <span><%= t("sensor_groups.#{group}") %></span>
                </span>
              </td>
            </tr>

            <% sensor_names.each do |sensor_name| %>
              <%= render SensorRow::Component.new(
                    sensor_name: sensor_name,
                    configuration: configuration,
                    reading: readings[sensor_name],
                  ) %>
            <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-end gap-2">
    <span class="text-base-content/50 text-xs"><%= t('.hide_unused') %></span>

    <input
      type="checkbox"
      class="toggle toggle-xs"
      data-preference-toggle-target="checkbox"
      data-action="change->preference-toggle#toggle"
      <% if hide_unused? %>
        checked
      <% end %>
    >
  </div>
</div>
