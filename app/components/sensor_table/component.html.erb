<% unless influxdb_running %>
  <div class="alert alert-warning mb-4">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span><%= t('.influxdb_not_running') %></span>
  </div>
<% end %>

<% if influxdb_error.present? %>
  <div class="alert alert-error mb-4">
    <i class="fa-solid fa-circle-exclamation"></i>
    <span><%= t('.influxdb_error', message: influxdb_error) %></span>
  </div>
<% end %>

<% if sensors_configured? %>
  <div class="overflow-x-auto">
    <table class="table-sm table">
      <thead>
        <tr>
          <th></th>
          <th><%= t('.measurement') %></th>
          <th><%= t('.field') %></th>
          <th class="text-right"><%= t('.value') %></th>
          <th></th>
          <th class="text-right"><%= t('.count') %></th>
          <th><%= t('.span') %></th>
        </tr>
      </thead>

      <% grouped_sensor_rows.each do |device_name, rows| %>
        <tbody>
          <tr class="h-4">
            <td colspan="7"></td>
          </tr>

          <tr class="bg-base-200/30">
            <td colspan="7" class="text-primary py-1 pl-3 text-xs font-bold tracking-wide uppercase">
              <i class="fa-solid fa-microchip mr-1"></i>
              <%= device_name %>
            </td>
          </tr>

          <% rows.each do |row| %>
            <tr>
              <td class="pl-6 font-mono text-sm font-semibold"><%= row[:name] %></td>
              <td class="text-base-content/70 font-mono text-sm"><%= row[:measurement] %></td>
              <td class="text-base-content/70 font-mono text-sm"><%= row[:field] %></td>

              <%= helpers.sensor_value_cell(row[:name], readings[row[:name]]) %>
              <%= helpers.sensor_time_cell(row[:name], readings[row[:name]]) %>

              <td class="text-base-content/50 text-right font-mono text-sm"><%= row[:count] %></td>
              <td class="text-base-content/50 text-sm"><%= format_span(row) %></td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </table>
  </div>
<% else %>
  <div class="text-base-content/50 py-8 text-center">
    <i class="fa-solid fa-gauge mb-2 text-4xl"></i>
    <p><%= t('.no_sensors') %></p>
  </div>
<% end %>
