<div
  class="mb-8"
  data-controller="sensors-polling preference-toggle"
  data-sensors-polling-url-value="<%= helpers.sensors_readings_path %>"
  data-sensors-polling-enabled-value="<%= polling_enabled? %>"
  data-preference-toggle-key-value="hide_unused"
>
  <div class="bg-base-100 border-base-content/10 rounded-2xl border">
    <div class="p-0">
      <table class="table-sm table" data-preference-toggle-target="container" data-hide-unused="<%= hide_unused? %>">
        <% all_groups.each do |group, sensor_names| %>
          <tbody data-has-enabled-sensors="<%= group_has_enabled_sensors?(sensor_names) %>">
            <tr>
              <td colspan="4" class="border-base-content/8 pt-8 pr-4 pb-4 pl-4 not-first:border-t">
                <span class="text-primary inline-flex items-center gap-3 text-base font-semibold tracking-wide uppercase">
                  <i aria-hidden="true" class="fa-solid text-xl <%= group_icon(group) %>"></i>
                  <span><%= t("sensor_groups.#{group}") %></span>
                </span>
              </td>
            </tr>

            <% sensor_names.each do |sensor_name| %>
              <%= render SensorRow::Component.new(
                    sensor_name: sensor_name,
                    configuration: configuration,
                    reading: readings[sensor_name],
                  ) %>
            <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-end gap-2">
    <span class="text-base-content/50 text-xs"><%= t('.hide_unused') %></span>

    <input
      type="checkbox"
      class="toggle toggle-xs"
      data-preference-toggle-target="checkbox"
      data-action="change->preference-toggle#toggle"
      <% if hide_unused? %>
        checked
      <% end %>
    >
  </div>
</div>
