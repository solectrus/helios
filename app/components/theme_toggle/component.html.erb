<button
  type="button"
  class="btn btn-ghost btn-sm btn-square"
  title="Toggle Theme"
  data-controller="theme-toggle--component"
  data-action="click->theme-toggle--component#toggle"
>
  <span class="<%= 'hidden' if preferences.dark_theme? %>" data-theme-toggle--component-target="sunIcon">
    <i class="fa-solid fa-sun"></i>
  </span>

  <span class="<%= 'hidden' unless preferences.dark_theme? %>" data-theme-toggle--component-target="moonIcon">
    <i class="fa-solid fa-moon"></i>
  </span>
</button>
