<div class="grid h-full min-h-0 grid-cols-1 gap-8 lg:grid-cols-2" data-controller="stack-preview">
  <% files.each do |file| %>
    <div class="card bg-base-100 min-h-0 shadow-md">
      <div class="card-body flex min-h-0 flex-col p-5">
        <h2 class="shrink-0 text-lg font-semibold"><%= file[:label] %></h2>

        <pre class="min-h-0 flex-1 overflow-auto text-xs leading-relaxed"><code class="<%= file[:language_class] %>" data-stack-preview-target="code"><%= file[:content] %></code></pre>
      </div>
    </div>
  <% end %>
</div>
