{
  "locale": "de",
  "title": {
    "de": "Stromspeicher",
    "default": "Battery"
  },
  "description": {
    "de": "Konfiguration deines Stromspeichers",
    "default": "Configuration of your battery storage"
  },
  "pages": [
    {
      "name": "p_battery",
      "title": {
        "de": "Datenquelle",
        "default": "Data source"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "data_source",
          "title": {
            "de": "Woher kommen die Daten deines Stromspeichers?",
            "default": "Where does your battery data come from?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "senec_local",
              "text": {
                "de": "SENEC (lokaler Zugriff)",
                "default": "SENEC (local access)"
              }
            },
            {
              "value": "senec_cloud",
              "text": {
                "de": "SENEC (Cloud-API)",
                "default": "SENEC (Cloud API)"
              }
            },
            {
              "value": "external",
              "text": {
                "de": "Extern (ioBroker, Home Assistant)",
                "default": "External (ioBroker, Home Assistant)"
              }
            },
            {
              "value": "mqtt",
              "text": {
                "de": "Direkt per MQTT",
                "default": "Directly via MQTT"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_external",
      "visibleIf": "{data_source} = 'external'",
      "title": {
        "de": "Externe Befüllung",
        "default": "External input"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "external_system",
          "title": {
            "de": "Welches System wird verwendet?",
            "default": "Which system is used?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "iobroker",
              "text": "ioBroker"
            },
            {
              "value": "home_assistant",
              "text": "Home Assistant"
            }
          ]
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
