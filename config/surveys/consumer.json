{
  "locale": "de",
  "title": {
    "de": "Verbraucher",
    "default": "Consumer"
  },
  "description": {
    "de": "Konfiguration eines Custom-Verbrauchers",
    "default": "Configuration of a custom consumer"
  },
  "pages": [
    {
      "name": "p_consumer",
      "title": {
        "de": "Datenquelle",
        "default": "Data source"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "data_source",
          "title": {
            "de": "Woher kommen die Messdaten dieses Verbrauchers?",
            "default": "Where does this consumer's measurement data come from?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "shelly",
              "text": {
                "de": "Shelly Energiemesser",
                "default": "Shelly energy meter"
              }
            },
            {
              "value": "smart_home",
              "text": {
                "de": "Smart-Home-System (ioBroker, Home Assistant)",
                "default": "Smart home system (ioBroker, Home Assistant)"
              }
            },
            {
              "value": "mqtt",
              "text": {
                "de": "Direkt per MQTT",
                "default": "Directly via MQTT"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_shelly",
      "visibleIf": "{data_source} = 'shelly'",
      "title": {
        "de": "Shelly-Konfiguration",
        "default": "Shelly Configuration"
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_host",
          "title": {
            "de": "Lokale IP-Adresse oder Hostname",
            "default": "Local IP address or host name"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. 192.168.178.43",
            "default": "e.g. 192.168.178.43"
          }
        },
        {
          "type": "text",
          "name": "shelly_interval",
          "title": {
            "de": "Abfrage-Intervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 1
        },
        {
          "type": "text",
          "name": "shelly_password",
          "title": {
            "de": "Passwort (optional)",
            "default": "Password (optional)"
          },
          "description": {
            "de": "Nur erforderlich, falls ein Passwort für den Shelly konfiguriert ist",
            "default": "Only required if a password is configured for the Shelly"
          }
        }
      ]
    },
    {
      "name": "p_smart_home",
      "visibleIf": "{data_source} = 'smart_home'",
      "title": {
        "de": "Smart-Home-System",
        "default": "Smart home system"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "smart_home_system",
          "title": {
            "de": "Welches Smart-Home-System nutzt du?",
            "default": "Which smart home system do you use?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "iobroker",
              "text": "ioBroker"
            },
            {
              "value": "home_assistant",
              "text": "Home Assistant"
            }
          ]
        }
      ]
    },
    {
      "name": "p_mqtt",
      "visibleIf": "{data_source} = 'mqtt'",
      "title": {
        "de": "MQTT-Konfiguration",
        "default": "MQTT Configuration"
      },
      "elements": [
        {
          "type": "text",
          "name": "mqtt_topic",
          "title": {
            "de": "MQTT-Topic für die Leistung (in Watt)",
            "default": "MQTT topic for power (in watts)"
          },
          "description": {
            "de": "Das Topic, auf dem der aktuelle Verbrauch veröffentlicht wird",
            "default": "The topic where current consumption is published"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. sensors/consumer/power",
            "default": "e.g. sensors/consumer/power"
          }
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
