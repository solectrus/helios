{
  "locale": "de",
  "title": {
    "de": "Verbraucher",
    "default": "Consumer"
  },
  "description": {
    "de": "Konfiguration eines Custom-Verbrauchers",
    "default": "Configuration of a custom consumer"
  },
  "pages": [
    {
      "name": "p_consumer",
      "title": {
        "de": "Datenquelle",
        "default": "Data source"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "data_source",
          "title": {
            "de": "Woher kommen die Messdaten dieses Verbrauchers?",
            "default": "Where does this consumer's measurement data come from?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "shelly",
              "text": {
                "de": "Shelly Energiemesser",
                "default": "Shelly energy meter"
              }
            },
            {
              "value": "external",
              "text": {
                "de": "Extern (ioBroker, Home Assistant)",
                "default": "External (ioBroker, Home Assistant)"
              }
            },
            {
              "value": "mqtt",
              "text": {
                "de": "Direkt per MQTT",
                "default": "Directly via MQTT"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_shelly_connection",
      "visibleIf": "{data_source} = 'shelly'",
      "title": {
        "de": "Shelly-Verbindung",
        "default": "Shelly Connection"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "shelly_connection",
          "title": {
            "de": "Wie ist der Shelly erreichbar?",
            "default": "How is the Shelly accessed?"
          },
          "isRequired": true,
          "defaultValue": "local",
          "choices": [
            {
              "value": "local",
              "text": {
                "de": "Lokal (im Heimnetzwerk)",
                "default": "Local (in home network)"
              }
            },
            {
              "value": "cloud",
              "text": {
                "de": "Über Shelly Cloud",
                "default": "Via Shelly Cloud"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_shelly_local",
      "visibleIf": "{data_source} = 'shelly' and {shelly_connection} = 'local'",
      "title": {
        "de": "Shelly — Lokaler Zugriff",
        "default": "Shelly — Local Access"
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_host",
          "title": {
            "de": "IP-Adresse oder Hostname",
            "default": "IP address or host name"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. 192.168.178.43",
            "default": "e.g. 192.168.178.43"
          }
        },
        {
          "type": "text",
          "name": "shelly_interval",
          "title": {
            "de": "Abfrage-Intervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 1
        },
        {
          "type": "text",
          "name": "shelly_password",
          "title": {
            "de": "Passwort (optional)",
            "default": "Password (optional)"
          },
          "description": {
            "de": "Nur erforderlich, falls ein Passwort für den Shelly konfiguriert ist",
            "default": "Only required if a password is configured for the Shelly"
          }
        }
      ]
    },
    {
      "name": "p_shelly_cloud",
      "visibleIf": "{data_source} = 'shelly' and {shelly_connection} = 'cloud'",
      "title": {
        "de": "Shelly — Cloud-Zugriff",
        "default": "Shelly — Cloud Access"
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_device_id",
          "title": {
            "de": "Geräte-ID",
            "default": "Device ID"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "shelly_interval",
          "title": {
            "de": "Abfrage-Intervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 1
        }
      ]
    },
    {
      "name": "p_external",
      "visibleIf": "{data_source} = 'external'",
      "title": {
        "de": "Externe Befüllung",
        "default": "External input"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "external_system",
          "title": {
            "de": "Welches System wird verwendet?",
            "default": "Which system is used?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "iobroker",
              "text": "ioBroker"
            },
            {
              "value": "home_assistant",
              "text": "Home Assistant"
            }
          ]
        }
      ]
    },
    {
      "name": "p_mqtt",
      "visibleIf": "{data_source} = 'mqtt'",
      "title": {
        "de": "MQTT-Konfiguration",
        "default": "MQTT Configuration"
      },
      "elements": [
        {
          "type": "text",
          "name": "mqtt_topic",
          "title": {
            "de": "MQTT-Topic für die Leistung (in Watt)",
            "default": "MQTT topic for power (in watts)"
          },
          "description": {
            "de": "Das Topic, auf dem der aktuelle Verbrauch veröffentlicht wird",
            "default": "The topic where current consumption is published"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. sensors/consumer/power",
            "default": "e.g. sensors/consumer/power"
          }
        }
      ]
    },
    {
      "name": "p_house_power",
      "title": {
        "de": "Hausverbrauch",
        "default": "House power"
      },
      "elements": [
        {
          "type": "boolean",
          "name": "exclude_from_house_power",
          "title": {
            "de": "Aus Hausverbrauch herausrechnen",
            "default": "Deduct from house power"
          },
          "description": {
            "de": "Korrigiert den Hausverbrauch, indem der Verbrauch dieses Geräts abgezogen wird",
            "default": "Corrects house power by deducting this device's consumption"
          },
          "defaultValue": false
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
