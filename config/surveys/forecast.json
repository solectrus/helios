    {
      "name": "p_forecast_advanced",
      "visibleIf": "{forecast} anyof ['forecast.solar', 'solcast']",
      "title": {
        "de": "Erweiterte Einstellungen",
        "default": "Advanced settings"
      },
      "elements": [
        {
          "type": "text",
          "name": "measurement",
          "title": {
            "de": "InfluxDB-Measurement",
            "default": "InfluxDB measurement"
          },
          "description": {
            "de": "Alle Forecast-Sensoren verwenden dasselbe Measurement. Eine nachträgliche Änderung ist kaum möglich, da bereits geschriebene Daten dauerhaft an diesen Namen gebunden sind.",
            "default": "All forecast sensors use the same measurement. Changing this later is very difficult, as previously written data remains permanently tied to this name."
          },
          "defaultValue": "forecast",
          "isRequired": true,
          "visibleIf": "{forecast} anyof ['forecast.solar', 'solcast', 'pvnode']"
        },
        {
          "type": "text",
          "name": "forecast_interval",
          "visibleIf": "{forecast} anyof ['forecast.solar', 'solcast']",
          "title": {
            "de": "Abfrageintervall (Sekunden)",
            "default": "Query interval (seconds)"
          },
          "description": {
            "de": "Wie oft die Prognose aktualisiert wird",
            "default": "How often the forecast is updated"
          },
          "defaultValue": "900",
          "inputType": "number",
          "min": 60
        },
        {
          "type": "text",
          "name": "forecast_damping_morning",
          "visibleIf": "{forecast} = 'forecast.solar'",
          "title": {
            "de": "Dämpfungsfaktor morgens (optional)",
            "default": "Damping factor morning (optional)"
          },
          "description": {
            "de": "Wert zwischen 0 und 1",
            "default": "Value between 0 and 1"
          },
          "inputType": "number",
          "min": 0,
          "max": 1
        },
        {
          "type": "text",
          "name": "forecast_damping_evening",
          "visibleIf": "{forecast} = 'forecast.solar'",
          "title": {
            "de": "Dämpfungsfaktor abends (optional)",
            "default": "Damping factor evening (optional)"
          },
          "description": {
            "de": "Wert zwischen 0 und 1",
            "default": "Value between 0 and 1"
          },
          "inputType": "number",
          "min": 0,
          "max": 1
        },
        {
          "type": "text",
          "name": "forecast_horizon",
          "visibleIf": "{forecast} = 'forecast.solar'",
          "title": {
            "de": "Horizontprofil (optional)",
            "default": "Horizon profile (optional)"
          },
          "description": {
            "de": "Kommaseparierte Erhebungswinkel",
            "default": "Comma-separated elevation angles"
          }
        },
        {
          "type": "text",
          "name": "forecast_inverter",
          "visibleIf": "{forecast} = 'forecast.solar'",
          "title": {
            "de": "Maximale Wechselrichterleistung in Watt (optional)",
            "default": "Maximum inverter power in watts (optional)"
          },
          "inputType": "number",
          "min": 0
        },
        {
          "type": "text",
          "name": "forecast_solar_apikey",
          "visibleIf": "{forecast} = 'forecast.solar'",
          "title": {
            "de": "Forecast.Solar API-Key (optional)",
            "default": "Forecast.Solar API key (optional)"
          },
          "description": {
            "de": "Nur erforderlich für die kostenpflichtige Variante von forecast.solar",
            "default": "Only required for the paid variant of forecast.solar"
          }
        }
      ]
