{
  "locale": "de",
  "title": {
    "de": "Ertragsvorhersage",
    "default": "Yield forecast"
  },
  "description": {
    "de": "Prognose deines PV-Ertrags",
    "default": "Forecast of your PV yield"
  },
  "pages": [
    {
      "name": "p_forecast_provider",
      "title": {
        "de": "Prognoseanbieter",
        "default": "Forecast provider"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "forecast",
          "title": {
            "de": "Welchen Prognosedienst möchtest du nutzen?",
            "default": "Which forecast service do you want to use?"
          },
          "description": {
            "de": "Alle Anbieter bieten sowohl kostenfreie als auch kostenpflichtige Tarife an.",
            "default": "All providers offer both free and paid tiers."
          },
          "isRequired": true,
          "choices": [
            {
              "value": "forecast.solar",
              "text": "forecast.solar"
            },
            {
              "value": "solcast",
              "text": "solcast.com"
            },
            {
              "value": "pvnode",
              "text": "pvnode.com"
            }
          ]
        }
      ]
    },
    {
      "name": "p_forecast_solar_location",
      "visibleIf": "{forecast} anyof ['forecast.solar', 'pvnode']",
      "title": {
        "de": "Standort",
        "default": "Location"
      },
      "elements": [
        {
          "type": "text",
          "name": "forecast_latitude",
          "title": {
            "de": "Breitengrad",
            "default": "Latitude"
          },
          "description": {
            "de": "-90 (Süd) bis 90 (Nord)",
            "default": "-90 (South) to 90 (North)"
          },
          "isRequired": true,
          "inputType": "number",
          "min": -90,
          "max": 90
        },
        {
          "type": "text",
          "name": "forecast_longitude",
          "title": {
            "de": "Längengrad",
            "default": "Longitude"
          },
          "description": {
            "de": "-180 (West) bis 180 (Ost)",
            "default": "-180 (West) to 180 (East)"
          },
          "isRequired": true,
          "inputType": "number",
          "min": -180,
          "max": 180
        }
      ]
    },
    {
      "name": "p_forecast_roofs",
      "visibleIf": "{forecast} anyof ['forecast.solar', 'solcast', 'pvnode']",
      "title": {
        "de": "Dachflächen",
        "default": "Roofs"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "forecast_roofs",
          "title": {
            "de": "Anzahl Dachflächen mit Solarmodulen",
            "default": "Number of roof surfaces with solar modules"
          },
          "isRequired": true,
          "choices": [
            "1",
            "2",
            {
              "value": "3",
              "visibleIf": "{forecast} anyof ['forecast.solar', 'pvnode']"
            },
            {
              "value": "4",
              "visibleIf": "{forecast} anyof ['forecast.solar', 'pvnode']"
            }
          ]
        }
      ]
    },
    {
      "name": "p_forecast_solar_roof1",
      "visibleIf": "{forecast} anyof ['forecast.solar', 'pvnode']",
      "title": {
        "de": "1. Dachfläche",
        "default": "1. Roof"
      },
      "elements": [
        {
          "type": "text",
          "name": "forecast_azimuth1",
          "visibleIf": "{forecast} = 'forecast.solar'",
          "title": {
            "de": "Ausrichtung",
            "default": "Azimuth"
          },
          "description": {
            "de": "-180 = Nord, -90 = Ost, 0 = Süd, 90 = West",
            "default": "-180 = north, -90 = east, 0 = south, 90 = west"
          },
          "isRequired": true,
          "inputType": "number",
          "min": -180,
          "max": 180
        },
        {
          "type": "text",
          "name": "forecast_pvnode_azimuth1",
          "visibleIf": "{forecast} = 'pvnode'",
          "title": {
            "de": "Ausrichtung",
            "default": "Azimuth"
          },
          "description": {
            "de": "0 = Nord, 90 = Ost, 180 = Süd, 270 = West",
            "default": "0 = north, 90 = east, 180 = south, 270 = west"
          },
          "isRequired": true,
          "inputType": "number",
          "min": 0,
          "max": 360
        },
        {
          "type": "text",
          "name": "forecast_declination1",
          "title": {
            "de": "Neigung",
            "default": "Declination"
          },
          "description": {
            "de": "0 (horizontal) bis 90 (vertikal)",
            "default": "0 (horizontal) to 90 (vertical)"
          },
          "isRequired": true,
          "inputType": "number",
          "min": 0,
          "max": 90
        },
        {
          "type": "text",
          "name": "forecast_kwp1",
          "title": {
            "de": "Leistung (kWp)",
            "default": "Power (kWp)"
          },
          "isRequired": true,
          "inputType": "number",
          "min": 0
        }
      ]
    },
    {
