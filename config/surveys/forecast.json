          }
        },
        {
          "type": "text",
          "name": "forecast_pvnode_extra_params3",
          "visibleIf": "{forecast_roofs} anyof [3, 4]",
          "title": {
            "de": "3. Dachfläche",
            "default": "3. Roof"
          },
          "description": {
            "de": "Überschreibt die globalen Parameter für diese Dachfläche",
