    {
      "name": "p_solcast",
      "visibleIf": "{forecast} = 'solcast'",
      "title": {
        "de": "Solcast API",
        "default": "Solcast API"
      },
      "elements": [
        {
          "type": "text",
          "name": "forecast_solcast_api_key",
          "title": {
            "de": "API-Key",
            "default": "API key"
          },
          "description": {
            "de": "Kostenfrei bei https://toolkit.solcast.com.au/",
            "default": "Free at https://toolkit.solcast.com.au/"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "forecast_solcast_id1",
          "title": {
            "de": "Ressourcen-ID 1. Dachfläche",
            "default": "Resource ID 1st roof"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "forecast_solcast_id2",
          "visibleIf": "{forecast_roofs} = '2'",
          "title": {
            "de": "Ressourcen-ID 2. Dachfläche",
            "default": "Resource ID 2nd roof"
          },
          "isRequired": true
        }
      ]
    },
    {
      "name": "p_pvnode",
      "visibleIf": "{forecast} = 'pvnode'",
      "title": {
        "de": "pvnode API",
        "default": "pvnode API"
      },
      "elements": [
        {
          "type": "html",
          "name": "pvnode_apikey_link",
          "html": {
            "de": "<p>Den API-Key bekommst du unter <a href=\"https://pvnode.com/settings/api-keys\" target=\"_blank\" rel=\"noopener\">pvnode.com/settings/api-keys</a>.</p>",
            "default": "<p>You can get the API key at <a href=\"https://pvnode.com/settings/api-keys\" target=\"_blank\" rel=\"noopener\">pvnode.com/settings/api-keys</a>.</p>"
          }
        },
        {
          "type": "text",
          "name": "forecast_pvnode_apikey",
          "title": {
            "de": "API-Key",
            "default": "API key"
          },
          "isRequired": true
        },
        {
          "type": "radiogroup",
          "name": "forecast_pvnode_paid",
          "title": {
            "de": "pvnode-Tarif",
            "default": "pvnode plan"
          },
          "description": {
            "de": "Der Tarif muss zum aktiv abonnierten pvnode-Konto passen. Eine falsche Angabe kann Fehler oder vorzeitiges Aufbrauchen des monatlichen Kontingents verursachen.",
            "default": "The plan must match your active pvnode subscription. A mismatch can cause errors or exhaust the monthly quota prematurely."
          },
          "isRequired": true,
          "defaultValue": "false",
          "choices": [
            {
              "value": "false",
              "text": {
                "de": "Kostenlos (40 Abfragen/Monat, 1-Tages-Vorhersage)",
                "default": "Free (40 queries/month, 1-day forecast)"
              }
            },
            {
              "value": "true",
              "text": {
                "de": "Hobbyist (1.000 Abfragen/Monat, 7-Tages-Vorhersage, stündliche Aktualisierungen)",
                "default": "Hobbyist (1,000 queries/month, 7-day forecast, hourly updates)"
              }
            },
            {
              "value": "nowcast",
              "text": {
                "de": "Hobbyist mit Nowcast (3.000 Abfragen/Monat, 7-Tages-Vorhersage, 10-Minuten-Aktualisierungen tagsüber)",
                "default": "Hobbyist with Nowcast (3,000 queries/month, 7-day forecast, 10-minute updates during daytime)"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_pvnode_extra_params",
      "visibleIf": "{forecast} = 'pvnode'",
      "title": {
        "de": "pvnode Query-Parameter (optional)",
        "default": "pvnode query parameters (optional)"
      },
      "description": {
        "de": "Zusätzliche Parameter für die pvnode-API",
        "default": "Additional parameters for the pvnode API"
      },
      "elements": [
        {
          "type": "html",
          "name": "pvnode_extra_params_docs",
          "html": {
            "de": "<p>Eine Liste der verfügbaren Parameter findest du in der <a href=\"https://www.pvnode.com/docs/de/endpoints/forecast\" target=\"_blank\" rel=\"noopener\">pvnode-API-Dokumentation</a>.</p>",
            "default": "<p>For a list of available parameters, see the <a href=\"https://www.pvnode.com/docs/de/endpoints/forecast\" target=\"_blank\" rel=\"noopener\">pvnode API documentation</a>.</p>"
          }
        },
        {
          "type": "text",
          "name": "forecast_pvnode_extra_params",
          "title": {
            "de": "Globale Query-Parameter",
            "default": "Global query parameters"
          },
          "description": {
            "de": "Gilt für alle Dachflächen, z.B. 'mountingplace=building&albedo=0.2'",
            "default": "Applies to all roofs, e.g. 'mountingplace=building&albedo=0.2'"
          }
        },
        {
          "type": "text",
          "name": "forecast_pvnode_extra_params1",
          "visibleIf": "{forecast_roofs} anyof [2, 3, 4]",
          "title": {
            "de": "1. Dachfläche",
