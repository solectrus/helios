{
  "locale": "de",
  "title": {
    "de": "Wärmepumpe",
    "default": "Heat pump"
  },
  "description": {
    "de": "Konfiguration deiner Wärmepumpe",
    "default": "Configuration of your heat pump"
  },
  "pages": [
    {
      "name": "p_heatpump_access",
      "title": {
        "de": "Datenquelle",
        "default": "Data source"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "heatpump_access",
          "title": {
            "de": "Wie wird der Stromverbrauch der Wärmepumpe gemessen?",
            "default": "How is the electricity consumption of the heat pump measured?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "shelly",
              "text": {
                "de": "Shelly Energiemesser",
                "default": "Shelly energy meter"
              }
            },
            {
              "value": "smart_home",
              "text": {
                "de": "Smart-Home-System (ioBroker, Home Assistant)",
                "default": "Smart home system (ioBroker, Home Assistant)"
              }
            },
            {
              "value": "mqtt",
              "text": {
                "de": "Direkt per MQTT",
                "default": "Directly via MQTT"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_shelly_connection",
      "visibleIf": "{heatpump_access} = 'shelly'",
      "title": {
        "de": "Shelly-Verbindung",
        "default": "Shelly Connection"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "shelly_connection",
          "title": {
            "de": "Wie ist der Shelly erreichbar?",
            "default": "How is the Shelly accessed?"
          },
          "isRequired": true,
          "defaultValue": "local",
          "choices": [
            {
              "value": "local",
              "text": {
                "de": "Lokal (im Heimnetzwerk)",
                "default": "Local (in home network)"
              }
            },
            {
              "value": "cloud",
              "text": {
                "de": "Über Shelly Cloud",
                "default": "Via Shelly Cloud"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_shelly_local",
      "visibleIf": "{heatpump_access} = 'shelly' and {shelly_connection} = 'local'",
      "title": {
        "de": "Shelly — Lokaler Zugriff",
        "default": "Shelly — Local Access"
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_host",
          "title": {
            "de": "IP-Adresse oder Hostname",
            "default": "IP address or host name"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. 192.168.178.43",
            "default": "e.g. 192.168.178.43"
          }
        },
        {
          "type": "text",
          "name": "shelly_interval",
          "title": {
            "de": "Abfrage-Intervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 1
        },
        {
          "type": "text",
          "name": "shelly_password",
          "title": {
            "de": "Passwort (optional)",
            "default": "Password (optional)"
          },
          "description": {
            "de": "Nur erforderlich, falls ein Passwort für den Shelly konfiguriert ist",
            "default": "Only required if a password is configured for the Shelly"
          }
        }
      ]
    },
    {
      "name": "p_shelly_cloud",
      "visibleIf": "{heatpump_access} = 'shelly' and {shelly_connection} = 'cloud'",
      "title": {
        "de": "Shelly — Cloud-Zugriff",
        "default": "Shelly — Cloud Access"
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_cloud_server",
          "title": {
            "de": "Cloud-Server-URL",
            "default": "Cloud server URL"
          },
          "isRequired": true,
          "placeholder": "https://shelly-42-eu.shelly.cloud"
        },
        {
          "type": "text",
          "name": "shelly_auth_key",
          "title": {
            "de": "Authentifizierungsschlüssel",
            "default": "Authentication key"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "shelly_device_id",
          "title": {
            "de": "Geräte-ID",
            "default": "Device ID"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "shelly_interval",
          "title": {
            "de": "Abfrage-Intervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 1
        }
      ]
    },
    {
      "name": "p_smart_home",
      "visibleIf": "{heatpump_access} = 'smart_home'",
      "title": {
        "de": "Smart-Home-System",
        "default": "Smart home system"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "smart_home_system",
          "title": {
            "de": "Welches Smart-Home-System nutzt du?",
            "default": "Which smart home system do you use?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "iobroker",
              "text": "ioBroker"
            },
            {
              "value": "home_assistant",
              "text": "Home Assistant"
            }
          ]
        }
      ]
    },
    {
      "name": "p_mqtt",
      "visibleIf": "{heatpump_access} = 'mqtt'",
      "title": {
        "de": "MQTT-Konfiguration",
        "default": "MQTT Configuration"
      },
      "elements": [
        {
          "type": "text",
          "name": "mqtt_topic",
          "title": {
            "de": "MQTT-Topic für die Leistung (in Watt)",
            "default": "MQTT topic for power (in watts)"
          },
          "description": {
            "de": "Das Topic, auf dem der aktuelle Verbrauch veröffentlicht wird",
            "default": "The topic where current consumption is published"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. sensors/heatpump/power",
            "default": "e.g. sensors/heatpump/power"
          }
        },
        {
          "type": "text",
          "name": "mqtt_topic_heating_power",
          "title": {
            "de": "MQTT-Topic für die Heizleistung (in Watt)",
            "default": "MQTT topic for heating power (in watts)"
          },
          "description": {
            "de": "Das Topic, auf dem die thermische Leistung veröffentlicht wird (optional)",
            "default": "The topic where thermal output is published (optional)"
          },
          "placeholder": {
            "de": "z.B. sensors/heatpump/heating_power",
            "default": "e.g. sensors/heatpump/heating_power"
          }
        },
        {
          "type": "text",
          "name": "mqtt_topic_tank_temp",
          "title": {
            "de": "MQTT-Topic für die Speichertemperatur (in °C)",
            "default": "MQTT topic for tank temperature (in °C)"
          },
          "description": {
            "de": "Das Topic, auf dem die Warmwasser-Speichertemperatur veröffentlicht wird (optional)",
            "default": "The topic where hot water tank temperature is published (optional)"
          },
          "placeholder": {
            "de": "z.B. sensors/heatpump/tank_temp",
            "default": "e.g. sensors/heatpump/tank_temp"
          }
        },
        {
          "type": "text",
          "name": "mqtt_topic_heatpump_status",
          "title": {
            "de": "MQTT-Topic für den Betriebsstatus",
            "default": "MQTT topic for operating status"
          },
          "description": {
            "de": "Das Topic, auf dem der aktuelle Betriebsstatus veröffentlicht wird (optional)",
            "default": "The topic where current operating status is published (optional)"
          },
          "placeholder": {
            "de": "z.B. sensors/heatpump/status",
            "default": "e.g. sensors/heatpump/status"
          }
        },
        {
          "type": "text",
          "name": "mqtt_topic_outdoor_temp",
          "title": {
            "de": "MQTT-Topic für die Außentemperatur (in °C)",
            "default": "MQTT topic for outdoor temperature (in °C)"
          },
          "description": {
            "de": "Das Topic, auf dem die Außentemperatur veröffentlicht wird (optional)",
            "default": "The topic where outdoor temperature is published (optional)"
          },
          "placeholder": {
            "de": "z.B. sensors/heatpump/outdoor_temp",
            "default": "e.g. sensors/heatpump/outdoor_temp"
          }
        }
      ]
    },
    {
      "name": "p_house_power",
      "title": {
        "de": "Hausverbrauch",
        "default": "House power"
      },
      "elements": [
        {
          "type": "boolean",
          "name": "exclude_from_house_power",
          "title": {
            "de": "Aus Hausverbrauch herausrechnen",
            "default": "Deduct from house power"
          },
          "description": {
            "de": "Korrigiert den Hausverbrauch, indem der Wärmepumpen-Verbrauch abgezogen wird",
            "default": "Corrects house power by deducting heat pump consumption"
          },
          "defaultValue": false
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
