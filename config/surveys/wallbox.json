{
  "locale": "de",
  "title": {
    "de": "Wallbox",
    "default": "Wallbox"
  },
  "description": {
    "de": "Konfiguration deiner Wallbox",
    "default": "Configuration of your wallbox"
  },
  "pages": [
    {
      "name": "p_wallbox",
      "title": {
        "de": "Datenquelle",
        "default": "Data source"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "wallbox_vendor",
          "title": {
            "de": "Woher kommen die Ladedaten deiner Wallbox?",
            "default": "Where does your wallbox charging data come from?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "senec",
              "text": {
                "de": "SENEC (gesteuert vom Stromspeicher)",
                "default": "SENEC (controlled by the battery)"
              }
            },
            {
              "value": "shelly",
              "text": {
                "de": "Shelly Energiemesser",
                "default": "Shelly energy meter"
              }
            },
            {
              "value": "smart_home",
              "text": {
                "de": "Smart-Home-System (ioBroker, Home Assistant)",
                "default": "Smart home system (ioBroker, Home Assistant)"
              }
            },
            {
              "value": "mqtt",
              "text": {
                "de": "Direkt per MQTT",
                "default": "Directly via MQTT"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_shelly_connection",
      "visibleIf": "{wallbox_vendor} = 'shelly'",
      "title": {
        "de": "Shelly-Verbindung",
        "default": "Shelly Connection"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "shelly_connection",
          "title": {
            "de": "Wie ist der Shelly erreichbar?",
            "default": "How is the Shelly accessed?"
          },
          "isRequired": true,
          "defaultValue": "local",
          "choices": [
            {
              "value": "local",
              "text": {
                "de": "Lokal (im Heimnetzwerk)",
                "default": "Local (in home network)"
              }
            },
            {
              "value": "cloud",
              "text": {
                "de": "Über Shelly Cloud",
                "default": "Via Shelly Cloud"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_shelly_local",
      "visibleIf": "{wallbox_vendor} = 'shelly' and {shelly_connection} = 'local'",
      "title": {
        "de": "Shelly — Lokaler Zugriff",
        "default": "Shelly — Local Access"
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_host",
          "title": {
            "de": "IP-Adresse oder Hostname",
            "default": "IP address or host name"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. 192.168.178.44",
            "default": "e.g. 192.168.178.44"
          }
        },
        {
          "type": "text",
          "name": "shelly_interval",
          "title": {
            "de": "Abfrage-Intervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 1
        },
        {
          "type": "text",
          "name": "shelly_password",
          "title": {
            "de": "Passwort (optional)",
            "default": "Password (optional)"
          },
          "description": {
            "de": "Nur erforderlich, falls ein Passwort für den Shelly konfiguriert ist",
            "default": "Only required if a password is configured for the Shelly"
          }
        }
      ]
    },
    {
      "name": "p_shelly_cloud",
      "visibleIf": "{wallbox_vendor} = 'shelly' and {shelly_connection} = 'cloud'",
      "title": {
        "de": "Shelly — Cloud-Zugriff",
        "default": "Shelly — Cloud Access"
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_cloud_server",
          "title": {
            "de": "Cloud-Server-URL",
            "default": "Cloud server URL"
          },
          "isRequired": true,
          "placeholder": "https://shelly-42-eu.shelly.cloud"
        },
        {
          "type": "text",
          "name": "shelly_auth_key",
          "title": {
            "de": "Authentifizierungsschlüssel",
            "default": "Authentication key"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "shelly_device_id",
          "title": {
            "de": "Geräte-ID",
            "default": "Device ID"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "shelly_interval",
          "title": {
            "de": "Abfrage-Intervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 1
        }
      ]
    },
    {
      "name": "p_smart_home",
      "visibleIf": "{wallbox_vendor} = 'smart_home'",
      "title": {
        "de": "Smart-Home-System",
        "default": "Smart home system"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "smart_home_system",
          "title": {
            "de": "Welches Smart-Home-System nutzt du?",
            "default": "Which smart home system do you use?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "iobroker",
              "text": "ioBroker"
            },
            {
              "value": "home_assistant",
              "text": "Home Assistant"
            }
          ]
        }
      ]
    },
    {
      "name": "p_mqtt",
      "visibleIf": "{wallbox_vendor} = 'mqtt'",
      "title": {
        "de": "MQTT-Konfiguration",
        "default": "MQTT Configuration"
      },
      "elements": [
        {
          "type": "text",
          "name": "mqtt_topic",
          "title": {
            "de": "MQTT-Topic für die Ladeleistung (in Watt)",
            "default": "MQTT topic for charging power (in watts)"
          },
          "description": {
            "de": "Das Topic, auf dem die aktuelle Ladeleistung veröffentlicht wird",
            "default": "The topic where current charging power is published"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. sensors/wallbox/power",
            "default": "e.g. sensors/wallbox/power"
          }
        }
      ]
    },
    {
      "name": "p_house_power",
      "title": {
        "de": "Hausverbrauch",
        "default": "House power"
      },
      "elements": [
        {
          "type": "boolean",
          "name": "exclude_from_house_power",
          "title": {
            "de": "Aus Hausverbrauch herausrechnen",
            "default": "Deduct from house power"
          },
          "description": {
            "de": "Korrigiert den Hausverbrauch, indem der Wallbox-Verbrauch abgezogen wird",
            "default": "Corrects house power by deducting wallbox consumption"
          },
          "defaultValue": false
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
