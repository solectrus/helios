{
  "locale": "de",
  "title": {
    "de": "Wechselrichter & Stromspeicher",
    "default": "Inverter & Battery"
  },
  "description": {
    "de": "Konfiguration deines Wechselrichters und Stromspeichers",
    "default": "Configuration of your inverter and battery storage"
  },
  "pages": [
    {
      "name": "p_battery_vendor",
      "title": {
        "de": "Stromspeicher-Hersteller",
        "default": "Battery vendor"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "battery_vendor",
          "title": {
            "de": "Welchen Stromspeicher hast du?",
            "default": "Which manufacturer is your storage system from?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "senec3",
              "text": {
                "de": "SENEC.Home V3 oder V2.1",
                "default": "SENEC.Home V3 or V2.1"
              }
            },
            {
              "value": "senec4",
              "text": "SENEC.Home 4"
            },
            {
              "value": "shelly",
              "text": {
                "de": "Anderer, per Shelly gemessen (z.B. Balkonkraftwerk)",
                "default": "Other, measured via Shelly (e.g. balcony power plant)"
              }
            },
            {
              "value": "smart_home",
              "text": {
                "de": "Anderer, über Smart-Home-System (ioBroker, Home Assistant)",
                "default": "Other, via smart home system (ioBroker, Home Assistant)"
              }
            },
            {
              "value": "mqtt",
              "text": {
                "de": "Anderer, Messwerte direkt per MQTT",
                "default": "Other, data directly via MQTT"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_senec3",
      "visibleIf": "{battery_vendor} = 'senec3'",
      "title": {
        "de": "SENEC V3 Konfiguration",
        "default": "SENEC V3 Configuration"
      },
      "elements": [
        {
          "type": "text",
          "name": "senec_host",
          "title": {
            "de": "Lokale IP-Adresse oder Hostname",
            "default": "Local IP address or host name"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. 192.168.178.42",
            "default": "e.g. 192.168.178.42"
          }
        },
        {
          "type": "text",
          "name": "senec_interval",
          "title": {
            "de": "Abfrage-Intervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 5
        },
        {
          "type": "radiogroup",
          "name": "senec_schema",
          "title": {
            "de": "Zugriffsprotokoll",
            "default": "Protocol"
          },
          "defaultValue": "https",
          "isRequired": true,
          "choices": ["https", "http"]
        },
        {
          "type": "text",
          "name": "senec_ignore",
          "title": {
            "de": "Felder ignorieren (optional)",
            "default": "Ignore fields (optional)"
          },
          "description": {
            "de": "Kommaseparierte Liste von Messfeldern, die nicht an InfluxDB gesendet werden sollen",
            "default": "Comma-separated list of measurement fields to exclude from InfluxDB"
          }
        },
        {
          "type": "radiogroup",
          "name": "senec_language",
          "title": {
            "de": "Sprache des SENEC-Geräts",
            "default": "Language of SENEC device"
          },
          "defaultValue": "de",
          "isRequired": true,
          "choices": [
            { "value": "de", "text": { "de": "Deutsch", "default": "German" } },
            { "value": "en", "text": { "de": "Englisch", "default": "English" } },
            { "value": "it", "text": { "de": "Italienisch", "default": "Italian" } }
          ]
        }
      ]
    },
    {
      "name": "p_senec4",
      "visibleIf": "{battery_vendor} = 'senec4'",
      "title": {
        "de": "SENEC Home 4 Konfiguration",
        "default": "SENEC Home 4 Configuration"
      },
      "elements": [
        {
          "type": "text",
          "name": "senec_username",
          "title": {
            "de": "E-Mail-Adresse",
            "default": "Email address"
          },
          "description": {
            "de": "Die Adresse, mit der du dich bei mein-senec.de einloggst",
            "default": "The address you use to log in to mein-senec.de"
          },
          "isRequired": true,
          "inputType": "email"
        },
        {
          "type": "text",
          "name": "senec_password",
          "title": {
            "de": "Passwort",
            "default": "Password"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "senec_totp_uri",
          "title": {
            "de": "URI für MFA (optional)",
            "default": "URI for MFA (optional)"
          },
          "description": {
            "de": "Nur erforderlich, falls MFA bei SENEC aktiviert ist",
            "default": "Only required if MFA is enabled"
          },
          "validators": [
            {
              "type": "expression",
              "text": {
                "de": "Muss mit otpauth:// beginnen",
                "default": "Must start with otpauth://"
              },
              "expression": "{senec_totp_uri} contains 'otpauth://' or {senec_totp_uri} empty"
            }
          ]
        },
        {
          "type": "text",
          "name": "senec_system_id",
          "title": {
            "de": "System-ID (optional)",
            "default": "System ID (optional)"
          },
          "description": {
            "de": "Leer lassen, falls nicht bekannt oder nur ein Speicher vorhanden",
            "default": "Leave empty if not known or only one battery"
          }
        },
        {
          "type": "text",
          "name": "senec_interval",
          "title": {
            "de": "Abfrageintervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 60,
          "isRequired": true,
          "inputType": "number",
          "min": 60
        },
        {
          "type": "text",
          "name": "senec_ignore",
          "title": {
            "de": "Felder ignorieren (optional)",
            "default": "Ignore fields (optional)"
          },
          "description": {
            "de": "Kommaseparierte Liste von Messfeldern, die nicht an InfluxDB gesendet werden sollen",
            "default": "Comma-separated list of measurement fields to exclude from InfluxDB"
          }
        }
      ]
    },
    {
      "name": "p_smart_home",
      "visibleIf": "{battery_vendor} = 'smart_home'",
      "title": {
        "de": "Smart-Home-System",
        "default": "Smart home system"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "smart_home_system",
          "title": {
            "de": "Welches Smart-Home-System nutzt du?",
            "default": "Which smart home system do you use?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "iobroker",
              "text": "ioBroker"
            },
            {
              "value": "home_assistant",
              "text": "Home Assistant"
            }
          ]
        }
      ]
    },
    {
      "name": "p_shelly_connection",
      "visibleIf": "{battery_vendor} = 'shelly'",
      "title": {
        "de": "Shelly-Verbindung",
        "default": "Shelly Connection"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "shelly_connection",
          "title": {
            "de": "Wie ist der Shelly erreichbar?",
            "default": "How is the Shelly accessed?"
          },
          "isRequired": true,
          "defaultValue": "local",
          "choices": [
            {
              "value": "local",
              "text": {
                "de": "Lokal (im Heimnetzwerk)",
                "default": "Local (in home network)"
              }
            },
            {
              "value": "cloud",
              "text": {
                "de": "Über Shelly Cloud",
                "default": "Via Shelly Cloud"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_shelly_local",
      "visibleIf": "{battery_vendor} = 'shelly' and {shelly_connection} = 'local'",
      "title": {
        "de": "Shelly — Lokaler Zugriff",
        "default": "Shelly — Local Access"
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_host",
          "title": {
            "de": "IP-Adresse oder Hostname",
            "default": "IP address or host name"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. 192.168.178.45",
            "default": "e.g. 192.168.178.45"
          }
        },
        {
          "type": "text",
          "name": "shelly_interval",
          "title": {
            "de": "Abfrage-Intervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 1
        },
        {
          "type": "text",
          "name": "shelly_password",
          "title": {
            "de": "Passwort (optional)",
            "default": "Password (optional)"
          },
          "description": {
            "de": "Nur erforderlich, falls ein Passwort für den Shelly konfiguriert ist",
            "default": "Only required if a password is configured for the Shelly"
          }
        }
      ]
    },
    {
      "name": "p_shelly_cloud",
      "visibleIf": "{battery_vendor} = 'shelly' and {shelly_connection} = 'cloud'",
      "title": {
        "de": "Shelly — Cloud-Zugriff",
        "default": "Shelly — Cloud Access"
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_cloud_server",
          "title": {
            "de": "Cloud-Server-URL",
            "default": "Cloud server URL"
          },
          "isRequired": true,
          "placeholder": "https://shelly-42-eu.shelly.cloud"
        },
        {
          "type": "text",
          "name": "shelly_auth_key",
          "title": {
            "de": "Authentifizierungsschlüssel",
            "default": "Authentication key"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "shelly_device_id",
          "title": {
            "de": "Geräte-ID",
            "default": "Device ID"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "shelly_interval",
          "title": {
            "de": "Abfrage-Intervall (in Sekunden)",
            "default": "Query interval (in seconds)"
          },
          "defaultValue": 5,
          "isRequired": true,
          "inputType": "number",
          "min": 1
        }
      ]
    },
    {
      "name": "p_shelly_advanced",
      "visibleIf": "{battery_vendor} = 'shelly'",
      "title": {
        "de": "Erweitert",
        "default": "Advanced"
      },
      "elements": [
        {
          "type": "boolean",
          "name": "shelly_invert_power",
          "title": {
            "de": "Leistungswert invertieren",
            "default": "Invert power value"
          },
          "description": {
            "de": "Aktivieren bei Stromerzeugern (z.B. Balkonkraftwerk), da der Shelly negative Werte liefert",
            "default": "Enable for power generators (e.g. balcony power plant), as the Shelly reports negative values"
          },
          "defaultValue": false
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
