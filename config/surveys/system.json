{
  "locale": "de",
  "title": {
    "de": "System-Einstellungen",
    "default": "System Settings"
  },
  "description": {
    "de": "Grundlegende Einstellungen für SOLECTRUS",
    "default": "Basic settings for SOLECTRUS"
  },
  "pages": [
    {
      "name": "p_general",
      "title": {
        "de": "Allgemein",
        "default": "General"
      },
      "elements": [
        {
          "type": "text",
          "name": "installation_date",
          "title": {
            "de": "Inbetriebnahme der PV-Anlage",
            "default": "Commissioning date of PV system"
          },
          "description": {
            "de": "Wird für die Zeitraumauswahl benötigt",
            "default": "Required for time range selection"
          },
          "isRequired": true,
          "inputType": "date"
        },
        {
          "type": "dropdown",
          "name": "timezone",
          "title": {
            "de": "Zeitzone",
            "default": "Timezone"
          },
          "isRequired": true,
          "defaultValue": "Europe/Berlin",
          "choices": [
            { "value": "Europe/Berlin", "text": "Europe/Berlin" },
            { "value": "Europe/Vienna", "text": "Europe/Vienna" },
            { "value": "Europe/Zurich", "text": "Europe/Zurich" },
            { "value": "Europe/Amsterdam", "text": "Europe/Amsterdam" },
            { "value": "Europe/Paris", "text": "Europe/Paris" },
            { "value": "Europe/Rome", "text": "Europe/Rome" },
            { "value": "Europe/London", "text": "Europe/London" },
            { "value": "America/New_York", "text": "America/New_York" },
            { "value": "America/Los_Angeles", "text": "America/Los_Angeles" },
            { "value": "Asia/Tokyo", "text": "Asia/Tokyo" },
            { "value": "Australia/Sydney", "text": "Australia/Sydney" }
          ]
        }
      ]
    },
    {
      "name": "p_network",
      "title": {
        "de": "Netzwerk",
        "default": "Network"
      },
      "elements": [
        {
          "type": "text",
          "name": "app_host",
          "title": {
            "de": "IP-Adresse oder Hostname",
            "default": "IP address or host name"
          },
          "isRequired": true
        }
      ]
    },
    {
      "name": "p_security",
      "title": {
        "de": "Sicherheit",
        "default": "Security"
      },
      "elements": [
        {
          "type": "text",
          "name": "admin_password",
          "title": {
            "de": "Administrator-Passwort",
            "default": "Administrator password"
          },
          "description": {
            "de": "Nur der Admin kann Einstellungen und Strompreise bearbeiten",
            "default": "Only the admin can edit settings and electricity prices"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "lockup_codeword",
          "title": {
            "de": "Zugangscode für die Weboberfläche (optional)",
            "default": "Access code for the web interface (optional)"
          },
          "description": {
            "de": "Sperrt die gesamte Weboberfläche mit einem Codewort",
            "default": "Locks the entire web interface with a codeword"
          }
        }
      ]
    },
    {
      "name": "p_advanced",
      "title": {
        "de": "Erweitert",
        "default": "Advanced"
      },
      "elements": [
        {
          "type": "text",
          "name": "co2_emission_factor",
          "title": {
            "de": "CO₂-Emissionsfaktor (g/kWh)",
            "default": "CO₂ emission factor (g/kWh)"
          },
          "description": {
            "de": "Faktor zur Berechnung der CO₂-Einsparung",
            "default": "Factor for calculating CO₂ savings"
          },
          "defaultValue": "401",
          "inputType": "number",
          "min": 0
        },
        {
          "type": "dropdown",
          "name": "ui_theme",
          "title": {
            "de": "Farbschema",
            "default": "Color theme"
          },
          "description": {
            "de": "Leer = Benutzer kann selbst wählen",
            "default": "Empty = user can choose"
          },
          "choices": [
            { "value": "light", "text": { "de": "Hell", "default": "Light" } },
            { "value": "dark", "text": { "de": "Dunkel", "default": "Dark" } }
          ]
        },
        {
          "type": "text",
          "name": "frame_ancestors",
          "title": {
            "de": "iFrame-Einbettung erlauben (optional)",
            "default": "Allow iFrame embedding (optional)"
          },
          "description": {
            "de": "URL der übergeordneten Webseite, z.B. https://example.com",
            "default": "URL of the parent website, e.g. https://example.com"
          }
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
