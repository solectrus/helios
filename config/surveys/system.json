          "defaultValue": "3000",
          "isRequired": true,
          "inputType": "number",
          "min": 1024,
          "max": 65535
        }
      ]
    },
    {
      "name": "p_dashboard",
      "title": "Dashboard",
      "elements": [
        {
          "type": "text",
