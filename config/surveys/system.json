      "elements": [
        {
          "type": "radiogroup",
          "name": "linux_machine",
          "title": {
            "de": "Auf welchem Gerät läuft SOLECTRUS?",
            "default": "On which device does SOLECTRUS run?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "raspberry",
              "text": "Raspberry Pi"
            },
            {
              "value": "synology",
              "text": "Synology NAS"
            },
            {
              "value": "other",
              "text": {
                "de": "Anderer Linux-Server",
                "default": "Other Linux server"
              }
            }
          ]
        },
        {
          "type": "text",
          "name": "app_host",
          "title": {
            "de": "IP-Adresse oder Hostname",
            "default": "IP address or host name"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "app_port",
          "title": {
            "de": "Port",
            "default": "Port"
