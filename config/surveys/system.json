{
  "locale": "de",
  "title": {
    "de": "System-Einstellungen",
    "default": "System Settings"
  },
  "description": {
    "de": "Grundlegende Einstellungen für SOLECTRUS",
    "default": "Basic settings for SOLECTRUS"
  },
  "pages": [
    {
      "name": "p_mode",
      "title": {
        "de": "Betriebsmodus",
        "default": "Deployment mode"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "mode",
          "title": {
            "de": "Welche Dienste soll HELIOS auf diesem Host betreiben?",
            "default": "Which services should HELIOS run on this host?"
          },
          "description": {
            "de": "Im Regelfall läuft alles auf einem Host — wähle dann die erste Option. Die beiden anderen Optionen sind Spezialfälle für verteilte Installationen über mehrere Hosts.",
            "default": "In most cases everything runs on a single host — pick the first option. The other two options are special cases for distributed setups across multiple hosts."
          },
          "isRequired": true,
          "defaultValue": "full",
          "choices": [
            {
              "value": "full",
              "text": {
                "de": "Dashboard, Datenbanken, Zusatzdienste und Kollektoren (empfohlen)\n\nVollständige Installation auf einem Host — Messwerte werden lokal erfasst, gespeichert und angezeigt.",
                "default": "Dashboard, databases, supporting services and collectors (recommended)\n\nFull single-host installation — measurements are collected, stored, and displayed locally."
              }
            },
            {
              "value": "collectors_only",
              "text": {
                "de": "Nur Kollektoren — Spezialfall\n\nVerteilte Installation: Kollektoren laufen hier und pushen ihre Messwerte an eine externe InfluxDB auf einem anderen Host.",
                "default": "Collectors only — special case\n\nDistributed setup: collectors run here and push measurements to an external InfluxDB on another host."
              }
            },
            {
              "value": "dashboard_only",
              "text": {
                "de": "Nur Dashboard, Datenbanken und Zusatzdienste — Spezialfall\n\nVerteilte Installation: Messwerte kommen von Kollektoren auf einem anderen Host und werden hier gespeichert und angezeigt.",
                "default": "Dashboard, databases and supporting services only — special case\n\nDistributed setup: measurements arrive from collectors on another host and are stored and displayed here."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_general",
      "title": {
        "de": "Allgemein",
        "default": "General"
      },
      "elements": [
        {
          "type": "text",
          "name": "installation_date",
          "title": {
            "de": "Inbetriebnahme der PV-Anlage",
            "default": "Commissioning date of PV system"
          },
          "description": {
            "de": "Wird für die Zeitraumauswahl benötigt",
            "default": "Required for time range selection"
          },
          "visibleIf": "{mode} <> 'collectors_only'",
          "isRequired": true,
          "inputType": "date"
        },
        {
          "type": "dropdown",
          "name": "timezone",
          "title": {
            "de": "Zeitzone",
            "default": "Timezone"
          },
          "isRequired": true,
          "defaultValue": "Europe/Berlin",
          "choices": [
            { "value": "Europe/Berlin", "text": "Europe/Berlin" },
            { "value": "Europe/Vienna", "text": "Europe/Vienna" },
            { "value": "Europe/Zurich", "text": "Europe/Zurich" },
            { "value": "Europe/Amsterdam", "text": "Europe/Amsterdam" },
            { "value": "Europe/Paris", "text": "Europe/Paris" },
            { "value": "Europe/Rome", "text": "Europe/Rome" },
            { "value": "Europe/London", "text": "Europe/London" },
            { "value": "America/New_York", "text": "America/New_York" },
            { "value": "America/Los_Angeles", "text": "America/Los_Angeles" },
            { "value": "Asia/Tokyo", "text": "Asia/Tokyo" },
            { "value": "Australia/Sydney", "text": "Australia/Sydney" }
          ]
        }
      ]
    },
    {
      "name": "p_network",
      "title": {
        "de": "Netzwerk",
        "default": "Network"
      },
      "visibleIf": "{mode} <> 'collectors_only'",
      "elements": [
        {
          "type": "text",
          "name": "app_host",
          "title": {
            "de": "IP-Adresse oder Hostname",
            "default": "IP address or host name"
          },
          "isRequired": true
        }
      ]
    },
    {
      "name": "p_security",
      "title": {
        "de": "Sicherheit",
        "default": "Security"
      },
      "elements": [
        {
          "type": "text",
          "name": "admin_password",
          "title": {
            "de": "Administrator-Passwort",
            "default": "Administrator password"
          },
          "description": {
            "de": "Nur der Admin kann Einstellungen und Strompreise bearbeiten",
            "default": "Only the admin can edit settings and electricity prices"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "lockup_codeword",
          "title": {
            "de": "Zugangscode für die Weboberfläche (optional)",
            "default": "Access code for the web interface (optional)"
          },
          "description": {
            "de": "Sperrt die gesamte Weboberfläche mit einem Codewort",
            "default": "Locks the entire web interface with a codeword"
          },
          "visibleIf": "{mode} <> 'collectors_only'"
        }
      ]
    },
    {
      "name": "p_advanced",
      "title": {
        "de": "Erweitert",
        "default": "Advanced"
      },
      "visibleIf": "{mode} <> 'collectors_only'",
      "elements": [
        {
          "type": "text",
          "name": "co2_emission_factor",
          "title": {
            "de": "CO₂-Emissionsfaktor (g/kWh)",
            "default": "CO₂ emission factor (g/kWh)"
          },
          "description": {
            "de": "Faktor zur Berechnung der CO₂-Einsparung",
            "default": "Factor for calculating CO₂ savings"
          },
          "defaultValue": "401",
          "inputType": "number",
          "min": 0
        },
        {
          "type": "dropdown",
          "name": "ui_theme",
          "title": {
            "de": "Farbschema",
            "default": "Color theme"
          },
          "description": {
            "de": "Leer = Benutzer kann selbst wählen",
            "default": "Empty = user can choose"
          },
          "choices": [
            { "value": "light", "text": { "de": "Hell", "default": "Light" } },
            { "value": "dark", "text": { "de": "Dunkel", "default": "Dark" } }
          ]
        },
        {
          "type": "text",
          "name": "frame_ancestors",
          "title": {
            "de": "iFrame-Einbettung erlauben (optional)",
            "default": "Allow iFrame embedding (optional)"
          },
          "description": {
            "de": "URL der übergeordneten Webseite, z.B. https://example.com",
            "default": "URL of the parent website, e.g. https://example.com"
          }
        }
      ]
    },
    {
      "name": "p_updates",
      "title": {
        "de": "Automatische Updates",
        "default": "Automatic updates"
      },
      "elements": [
        {
          "type": "html",
          "name": "update_interval_info",
          "html": {
            "de": "<p>Neue Versionen der Dienste werden automatisch installiert, sobald sie verfügbar sind.</p>",
            "default": "<p>New versions of the services are installed automatically as soon as they become available.</p>"
          }
        },
        {
          "type": "radiogroup",
          "name": "update_interval",
          "title": {
            "de": "Prüfintervall",
            "default": "Check interval"
          },
          "isRequired": true,
          "defaultValue": "86400",
          "choices": [
            {
              "value": "86400",
              "text": {
                "de": "Täglich (empfohlen)",
                "default": "Daily (recommended)"
              }
            },
            {
              "value": "28800",
              "text": {
                "de": "Alle 8 Stunden",
                "default": "Every 8 hours"
              }
            },
            {
              "value": "3600",
              "text": {
                "de": "Stündlich",
                "default": "Hourly"
              }
            }
          ]
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
