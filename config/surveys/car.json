        "de": "Datenquelle",
        "default": "Data source"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "data_source",
          "title": {
            "de": "Woher kommen die Daten deines Elektroautos?",
            "default": "Where does your electric car data come from?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "external",
              "text": {
                "de": "Extern (ioBroker, Home Assistant)",
                "default": "External (ioBroker, Home Assistant)"
              }
            },
            {
              "value": "mqtt",
              "text": {
                "de": "Direkt per MQTT",
                "default": "Directly via MQTT"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_external",
      "visibleIf": "{data_source} = 'external'",
      "title": {
        "de": "Externe Befüllung",
        "default": "External input"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "external_system",
          "title": {
            "de": "Welches System wird verwendet?",
            "default": "Which system is used?"
          },
          "isRequired": true,
          "choices": [
            {
              "value": "iobroker",
              "text": "ioBroker"
            },
            {
              "value": "home_assistant",
              "text": "Home Assistant"
            }
          ]
        }
      ]
    },
    {
      "name": "p_mqtt",
      "visibleIf": "{data_source} = 'mqtt'",
      "title": {
        "de": "MQTT-Konfiguration",
        "default": "MQTT Configuration"
      },
      "elements": [
        {
          "type": "text",
          "name": "mqtt_topic",
          "title": {
            "de": "MQTT-Topic für den Ladestand (in Prozent)",
            "default": "MQTT topic for state of charge (in percent)"
          },
          "description": {
            "de": "Das Topic, auf dem der aktuelle Ladestand veröffentlicht wird",
            "default": "The topic where current state of charge is published"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. sensors/car/soc",
            "default": "e.g. sensors/car/soc"
          }
        }
      ]
    }
