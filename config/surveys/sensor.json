{
  "locale": "de",
  "title": {
    "de": "Sensor konfigurieren",
    "default": "Configure sensor"
  },
  "clearInvisibleValues": "onHidden",
  "pages": [
    {
      "name": "p_source",
      "title": {
        "de": "Datenquelle",
        "default": "Data source"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "source",
          "title": {
            "de": "Woher kommen die Messdaten?",
            "default": "Where does the measurement data come from?"
          },
          "isRequired": true,
          "choices": []
        }
      ]
    },
    {
      "name": "p_shelly_local",
      "visibleIf": "{source} = 'shelly'",
      "title": {
        "de": "Shelly — Lokaler Zugriff",
        "default": "Shelly — Local Access"
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_host",
          "title": {
            "de": "IP-Adresse oder Hostname",
            "default": "IP address or host name"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. 192.168.178.43",
            "default": "e.g. 192.168.178.43"
          }
        },
        {
          "type": "text",
          "name": "shelly_password",
          "title": {
            "de": "Passwort (optional)",
            "default": "Password (optional)"
          },
          "description": {
            "de": "Nur erforderlich, falls ein Passwort für den Shelly konfiguriert ist",
            "default": "Only required if a password is configured for the Shelly"
          }
        }
      ]
    },
    {
      "name": "p_shelly_cloud",
      "visibleIf": "{source} = 'shelly'",
      "title": {
        "de": "Shelly — Cloud-Zugriff",
        "default": "Shelly — Cloud Access"
      },
      "elements": [
        {
          "type": "text",
          "name": "shelly_device_id",
          "title": {
            "de": "Geräte-ID",
            "default": "Device ID"
          },
          "isRequired": true
        }
      ]
    },
    {
      "name": "p_mqtt",
      "visibleIf": "{source} = 'mqtt'",
      "title": {
        "de": "MQTT — Topic & Datentyp",
        "default": "MQTT — Topic & Data Type"
      },
      "elements": [
        {
          "type": "text",
          "name": "mqtt_topic",
          "title": {
            "de": "MQTT-Topic",
            "default": "MQTT topic"
          },
          "description": {
            "de": "Das Topic, auf dem der Messwert veröffentlicht wird",
            "default": "The topic where the measurement value is published"
          },
          "isRequired": true,
          "placeholder": {
            "de": "z.B. sensors/power",
            "default": "e.g. sensors/power"
          }
        },
        {
          "type": "dropdown",
          "name": "mqtt_payload_type",
          "title": {
            "de": "Datentyp",
            "default": "Data type"
          },
          "description": {
            "de": "Der Datentyp des empfangenen Messwerts",
            "default": "The data type of the received measurement value"
          },
          "isRequired": true,
          "defaultValue": "float",
          "choices": [
            {
              "value": "float",
              "text": {
                "de": "Gleitkommazahl (float)",
                "default": "Floating point (float)"
              }
            },
            {
              "value": "integer",
              "text": {
                "de": "Ganzzahl (integer)",
                "default": "Integer"
              }
            },
            {
              "value": "string",
              "text": {
                "de": "Zeichenkette (string)",
                "default": "String"
              }
            },
            {
              "value": "boolean",
              "text": {
                "de": "Wahrheitswert (boolean)",
                "default": "Boolean"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "p_mqtt_extraction",
      "visibleIf": "{source} = 'mqtt'",
      "title": {
        "de": "MQTT — Wertgewinnung",
        "default": "MQTT — Value Extraction"
      },
      "elements": [
        {
          "type": "radiogroup",
          "name": "mqtt_extraction_mode",
          "title": {
            "de": "Wie wird der Messwert aus der Nachricht gewonnen?",
            "default": "How is the value extracted from the message?"
          },
          "isRequired": true,
          "defaultValue": "plain",
          "choices": [
            {
              "value": "plain",
              "text": {
                "de": "Payload direkt übernehmen",
                "default": "Use payload directly"
              }
            },
            {
              "value": "json_key",
              "text": {
                "de": "Aus flachem JSON per Schlüssel",
                "default": "From flat JSON by key"
              }
            },
            {
              "value": "json_path",
              "text": {
                "de": "Aus verschachteltem JSON per JSONPath",
                "default": "From nested JSON by JSONPath"
              }
            },
            {
              "value": "json_formula",
              "text": {
                "de": "Formel über JSON-Werte",
                "default": "Formula on JSON values"
              }
            },
            {
              "value": "formula",
              "text": {
                "de": "Formel über Payload",
                "default": "Formula on payload"
              }
            }
          ]
        },
        {
          "type": "text",
          "name": "mqtt_json_key",
          "visibleIf": "{mqtt_extraction_mode} = 'json_key'",
          "isRequired": true,
          "title": {
            "de": "JSON-Schlüssel",
            "default": "JSON key"
          },
          "description": {
            "de": "Name des Felds im flachen JSON-Objekt",
            "default": "Name of the field in a flat JSON object"
          },
          "placeholder": {
            "de": "z.B. power oder DHW tank temp. (R5T)",
            "default": "e.g. power or DHW tank temp. (R5T)"
          }
        },
        {
          "type": "text",
          "name": "mqtt_json_path",
          "visibleIf": "{mqtt_extraction_mode} = 'json_path'",
          "isRequired": true,
          "title": {
            "de": "JSONPath-Ausdruck",
            "default": "JSONPath expression"
          },
          "description": {
            "de": "Beginnt mit $, zum Beispiel $.ccp[2] oder $.sensor.temp",
            "default": "Starts with $, e.g. $.ccp[2] or $.sensor.temp"
          },
          "placeholder": "$.ccp[2]"
        },
        {
          "type": "text",
          "name": "mqtt_json_formula",
          "visibleIf": "{mqtt_extraction_mode} = 'json_formula'",
          "isRequired": true,
          "title": {
            "de": "Formel mit JSON-Werten",
            "default": "Formula with JSON values"
          },
          "description": {
            "de": "JSON-Werte in geschweiften Klammern referenzieren, z.B. round({power} / 1000)",
            "default": "Reference JSON values in braces, e.g. round({power} / 1000)"
          },
          "placeholder": "round({power} / 1000)"
        },
        {
          "type": "text",
          "name": "mqtt_formula",
          "visibleIf": "{mqtt_extraction_mode} = 'formula'",
          "isRequired": true,
          "title": {
            "de": "Formel mit Payload",
            "default": "Formula with payload"
          },
          "description": {
            "de": "{value} steht für die komplette Payload, z.B. round({value} * 1000)",
            "default": "{value} represents the full payload, e.g. round({value} * 1000)"
          },
          "placeholder": "round({value} * 1000)"
        }
      ]
    },
    {
      "name": "p_mqtt_filter",
      "visibleIf": "{source} = 'mqtt' and ({mqtt_payload_type} = 'float' or {mqtt_payload_type} = 'integer')",
      "title": {
        "de": "MQTT — Filter (optional)",
        "default": "MQTT — Filters (optional)"
      },
      "elements": [
        {
          "type": "text",
          "inputType": "number",
          "name": "mqtt_min",
          "title": {
            "de": "Minimalwert",
            "default": "Minimum value"
          },
          "description": {
            "de": "Kleinere Werte werden verworfen (leer lassen für keine Grenze)",
            "default": "Values below are discarded (leave empty for no limit)"
          }
        },
        {
          "type": "text",
          "inputType": "number",
          "name": "mqtt_max",
          "title": {
            "de": "Maximalwert",
            "default": "Maximum value"
          },
          "description": {
            "de": "Größere Werte werden verworfen (leer lassen für keine Grenze)",
            "default": "Values above are discarded (leave empty for no limit)"
          }
        },
        {
          "type": "boolean",
          "name": "mqtt_null_to_zero",
          "title": {
            "de": "NULL als 0 speichern",
            "default": "Store NULL as 0"
          },
          "description": {
            "de": "Leere oder NULL-Werte werden als 0 in InfluxDB gespeichert",
            "default": "Empty or NULL values are stored as 0 in InfluxDB"
          },
          "defaultValue": false
        }
      ]
    },
    {
      "name": "p_mapping",
      "title": {
        "de": "InfluxDB-Zuordnung",
        "default": "InfluxDB Mapping"
      },
      "description": {
        "de": "⚠️ Measurement und Field sollten gut überlegt gewählt werden. Sie legen fest, wo die Daten in InfluxDB gespeichert werden. Eine nachträgliche Änderung ist kaum möglich, da bereits geschriebene Daten dauerhaft an diese Bezeichnungen gebunden sind.",
        "default": "⚠️ Choose measurement and field carefully. They determine where data is stored in InfluxDB. Changing these later is very difficult, as previously written data remains permanently tied to these names."
      },
      "elements": [
        {
          "type": "text",
          "name": "measurement",
          "title": {
            "de": "Measurement",
            "default": "Measurement"
          },
          "description": {
            "de": "Name des InfluxDB-Measurements, in das der Sensor schreibt",
            "default": "Name of the InfluxDB measurement the sensor writes to"
          },
          "isRequired": true
        },
        {
          "type": "text",
          "name": "field",
          "title": {
            "de": "Field",
            "default": "Field"
          },
          "description": {
            "de": "Name des InfluxDB-Fields innerhalb des Measurements",
            "default": "Name of the InfluxDB field within the measurement"
          },
          "isRequired": true
        }
      ]
    }
  ],
  "showQuestionNumbers": "off",
  "completeText": {
    "de": "Speichern",
    "default": "Save"
  },
  "pageNextText": {
    "de": "Weiter",
    "default": "Next"
  },
  "pagePrevText": {
    "de": "Zurück",
    "default": "Back"
  },
  "showCompletePage": false
}
