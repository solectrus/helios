{
  "permissions": {
    "allow": [
      "Bash(bats:*)",
      "Bash(bin/brakeman:*)",
      "Bash(bin/bundler-audit:*)",
      "Bash(bin/ci:*)",
      "Bash(bin/herb:*)",
      "Bash(bin/rails:*)",
      "Bash(bin/rake:*)",
      "Bash(bin/rspec:*)",
      "Bash(bin/rubocop:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(bundle install:*)",
      "Bash(bundle show:*)",
      "Bash(docker compose:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh search issues:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/track-changed-file.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-stop.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
