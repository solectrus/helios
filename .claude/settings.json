{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bin/brakeman:*)",
      "Bash(bin/bundler-audit:*)",
      "Bash(bin/ci:*)",
      "Bash(bin/coverage:*)",
      "Bash(bin/herb:*)",
      "Bash(bin/rails:*)",
      "Bash(bin/rake:*)",
      "Bash(bin/rspec:*)",
      "Bash(bin/rubocop:*)",
      "Bash(bin/turbo_tests:*)",
      "Bash(bun run erb:check:*)",
      "Bash(bun run erb:format:*)",
      "Bash(bun run format:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run test:*)",
      "Bash(bun run tsc:*)",
      "Bash(docker compose:*)"
    ],
    "ask": [
      "Bash(bin/dev:*)",
      "Bash(bin/rails db*)",
      "Bash(bin/rails runner:*)",
      "Bash(bin/rake db*)",
      "Bash(bin/setup:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose kill:*)",
      "Bash(docker compose rm:*)",
      "Bash(docker compose stop:*)"
    ]
  }
}
