{
  "name": "helios",
  "private": true,
  "scripts": {
    "erb:format": "herb-format",
    "erb:check": "herb-format --check",
    "lint": "eslint --cache .",
    "format": "prettier . --write --plugin=prettier-plugin-tailwindcss",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@rails/actioncable": "^8.1.200",
    "survey-core": "^2.5.14",
    "survey-js-ui": "^2.5.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@herb-tools/formatter": "^0.8.10",
    "@size-limit/file": "^12.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.3.5",
    "daisyui": "^5.5.19",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rollup": "^4.59.0",
    "size-limit": "^12.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-rails": "^0.5.0"
  },
  "dependenciesMeta": {
    "@tailwindcss/oxide": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "vite": {
      "built": true
    }
  },
  "size-limit": [
    {
      "limit": "360 kB",
      "path": "public/{vite,vite-dev,vite-test}/assets/*.js"
    }
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.13.0"
}
