{
  "name": "helios",
  "private": true,
  "scripts": {
    "erb:format": "herb-format",
    "erb:check": "herb-format --check .",
    "lint": "eslint --cache .",
    "format": "prettier . --write --plugin=prettier-plugin-tailwindcss",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@rails/actioncable": "^8.1.300",
    "highlight.js": "^11.11.1",
    "stimulus-vite-helpers": "^3.1.0",
    "survey-core": "^2.5.19",
    "survey-js-ui": "^2.5.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@herb-tools/formatter": "^0.9.5",
    "@herb-tools/linter": "^0.9.5",
    "@size-limit/file": "^12.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "daisyui": "^5.5.19",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "^20.8.9",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rails-vite-plugin": "^0.2.3",
    "size-limit": "^12.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.7",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.3"
  },
  "dependenciesMeta": {
    "@tailwindcss/oxide": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "vite": {
      "built": true
    }
  },
  "size-limit": [
    {
      "limit": "360 kB",
      "path": "public/vite/assets/*.js"
    }
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.13.0"
}
