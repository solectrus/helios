{
  "name": "helios",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "erb:format": "herb-format",
    "erb:check": "herb-format --check .",
    "lint": "eslint --cache .",
    "format": "prettier . --write --plugin=prettier-plugin-tailwindcss",
    "screenshots": "bun script/screenshots.mjs",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@rails/actioncable": "^8.1.301",
    "highlight.js": "^11.12.0",
    "stimulus-vite-helpers": "^3.1.0",
    "survey-core": "^3.1.0",
    "survey-js-ui": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@herb-tools/formatter": "^0.10.4",
    "@herb-tools/linter": "^0.10.4",
    "@size-limit/file": "^13.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.38",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rails-vite-plugin": "^0.2.5",
    "size-limit": "^13.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.1"
  },
  "resolutions": {
    "typescript": "^6"
  },
  "size-limit": [
    {
      "limit": "360 kB",
      "path": "public/vite/assets/*.js"
    }
  ],
  "engines": {
    "bun": ">=1.4"
  }
}
