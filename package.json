{
  "name": "helios",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "erb:format": "herb-format",
    "erb:check": "herb-format --check .",
    "lint": "eslint --cache .",
    "format": "prettier . --write --plugin=prettier-plugin-tailwindcss",
    "screenshots": "bun script/screenshots.mjs",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deps:check": "npm ls --all > /dev/null"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@rails/actioncable": "^8.1.401",
    "highlight.js": "^11.12.0",
    "stimulus-vite-helpers": "^3.1.0",
    "survey-core": "^3.2.4",
    "survey-js-ui": "^3.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@herb-tools/formatter": "^0.11.2",
    "@herb-tools/linter": "^0.11.2",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rails-vite-plugin": "^0.3.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-compression2": "^2.5.4",
    "vitest": "^5.1.0"
  },
  "resolutions": {
    "typescript": "^6"
  },
  "size-limit": [
    {
      "limit": "420 kB",
      "path": "public/vite/assets/*.js"
    }
  ],
  "engines": {
    "bun": ">=1.4"
  }
}
