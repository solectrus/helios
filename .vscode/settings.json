{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/tmp/**": true,
    "**/public/vite*": true
  },
  "search.exclude": {
    "**/tmp": true,
    "**/public/vite*": true,
    "**/node_modules": true
  },
  "eslint.validate": ["javascript"],
  // The SchemaStore maps "**/scenarios/*/*.yaml" to the CrowdSec scenario
  // schema, which every file under spec/scenarios then fails against. An
  // empty schema says nothing and keeps it out.
  "yaml.schemas": { "./.vscode/empty-schema.json": ["**/spec/scenarios/**"] },
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[dotenv]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[ignore]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
