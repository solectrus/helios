##################################################################
# Dashboard application (the main part)
#
# Domain name or IP address of your host
APP_HOST=localhost
#
TZ=Europe/Berlin
#
# SSL redirect: Use "true" if you want to auto-redirect to https, but ensure that you have a valid SSL certificate
# and a reverse proxy in front of the app!
# In all other cases, the option must be "false"!
FORCE_SSL=false
#
# Secret token to secure cookies, 128 chars long hexadecimal encoded string (don't use this example, make some random changes!)
# Currently there are no cookies in Soletrus, but this may change in the future
SECRET_KEY_BASE=c5a9c3e5d6a7b8c9d0e1f2a3b4c5d6e7f8g9h0i1j2k3l4m5n6o7p8q9r0s1t2u3v4w5x6y7z8a9b0c1d2e3f4g5h6
#
# Date of commissioning of your photovoltaic system
INSTALLATION_DATE=2022-01-01
#
# Password for the PostgreSQL database, used by the app to comunicate internally with the database
POSTGRES_PASSWORD=my-secret-db-password
#
# Password to login as administrator, required to manage settings like historical prices
ADMIN_PASSWORD=password
#
# Optional: Allow iframe embedding
#FRAME_ANCESTORS=https://test.de
#
# Start web server Puma in single mode (recommended to reduce memory usage)
WEB_CONCURRENCY=0
#

##################################################################
# Influx database settings
#
# Influx host (to access from SOLECTRUS dashboard and collectors)
INFLUX_HOST=influxdb
INFLUX_SCHEMA=http
INFLUX_PORT=8086
#
# Credentials for the Influx database, don't change after the first run!
INFLUX_ORG=solectrus
INFLUX_USERNAME=admin
INFLUX_PASSWORD=password
INFLUX_ADMIN_TOKEN=my-super-secret-admin-token
#
# Set these names before first run, they can't be changed later!
INFLUX_BUCKET=my-solectrus-bucket
INFLUX_MEASUREMENT_PV=SENEC
INFLUX_MEASUREMENT_FORECAST=Forecast
INFLUX_MEASUREMENT_TIBBER=my-tibber
INFLUX_MEASUREMENT_CAR=Car_Opel
INFLUX_MEASUREMENT_Garage=Garage
#
# To keep things simple, we use ONE token (INFLUX_ADMIN_TOKEN) for both writing and reading.
# For better security, you can use two separate tokens, created via the InfluxDB frontend.
INFLUX_TOKEN_WRITE=my-super-secret-admin-token
INFLUX_TOKEN_READ=my-super-secret-admin-token
#
# Volume path for storing the Influx data
INFLUX_VOLUME_PATH=./influxdb
#
# Interval in seconds for polling the InfluxDB
INFLUX_POLL_INTERVAL=5
#
#INFLUX measurements umsortieren
INFLUX_SENSOR_INVERTER_POWER=
INFLUX_SENSOR_INVERTER_POWER_FORECAST=Forecast:watt
INFLUX_SENSOR_GRID_IMPORT_POWER=SENEC:grid_power_plus
INFLUX_SENSOR_GRID_EXPORT_POWER=SENEC:grid_power_minus
INFLUX_SENSOR_HOUSE_POWER=SENEC:house_power
INFLUX_SENSOR_GRID_EXPORT_LIMIT=
INFLUX_SENSOR_WALLBOX_POWER=SENEC:wallbox_charge_power
INFLUX_SENSOR_HEATPUMP_POWER=
INFLUX_SENSOR_BATTERY_CHARGING_POWER=SENEC:bat_power_plus
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=SENEC:bat_power_minus
INFLUX_SENSOR_BATTERY_CHARGING_POWER=SENEC:bat_power_plus
INFLUX_SENSOR_BATTERY_SOC=SENEC:bat_fuel_charge
INFLUX_SENSOR_CASE_TEMP=SENEC:case_temp
INFLUX_SENSOR_SYSTEM_STATUS=SENEC:current_state
INFLUX_SENSOR_SYSTEM_STATUS_OK=SENEC:current_state_ok
INFLUX_SENSOR_CAR_BATTERY_SOC=Car_Opel:car_battery_soc
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=Car_Opel:plug_status
INFLUX_SENSOR_INVERTER_POWER_1=SENEC:inverter_power
INFLUX_SENSOR_INVERTER_POWER_2=Garage:inverter_power
#
##################################################################
#SENEC Wallbox & Erzeugung & Hausverbrauch ausschliessen
SENEC_IGNORE=wallbox_charge_power
#
##################################################################
# REDIS settings
#
REDIS_VOLUME_PATH=./redis

##################################################################
# PostgreSQL database settings
#
DB_VOLUME_PATH=./postgresql

##################################################################
# SENEC Collector
#
# Change this to your own SENEC IP address!
SENEC_HOST=192.168.1.100
SENEC_SCHEMA=https
SENEC_INTERVAL=5
SENEC_LANGUAGE=de

###################################################################
# Ingest
INGEST_VOLUME_PATH=./ingest

##################################################################
# MQTT Collector

# MQTT Broker credentials
MQTT_HOST=192.168.1.2
MQTT_PORT=1883
MQTT_SSL=false
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT topics
MAPPING_0_TOPIC=homeassistant/lp/1/W
MAPPING_0_MEASUREMENT=SENEC
MAPPING_0_FIELD=wallbox_charge_power
MAPPING_0_TYPE=integer

MAPPING_1_TOPIC=homeassistant/lp/1/%Soc
MAPPING_1_MEASUREMENT=Car_Opel
MAPPING_1_FIELD=car_battery_soc
MAPPING_1_TYPE=integer

# MAPPING_2_TOPIC=homeassistant/PV/HousePower
# MAPPING_2_MEASUREMENT=SENEC
# MAPPING_2_FIELD=house_power
# MAPPING_2_TYPE=integer

MAPPING_3_TOPIC=homeassistant/PV/GaragePower
MAPPING_3_MEASUREMENT=Garage
MAPPING_3_FIELD=inverter_power
MAPPING_3_TYPE=integer

MAPPING_4_TOPIC=homeassistant/lp/1/PlugStat
MAPPING_4_MEASUREMENT=Car_Opel
MAPPING_4_FIELD=plug_status
MAPPING_4_TYPE=integer

##################################################################
# Solar forecasting with https://forecast.solar
#
FORECAST_CONFIGURATIONS=2
# Latitude of the plant location
FORECAST_LATITUDE=51.12345
#
# Longitude of the plant location
FORECAST_LONGITUDE=12.12345
#
# Plane declination: 0 (horizontal) - 90 (vertical)
FORECAST_0_DECLINATION=30
FORECAST_1_DECLINATION=10
#
# Plane azimuth: -180 ... 180 (-180 = north, -90 = east, 0 = south, 90 = west, 180 = north)
FORECAST_0_AZIMUTH=-30
FORECAST_1_AZIMUTH=75
#
# Installed modules power in kilowatt peak (kWp)
FORECAST_0_KWP=9.9
FORECAST_1_KWP=1.5
#
# Update interval in seconds, 900s = 15 minutes, the public (and free) API allows a minimum of 900 seconds
# BEWARE: Each plane counts as one request, so if you have multiple planes, you need to multiply the interval!
FORECAST_INTERVAL=900
#
