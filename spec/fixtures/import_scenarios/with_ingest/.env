# ============================================================
# DO NOT EDIT THIS FILE.
#
# This file is generated by HELIOS. Any manual change WILL be
# overwritten — silently, without backup — the next time HELIOS
# applies a configuration. In the worst case your edit breaks
# the stack and HELIOS can no longer recover it.
#
# Change every setting through the HELIOS web interface.
#
# Missing a setting? HELIOS is actively developed and can be
# extended — suggest it at:
# https://github.com/solectrus/helios/issues
#
# HELIOS fits the vast majority of setups. For a very
# specialized configuration, managing compose.yaml + .env
# by hand instead remains a valid alternative.
# ============================================================

#
# +----------------------------------------------------------+
# |  General settings                                        |
# +----------------------------------------------------------+
#

# Timezone for all services (IANA format, e.g. Europe/Berlin)
TZ=Europe/Berlin

# Date of first solar installation (YYYY-MM-DD) — used for statistics and charts
INSTALLATION_DATE=2022-01-01

# Currency for monetary values in the dashboard (ISO 4217 code, e.g. EUR, CHF, USD)
CURRENCY=EUR

#
# +----------------------------------------------------------+
# |  Security                                                |
# +----------------------------------------------------------+
#

# Admin password — shared by Dashboard and HELIOS
ADMIN_PASSWORD=password

# Secret key for Rails sessions — shared by Dashboard and HELIOS
SECRET_KEY_BASE=c5a9c3e5d6a7b8c9d0e1f2a3b4c5d6e7f8g9h0i1j2k3l4m5n6o7p8q9r0s1t2u3v4w5x6y7z8a9b0c1d2e3f4g5h6

#
# +----------------------------------------------------------+
# |  Dashboard                                               |
# +----------------------------------------------------------+
#

# Hostname for the SOLECTRUS web interface
APP_HOST=localhost

# Must be TRUE only when a reverse proxy terminates TLS in front of the dashboard
FORCE_SSL=false

# Number of Puma worker processes (0 = single-process mode, sufficient for most setups)
WEB_CONCURRENCY=0

#
# +----------------------------------------------------------+
# |  PostgreSQL database                                     |
# +----------------------------------------------------------+
#

# Database password — auto-generated, do not change after first start
POSTGRES_PASSWORD=my-secret-db-password

# Volume path for storing the PostgreSQL data
DB_VOLUME_PATH=./postgresql

#
# +----------------------------------------------------------+
# |  InfluxDB time-series database                           |
# +----------------------------------------------------------+
#

# Admin password — auto-generated, do not change after first start
INFLUX_PASSWORD=password

# Organization name
INFLUX_ORG=solectrus

# Bucket (database) name for time-series data
INFLUX_BUCKET=my-solectrus-bucket

# Admin token — used by InfluxDB init and backup
INFLUX_ADMIN_TOKEN=my-super-secret-admin-token

# Read+write token — used by power-splitter
INFLUX_TOKEN_READWRITE=my-super-secret-admin-token

# Write token — used by all collectors
INFLUX_TOKEN_WRITE=my-super-secret-admin-token

# Read token — used by the dashboard
INFLUX_TOKEN_READ=my-super-secret-admin-token

# Volume path for storing the InfluxDB data
INFLUX_VOLUME_PATH=./influxdb

#
# +----------------------------------------------------------+
# |  Redis cache                                             |
# +----------------------------------------------------------+
#

# Volume path for storing the Redis data
REDIS_VOLUME_PATH=./redis

#
# +----------------------------------------------------------+
# |  Power Splitter                                          |
# +----------------------------------------------------------+
#

# Recalculation interval in seconds
POWER_SPLITTER_INTERVAL=300

#
# +----------------------------------------------------------+
# |  SENEC collector                                         |
# +----------------------------------------------------------+
#

# SENEC adapter type (local or cloud)
SENEC_ADAPTER=local

# SENEC device IP or hostname
SENEC_HOST=192.168.1.100

# Connection protocol
SENEC_SCHEMA=https

# Status text language
SENEC_LANGUAGE=de

# Polling interval in seconds
SENEC_INTERVAL=5

# Fields excluded from InfluxDB because another source feeds them (auto-derived)
SENEC_IGNORE=wallbox_charge_power

# InfluxDB measurement name for SENEC
INFLUX_MEASUREMENT_SENEC=SENEC

#
# +----------------------------------------------------------+
# |  Forecast                                                |
# +----------------------------------------------------------+
#

# Forecast provider
FORECAST_PROVIDER=forecast.solar

# Solar panel latitude
FORECAST_LATITUDE=51.12345

# Solar panel longitude
FORECAST_LONGITUDE=12.12345

# Forecast update interval in seconds
FORECAST_INTERVAL=900

# Number of roof surfaces
FORECAST_CONFIGURATIONS=2

# Roof surface 1 tilt angle
FORECAST_0_DECLINATION=30

# Roof surface 1 orientation (-180=N, -90=E, 0=S, 90=W, 180=N)
FORECAST_0_AZIMUTH=-30

# Roof surface 1 capacity in kWp
FORECAST_0_KWP=9.9

# Roof surface 2 tilt angle
FORECAST_1_DECLINATION=10

# Roof surface 2 orientation (-180=N, -90=E, 0=S, 90=W, 180=N)
FORECAST_1_AZIMUTH=75

# Roof surface 2 capacity in kWp
FORECAST_1_KWP=1.5

# InfluxDB measurement name for forecasts
INFLUX_MEASUREMENT_FORECAST=Forecast

#
# +----------------------------------------------------------+
# |  MQTT broker                                             |
# +----------------------------------------------------------+
#

# MQTT broker hostname
MQTT_HOST=192.168.1.2

# MQTT broker port
MQTT_PORT=1883

# Enable SSL for MQTT connection
MQTT_SSL=false

# --- Mapping 0 for CAR_BATTERY_SOC

MAPPING_0_TOPIC=homeassistant/lp/1/%Soc
MAPPING_0_MEASUREMENT=Car_Opel
MAPPING_0_FIELD=car_battery_soc
MAPPING_0_TYPE=integer

# --- Mapping 1 for INVERTER_POWER_2

MAPPING_1_TOPIC=homeassistant/PV/GaragePower
MAPPING_1_MEASUREMENT=Garage
MAPPING_1_FIELD=inverter_power
MAPPING_1_TYPE=integer

# --- Mapping 2 for WALLBOX_CAR_CONNECTED

MAPPING_2_TOPIC=homeassistant/lp/1/PlugStat
MAPPING_2_MEASUREMENT=Car_Opel
MAPPING_2_FIELD=plug_status
MAPPING_2_TYPE=integer

# --- Mapping 3 for WALLBOX_POWER

MAPPING_3_TOPIC=homeassistant/lp/1/W
MAPPING_3_MEASUREMENT=SENEC
MAPPING_3_FIELD=wallbox_charge_power
MAPPING_3_TYPE=integer

#
# +--------------------------------------------------------------+
# |  Ingest (recalculates house_power for balcony power plants)  |
# +--------------------------------------------------------------+
#

# Hours of measurement data Ingest buffers in its SQLite store
RETENTION_HOURS=12

# Volume path for storing the Ingest data
INGEST_VOLUME_PATH=./ingest

#
# +----------------------------------------------------------+
# |  Watchtower (automatic Docker image updates)             |
# +----------------------------------------------------------+
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

# Time a container gets to stop before it is killed (Watchtower ignores stop_grace_period)
WATCHTOWER_TIMEOUT=60s

#
# +----------------------------------------------------------+
# |  Sensor mappings                                         |
# +----------------------------------------------------------+
#

# Sensor: inverter_power_1
INFLUX_SENSOR_INVERTER_POWER_1=SENEC:inverter_power

# Sensor: inverter_power_2
INFLUX_SENSOR_INVERTER_POWER_2=Garage:inverter_power

# Sensor: grid_import_power
INFLUX_SENSOR_GRID_IMPORT_POWER=SENEC:grid_power_plus

# Sensor: grid_export_power
INFLUX_SENSOR_GRID_EXPORT_POWER=SENEC:grid_power_minus

# Sensor: house_power
INFLUX_SENSOR_HOUSE_POWER=SENEC:house_power

# Sensor: battery_charging_power
INFLUX_SENSOR_BATTERY_CHARGING_POWER=SENEC:bat_power_plus

# Sensor: battery_discharging_power
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=SENEC:bat_power_minus

# Sensor: battery_soc
INFLUX_SENSOR_BATTERY_SOC=SENEC:bat_fuel_charge

# Sensor: wallbox_power
INFLUX_SENSOR_WALLBOX_POWER=SENEC:wallbox_charge_power

# Sensor: wallbox_car_connected
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=Car_Opel:plug_status

# Sensor: car_battery_soc
INFLUX_SENSOR_CAR_BATTERY_SOC=Car_Opel:car_battery_soc

# Sensor: case_temp
INFLUX_SENSOR_CASE_TEMP=SENEC:case_temp

# Sensor: system_status
INFLUX_SENSOR_SYSTEM_STATUS=SENEC:current_state

# Sensor: system_status_ok
INFLUX_SENSOR_SYSTEM_STATUS_OK=SENEC:current_state_ok

# Sensor: inverter_power_forecast
INFLUX_SENSOR_INVERTER_POWER_FORECAST=Forecast:watt

