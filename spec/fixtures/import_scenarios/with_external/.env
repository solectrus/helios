# ============================================================
# DO NOT EDIT THIS FILE.
#
# This file is generated by HELIOS. Any manual change WILL be
# overwritten — silently, without backup — the next time HELIOS
# applies a configuration. In the worst case your edit breaks
# the stack and HELIOS can no longer recover it.
#
# Change every setting through the HELIOS web interface.
#
# Need something HELIOS does not expose? Then HELIOS is no longer
# the right tool for your stack: uninstall HELIOS and manage
# compose.yaml + .env by hand.
# ============================================================

#
# ┌──────────────────────────────────────────────────────────┐
# │  General settings                                        │
# └──────────────────────────────────────────────────────────┘
#

# Timezone for all services (IANA format, e.g. Europe/Berlin)
TZ=Europe/Berlin

# Date of first solar installation (YYYY-MM-DD) — used for statistics and charts
INSTALLATION_DATE=2025-01-01

#
# ┌──────────────────────────────────────────────────────────┐
# │  Security                                                │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — shared by Dashboard and HELIOS
ADMIN_PASSWORD=example-admin-password

# Secret key for Rails sessions — shared by Dashboard and HELIOS
SECRET_KEY_BASE=example-secret-key-base

#
# ┌──────────────────────────────────────────────────────────┐
# │  Dashboard                                               │
# └──────────────────────────────────────────────────────────┘
#

# Hostname for the SOLECTRUS web interface
APP_HOST=192.168.1.100

# Sensors excluded from house power calculation
INFLUX_EXCLUDE_FROM_HOUSE_POWER=HEATPUMP_POWER

#
# ┌──────────────────────────────────────────────────────────┐
# │  PostgreSQL database                                     │
# └──────────────────────────────────────────────────────────┘
#

# Database password — auto-generated, do not change after first start
POSTGRES_PASSWORD=example-postgres-password

# Volume path for storing the PostgreSQL data
DB_VOLUME_PATH=/opt/solectrus/postgresql

#
# ┌──────────────────────────────────────────────────────────┐
# │  InfluxDB time-series database                           │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — auto-generated, do not change after first start
INFLUX_PASSWORD=example-influx-password

# Organization name
INFLUX_ORG=solectrus

# Bucket (database) name for time-series data
INFLUX_BUCKET=solectrus

# API token with full access — auto-generated, do not change after first start
INFLUX_TOKEN=example-influx-admin-token

# Volume path for storing the InfluxDB data
INFLUX_VOLUME_PATH=/opt/solectrus/influxdb

#
# ┌──────────────────────────────────────────────────────────┐
# │  Redis cache                                             │
# └──────────────────────────────────────────────────────────┘
#

# Volume path for storing the Redis data
REDIS_VOLUME_PATH=/opt/solectrus/redis

#
# ┌──────────────────────────────────────────────────────────┐
# │  Watchtower (automatic Docker image updates)             │
# └──────────────────────────────────────────────────────────┘
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

#
# ┌──────────────────────────────────────────────────────────┐
# │  Sensor mappings                                         │
# └──────────────────────────────────────────────────────────┘
#

# Sensor: inverter_power
INFLUX_SENSOR_INVERTER_POWER=inverter:power

# Sensor: inverter_power_1
INFLUX_SENSOR_INVERTER_POWER_1=inverter_1:power

# Sensor: inverter_power_2
INFLUX_SENSOR_INVERTER_POWER_2=inverter_2:power

# Sensor: inverter_power_3
INFLUX_SENSOR_INVERTER_POWER_3=inverter_3:power

# Sensor: grid_import_power
INFLUX_SENSOR_GRID_IMPORT_POWER=grid:import_power

# Sensor: grid_export_power
INFLUX_SENSOR_GRID_EXPORT_POWER=grid:export_power

# Sensor: grid_export_limit
INFLUX_SENSOR_GRID_EXPORT_LIMIT=grid:export_limit

# Sensor: house_power
INFLUX_SENSOR_HOUSE_POWER=house:power

# Sensor: battery_charging_power
INFLUX_SENSOR_BATTERY_CHARGING_POWER=battery:charging_power

# Sensor: battery_discharging_power
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=battery:discharging_power

# Sensor: battery_soc
INFLUX_SENSOR_BATTERY_SOC=battery:soc

# Sensor: wallbox_power
INFLUX_SENSOR_WALLBOX_POWER=wallbox:power

# Sensor: wallbox_car_connected
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=wallbox:connected

# Sensor: car_battery_soc
INFLUX_SENSOR_CAR_BATTERY_SOC=car:battery_soc

# Sensor: heatpump_power
INFLUX_SENSOR_HEATPUMP_POWER=heatpump:power

# Sensor: heatpump_heating_power
INFLUX_SENSOR_HEATPUMP_HEATING_POWER=heatpump:heating_power

# Sensor: heatpump_tank_temp
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=heatpump:tank_temp

# Sensor: heatpump_status
INFLUX_SENSOR_HEATPUMP_STATUS=heatpump:status

# Sensor: case_temp
INFLUX_SENSOR_CASE_TEMP=case:temperature

# Sensor: outdoor_temp
INFLUX_SENSOR_OUTDOOR_TEMP=outdoor:temperature

# Sensor: system_status
INFLUX_SENSOR_SYSTEM_STATUS=system:status

# Sensor: system_status_ok
INFLUX_SENSOR_SYSTEM_STATUS_OK=system:status_ok

# Sensor: inverter_power_forecast
INFLUX_SENSOR_INVERTER_POWER_FORECAST=inverter_forecast:power

# Sensor: inverter_power_forecast_clearsky
INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY=inverter_forecast_clearsky:power

# Sensor: outdoor_temp_forecast
INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST=outdoor_forecast:temperature

# Sensor: custom_power_01
INFLUX_SENSOR_CUSTOM_POWER_01=custom_01:power

# Sensor: custom_power_02
INFLUX_SENSOR_CUSTOM_POWER_02=custom_02:power

# Sensor: custom_power_03
INFLUX_SENSOR_CUSTOM_POWER_03=custom_03:power

# Sensor: custom_power_04
INFLUX_SENSOR_CUSTOM_POWER_04=custom_04:power

