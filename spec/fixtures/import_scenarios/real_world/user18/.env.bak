##################################################################
# Dashboard application (the main part)
#
# Domain name or IP address of your host
APP_HOST=localhost
#
# SSL redirect: Use "true" (which is the default) if you want to auto-redirect to https
FORCE_SSL=false
SENEC_SCHEMA=https
#
# Secret token to secure cookies, 128 chars long hexadecimal encoded string (don't use this example, make some random changes!)
# Currently there are no cookies in Soletrus, but this may change in the future
SECRET_KEY_BASE=my-secret-key-base
#
# Date of commissioning of your photovoltaic system
INSTALLATION_DATE=2022-01-01
#
# Price you pay for 1kWH (in EUR)
# Can be changed later in the UI when logged in as administrator
ELECTRICITY_PRICE=0.40
#
# Price you get for 1kWH (in EUR)
# Can be changed later in the UI when logged in as administrator
FEED_IN_TARIFF=0.078
#
# Password for the PostgreSQL database, used by the app to comunicate internally with the database
POSTGRES_PASSWORD=my-super-secret-password
#
# Password to login as administrator, required to manage settings like historical prices
ADMIN_PASSWORD=my-admin-password
#
# Shelly Config
SHELLY_HOST_TV=192.168.3.89
SHELLY_HOST_GSA=192.168.3.90
SHELLY_HOST_OVEN=192.168.3.91
SHELLY_HOST_MW=192.168.3.92
SHELLY_HOST_DRYER=192.168.3.93
SHELLY_HOST_WA=192.168.3.94
SHELLY_HOST_DRYER2=192.168.3.95
SHELLY_HOST_WA2=192.168.3.96
SHELLY_HOST_OVEN2=192.168.3.97
SHELLY_INTERVAL=5
SHELLY_GEN_TV=2
SHELLY_GEN_OVEN=2
SHELLY_GEN_OVEN2=2
SHELLY_GEN_WA=2
SHELLY_GEN_WA2=2
SHELLY_GEN_DRYER=2
SHELLY_GEN_DRYER2=2
SHELLY_GEN_MW=2
SHELLY_GEN_GSA=2

##################################################################
# Influx database settings
#
# Influx host (to access from SOLECTRUS dashboard and collectors)
INFLUX_HOST=influxdb
INFLUX_SCHEMA=http
INFLUX_PORT=8086
#
# Credentials for the Influx database
INFLUX_MEASUREMENT_SHELLY_TV=tv
INFLUX_MEASUREMENT_SHELLY_GSA=gsa
INFLUX_ORG=solectrus
INFLUX_USERNAME=admin
INFLUX_PASSWORD=my-influx-password
INFLUX_ADMIN_TOKEN=my-super-secret-admin-token
INFLUX_BUCKET=my-solectrus-bucket
INFLUX_MEASUREMENT_PV=SENEC
INFLUX_MEASUREMENT_PRICES = Tibber
INFLUX_MEASUREMENT_FORECAST=Forecast
INFLUX_SENSOR_CUSTOM_POWER_01=TV:power
INFLUX_SENSOR_CUSTOM_POWER_02=OVEN:power
INFLUX_SENSOR_CUSTOM_POWER_03=OVEN2:power
INFLUX_SENSOR_CUSTOM_POWER_04=WA:power
INFLUX_SENSOR_CUSTOM_POWER_05=WA2:power
INFLUX_SENSOR_CUSTOM_POWER_06=DRYER:power
INFLUX_SENSOR_CUSTOM_POWER_07=DRYER2:power
INFLUX_SENSOR_CUSTOM_POWER_08=MW:power
INFLUX_SENSOR_CUSTOM_POWER_09=GSA:power
INFLUX_EXCLUDE_FROM_HOUSE_POWER=OVEN_POWER,CUSTOM_POWER_02,OVEN2_POWER,CUSTOM_POWER_03

# To keep things simple, we use ONE token (INFLUX_ADMIN_TOKEN) for both writing and reading.

# For better security, it is recommended NOT to use the admin token here. Instead,
# create two separate tokens for writing and reading (via the InfluxDB frontend).
INFLUX_TOKEN_WRITE=my-super-secret-admin-token
INFLUX_TOKEN_READ=my-super-secret-admin-token
#
# Volume path for storing the Influx data
INFLUX_VOLUME_PATH=./influxdb
#
#
##################################################################
# REDIS settings
#
REDIS_VOLUME_PATH=./redis
#
#
##################################################################
# PostgreSQL database settings
#
DB_VOLUME_PATH=./postgresql
#
#
##################################################################
# SENEC Collector
#
# Change this to your own SENEC IP address!
SENEC_HOST=192.168.3.100
SENEC_INTERVAL=5
#
##################################################################
# Solar forecasting with https://forecast.solar
# API docs: https://doc.forecast.solar/doku.php?id=api:estimate
#
# Latitude of the plant location
FORECAST_LATITUDE=0.00000
#
# Longitude of the plant location
FORECAST_LONGITUDE=0.00000
#
# Plane declination: 0 (horizontal) - 90 (vertical)
FORECAST_DECLINATION=20
#
# Plane azimuth: -180 ... 180 (-180 = north, -90 = east, 0 = south, 90 = west, 180 = north)
FORECAST_AZIMUTH=-45
#
# Installed modules power in kilowatt peak (kWp)
FORECAST_KWP=10.0
#
# Update interval in seconds, 900s = 15 minutes, the public (and free) API allows a minimum of 900 seconds
FORECAST_INTERVAL=900
FORECAST_SOLAR_APIKEY=my-forecast-solar-api-key
#
# Interval in seconds to check for charging
CHARGER_INTERVAL = 900
#
# Länge des betrachteten Zeitfensters für die Preise in Stunden - Standard ist 4, d.h. es werden die Preise der nächsten 4 Stunden betrachtet
CHARGER_PRICE_TIME_RANGE = 4
#
# Wert in Prozent, = Geladen wird, wenn der Durchschnittspreis (in Cent) der nächsten 3 Stunden nur 70 % (oder weniger) des Durchschnittspreises in den nächsten 24 Stunden beträgt (und Akku leer und keine Sonne in Sicht).
CHARGER_PRICE_MAX = 85
#
# Höchster PV-Ertrag (in kWh) in den nächsten 24h, bei denen noch eine Netzladung erfolgt.
CHARGER_FORECAST_THRESHOLD = 10
#
# Bei "true" läuft der Container als "Trockenübung", d.h. es wird keine Ladung oder Entladung durchgeführt. Es wird nur das Log ausgegeben.
CHARGER_DRY_RUN = false
#
#
# Tibber settings
TIBBER_TOKEN = my-tibber-token
TIBBER_INTERVAL = 3600
TZ = Europe/Berlin
