##################################################################
# Dashboard application (the main part)
#
# Domain name or IP address of your host
APP_HOST=192.168.0.123
#
# SSL redirect: Use "true" if you want to auto-redirect to https, but ensure that you have a valid SSL certificate
# and a reverse proxy in front of the app!
# In all other cases, the option must be "false"!
FORCE_SSL=false
TZ=Europe/Berlin
# Secret token to secure cookies, 128 chars long hexadecimal encoded string (don't use this example, make some random changes!)
# Currently there are no cookies in Soletrus, but this may change in the future
SECRET_KEY_BASE=AAAAA
#
# Date of commissioning of your photovoltaic system
INSTALLATION_DATE=2022-01-01
#
# Password for the PostgreSQL database, used by the app to comunicate internally with the database
# Caution: Do not change this after the first run, otherwise the app will no longer be able to connect to the database!
POSTGRES_PASSWORD=BBBBB
#
# Password to login as administrator, required to manage settings like historical prices
ADMIN_PASSWORD=CCCCC
#
# Optional: Allow iframe embedding
# FRAME_ANCESTORS=https://my-other-home-automation-software.com
#
# Start web server Puma in single mode (recommended to reduce memory usage)
WEB_CONCURRENCY=0
#
FRAME_ANCESTORS=http://192.168.0.124:8081
##################################################################
# Influx database settings
#
# Influx host (to access from SOLECTRUS dashboard and collectors)
INFLUX_HOST=influxdb
INFLUX_SCHEMA=http
INFLUX_PORT=8086
#
# Credentials for the Influx database, don't change after the first run!
INFLUX_ORG=DDDDD
INFLUX_USERNAME=admin
INFLUX_PASSWORD=EEEEE
INFLUX_ADMIN_TOKEN=FFFFF
#
# Set these names before first run, they can't be changed later!
INFLUX_BUCKET=DDDDD
INFLUX_MEASUREMENT_PV=my-pv-measurement
INFLUX_MEASUREMENT_FORECAST=forecast
INFLUX_SENSOR_WALLBOX_POWER=my-pv-measurement:wallbox_charge_power
INFLUX_SENSOR_GRID_IMPORT_POWER=my-pv-measurement:grid_power_plus
INFLUX_SENSOR_GRID_EXPORT_POWER=my-pv-measurement:grid_power_minus
INFLUX_SENSOR_HOUSE_POWER=my-pv-measurement:house_power
INFLUX_SENSOR_CAR_BATTERY_SOC=Batmobile:SOC
INFLUX_SENSOR_BATTERY_SOC=my-pv-measurement:bat_fuel_charge
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=my_wallbox:ev_connected
INFLUX_SENSOR_INVERTER_POWER_FORECAST=forecast:watt
INFLUX_SENSOR_BATTERY_CHARGING_POWER=my-pv-measurement:bat_power_plus
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=my-pv-measurement:bat_power_minus
INFLUX_SENSOR_CUSTOM_POWER_01=Fridge:power
INFLUX_SENSOR_CUSTOM_POWER_02=Washer:power
INFLUX_SENSOR_CUSTOM_POWER_03=Dishwasher:power
INFLUX_SENSOR_CUSTOM_POWER_04=Bosch:power
INFLUX_SENSOR_CUSTOM_POWER_05=Foo:power
INFLUX_SENSOR_CUSTOM_POWER_06=Bunker:power
INFLUX_SENSOR_CUSTOM_POWER_07=ArcadeBox:power
INFLUX_SENSOR_CUSTOM_POWER_10=Drucker:power
INFLUX_SENSOR_CUSTOM_POWER_11=SockEater:power
INFLUX_SENSOR_CUSTOM_POWER_12=JungleSprinkler:power
INFLUX_SENSOR_CUSTOM_POWER_09=PC3:power
INFLUX_SENSOR_CUSTOM_POWER_08=ToastMaster:power
INFLUX_SENSOR_INVERTER_POWER=my-pv-measurement:inverter_power
INFLUX_SENSOR_INVERTER_POWER_1=my_pv_measurement:pvneben
INFLUX_SENSOR_INVERTER_POWER_2=my_pv_measurement:pvhaupt
INFLUX_SENSOR_INVERTER_POWER_3=my_pv_measurement:pvgarten
INFLUX_SENSOR_INVERTER_POWER_4=my_pv_measurement:kostal
INFLUX_SENSOR_INVERTER_POWER_5=
#INFLUX_SENSOR_BALCONY_INVERTER_POWER=balcony:inverter_power
INFLUX_SENSOR_HEATPUMP_POWER=heatpump:power
INFLUX_SENSOR_HEATPUMP_HEATING_POWER=heatpump:waerme
INFLUX_SENSOR_HEATPUMP_STATUS=heatpump:statusWP
#INFLUX_SENSOR_HEATPUMP_TANK_TEMP=heatpump:tank_temp
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=heatpump:tank_temp_float
INFLUX_SENSOR_HEATPUMP_TANK_TEMP_SETPOINT=heatpump:tank_temp_setpoint
#INFLUX_SENSOR_OUTDOOR_TEMP=heatpump:outdoor_temp
INFLUX_SENSOR_OUTDOOR_TEMP=heatpump:outdoor_temp_float2
INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST=forecast:temp
INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY=forecast:watt_clearsky
#INFLUX_EXCLUDE_FROM_HOUSE_POWER=HEATPUMP_POWER
#
# To keep things simple, we use ONE token (INFLUX_ADMIN_TOKEN) for both writing and reading.
# For better security, you can use two separate tokens, created via the InfluxDB frontend.
INFLUX_TOKEN_WRITE=FFFFF
INFLUX_TOKEN_READ=FFFFF
#
# Volume path for storing the Influx data
INFLUX_VOLUME_PATH=/home/pi/solectrus/influxdb
#
# Interval in seconds for polling the InfluxDB
INFLUX_POLL_INTERVAL=5
POWER_SPLITTER_INTERVAL=300
#SHELLY_HOST=192.168.0.125
#SHELLY_INTERVAL=5
##################################################################
# REDIS settings
#
REDIS_VOLUME_PATH=/home/pi/solectrus/redis

##################################################################
# PostgreSQL database settings
#
DB_VOLUME_PATH=/home/pi/solectrus/postgresql

