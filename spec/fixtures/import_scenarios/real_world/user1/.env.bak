##################################################################
# Solar forecasting with https://forecast.solar
# API docs: https://doc.forecast.solar/doku.php?id=api:estimate
#
# Latitude of the plant location
#FORECAST_LATITUDE=51.798715
FORECAST_LATITUDE=50.0
# Longitude of the plant location
FORECAST_LONGITUDE=10.0
FORECAST_CONFIGURATIONS=3
FORECAST_0_AZIMUTH=230
FORECAST_0_DECLINATION=8
FORECAST_0_KWP=5.2
FORECAST_1_AZIMUTH=220
FORECAST_1_DECLINATION=8
FORECAST_1_KWP=9.72
FORECAST_2_AZIMUTH=300
FORECAST_2_DECLINATION=8
FORECAST_2_KWP=1.85
# Plane declination: 0 (horizontal) - 90 (vertical)
#
# Plane azimuth: -180 ... 180 (-180 = north, -90 = east, 0 = south, 90 = west, 180 = north)
#
# Installed modules power in kilowatt peak (kWp)
#
# Optional damping factors (http://doc.forecast.solar/damping)
# FORECAST_DAMPING_MORNING=0.5
# FORECAST_DAMPING_EVENING=0
#
# Optional configuration for multiple planes
#
# Number of planes
# FORECAST_CONFIGURATIONS=2
#
# Starting from 0, add params different from the values defined above
# FORECAST_0_AZIMUTH=90
# FORECAST_0_KWP=5.32
# FORECAST_1_AZIMUTH=-90
# FORECAST_1_KWP=7.84
#
# Available params are:
# - FORECAST_x_LATITUDE
# - FORECAST_x_LONGITUDE
# - FORECAST_x_DECLINATION
# - FORECAST_x_AZIMUTH
# - FORECAST_x_KWP
# - FORECAST_x_DAMPING_MORNING
# - FORECAST_x_DAMPING_EVENING
#
# Update interval in seconds, 900s = 15 minutes, the public (and free) API allows a minimum of 900 seconds
# BEWARE: Each plane counts as one request, so if you have multiple planes, you need to multiply the interval!
#FORECAST_INTERVAL=3600
#
# Optional API key for registered users of forecast.solar (https://doc.forecast.solar/account_models)
# FORECAST_SOLAR_APIKEY=abc123
FORECAST_PROVIDER=pvnode

# Number of planes (if you have more than one). Default is 1. Forecast.solar allows up to 4 planes, Solcast up to 2.
#FORECAST_CONFIGURATIONS=2

# Update interval in seconds
FORECAST_INTERVAL=17280

# Measurement name for InfluxDB
FORECAST_INFLUX_MEASUREMENT=forecast

### Details for forecast.solar
# API docs: https://doc.forecast.solar/doku.php?id=api:estimate

# Latitude of the plant location
# FORECAST_LATITUDE=50.12345

# Longitude of the plant location
# FORECAST_LONGITUDE=6.12345

# Plane declination: 0 (horizontal) - 90 (vertical)
# FORECAST_DECLINATION=30

# Plane azimuth: -180 ... 180 (-180 = north, -90 = east, 0 = south, 90 = west, 180 = north)
# FORECAST_AZIMUTH=20

# Installed modules power in kilowatt peak (kWp)
# FORECAST_KWP=8.4

# Optional damping factors (http://doc.forecast.solar/damping)
# FORECAST_DAMPING_MORNING=0.5
# FORECAST_DAMPING_EVENING=0
#
# Optional configuration for multiple planes
#
# Starting from 0, add params different from the values defined above
# FORECAST_0_DECLINATION=35
# FORECAST_0_AZIMUTH=-180
# FORECAST_0_KWP=5.32
#
# FORECAST_1_DECLINATION=38
# FORECAST_1_AZIMUTH=-90
# FORECAST_1_KWP=5.32
#
# FORECAST_2_DECLINATION=50
# FORECAST_2_AZIMUTH=0
# FORECAST_2_KWP=7.84
#
# FORECAST_3_DECLINATION=50
# FORECAST_3_AZIMUTH=90
# FORECAST_3_KWP=2.58
#
# Available params are:
# - FORECAST_x_LATITUDE
# - FORECAST_x_LONGITUDE
# - FORECAST_x_DECLINATION
# - FORECAST_x_AZIMUTH
# - FORECAST_x_KWP
# - FORECAST_x_DAMPING_MORNING
# - FORECAST_x_DAMPING_EVENING


PVNODE_APIKEY=IIIII
PVNODE_PAID=true

# Additional query parameters to append to the API request (per-plane configuration)
# Format: key1=value1&key2=value2 (without leading ? or &)
# https://www.pvnode.com/docs/yield#optional-parameters
#
# Example parameters:
#   diffuse_radiation_model=perez
#   snow_slide_coefficient=0.5 (0.0-0.8, controls snow sliding speed)
#
# Single plane:
# PVNODE_EXTRA_PARAMS=diffuse_radiation_model=perez&snow_slide_coefficient=0.5
#
# Multiple planes (use PVNODE_x_EXTRA_PARAMS for specific planes):
PVNODE_0_EXTRA_PARAMS=diffuse_radiation_model=perez&snow_slide_coefficient=0.3
PVNODE_1_EXTRA_PARAMS=diffuse_radiation_model=perez&snow_slide_coefficient=0.3
PVNODE_2_EXTRA_PARAMS=diffuse_radiation_model=perez&snow_slide_coefficient=0.3
# Optional API key for registered users of forecast.solar (https://doc.forecast.solar/account_models)
# FORECAST_SOLAR_APIKEY=abc123

### Details for solcast.com

#SOLCAST_APIKEY=dummy_solcast_apikey
#SOLCAST_SITE=1111-2222-3333-4444

#SOLCAST_0_SITE=4123-4567-abcd-ef12
#SOLCAST_1_SITE=1111-2222-3333-4444
