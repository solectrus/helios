# ============================================================
# DO NOT EDIT THIS FILE.
#
# This file is generated by HELIOS. Any manual change WILL be
# overwritten — silently, without backup — the next time HELIOS
# applies a configuration. In the worst case your edit breaks
# the stack and HELIOS can no longer recover it.
#
# Change every setting through the HELIOS web interface.
#
# Missing a setting? HELIOS is actively developed and can be
# extended — suggest it at:
# https://github.com/solectrus/helios/issues
#
# HELIOS fits the vast majority of setups. For a very
# specialized configuration, managing compose.yaml + .env
# by hand instead remains a valid alternative.
# ============================================================

#
# ┌──────────────────────────────────────────────────────────┐
# │  General settings                                        │
# └──────────────────────────────────────────────────────────┘
#

# Timezone for all services (IANA format, e.g. Europe/Berlin)
TZ=Europe/Berlin

# Date of first solar installation (YYYY-MM-DD) — used for statistics and charts
INSTALLATION_DATE=2024-02-03

#
# ┌──────────────────────────────────────────────────────────┐
# │  Security                                                │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — shared by Dashboard and HELIOS
ADMIN_PASSWORD=AAAAA

# Secret key for Rails sessions — shared by Dashboard and HELIOS
SECRET_KEY_BASE=BBBBB

#
# ┌──────────────────────────────────────────────────────────┐
# │  Dashboard                                               │
# └──────────────────────────────────────────────────────────┘
#

# Hostname for the SOLECTRUS web interface
APP_HOST=192.168.178.225

# Must be FALSE, unless Traefik terminates TLS in front of the dashboard
FORCE_SSL=false

# Number of Puma worker processes (0 = single-process mode, sufficient for most setups)
WEB_CONCURRENCY=0

# How often the Dashboard polls InfluxDB for live values, in seconds
INFLUX_POLL_INTERVAL=5

# Allowed frame ancestors for embedding
FRAME_ANCESTORS=http://192.168.168.101:8123

# Sensors excluded from house power calculation
INFLUX_EXCLUDE_FROM_HOUSE_POWER=HEATPUMP_POWER

#
# ┌──────────────────────────────────────────────────────────┐
# │  PostgreSQL database                                     │
# └──────────────────────────────────────────────────────────┘
#

# Database password — auto-generated, do not change after first start
POSTGRES_PASSWORD=CCCCC

# Volume path for storing the PostgreSQL data
DB_VOLUME_PATH=/var/lib/docker/volumes/solectrus/_data/postgresql

#
# ┌──────────────────────────────────────────────────────────┐
# │  InfluxDB time-series database                           │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — auto-generated, do not change after first start
INFLUX_PASSWORD=HHHHH

# Organization name
INFLUX_ORG=GGGGG

# Bucket (database) name for time-series data
INFLUX_BUCKET=JJJJJ

# Admin token — used by InfluxDB init and backup
INFLUX_ADMIN_TOKEN=IIIII

# Read+write token — used by power-splitter
INFLUX_TOKEN_READWRITE=IIIII

# Write token — used by all collectors
INFLUX_TOKEN_WRITE=KKKKK

# Read token — used by the dashboard
INFLUX_TOKEN_READ=LLLLL

# Volume path for storing the InfluxDB data
INFLUX_VOLUME_PATH=/var/lib/docker/volumes/solectrus/_data/influxdb

#
# ┌──────────────────────────────────────────────────────────┐
# │  Redis cache                                             │
# └──────────────────────────────────────────────────────────┘
#

# Volume path for storing the Redis data
REDIS_VOLUME_PATH=/var/lib/docker/volumes/solectrus/_data/redis

#
# ┌──────────────────────────────────────────────────────────┐
# │  Power Splitter                                          │
# └──────────────────────────────────────────────────────────┘
#

# Recalculation interval in seconds (min 300)
POWER_SPLITTER_INTERVAL=3600

#
# ┌──────────────────────────────────────────────────────────┐
# │  Forecast                                                │
# └──────────────────────────────────────────────────────────┘
#

# Forecast provider
FORECAST_PROVIDER=forecast.solar

# Solar panel latitude
FORECAST_LATITUDE=FFFFF

# Solar panel longitude
FORECAST_LONGITUDE=FFFFF

# Forecast update interval in seconds
FORECAST_INTERVAL=900

# Damping factor for morning hours
FORECAST_DAMPING_MORNING=0.5

# Damping factor for evening hours
FORECAST_DAMPING_EVENING=0.5

# Number of roof surfaces
FORECAST_CONFIGURATIONS=3

# Roof surface 1 tilt angle
FORECAST_0_DECLINATION=20

# Roof surface 1 orientation (-180=N, -90=E, 0=S, 90=W, 180=N)
FORECAST_0_AZIMUTH=-72

# Roof surface 1 capacity in kWp
FORECAST_0_KWP=5.04

# Roof surface 2 tilt angle
FORECAST_1_DECLINATION=20

# Roof surface 2 orientation (-180=N, -90=E, 0=S, 90=W, 180=N)
FORECAST_1_AZIMUTH=102

# Roof surface 2 capacity in kWp
FORECAST_1_KWP=5.04

# Roof surface 3 tilt angle
FORECAST_2_DECLINATION=55

# Roof surface 3 orientation (-180=N, -90=E, 0=S, 90=W, 180=N)
FORECAST_2_AZIMUTH=10

# Roof surface 3 capacity in kWp
FORECAST_2_KWP=4.60

# InfluxDB measurement name for forecasts
INFLUX_MEASUREMENT_FORECAST=Forecast

#
# ┌──────────────────────────────────────────────────────────┐
# │  MQTT broker                                             │
# └──────────────────────────────────────────────────────────┘
#

# MQTT broker hostname
MQTT_HOST=192.168.178.222

# MQTT broker port
MQTT_PORT=1883

# Enable SSL for MQTT connection
MQTT_SSL=false

# MQTT broker username
MQTT_USERNAME=DDDDD

# MQTT broker password
MQTT_PASSWORD=EEEEE

# --- Mapping 0 for BATTERY_CHARGING_POWER

MAPPING_0_TOPIC=envoy/json
MAPPING_0_MEASUREMENT=xxx-pv-messung
MAPPING_0_FIELD=bat_power_plus
MAPPING_0_TYPE=integer
MAPPING_0_JSON_FORMULA='IF((round({$.meters.storage.agg_p_mw} / 1000)) < 0, -(round({$.meters.storage.agg_p_mw} / 1000)), 0)'
MAPPING_0_NULL_TO_ZERO=true

# --- Mapping 1 for BATTERY_DISCHARGING_POWER

MAPPING_1_TOPIC=envoy/json
MAPPING_1_MEASUREMENT=xxx-pv-messung
MAPPING_1_FIELD=bat_power_minus
MAPPING_1_TYPE=integer
MAPPING_1_JSON_FORMULA='IF((round({$.meters.storage.agg_p_mw} / 1000)) > 0, (round({$.meters.storage.agg_p_mw} / 1000)), 0)'
MAPPING_1_NULL_TO_ZERO=true

# --- Mapping 2 for BATTERY_SOC

MAPPING_2_TOPIC=envoy/json
MAPPING_2_MEASUREMENT=xxx-pv-messung
MAPPING_2_FIELD=bat_fuel_charge
MAPPING_2_TYPE=float
MAPPING_2_JSON_PATH='$.meters.soc'
MAPPING_2_NULL_TO_ZERO=true

# --- Mapping 3 for CAR_BATTERY_SOC

MAPPING_3_TOPIC=evcc/loadpoints/2/vehicleSoc
MAPPING_3_MEASUREMENT=xxx-pv-messung
MAPPING_3_FIELD=car_battery_soc
MAPPING_3_TYPE=integer

# --- Mapping 4 for CASE_TEMP

MAPPING_4_TOPIC=forSOLECTRUS/hausakkutemperatur
MAPPING_4_MEASUREMENT=xxx-pv-messung
MAPPING_4_FIELD=battery_case_temp
MAPPING_4_TYPE=float
MAPPING_4_NULL_TO_ZERO=true

# --- Mapping 5 for CUSTOM_POWER_01

MAPPING_5_TOPIC=shelly/waschmaschine/status/switch:0
MAPPING_5_MEASUREMENT=waschmaschine
MAPPING_5_FIELD=power
MAPPING_5_TYPE=float
MAPPING_5_JSON_KEY=apower
MAPPING_5_NULL_TO_ZERO=true

