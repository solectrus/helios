MAPPING_6_TOPIC=shelly/spuelmaschine/status/switch:0
MAPPING_6_MEASUREMENT=spulmaschine
MAPPING_6_FIELD=power
MAPPING_6_TYPE=float
MAPPING_6_JSON_KEY=apower
MAPPING_6_NULL_TO_ZERO=true

