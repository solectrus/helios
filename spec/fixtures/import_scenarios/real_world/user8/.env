MAPPING_7_TOPIC=shelly/ebikeladestation/status/switch:0
MAPPING_7_MEASUREMENT=ebikeladestation
MAPPING_7_FIELD=power
MAPPING_7_TYPE=float
MAPPING_7_JSON_KEY=apower
MAPPING_7_NULL_TO_ZERO=true

# --- Mapping 8 for CUSTOM_POWER_04

MAPPING_8_TOPIC=shelly/luftentfeuchter/status/switch:0
MAPPING_8_MEASUREMENT=luftentfeuchter
MAPPING_8_FIELD=power
MAPPING_8_TYPE=float
MAPPING_8_JSON_KEY=apower
MAPPING_8_NULL_TO_ZERO=true

# --- Mapping 9 for CUSTOM_POWER_05

MAPPING_9_TOPIC=shelly/rocket/status/switch:0
MAPPING_9_MEASUREMENT=rocket
MAPPING_9_FIELD=power
MAPPING_9_TYPE=float
MAPPING_9_JSON_KEY=apower
MAPPING_9_NULL_TO_ZERO=true

# --- Mapping 10 for CUSTOM_POWER_06

MAPPING_10_TOPIC=shelly/kuehlschrank/status/switch:0
MAPPING_10_MEASUREMENT=kuhlschrank
MAPPING_10_FIELD=power
MAPPING_10_TYPE=float
MAPPING_10_JSON_KEY=apower
MAPPING_10_NULL_TO_ZERO=true

# --- Mapping 11 for CUSTOM_POWER_07

MAPPING_11_TOPIC=shelly/serverschrank/status/switch:0
MAPPING_11_MEASUREMENT=serverschrank
MAPPING_11_FIELD=power
MAPPING_11_TYPE=float
MAPPING_11_JSON_KEY=apower
MAPPING_11_NULL_TO_ZERO=true

# --- Mapping 12 for CUSTOM_POWER_08

MAPPING_12_TOPIC=shelly/3ddrucker/status/switch:0
MAPPING_12_MEASUREMENT=3ddrucker
MAPPING_12_FIELD=power
MAPPING_12_TYPE=float
MAPPING_12_JSON_KEY=apower
MAPPING_12_NULL_TO_ZERO=true

# --- Mapping 13 for CUSTOM_POWER_09

MAPPING_13_TOPIC=shelly/heizluefter/status/switch:0
MAPPING_13_MEASUREMENT=heizluefter
MAPPING_13_FIELD=power
MAPPING_13_TYPE=integer
MAPPING_13_JSON_KEY=apower
MAPPING_13_NULL_TO_ZERO=true

# --- Mapping 14 for CUSTOM_POWER_10

MAPPING_14_TOPIC=shelly/schreibtisch/status/switch:0
MAPPING_14_MEASUREMENT=schreibtisch
MAPPING_14_FIELD=power
MAPPING_14_TYPE=float
MAPPING_14_JSON_KEY=apower
MAPPING_14_NULL_TO_ZERO=true

# --- Mapping 15 for GRID_EXPORT_POWER

MAPPING_15_TOPIC=envoy/json
MAPPING_15_MEASUREMENT=xxx-pv-messung
MAPPING_15_FIELD=grid_power_minus
MAPPING_15_TYPE=integer
MAPPING_15_JSON_FORMULA='IF((round({$.meters.grid.agg_p_mw} / 1000)) < 0, -(round({$.meters.grid.agg_p_mw} / 1000)), 0)'
MAPPING_15_NULL_TO_ZERO=true

# --- Mapping 16 for GRID_IMPORT_POWER

MAPPING_16_TOPIC=envoy/json
MAPPING_16_MEASUREMENT=xxx-pv-messung
MAPPING_16_FIELD=grid_power_plus
MAPPING_16_TYPE=integer
MAPPING_16_JSON_FORMULA='IF((round({$.meters.grid.agg_p_mw} / 1000)) > 0, (round({$.meters.grid.agg_p_mw} / 1000)), 0)'
MAPPING_16_NULL_TO_ZERO=true

# --- Mapping 17 for HEATPUMP_HEATING_POWER

MAPPING_17_TOPIC=espaltherma/ATTR
MAPPING_17_MEASUREMENT=ALTHERMA
MAPPING_17_FIELD=heat
MAPPING_17_TYPE=float
MAPPING_17_JSON_FORMULA="IF({Aktuelle Betriebsart} = 'Heating' AND {Frostschutz} = 'OFF' AND {R1T-Wasser Vorlauftemp. nach dem Plattenwärmetauscher} > {R4T-Wasser Rücklauftemp. vor dem Plattenwärmetauscher}, {Durchflussmenge (l/min)} * 60.0 * 1.163 * ({R1T-Wasser Vorlauftemp. nach dem Plattenwärmetauscher} - {R4T-Wasser Rücklauftemp. vor dem Plattenwärmetauscher}), 0)"

# --- Mapping 18 for HEATPUMP_POWER

MAPPING_18_TOPIC=forSOLECTRUS/heatpump_bereinigt
MAPPING_18_MEASUREMENT=heatpump
MAPPING_18_FIELD=power
MAPPING_18_TYPE=float
MAPPING_18_NULL_TO_ZERO=true

# --- Mapping 19 for HEATPUMP_STATUS

MAPPING_19_TOPIC=espaltherma/ATTR
MAPPING_19_MEASUREMENT=ALTHERMA
MAPPING_19_FIELD=current_state
MAPPING_19_TYPE=string
MAPPING_19_JSON_FORMULA="IF({Frostschutz} == 'ON', 'Frostschutz', IF({Abtauung} == 'ON', 'Abtauen', IF({3-Wege-Ventil (ON: DHW/OFF: Raumheizung)} == 'ON', 'Warmwasser', IF({3-Wege-Ventil (ON: DHW/OFF: Raumheizung)} == 'OFF' AND {Drehzahl Verdichter (U/Sek)} > 0, 'Heizen', 'Warten'))))"

# --- Mapping 20 for HEATPUMP_TANK_TEMP

MAPPING_20_TOPIC=espaltherma/ATTR
MAPPING_20_MEASUREMENT=ALTHERMA
MAPPING_20_FIELD=r5t_tank_temp
MAPPING_20_TYPE=float
MAPPING_20_JSON_KEY='R5T-Brauchwassertemperatur im Speicher'

# --- Mapping 21 for HOUSE_POWER

MAPPING_21_TOPIC=forSOLECTRUS/hausverbrauchMINUSauto
MAPPING_21_MEASUREMENT=xxx-pv-messung
MAPPING_21_FIELD=house_power
MAPPING_21_TYPE=integer
MAPPING_21_NULL_TO_ZERO=true

# --- Mapping 22 for INVERTER_POWER

MAPPING_22_TOPIC=envoy/json
MAPPING_22_MEASUREMENT=xxx-pv-messung
MAPPING_22_FIELD=inverter_power
MAPPING_22_TYPE=integer
MAPPING_22_JSON_FORMULA='round({$.meters.pv.agg_p_mw} / 1000)'
MAPPING_22_NULL_TO_ZERO=true

# --- Mapping 23 for INVERTER_POWER_1

MAPPING_23_TOPIC=forSOLECTRUS/pv_ost
MAPPING_23_MEASUREMENT=xxx-pv-messung
MAPPING_23_FIELD=pv_ost
MAPPING_23_TYPE=integer
MAPPING_23_NULL_TO_ZERO=true

# --- Mapping 24 for INVERTER_POWER_2

MAPPING_24_TOPIC=forSOLECTRUS/pv_sued
MAPPING_24_MEASUREMENT=xxx-pv-messung
MAPPING_24_FIELD=pv_sued
MAPPING_24_TYPE=integer
MAPPING_24_NULL_TO_ZERO=true

# --- Mapping 25 for INVERTER_POWER_3

MAPPING_25_TOPIC=forSOLECTRUS/pv_west
MAPPING_25_MEASUREMENT=xxx-pv-messung
MAPPING_25_FIELD=pv_west
MAPPING_25_TYPE=integer
MAPPING_25_NULL_TO_ZERO=true

# --- Mapping 26 for OUTDOOR_TEMP

MAPPING_26_TOPIC=espaltherma/ATTR
MAPPING_26_MEASUREMENT=ALTHERMA
MAPPING_26_FIELD=r1t_outdoor_temp
MAPPING_26_TYPE=float
MAPPING_26_JSON_KEY=R1T-Außentemperatur

# --- Mapping 27 for SYSTEM_STATUS

MAPPING_27_TOPIC=forSOLECTRUS/enphasebetriebsstatus
MAPPING_27_MEASUREMENT=xxx-pv-messung
MAPPING_27_FIELD=current_state
MAPPING_27_TYPE=string

# --- Mapping 28 for WALLBOX_CAR_CONNECTED

MAPPING_28_TOPIC=evcc/loadpoints/2/connected
MAPPING_28_MEASUREMENT=xxx-pv-messung
MAPPING_28_FIELD=wallbox_car_connected
MAPPING_28_TYPE=boolean

# --- Mapping 29 for WALLBOX_POWER

MAPPING_29_TOPIC=evcc/loadpoints/2/chargePower
MAPPING_29_MEASUREMENT=xxx-pv-messung
MAPPING_29_FIELD=wallbox_charge_power
MAPPING_29_TYPE=integer

#
# ┌──────────────────────────────────────────────────────────┐
# │  Watchtower (automatic Docker image updates)             │
# └──────────────────────────────────────────────────────────┘
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

#
# ┌──────────────────────────────────────────────────────────┐
# │  Sensor mappings                                         │
# └──────────────────────────────────────────────────────────┘
#

# Sensor: inverter_power
INFLUX_SENSOR_INVERTER_POWER=xxx-pv-messung:inverter_power

# Sensor: inverter_power_1
INFLUX_SENSOR_INVERTER_POWER_1=xxx-pv-messung:pv_ost

# Sensor: inverter_power_2
INFLUX_SENSOR_INVERTER_POWER_2=xxx-pv-messung:pv_sued

# Sensor: inverter_power_3
INFLUX_SENSOR_INVERTER_POWER_3=xxx-pv-messung:pv_west

# Sensor: grid_import_power
INFLUX_SENSOR_GRID_IMPORT_POWER=xxx-pv-messung:grid_power_plus

# Sensor: grid_export_power
INFLUX_SENSOR_GRID_EXPORT_POWER=xxx-pv-messung:grid_power_minus

# Sensor: house_power
INFLUX_SENSOR_HOUSE_POWER=xxx-pv-messung:house_power

# Sensor: battery_charging_power
INFLUX_SENSOR_BATTERY_CHARGING_POWER=xxx-pv-messung:bat_power_plus

# Sensor: battery_discharging_power
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=xxx-pv-messung:bat_power_minus

# Sensor: battery_soc
INFLUX_SENSOR_BATTERY_SOC=xxx-pv-messung:bat_fuel_charge

# Sensor: wallbox_power
INFLUX_SENSOR_WALLBOX_POWER=xxx-pv-messung:wallbox_charge_power

# Sensor: wallbox_car_connected
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=xxx-pv-messung:wallbox_car_connected

# Sensor: car_battery_soc
INFLUX_SENSOR_CAR_BATTERY_SOC=xxx-pv-messung:car_battery_soc

# Sensor: heatpump_power
INFLUX_SENSOR_HEATPUMP_POWER=heatpump:power

# Sensor: heatpump_heating_power
INFLUX_SENSOR_HEATPUMP_HEATING_POWER=ALTHERMA:heat

# Sensor: heatpump_tank_temp
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=ALTHERMA:r5t_tank_temp

# Sensor: heatpump_status
INFLUX_SENSOR_HEATPUMP_STATUS=ALTHERMA:current_state

# Sensor: case_temp
INFLUX_SENSOR_CASE_TEMP=xxx-pv-messung:battery_case_temp

# Sensor: outdoor_temp
INFLUX_SENSOR_OUTDOOR_TEMP=ALTHERMA:r1t_outdoor_temp

# Sensor: system_status
INFLUX_SENSOR_SYSTEM_STATUS=xxx-pv-messung:current_state

# Sensor: inverter_power_forecast
INFLUX_SENSOR_INVERTER_POWER_FORECAST=Forecast:watt

# Sensor: custom_power_01
INFLUX_SENSOR_CUSTOM_POWER_01=waschmaschine:power

# Sensor: custom_power_02
INFLUX_SENSOR_CUSTOM_POWER_02=spulmaschine:power

# Sensor: custom_power_03
INFLUX_SENSOR_CUSTOM_POWER_03=ebikeladestation:power

# Sensor: custom_power_04
INFLUX_SENSOR_CUSTOM_POWER_04=luftentfeuchter:power

# Sensor: custom_power_05
INFLUX_SENSOR_CUSTOM_POWER_05=rocket:power

# Sensor: custom_power_06
INFLUX_SENSOR_CUSTOM_POWER_06=kuhlschrank:power

# Sensor: custom_power_07
INFLUX_SENSOR_CUSTOM_POWER_07=serverschrank:power

# Sensor: custom_power_08
INFLUX_SENSOR_CUSTOM_POWER_08=3ddrucker:power

# Sensor: custom_power_09
INFLUX_SENSOR_CUSTOM_POWER_09=heizluefter:power

# Sensor: custom_power_10
INFLUX_SENSOR_CUSTOM_POWER_10=schreibtisch:power

