##############################################
# General
##############################################

# Timezone (used by all services)
TZ=Europe/Berlin

# Date of PV system installation (first yield)
INSTALLATION_DATE=2022-06-01

##############################################
# Dashboard (Rails application)
##############################################

# Hostname the app is served from
APP_HOST=192.168.178.114

# Admin password for protected actions
ADMIN_PASSWORD=AAAAA

# Secret key for session cookies and signed tokens (generate with `rails secret`)
SECRET_KEY_BASE=BBBBB

# Force HTTPS (set to true behind SSL-terminating proxy)
FORCE_SSL=false

# Number of Puma worker processes (0 = single-process mode, sufficient for most setups)
WEB_CONCURRENCY=0

# Optional: Number of threads per Puma worker (default: 3)
# Also used for database connection pool size
# RAILS_MAX_THREADS=3

# Optional: Log level in production (default: info)
# RAILS_LOG_LEVEL=info

# Optional: CDN or asset server host
# ASSET_HOST=

# Optional: Allow embedding in iframes from these origins (comma-separated)
FRAME_ANCESTORS=*

# Optional: CO2 emission factor in g/kWh (default: 401)
# CO2_EMISSION_FACTOR=401

# Optional: Set static UI theme ('light' or 'dark', omit for auto-detection)
# UI_THEME=

# Optional: Lock app with a password (Lockup gem)
#LOCKUP_CODEWORD=S0170d7s!

# Optional: Skip browser compatibility check
# SKIP_BROWSER_CHECK=true

##############################################
# PostgreSQL
##############################################

# Database host
DB_HOST=postgresql

# Database user
DB_USER=postgres

# Database password (used by the Rails app via DB_PASSWORD)
POSTGRES_PASSWORD=CCCCC

# Optional: Database port (default: 5432)
# DB_PORT=5432

##############################################
# InfluxDB
##############################################

# InfluxDB connection
INFLUX_HOST=influxdb
INFLUX_SCHEMA=http
INFLUX_PORT=8086
INFLUX_ORG=DDDDD
INFLUX_BUCKET=EEEEE

# InfluxDB credentials for initial setup
INFLUX_USERNAME=my-influx-username
INFLUX_PASSWORD=FFFFF
INFLUX_ADMIN_TOKEN=GGGGG
INFLUX_MEASUREMENT=SENEC
INFLUX_MEASUREMENT_FORECAST=forecast
# Read-only token (used by the dashboard, mapped to INFLUX_TOKEN in compose.yaml)
INFLUX_TOKEN_READ=HHHHH
INFLUX_TOKEN_WRITE=IIIII
# Polling interval in seconds for live data updates
INFLUX_POLL_INTERVAL=5

##############################################
# Redis
##############################################

# Redis URL for caching and ActionCable
REDIS_URL=redis://redis:6379/1

##############################################
# Docker Volumes
##############################################

DB_VOLUME_PATH=/opt/solectrus/postgresql
INFLUX_VOLUME_PATH=/opt/solectrus/influxdb
REDIS_VOLUME_PATH=/opt/solectrus/redis

##############################################
# Power Splitter
##############################################

# Interval in seconds for power splitting calculations
POWER_SPLITTER_INTERVAL=300

##############################################
# Sensor mapping (InfluxDB measurement:field)
##############################################

# Inverter
INFLUX_SENSOR_INVERTER_POWER=SENEC:inverter_power
INFLUX_SENSOR_INVERTER_POWER_1=SENEC:mpp1
INFLUX_SENSOR_INVERTER_POWER_2=SENEC:mpp2
INFLUX_SENSOR_INVERTER_POWER_3=SENEC:mpp3
INFLUX_SENSOR_INVERTER_POWER_4=
INFLUX_SENSOR_INVERTER_POWER_5=

# Grid
INFLUX_SENSOR_GRID_IMPORT_POWER=SENEC:grid_power_plus
INFLUX_SENSOR_GRID_EXPORT_POWER=SENEC:grid_power_minus
INFLUX_SENSOR_GRID_EXPORT_LIMIT=SENEC:power_ratio

# House
INFLUX_SENSOR_HOUSE_POWER=SENEC:house_power

# Battery
INFLUX_SENSOR_BATTERY_CHARGING_POWER=SENEC:bat_power_plus
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=SENEC:bat_power_minus
INFLUX_SENSOR_BATTERY_SOC=SENEC:bat_fuel_charge
INFLUX_SENSOR_CASE_TEMP=SENEC:case_temp

# Wallbox
INFLUX_SENSOR_WALLBOX_POWER=SENEC:wallbox_charge_power
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=SENEC:connected

# Heat pump
INFLUX_SENSOR_HEATPUMP_POWER=SENEC:heatpump_power
INFLUX_SENSOR_HEATPUMP_HEATING_POWER=SENEC:heatpumppowerwattnew
INFLUX_SENSOR_HEATPUMP_STATUS=SENEC:heatpump_state
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=SENEC:heatpumphotwater

# Car
INFLUX_SENSOR_CAR_BATTERY_SOC=SENEC:opel_soc

# Environment
INFLUX_SENSOR_OUTDOOR_TEMP=SENEC:aussentemperatur2

# System status
INFLUX_SENSOR_SYSTEM_STATUS=SENEC:current_state
INFLUX_SENSOR_SYSTEM_STATUS_OK=SENEC:current_state_ok

# Forecasts
INFLUX_SENSOR_INVERTER_POWER_FORECAST=forecast:watt
INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY=forecast:watt_clearsky
INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST=forecast:temp

##############################################
# Custom power sensors (up to 20)
##############################################

INFLUX_SENSOR_CUSTOM_POWER_01=SENEC:trockner
INFLUX_SENSOR_CUSTOM_POWER_02=SENEC:waschmaschine
INFLUX_SENSOR_CUSTOM_POWER_03=SENEC:gefrierschrank
INFLUX_SENSOR_CUSTOM_POWER_04=SENEC:itdach
INFLUX_SENSOR_CUSTOM_POWER_05=SENEC:kuehlschrank
INFLUX_SENSOR_CUSTOM_POWER_06=SENEC:spuelmaschine
INFLUX_SENSOR_CUSTOM_POWER_07=SENEC:fernseher
INFLUX_SENSOR_CUSTOM_POWER_08=custom_08:power
INFLUX_SENSOR_CUSTOM_POWER_09=custom_09:power
INFLUX_SENSOR_CUSTOM_POWER_10=custom_10:power
INFLUX_SENSOR_CUSTOM_POWER_11=custom_11:power
INFLUX_SENSOR_CUSTOM_POWER_12=custom_12:power
INFLUX_SENSOR_CUSTOM_POWER_13=custom_13:power
INFLUX_SENSOR_CUSTOM_POWER_14=custom_14:power
INFLUX_SENSOR_CUSTOM_POWER_15=custom_15:power
INFLUX_SENSOR_CUSTOM_POWER_16=custom_16:power
INFLUX_SENSOR_CUSTOM_POWER_17=custom_17:power
INFLUX_SENSOR_CUSTOM_POWER_18=custom_18:power
INFLUX_SENSOR_CUSTOM_POWER_19=custom_19:power
INFLUX_SENSOR_CUSTOM_POWER_20=custom_20:power

##############################################
# Exclude sensors from house power calculation
##############################################

# Comma-separated list of sensor names (e.g. HEATPUMP_POWER,WALLBOX_POWER)
#INFLUX_EXCLUDE_FROM_HOUSE_POWER=HEATPUMP_POWER

##############################################
# External services (optional)
##############################################

# Honeybadger.io error tracking
# HONEYBADGER_API_KEY=

# RorVsWild performance monitoring
# RORVSWILD_API_KEY=

# Plausible analytics
# PLAUSIBLE_URL=
# Solar forecasting
#
# Anbieter
FORECAST_PROVIDER=pvnode

# Zeitzone
TZ=Europe/Berlin

# Standort
FORECAST_LATITUDE=0.00000
FORECAST_LONGITUDE=0.00000

# Anzahl der Dachflächen
FORECAST_CONFIGURATIONS=1

# Erste Dachfläche
FORECAST_0_DECLINATION=30
FORECAST_0_AZIMUTH=180
FORECAST_0_KWP=9.72

# pvnode-Zugangsdaten
PVNODE_APIKEY=JJJJJ

# Optional: Kostenpflichtiger Account
PVNODE_PAID=true
PVNODE_EXTRA_PARAMS=pv_technology_type=topcon&temperature_coefficient_power=-0.24&panel_age_years=3&elevation=0&installation_height=5&shading_config=2:1:0:1_6:2:0:2_6:2:0:2
##################################################################
##################################################################
# MQTT Collector

# MQTT Broker credentials
MQTT_HOST=192.168.178.164
MQTT_PORT=1883
MQTT_SSL=false
MQTT_USERNAME=KKKKK
MQTT_PASSWORD=LLLLL

