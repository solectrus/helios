# ============================================================
# DO NOT EDIT THIS FILE.
#
# This file is generated by HELIOS. Any manual change WILL be
# overwritten — silently, without backup — the next time HELIOS
# applies a configuration. In the worst case your edit breaks
# the stack and HELIOS can no longer recover it.
#
# Change every setting through the HELIOS web interface.
#
# Missing a setting? HELIOS is actively developed and can be
# extended — suggest it at:
# https://github.com/solectrus/helios/issues
#
# HELIOS fits the vast majority of setups. For a very
# specialized configuration, managing compose.yaml + .env
# by hand instead remains a valid alternative.
# ============================================================

#
# +----------------------------------------------------------+
# |  General settings                                        |
# +----------------------------------------------------------+
#

# Timezone for all services (IANA format, e.g. Europe/Berlin)
TZ=Europe/Berlin

# Date of first solar installation (YYYY-MM-DD) — used for statistics and charts
INSTALLATION_DATE=2022-06-01

#
# +----------------------------------------------------------+
# |  Security                                                |
# +----------------------------------------------------------+
#

# Admin password — shared by Dashboard and HELIOS
ADMIN_PASSWORD=AAAAA

# Secret key for Rails sessions — shared by Dashboard and HELIOS
SECRET_KEY_BASE=BBBBB

#
# +----------------------------------------------------------+
# |  Dashboard                                               |
# +----------------------------------------------------------+
#

# Hostname for the SOLECTRUS web interface
APP_HOST=192.168.178.114

# Must be FALSE, unless Traefik terminates TLS in front of the dashboard
FORCE_SSL=false

# Number of Puma worker processes (0 = single-process mode, sufficient for most setups)
WEB_CONCURRENCY=0

# Allowed frame ancestors for embedding
FRAME_ANCESTORS=*

#
# +----------------------------------------------------------+
# |  PostgreSQL database                                     |
# +----------------------------------------------------------+
#

# Database password — auto-generated, do not change after first start
POSTGRES_PASSWORD=CCCCC

# Volume path for storing the PostgreSQL data
DB_VOLUME_PATH=/opt/solectrus/postgresql

#
# +----------------------------------------------------------+
# |  InfluxDB time-series database                           |
# +----------------------------------------------------------+
#

# Admin password — auto-generated, do not change after first start
INFLUX_PASSWORD=FFFFF

# Organization name
INFLUX_ORG=DDDDD

# Bucket (database) name for time-series data
INFLUX_BUCKET=EEEEE

# Admin token — used by InfluxDB init and backup
INFLUX_ADMIN_TOKEN=GGGGG

# Read+write token — used by power-splitter
INFLUX_TOKEN_READWRITE=GGGGG

# Write token — used by all collectors
INFLUX_TOKEN_WRITE=IIIII

# Read token — used by the dashboard
INFLUX_TOKEN_READ=HHHHH

# Volume path for storing the InfluxDB data
INFLUX_VOLUME_PATH=/opt/solectrus/influxdb

#
# +----------------------------------------------------------+
# |  Redis cache                                             |
# +----------------------------------------------------------+
#

# Volume path for storing the Redis data
REDIS_VOLUME_PATH=/opt/solectrus/redis

#
# +----------------------------------------------------------+
# |  Power Splitter                                          |
# +----------------------------------------------------------+
#

# Recalculation interval in seconds (min 300)
POWER_SPLITTER_INTERVAL=300

#
# +----------------------------------------------------------+
# |  Forecast                                                |
# +----------------------------------------------------------+
#

# Forecast provider
FORECAST_PROVIDER=pvnode

# Solar panel latitude
FORECAST_LATITUDE=0.00000

# Solar panel longitude
FORECAST_LONGITUDE=0.00000

# Roof tilt angle
FORECAST_DECLINATION=30

# Roof orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_AZIMUTH=180

# System capacity in kWp
FORECAST_KWP=9.72

# pvnode API key
PVNODE_APIKEY=JJJJJ

# pvnode paid plan — only set for paid accounts (true = Hobbyist, nowcast = Hobbyist with Nowcast)
PVNODE_PAID=true

# Additional pvnode parameters
PVNODE_EXTRA_PARAMS=pv_technology_type=topcon&temperature_coefficient_power=-0.24&panel_age_years=3&elevation=0&installation_height=5&shading_config=2:1:0:1_6:2:0:2_6:2:0:2

# InfluxDB measurement name for forecasts
INFLUX_MEASUREMENT_FORECAST=forecast

#
# +----------------------------------------------------------+
# |  MQTT broker                                             |
# +----------------------------------------------------------+
#

# MQTT broker hostname
MQTT_HOST=192.168.178.164

# MQTT broker port
MQTT_PORT=1883

# Enable SSL for MQTT connection
MQTT_SSL=false

# MQTT broker username
MQTT_USERNAME=KKKKK

# MQTT broker password
MQTT_PASSWORD=LLLLL

# --- Mapping 0 for BATTERY_CHARGING_POWER

MAPPING_0_TOPIC=evcc/site/battery/power
MAPPING_0_MEASUREMENT=SENEC
MAPPING_0_FIELD=bat_power_plus
MAPPING_0_TYPE=integer
MAPPING_0_FORMULA='IF({value} < 0, -{value}, 0)'

# --- Mapping 1 for BATTERY_DISCHARGING_POWER

MAPPING_1_TOPIC=evcc/site/battery/power
MAPPING_1_MEASUREMENT=SENEC
MAPPING_1_FIELD=bat_power_minus
MAPPING_1_TYPE=integer
MAPPING_1_FORMULA='IF({value} > 0, {value}, 0)'

# --- Mapping 2 for BATTERY_SOC

MAPPING_2_TOPIC=evcc/site/battery/soc
MAPPING_2_MEASUREMENT=SENEC
MAPPING_2_FIELD=bat_fuel_charge
MAPPING_2_TYPE=float

# --- Mapping 3 for CAR_BATTERY_SOC

MAPPING_3_TOPIC=hassio/opel/soc
MAPPING_3_MEASUREMENT=SENEC
MAPPING_3_FIELD=opel_soc
MAPPING_3_TYPE=integer

# --- Mapping 4 for CUSTOM_POWER_01

MAPPING_4_TOPIC=hassio/trockner/watt
MAPPING_4_MEASUREMENT=SENEC
MAPPING_4_FIELD=trockner
MAPPING_4_TYPE=integer

# --- Mapping 5 for CUSTOM_POWER_02

MAPPING_5_TOPIC=hassio/waschmaschine/watt
MAPPING_5_MEASUREMENT=SENEC
MAPPING_5_FIELD=waschmaschine
MAPPING_5_TYPE=integer

# --- Mapping 6 for CUSTOM_POWER_04

MAPPING_6_TOPIC=hassio/itdach/watt
MAPPING_6_MEASUREMENT=SENEC
MAPPING_6_FIELD=itdach
MAPPING_6_TYPE=integer

# --- Mapping 7 for CUSTOM_POWER_05

MAPPING_7_TOPIC=hassio/kuehlschrank/watt
MAPPING_7_MEASUREMENT=SENEC
MAPPING_7_FIELD=kuehlschrank
MAPPING_7_TYPE=integer

# --- Mapping 8 for CUSTOM_POWER_06

MAPPING_8_TOPIC=hassio/spuelmaschine/watt
MAPPING_8_MEASUREMENT=SENEC
MAPPING_8_FIELD=spuelmaschine
MAPPING_8_TYPE=integer

# --- Mapping 9 for GRID_EXPORT_POWER

MAPPING_9_TOPIC=evcc/site/grid/power
MAPPING_9_MEASUREMENT=SENEC
MAPPING_9_FIELD=grid_power_minus
MAPPING_9_TYPE=integer
MAPPING_9_FORMULA='IF({value} < 0, -{value}, 0)'

# --- Mapping 10 for GRID_IMPORT_POWER

MAPPING_10_TOPIC=evcc/site/grid/power
MAPPING_10_MEASUREMENT=SENEC
MAPPING_10_FIELD=grid_power_plus
MAPPING_10_TYPE=integer
MAPPING_10_FORMULA='IF({value} > 0, {value}, 0)'

# --- Mapping 11 for HEATPUMP_HEATING_POWER

MAPPING_11_TOPIC=hassio/senec/heatpumppowerwattnew
MAPPING_11_MEASUREMENT=SENEC
MAPPING_11_FIELD=heatpumppowerwattnew
MAPPING_11_TYPE=float

# --- Mapping 12 for HEATPUMP_POWER

MAPPING_12_TOPIC=hassio/heatpump/watt
MAPPING_12_MEASUREMENT=SENEC
MAPPING_12_FIELD=heatpump_power
MAPPING_12_TYPE=integer

# --- Mapping 13 for HEATPUMP_TANK_TEMP

MAPPING_13_TOPIC=hassio/senec/heatpumphotwater
MAPPING_13_MEASUREMENT=SENEC
MAPPING_13_FIELD=heatpumphotwater
MAPPING_13_TYPE=float

# --- Mapping 14 for HOUSE_POWER

MAPPING_14_TOPIC=evcc/site/homePower
MAPPING_14_MEASUREMENT=SENEC
MAPPING_14_FIELD=house_power
MAPPING_14_TYPE=integer

# --- Mapping 15 for INVERTER_POWER

MAPPING_15_TOPIC=evcc/site/pvPower
MAPPING_15_MEASUREMENT=SENEC
MAPPING_15_FIELD=inverter_power
MAPPING_15_TYPE=integer

# --- Mapping 16 for WALLBOX_CAR_CONNECTED

MAPPING_16_TOPIC=evcc/loadpoints/1/connected
MAPPING_16_MEASUREMENT=SENEC
MAPPING_16_FIELD=connected
MAPPING_16_TYPE=string

# --- Mapping 17 for WALLBOX_POWER

MAPPING_17_TOPIC=evcc/loadpoints/1/chargePower
MAPPING_17_MEASUREMENT=SENEC
MAPPING_17_FIELD=wallbox_charge_power
MAPPING_17_TYPE=integer

# --- Mapping 18 (additional)

MAPPING_18_TOPIC=hassio/senec/co2
MAPPING_18_MEASUREMENT=SENEC
MAPPING_18_FIELD=co2
MAPPING_18_TYPE=float

# --- Mapping 19 (additional)

MAPPING_19_TOPIC=hassio/opel/mileage
MAPPING_19_MEASUREMENT=SENEC
MAPPING_19_FIELD=mileagecorsa
MAPPING_19_TYPE=float

#
# +----------------------------------------------------------+
# |  Watchtower (automatic Docker image updates)             |
# +----------------------------------------------------------+
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

#
# +----------------------------------------------------------+
# |  Sensor mappings                                         |
# +----------------------------------------------------------+
