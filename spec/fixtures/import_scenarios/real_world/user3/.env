MAPPING_6_TOPIC=zigbee2mqtt/Wasserkocher
MAPPING_6_MEASUREMENT=Wasserkocher
MAPPING_6_FIELD=power
MAPPING_6_TYPE=float
MAPPING_6_JSON_KEY=power

# --- Mapping 7 for CUSTOM_POWER_08

MAPPING_7_TOPIC=zigbee2mqtt/Kaffeemaschine
MAPPING_7_MEASUREMENT=Kaffeemaschine
MAPPING_7_FIELD=power
MAPPING_7_TYPE=float
MAPPING_7_JSON_KEY=power

# --- Mapping 8 for CUSTOM_POWER_09

MAPPING_8_TOPIC=zigbee2mqtt/Backofen
MAPPING_8_MEASUREMENT=Backofen
MAPPING_8_FIELD=power
MAPPING_8_TYPE=float
MAPPING_8_JSON_KEY=power

# --- Mapping 9 for CUSTOM_POWER_10

MAPPING_9_TOPIC=zigbee2mqtt/Buegeleisen
MAPPING_9_MEASUREMENT=Buegeleisen
MAPPING_9_FIELD=power
MAPPING_9_TYPE=float
MAPPING_9_JSON_KEY=power

# --- Mapping 10 for CUSTOM_POWER_13

MAPPING_10_TOPIC=homeassistant/sensor/it_gerate/state
MAPPING_10_MEASUREMENT=IT
MAPPING_10_FIELD=power
MAPPING_10_TYPE=float

# --- Mapping 11 for CUSTOM_POWER_16

MAPPING_11_TOPIC=homeassistant/sensor/multimedia_gerate/state
MAPPING_11_MEASUREMENT=Multimedia_Geraete
MAPPING_11_FIELD=power
MAPPING_11_TYPE=float

# --- Mapping 12 for CUSTOM_POWER_17

MAPPING_12_TOPIC=homeassistant/sensor/summe_kameras/state
MAPPING_12_MEASUREMENT=summe_kameras
MAPPING_12_FIELD=power
MAPPING_12_TYPE=float

# --- Mapping 13 for CUSTOM_POWER_18

MAPPING_13_TOPIC=homeassistant/sensor/senec_eigenverbrauch/state
MAPPING_13_MEASUREMENT=senec_eigenverbrauch
MAPPING_13_FIELD=power
MAPPING_13_TYPE=float

# --- Mapping 14 for CUSTOM_POWER_19

MAPPING_14_TOPIC=homeassistant/sensor/summe_l2_terrasse_garage/state
MAPPING_14_MEASUREMENT=summe_l2_terrasse_garage
MAPPING_14_FIELD=power
MAPPING_14_TYPE=float

# --- Mapping 15 (additional)

MAPPING_15_TOPIC=homeassistant/sensor/ws2900_v2_01_18_outdoor_temperature/state
MAPPING_15_MEASUREMENT=ws2900_v2_01_18_outdoor_temperature
MAPPING_15_FIELD=temperature
MAPPING_15_TYPE=float

#
# +----------------------------------------------------------+
# |  Shelly collector                                        |
# +----------------------------------------------------------+
#

# Polling interval in seconds
SHELLY_INTERVAL=5

# Shelly device hostnames (comma-separated)
SHELLY_HOST=192.168.1.243,192.168.1.246,192.168.1.241,192.168.1.244

# InfluxDB measurement names (comma-separated)
INFLUX_MEASUREMENT=AUFZUG,HERD,TERRASSE,THERME

#
# +--------------------------------------------------------------+
# |  Ingest (recalculates house_power for balcony power plants)  |
# +--------------------------------------------------------------+
#

# Hours of measurement data Ingest buffers in its SQLite store
RETENTION_HOURS=12

# Volume path for storing the Ingest data
INGEST_VOLUME_PATH=/home/pi/solectrus/ingest

#
# +----------------------------------------------------------+
# |  Watchtower (automatic Docker image updates)             |
# +----------------------------------------------------------+
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

#
# +----------------------------------------------------------+
# |  Sensor mappings                                         |
# +----------------------------------------------------------+
#

# Sensor: inverter_power_1
INFLUX_SENSOR_INVERTER_POWER_1=SENEC:inverter_power

# Sensor: inverter_power_2
INFLUX_SENSOR_INVERTER_POWER_2=TERRASSE:power_c

# Sensor: grid_import_power
INFLUX_SENSOR_GRID_IMPORT_POWER=SENEC:grid_power_plus

# Sensor: grid_export_power
INFLUX_SENSOR_GRID_EXPORT_POWER=SENEC:grid_power_minus

# Sensor: grid_export_limit
INFLUX_SENSOR_GRID_EXPORT_LIMIT=SENEC:power_ratio

# Sensor: house_power
INFLUX_SENSOR_HOUSE_POWER=SENEC:house_power

# Sensor: battery_charging_power
INFLUX_SENSOR_BATTERY_CHARGING_POWER=SENEC:bat_power_plus

# Sensor: battery_discharging_power
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=SENEC:bat_power_minus

# Sensor: battery_soc
INFLUX_SENSOR_BATTERY_SOC=SENEC:bat_fuel_charge

# Sensor: case_temp
INFLUX_SENSOR_CASE_TEMP=SENEC:case_temp

# Sensor: system_status
INFLUX_SENSOR_SYSTEM_STATUS=SENEC:current_state

# Sensor: system_status_ok
INFLUX_SENSOR_SYSTEM_STATUS_OK=SENEC:current_state_ok

# Sensor: inverter_power_forecast
INFLUX_SENSOR_INVERTER_POWER_FORECAST=forecast:watt

# Sensor: inverter_power_forecast_clearsky
INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY=forecast:watt_clearsky

# Sensor: outdoor_temp_forecast
INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST=forecast:temp

