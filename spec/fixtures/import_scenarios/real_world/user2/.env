# ============================================================
# DO NOT EDIT THIS FILE.
#
# This file is generated by HELIOS. Any manual change WILL be
# overwritten — silently, without backup — the next time HELIOS
# applies a configuration. In the worst case your edit breaks
# the stack and HELIOS can no longer recover it.
#
# Change every setting through the HELIOS web interface.
#
# Need something HELIOS does not expose? Then HELIOS is no longer
# the right tool for your stack: uninstall HELIOS and manage
# compose.yaml + .env by hand.
# ============================================================

#
# ┌──────────────────────────────────────────────────────────┐
# │  General settings                                        │
# └──────────────────────────────────────────────────────────┘
#

# Timezone for all services (IANA format, e.g. Europe/Berlin)
TZ=Europe/Berlin

# Date of first solar installation (YYYY-MM-DD) — used for statistics and charts
INSTALLATION_DATE=2022-04-28

#
# ┌──────────────────────────────────────────────────────────┐
# │  Security                                                │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — shared by Dashboard and HELIOS
ADMIN_PASSWORD=my-admin-password

# Secret key for Rails sessions — shared by Dashboard and HELIOS
SECRET_KEY_BASE=my-secret-key-base

#
# ┌──────────────────────────────────────────────────────────┐
# │  Dashboard                                               │
# └──────────────────────────────────────────────────────────┘
#

# Hostname for the SOLECTRUS web interface
APP_HOST=solectrus.my-domain.com

# Must be FALSE, unless Traefik terminates TLS in front of the dashboard
FORCE_SSL=false

# Number of Puma worker processes (0 = single-process mode, sufficient for most setups)
WEB_CONCURRENCY=0

# CO2 emission factor (g/kWh)
CO2_EMISSION_FACTOR=258

# Sensors excluded from house power calculation
INFLUX_EXCLUDE_FROM_HOUSE_POWER=CUSTOM_POWER_01,CUSTOM_POWER_08,CUSTOM_POWER_13,HEATPUMP_POWER

#
# ┌──────────────────────────────────────────────────────────┐
# │  PostgreSQL database                                     │
# └──────────────────────────────────────────────────────────┘
#

# Database password — auto-generated, do not change after first start
POSTGRES_PASSWORD=my-postgres-password

# Postgres data directory inside the container (imported from existing installation)
PGDATA=/var/lib/postgresql/data/

# Volume path for storing the PostgreSQL data
DB_VOLUME_PATH=/home/user2/docker/solectrus/postgres/16

#
# ┌──────────────────────────────────────────────────────────┐
# │  InfluxDB time-series database                           │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — auto-generated, do not change after first start
INFLUX_PASSWORD=my-influx-password

# Organization name
INFLUX_ORG=my-influx-org

# Bucket (database) name for time-series data
INFLUX_BUCKET=my-solectrus-bucket

# API token with full access — auto-generated, do not change after first start
INFLUX_TOKEN=my-influx-read-token

# Store API tokens as bcrypt hashes (imported from existing installation)
INFLUXD_USE_HASHED_TOKENS=true

# Volume path for storing the InfluxDB data
INFLUX_VOLUME_PATH=/home/user2/docker/solectrus/influxdb/data

#
# ┌──────────────────────────────────────────────────────────┐
# │  Redis cache                                             │
# └──────────────────────────────────────────────────────────┘
#

# Volume path for storing the Redis data
REDIS_VOLUME_PATH=/home/user2/docker/solectrus/redis

#
# ┌──────────────────────────────────────────────────────────┐
# │  Power Splitter                                          │
# └──────────────────────────────────────────────────────────┘
#

# Recalculation interval in seconds (min 300)
POWER_SPLITTER_INTERVAL=600

#
# ┌──────────────────────────────────────────────────────────┐
# │  SENEC collector                                         │
# └──────────────────────────────────────────────────────────┘
#

# SENEC adapter type (local or cloud)
SENEC_ADAPTER=local

# SENEC device IP or hostname
SENEC_HOST=senec.local

# Connection protocol
SENEC_SCHEMA=https

# Status text language
SENEC_LANGUAGE=de

# Polling interval in seconds
SENEC_INTERVAL=7

# Comma-separated fields to exclude from InfluxDB
SENEC_IGNORE=ev_connected,wallbox_charge_power,wallbox_charge_power0,wallbox_charge_power1,wallbox_charge_power2,wallbox_charge_power3

# InfluxDB measurement name for SENEC
INFLUX_MEASUREMENT_SENEC=SENEC

#
# ┌──────────────────────────────────────────────────────────┐
# │  Forecast                                                │
# └──────────────────────────────────────────────────────────┘
#

# Forecast provider
FORECAST_PROVIDER=pvnode

# Solar panel latitude
FORECAST_LATITUDE=52.009085

# Solar panel longitude
FORECAST_LONGITUDE=11.737578

# Forecast update interval in seconds
FORECAST_INTERVAL=900

# Number of roof surfaces
FORECAST_CONFIGURATIONS=4

# Roof surface 1 tilt angle
FORECAST_0_DECLINATION=53

# Roof surface 1 orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_0_AZIMUTH=135

# Roof surface 1 capacity in kWp
FORECAST_0_KWP=6.375

# Roof surface 2 tilt angle
FORECAST_1_DECLINATION=53

# Roof surface 2 orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_1_AZIMUTH=315

# Roof surface 2 capacity in kWp
FORECAST_1_KWP=6.375

# Roof surface 3 tilt angle
FORECAST_2_DECLINATION=90

# Roof surface 3 orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_2_AZIMUTH=225

# Roof surface 3 capacity in kWp
FORECAST_2_KWP=1.305

# Roof surface 4 tilt angle
FORECAST_3_DECLINATION=12.67

# Roof surface 4 orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_3_AZIMUTH=135

# Roof surface 4 capacity in kWp
FORECAST_3_KWP=3.28

# pvnode API key
PVNODE_APIKEY=my-pvnode-apikey

# pvnode paid plan — only set for paid accounts (true = Hobbyist, nowcast = Hobbyist with Nowcast)
PVNODE_PAID=true

# Additional pvnode parameters for roof 1
PVNODE_0_EXTRA_PARAMS=diffuse_radiation_model=perez&mounting_type=isol&terrain_based_horizon_coverage=true&sky_obstruction_config=85:95:17_240:280:24

# Additional pvnode parameters for roof 2
PVNODE_1_EXTRA_PARAMS=diffuse_radiation_model=perez&mounting_type=isol&terrain_based_horizon_coverage=true&sky_obstruction_config=85:95:17_240:280:24

# Additional pvnode parameters for roof 3
PVNODE_2_EXTRA_PARAMS=diffuse_radiation_model=perez&mounting_type=isol&terrain_based_horizon_coverage=true&sky_obstruction_config=85:95:17_240:280:24

# Additional pvnode parameters for roof 4
PVNODE_3_EXTRA_PARAMS=diffuse_radiation_model=perez&mounting_type=isol&terrain_based_horizon_coverage=true&sky_obstruction_config=85:95:17_240:280:24

# InfluxDB measurement name for forecasts
INFLUX_MEASUREMENT_FORECAST=forecast

#
# ┌──────────────────────────────────────────────────────────┐
# │  MQTT broker                                             │
# └──────────────────────────────────────────────────────────┘
#

# MQTT broker hostname
MQTT_HOST=mosquitto

# MQTT broker port
MQTT_PORT=1883

# Enable SSL for MQTT connection
MQTT_SSL=false

# MQTT broker username
MQTT_USERNAME=my-mqtt-username

# MQTT broker password
MQTT_PASSWORD=my-mqtt-password

# --- Mapping 0 for CUSTOM_POWER_03

MAPPING_0_TOPIC=ac_bedroom/status/switch:0
MAPPING_0_MEASUREMENT=ac_bedroom
MAPPING_0_FIELD=power
MAPPING_0_TYPE=float
MAPPING_0_JSON_KEY=apower
MAPPING_0_MIN=0
MAPPING_0_MAX=3500

# --- Mapping 1 for CUSTOM_POWER_04

MAPPING_1_TOPIC=ac_veranda/tele/SENSOR
MAPPING_1_MEASUREMENT=ac_veranda
MAPPING_1_FIELD=power
MAPPING_1_TYPE=float
MAPPING_1_JSON_PATH='$.ENERGY.Power'
MAPPING_1_MIN=0
MAPPING_1_MAX=2300

# --- Mapping 2 for CUSTOM_POWER_05

MAPPING_2_TOPIC=ac_living_room/tele/SENSOR
MAPPING_2_MEASUREMENT=ac_living_room
MAPPING_2_FIELD=power
MAPPING_2_TYPE=float
MAPPING_2_JSON_PATH='$.ENERGY.Power'
MAPPING_2_MIN=0
MAPPING_2_MAX=2300

# --- Mapping 3 for CUSTOM_POWER_07

MAPPING_3_TOPIC=microwave/tele/SENSOR
MAPPING_3_MEASUREMENT=microwave
MAPPING_3_FIELD=power
MAPPING_3_TYPE=float
MAPPING_3_JSON_PATH='$.ENERGY.Power'
MAPPING_3_MIN=0
MAPPING_3_MAX=2300

# --- Mapping 4 for CUSTOM_POWER_09

MAPPING_4_TOPIC=washing_machine/tele/SENSOR
MAPPING_4_MEASUREMENT=washing_machine
MAPPING_4_FIELD=power
MAPPING_4_TYPE=float
MAPPING_4_JSON_PATH='$.ENERGY.Power'
MAPPING_4_MIN=0
MAPPING_4_MAX=2300

# --- Mapping 5 for CUSTOM_POWER_10

MAPPING_5_TOPIC=dryer/tele/SENSOR
MAPPING_5_MEASUREMENT=dryer
MAPPING_5_FIELD=power
MAPPING_5_TYPE=float
MAPPING_5_JSON_PATH='$.ENERGY.Power'
MAPPING_5_MIN=0
MAPPING_5_MAX=3450

# --- Mapping 6 for CUSTOM_POWER_11

MAPPING_6_TOPIC=dish_washer/status/em1:0
MAPPING_6_MEASUREMENT=dish_washer
MAPPING_6_FIELD=power
MAPPING_6_TYPE=float
MAPPING_6_JSON_KEY=act_power
MAPPING_6_MIN=0
MAPPING_6_MAX=35000

# --- Mapping 7 for CUSTOM_POWER_12

MAPPING_7_TOPIC=multimedia/tele/SENSOR
MAPPING_7_MEASUREMENT=multimedia
MAPPING_7_FIELD=power
MAPPING_7_TYPE=float
MAPPING_7_JSON_PATH='$.ENERGY.Power'
MAPPING_7_MIN=0
MAPPING_7_MAX=2300

# --- Mapping 8 (additional)

MAPPING_8_TOPIC=ac_bedroom/status/switch:0
MAPPING_8_MEASUREMENT=ac_bedroom
MAPPING_8_FIELD=energy_in
MAPPING_8_TYPE=float
MAPPING_8_JSON_FORMULA='{$.aenergy.total}/1000.0'
MAPPING_8_MIN=0
MAPPING_8_MAX=999999

# --- Mapping 9 (additional)

MAPPING_9_TOPIC=dish_washer/status/em1data:0
MAPPING_9_MEASUREMENT=dish_washer
MAPPING_9_FIELD=energy_in
MAPPING_9_TYPE=float
MAPPING_9_JSON_FORMULA='{$.total_act_energy}/1000.0'
MAPPING_9_MIN=0
MAPPING_9_MAX=999999

#
# ┌──────────────────────────────────────────────────────────────┐
# │  Ingest (recalculates house_power for balcony power plants)  │
# └──────────────────────────────────────────────────────────────┘
#

# Hours of measurement data Ingest buffers in its SQLite store
RETENTION_HOURS=24

# Volume path for storing the Ingest data
INGEST_VOLUME_PATH=/home/user2/docker/solectrus/ingest

#
# ┌──────────────────────────────────────────────────────────┐
# │  Watchtower (automatic Docker image updates)             │
# └──────────────────────────────────────────────────────────┘
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

#
# ┌──────────────────────────────────────────────────────────┐
# │  Sensor mappings                                         │
# └──────────────────────────────────────────────────────────┘
#

# Sensor: inverter_power_1
INFLUX_SENSOR_INVERTER_POWER_1=SENEC:inverter_power

# Sensor: inverter_power_2
INFLUX_SENSOR_INVERTER_POWER_2=balcony:power

# Sensor: inverter_power_3
INFLUX_SENSOR_INVERTER_POWER_3=anker-akku:power_out

# Sensor: grid_import_power
INFLUX_SENSOR_GRID_IMPORT_POWER=powermeter:power_in

# Sensor: grid_export_power
INFLUX_SENSOR_GRID_EXPORT_POWER=powermeter:power_out

# Sensor: grid_export_limit
INFLUX_SENSOR_GRID_EXPORT_LIMIT=SENEC:power_ratio

# Sensor: house_power
INFLUX_SENSOR_HOUSE_POWER=Calculated:house_power

# Sensor: battery_charging_power
INFLUX_SENSOR_BATTERY_CHARGING_POWER=batteries:charging_power

# Sensor: battery_discharging_power
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=batteries:discharging_power

# Sensor: battery_soc
INFLUX_SENSOR_BATTERY_SOC=SENEC:bat_fuel_charge

# Sensor: wallbox_power
INFLUX_SENSOR_WALLBOX_POWER=SENEC:wallbox_charge_power

# Sensor: wallbox_car_connected
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=SENEC:ev_connected

# Sensor: car_battery_soc
INFLUX_SENSOR_CAR_BATTERY_SOC=sax:soc

# Sensor: heatpump_power
INFLUX_SENSOR_HEATPUMP_POWER=sdm72d-m:power

# Sensor: heatpump_heating_power
INFLUX_SENSOR_HEATPUMP_HEATING_POWER=thermav:heat_output

# Sensor: heatpump_tank_temp
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=watertemp:temperature

# Sensor: heatpump_status
INFLUX_SENSOR_HEATPUMP_STATUS=thermav:current_state

# Sensor: case_temp
INFLUX_SENSOR_CASE_TEMP=SENEC:case_temp

# Sensor: outdoor_temp
INFLUX_SENSOR_OUTDOOR_TEMP=netatmo:temperature

# Sensor: system_status
INFLUX_SENSOR_SYSTEM_STATUS=SENEC:current_state

# Sensor: system_status_ok
INFLUX_SENSOR_SYSTEM_STATUS_OK=SENEC:current_state_ok

# Sensor: inverter_power_forecast
INFLUX_SENSOR_INVERTER_POWER_FORECAST=Pvnode:watt

# Sensor: inverter_power_forecast_clearsky
INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY=Pvnode:watt_clearsky

# Sensor: outdoor_temp_forecast
INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST=Pvnode:temp

# Sensor: custom_power_01
INFLUX_SENSOR_CUSTOM_POWER_01=heatpump:power

# Sensor: custom_power_02
INFLUX_SENSOR_CUSTOM_POWER_02=freezer:power

# Sensor: custom_power_03
INFLUX_SENSOR_CUSTOM_POWER_03=ac_bedroom:power

# Sensor: custom_power_04
INFLUX_SENSOR_CUSTOM_POWER_04=ac_veranda:power

# Sensor: custom_power_05
INFLUX_SENSOR_CUSTOM_POWER_05=ac_living_room:power

# Sensor: custom_power_06
INFLUX_SENSOR_CUSTOM_POWER_06=fridge_basement:power

# Sensor: custom_power_07
INFLUX_SENSOR_CUSTOM_POWER_07=microwave:power

# Sensor: custom_power_08
INFLUX_SENSOR_CUSTOM_POWER_08=well_pump:power

# Sensor: custom_power_09
INFLUX_SENSOR_CUSTOM_POWER_09=washing_machine:power

# Sensor: custom_power_10
INFLUX_SENSOR_CUSTOM_POWER_10=dryer:power

# Sensor: custom_power_11
INFLUX_SENSOR_CUSTOM_POWER_11=dish_washer:power

# Sensor: custom_power_12
INFLUX_SENSOR_CUSTOM_POWER_12=multimedia:power

# Sensor: custom_power_13
INFLUX_SENSOR_CUSTOM_POWER_13=anker-akku:power

#
# ┌──────────────────────────────────────────────────────────┐
# │  mqtt_collector_ingest — service environment             │
# └──────────────────────────────────────────────────────────┘
#

# --- MQTT
MQTT_COLLECTOR_INFLUX_TOKEN=my-influx-write-token

# --- INGEST
INGEST_MAPPING_0_TOPIC=batteries/tele/SENSOR
INGEST_MAPPING_0_JSON_PATH='$.power'
INGEST_MAPPING_0_MEASUREMENT_POSITIVE=batteries
INGEST_MAPPING_0_MEASUREMENT_NEGATIVE=batteries
INGEST_MAPPING_0_FIELD_POSITIVE=discharging_power
INGEST_MAPPING_0_FIELD_NEGATIVE=charging_power
INGEST_MAPPING_0_TYPE=float
INGEST_MAPPING_0_MAX=25000
INGEST_MAPPING_0_MIN=-25000

#
# ┌──────────────────────────────────────────────────────────┐
# │  tibber_collector — service environment                  │
# └──────────────────────────────────────────────────────────┘
#

TIBBER_INFLUX_MEASUREMENT=smard-tibber
TIBBER_INFLUX_TOKEN=my-influx-write-token
TIBBER_INTERVAL=3600
TIBBER_TOKEN=my-tibber-token

#
# ┌──────────────────────────────────────────────────────────────┐
# │  Unmanaged variables (preserved from existing installation)  │
# └──────────────────────────────────────────────────────────────┘
#

BASE_DIR=/home/user2/docker/solectrus

CONTAINER_DUMP=/dump

HOST_DUMP='${BASE_DIR}/db_dumps'

DOMAIN=my-domain.com

