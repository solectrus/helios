# ============================================================
# DO NOT EDIT THIS FILE.
#
# This file is generated by HELIOS. Any manual change WILL be
# overwritten — silently, without backup — the next time HELIOS
# applies a configuration. In the worst case your edit breaks
# the stack and HELIOS can no longer recover it.
#
# Change every setting through the HELIOS web interface.
#
# Missing a setting? HELIOS is actively developed and can be
# extended — suggest it at:
# https://github.com/solectrus/helios/issues
#
# HELIOS fits the vast majority of setups. For a very
# specialized configuration, managing compose.yaml + .env
# by hand instead remains a valid alternative.
# ============================================================

#
# +----------------------------------------------------------+
# |  General settings                                        |
# +----------------------------------------------------------+
#

# Timezone for all services (IANA format, e.g. Europe/Berlin)
TZ=Europe/Berlin

# Date of first solar installation (YYYY-MM-DD) — used for statistics and charts
INSTALLATION_DATE=2024-10-18

# Currency for monetary values in the dashboard (ISO 4217 code, e.g. EUR, CHF, USD)
CURRENCY=EUR

#
# +----------------------------------------------------------+
# |  Security                                                |
# +----------------------------------------------------------+
#

# Admin password — shared by Dashboard and HELIOS
ADMIN_PASSWORD=my-admin-password

# Secret key for Rails sessions — shared by Dashboard and HELIOS
SECRET_KEY_BASE=my-secret-key-base

#
# +----------------------------------------------------------+
# |  Dashboard                                               |
# +----------------------------------------------------------+
#

# Hostname for the SOLECTRUS web interface
APP_HOST=solectrus.example.de

# Must be FALSE, unless Traefik terminates TLS in front of the dashboard
FORCE_SSL=true

# Number of Puma worker processes (0 = single-process mode, sufficient for most setups)
WEB_CONCURRENCY=0

# Codeword for lockup page protection
LOCKUP_CODEWORD=my-lockup-codeword

#
# +----------------------------------------------------------+
# |  PostgreSQL database                                     |
# +----------------------------------------------------------+
#

# Database password — auto-generated, do not change after first start
POSTGRES_PASSWORD=my-secret-db-password

# Volume path for storing the PostgreSQL data
DB_VOLUME_PATH=./postgresql

#
# +----------------------------------------------------------+
# |  InfluxDB time-series database                           |
# +----------------------------------------------------------+
#

# Admin password — auto-generated, do not change after first start
INFLUX_PASSWORD=my-influx-password

# Organization name
INFLUX_ORG=solectrus

# Bucket (database) name for time-series data
INFLUX_BUCKET=solectrus

# Admin token — used by InfluxDB init and backup
INFLUX_ADMIN_TOKEN=my-super-secret-admin-token

# Read+write token — used by power-splitter
INFLUX_TOKEN_READWRITE=my-super-secret-admin-token

# Write token — used by all collectors
INFLUX_TOKEN_WRITE=my-super-secret-admin-token

# Read token — used by the dashboard
INFLUX_TOKEN_READ=my-super-secret-admin-token

# Volume path for storing the InfluxDB data
INFLUX_VOLUME_PATH=./influxdb

#
# +----------------------------------------------------------+
# |  Redis cache                                             |
# +----------------------------------------------------------+
#

# Volume path for storing the Redis data
REDIS_VOLUME_PATH=./redis

#
# +----------------------------------------------------------+
# |  Reverse Proxy (Traefik)                                 |
# +----------------------------------------------------------+
#

# Domain for HTTPS access via Traefik
APP_DOMAIN=solectrus.example.de

# Email for Let's Encrypt certificate notifications
LETSENCRYPT_EMAIL=mustermann@example.de

# Volume path for storing the Let's Encrypt certificates
TRAEFIK_VOLUME_PATH=./traefik

#
# +----------------------------------------------------------+
# |  Power Splitter                                          |
# +----------------------------------------------------------+
#

# Recalculation interval in seconds
POWER_SPLITTER_INTERVAL=300

#
# +----------------------------------------------------------+
# |  SENEC collector                                         |
# +----------------------------------------------------------+
#

# SENEC adapter type (local or cloud)
SENEC_ADAPTER=cloud

# SENEC cloud username
SENEC_USERNAME=my-senec-username

# SENEC cloud password
SENEC_PASSWORD=my-senec-password

# Cloud request mode: minimal (default) or full (adds case_temp, application_version, current_state)
SENEC_REQUEST_MODE=full

# Polling interval in seconds
SENEC_INTERVAL=60

# InfluxDB measurement name for SENEC
INFLUX_MEASUREMENT_SENEC=SENEC

#
# +----------------------------------------------------------+
# |  Forecast                                                |
# +----------------------------------------------------------+
#

# Forecast provider
FORECAST_PROVIDER=pvnode

# Solar panel latitude
FORECAST_LATITUDE=51.00000

# Solar panel longitude
FORECAST_LONGITUDE=12.00000

# Number of roof surfaces
FORECAST_CONFIGURATIONS=4

# Roof surface 1 tilt angle
FORECAST_0_DECLINATION=45

# Roof surface 1 orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_0_AZIMUTH=180

# Roof surface 1 capacity in kWp
FORECAST_0_KWP=6

# Roof surface 2 tilt angle
FORECAST_1_DECLINATION=38

# Roof surface 2 orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_1_AZIMUTH=180

# Roof surface 2 capacity in kWp
FORECAST_1_KWP=3.08

# Roof surface 3 tilt angle
FORECAST_2_DECLINATION=38

# Roof surface 3 orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_2_AZIMUTH=90

# Roof surface 3 capacity in kWp
FORECAST_2_KWP=3.85

# Roof surface 4 tilt angle
FORECAST_3_DECLINATION=38

# Roof surface 4 orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_3_AZIMUTH=270

# Roof surface 4 capacity in kWp
FORECAST_3_KWP=3.85

# pvnode API key
PVNODE_APIKEY=my-pvnode-api-key

# pvnode paid plan — only set for paid accounts (true = Light, nowcast = Plus)
PVNODE_PAID=true

# Additional pvnode parameters
PVNODE_EXTRA_PARAMS=diffuse_radiation_model=perez

# InfluxDB measurement name for forecasts
INFLUX_MEASUREMENT_FORECAST=forecast

#
# +----------------------------------------------------------+
# |  Shelly collector                                        |
# +----------------------------------------------------------+
#

# Polling interval in seconds
SHELLY_INTERVAL=20

# Shelly cloud device IDs (comma-separated)
SHELLY_DEVICE_ID=my-dishwasher-device-id,my-dryer-device-id,my-fridge-device-id,my-froster-device-id,my-heating-wc-device-id,my-hob-device-id,my-lighting-device-id,my-office-device-id,my-outdoor-device-id,my-oven-device-id,my-pump17-device-id,my-pump22-device-id,my-sauna-device-id,my-trotec-device-id,my-tv-bose-device-id,my-utility-device-id,my-washer-device-id

# InfluxDB measurement names (comma-separated)
INFLUX_MEASUREMENT=Dishwasher,Dryer,Fridge,Froster,HeatingWC,Hob,Lighting,Office,Outdoor,Oven,Pump17,Pump22,Sauna,TroTec,TvBose,Utility,Washer

# InfluxDB write mode (default or essential)
INFLUX_MODE=essential

# Shelly Cloud server URL
SHELLY_CLOUD_SERVER=https://shelly-158-eu.shelly.cloud

# Shelly Cloud authentication key
SHELLY_AUTH_KEY=my-shelly-auth-key

#
# +----------------------------------------------------------+
# |  Watchtower (automatic Docker image updates)             |
# +----------------------------------------------------------+
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

#
# +----------------------------------------------------------+
# |  Sensor mappings                                         |
# +----------------------------------------------------------+
#

# Sensor: inverter_power
INFLUX_SENSOR_INVERTER_POWER=SENEC:inverter_power

# Sensor: grid_import_power
INFLUX_SENSOR_GRID_IMPORT_POWER=SENEC:grid_power_plus

# Sensor: grid_export_power
INFLUX_SENSOR_GRID_EXPORT_POWER=SENEC:grid_power_minus

# Sensor: grid_export_limit
INFLUX_SENSOR_GRID_EXPORT_LIMIT=SENEC:power_ratio

# Sensor: house_power
INFLUX_SENSOR_HOUSE_POWER=SENEC:house_power

# Sensor: battery_charging_power
INFLUX_SENSOR_BATTERY_CHARGING_POWER=SENEC:bat_power_plus

# Sensor: battery_discharging_power
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=SENEC:bat_power_minus

# Sensor: battery_soc
INFLUX_SENSOR_BATTERY_SOC=SENEC:bat_fuel_charge

# Sensor: wallbox_power
INFLUX_SENSOR_WALLBOX_POWER=SENEC:wallbox_charge_power

# Sensor: wallbox_car_connected
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=SENEC:ev_connected

# Sensor: case_temp
INFLUX_SENSOR_CASE_TEMP=SENEC:case_temp

# Sensor: system_status
INFLUX_SENSOR_SYSTEM_STATUS=SENEC:current_state

# Sensor: system_status_ok
INFLUX_SENSOR_SYSTEM_STATUS_OK=SENEC:current_state_ok

# Sensor: inverter_power_forecast
INFLUX_SENSOR_INVERTER_POWER_FORECAST=forecast:watt

# Sensor: inverter_power_forecast_clearsky
INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY=forecast:watt_clearsky

# Sensor: outdoor_temp_forecast
INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST=forecast:temp

# Sensor: custom_power_01
INFLUX_SENSOR_CUSTOM_POWER_01=Fridge:power

# Sensor: custom_power_02
INFLUX_SENSOR_CUSTOM_POWER_02=Dishwasher:power

# Sensor: custom_power_03
INFLUX_SENSOR_CUSTOM_POWER_03=Washer:power

# Sensor: custom_power_04
INFLUX_SENSOR_CUSTOM_POWER_04=Oven:power

# Sensor: custom_power_05
INFLUX_SENSOR_CUSTOM_POWER_05=Dryer:power

# Sensor: custom_power_06
INFLUX_SENSOR_CUSTOM_POWER_06=Hob:power

# Sensor: custom_power_07
INFLUX_SENSOR_CUSTOM_POWER_07=Sauna:power

# Sensor: custom_power_08
INFLUX_SENSOR_CUSTOM_POWER_08=Pump22:power

# Sensor: custom_power_09
INFLUX_SENSOR_CUSTOM_POWER_09=Pump17:power

# Sensor: custom_power_10
INFLUX_SENSOR_CUSTOM_POWER_10=HeatingWC:power

# Sensor: custom_power_11
INFLUX_SENSOR_CUSTOM_POWER_11=Outdoor:power

# Sensor: custom_power_12
INFLUX_SENSOR_CUSTOM_POWER_12=Froster:power

# Sensor: custom_power_13
INFLUX_SENSOR_CUSTOM_POWER_13=TvBose:power

# Sensor: custom_power_14
INFLUX_SENSOR_CUSTOM_POWER_14=TroTec:power

# Sensor: custom_power_15
INFLUX_SENSOR_CUSTOM_POWER_15=Office:power

# Sensor: custom_power_16
INFLUX_SENSOR_CUSTOM_POWER_16=Lighting:power

# Sensor: custom_power_17
INFLUX_SENSOR_CUSTOM_POWER_17=Utility:power

