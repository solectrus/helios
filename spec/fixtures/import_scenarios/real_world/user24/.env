# ============================================================
# DO NOT EDIT THIS FILE.
#
# This file is generated by HELIOS. Any manual change WILL be
# overwritten — silently, without backup — the next time HELIOS
# applies a configuration. In the worst case your edit breaks
# the stack and HELIOS can no longer recover it.
#
# Change every setting through the HELIOS web interface.
#
# Missing a setting? HELIOS is actively developed and can be
# extended — suggest it at:
# https://github.com/solectrus/helios/issues
#
# HELIOS fits the vast majority of setups. For a very
# specialized configuration, managing compose.yaml + .env
# by hand instead remains a valid alternative.
# ============================================================

#
# +----------------------------------------------------------+
# |  General settings                                        |
# +----------------------------------------------------------+
#

# Timezone for all services (IANA format, e.g. Europe/Berlin)
TZ=Europe/Berlin

# Date of first solar installation (YYYY-MM-DD) — used for statistics and charts
INSTALLATION_DATE=2023-08-02

# Currency for monetary values in the dashboard (ISO 4217 code, e.g. EUR, CHF, USD)
CURRENCY=EUR

#
# +----------------------------------------------------------+
# |  Security                                                |
# +----------------------------------------------------------+
#

# Admin password — shared by Dashboard and HELIOS
ADMIN_PASSWORD=KKKKK

# Secret key for Rails sessions — shared by Dashboard and HELIOS
SECRET_KEY_BASE=BBBBB

#
# +----------------------------------------------------------+
# |  Dashboard                                               |
# +----------------------------------------------------------+
#

# Hostname for the SOLECTRUS web interface
APP_HOST=10.31.22.46

# Must be TRUE only when a reverse proxy terminates TLS in front of the dashboard
FORCE_SSL=false

# Number of Puma worker processes (0 = single-process mode, sufficient for most setups)
WEB_CONCURRENCY=0

#
# +----------------------------------------------------------+
# |  PostgreSQL database                                     |
# +----------------------------------------------------------+
#

# Database password — auto-generated, do not change after first start
POSTGRES_PASSWORD=CCCCC

# Volume path for storing the PostgreSQL data
DB_VOLUME_PATH=/home/pi/solectrus/postgresql

#
# +----------------------------------------------------------+
# |  InfluxDB time-series database                           |
# +----------------------------------------------------------+
#

# Admin password — auto-generated, do not change after first start
INFLUX_PASSWORD=DDDDD

# Organization name
INFLUX_ORG=AAAAA

# Bucket (database) name for time-series data
INFLUX_BUCKET=EEEEE

# Admin token — used by InfluxDB init and backup
INFLUX_ADMIN_TOKEN=FFFFF

# Read+write token — used by power-splitter
INFLUX_TOKEN_READWRITE=FFFFF

# Write token — used by all collectors
INFLUX_TOKEN_WRITE=FFFFF

# Read token — used by the dashboard
INFLUX_TOKEN_READ=FFFFF

# Volume path for storing the InfluxDB data
INFLUX_VOLUME_PATH=/home/pi/solectrus/influxdb

#
# +----------------------------------------------------------+
# |  Redis cache                                             |
# +----------------------------------------------------------+
#

# Volume path for storing the Redis data
REDIS_VOLUME_PATH=/home/pi/solectrus/redis

#
# +----------------------------------------------------------+
# |  Power Splitter                                          |
# +----------------------------------------------------------+
#

# Recalculation interval in seconds
POWER_SPLITTER_INTERVAL=300

#
# +----------------------------------------------------------+
# |  Forecast                                                |
# +----------------------------------------------------------+
#

# Forecast provider
FORECAST_PROVIDER=pvnode

# Solar panel latitude
FORECAST_LATITUDE=51.00000

# Solar panel longitude
FORECAST_LONGITUDE=6.00000

# Roof tilt angle
FORECAST_DECLINATION=44

# Roof orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_AZIMUTH=208

# System capacity in kWp
FORECAST_KWP=13.4

# pvnode API key
PVNODE_APIKEY=GGGGG

# InfluxDB measurement name for forecasts
INFLUX_MEASUREMENT_FORECAST=Forecast

#
# +----------------------------------------------------------+
# |  MQTT broker                                             |
# +----------------------------------------------------------+
#

# MQTT broker hostname
MQTT_HOST=10.31.22.46

# MQTT broker port
MQTT_PORT=1883

# Enable SSL for MQTT connection
MQTT_SSL=false

# MQTT broker username
MQTT_USERNAME=HHHHH

# MQTT broker password
MQTT_PASSWORD=JJJJJ

# --- Mapping 0 for BATTERY_CHARGING_POWER

MAPPING_0_TOPIC=evcc/site/battery/devices/1/power
MAPPING_0_MEASUREMENT=my-pv-measurement
MAPPING_0_FIELD=bat_power_plus
MAPPING_0_TYPE=integer
MAPPING_0_FORMULA='IF({value} < 0, -{value}, 0)'

# --- Mapping 1 for BATTERY_DISCHARGING_POWER

MAPPING_1_TOPIC=evcc/site/battery/devices/1/power
MAPPING_1_MEASUREMENT=my-pv-measurement
MAPPING_1_FIELD=bat_power_minus
MAPPING_1_TYPE=integer
MAPPING_1_FORMULA='IF({value} > 0, {value}, 0)'

# --- Mapping 2 for BATTERY_SOC

MAPPING_2_TOPIC=evcc/site/battery/devices/1/soc
MAPPING_2_MEASUREMENT=my-pv-measurement
MAPPING_2_FIELD=bat_fuel_charge
MAPPING_2_TYPE=float

# --- Mapping 3 for CAR_BATTERY_SOC

MAPPING_3_TOPIC=evcc/loadpoints/1/vehicleSoc
MAPPING_3_MEASUREMENT=my-pv-measurement
MAPPING_3_FIELD=evoque_soc
MAPPING_3_TYPE=float

# --- Mapping 4 for CASE_TEMP

MAPPING_4_TOPIC=ems-esp/boiler_data
MAPPING_4_MEASUREMENT=my-pv-measurement
MAPPING_4_FIELD=case_temp
MAPPING_4_TYPE=float
MAPPING_4_JSON_PATH='$.curflowtemp'

# --- Mapping 5 for CUSTOM_POWER_03

MAPPING_5_TOPIC=Buderus/Allgemeinstrom
MAPPING_5_MEASUREMENT=strom
MAPPING_5_FIELD=allgemeinstrom
MAPPING_5_TYPE=float

# --- Mapping 6 for GRID_EXPORT_POWER

MAPPING_6_TOPIC=evcc/site/grid/power
MAPPING_6_MEASUREMENT=my-pv-measurement
MAPPING_6_FIELD=grid_power_minus
MAPPING_6_TYPE=integer
MAPPING_6_FORMULA='IF({value} < 0, -{value}, 0)'

# --- Mapping 7 for GRID_IMPORT_POWER

MAPPING_7_TOPIC=evcc/site/grid/power
MAPPING_7_MEASUREMENT=my-pv-measurement
MAPPING_7_FIELD=grid_power_plus
MAPPING_7_TYPE=integer
MAPPING_7_FORMULA='IF({value} > 0, {value}, 0)'

# --- Mapping 8 for HEATPUMP_HEATING_POWER

MAPPING_8_TOPIC=Buderus/Kompressor_power
MAPPING_8_MEASUREMENT=my-pv-measurement
MAPPING_8_FIELD=Buderus_Kompressor_power
MAPPING_8_TYPE=float

# --- Mapping 9 for HEATPUMP_POWER

MAPPING_9_TOPIC=evcc/loadpoints/2/chargePower
MAPPING_9_MEASUREMENT=my-pv-measurement
MAPPING_9_FIELD=heatpump_power
MAPPING_9_TYPE=integer

# --- Mapping 10 for HEATPUMP_STATUS

MAPPING_10_TOPIC=Buderus/Kompressor_Status
MAPPING_10_MEASUREMENT=my-pv-measurement
MAPPING_10_FIELD=kompressor_status
MAPPING_10_TYPE=string

# --- Mapping 11 for HEATPUMP_TANK_TEMP

MAPPING_11_TOPIC=Buderus/curtemp
MAPPING_11_MEASUREMENT=my-pv-measurement
MAPPING_11_FIELD=Buderus_warmwasser
MAPPING_11_TYPE=float

# --- Mapping 12 for HOUSE_POWER

MAPPING_12_TOPIC=evcc/site/homePower
MAPPING_12_MEASUREMENT=my-pv-measurement
MAPPING_12_FIELD=house_power
MAPPING_12_TYPE=integer

# --- Mapping 13 for INVERTER_POWER

MAPPING_13_TOPIC=evcc/site/pvPower
MAPPING_13_MEASUREMENT=my-pv-measurement
MAPPING_13_FIELD=inverter_power
MAPPING_13_TYPE=integer

# --- Mapping 14 for OUTDOOR_TEMP

MAPPING_14_TOPIC=Buderus/outdoortemp
MAPPING_14_MEASUREMENT=my-pv-measurement
MAPPING_14_FIELD=Buderus_outdoortemp
MAPPING_14_TYPE=float

# --- Mapping 15 for WALLBOX_CAR_CONNECTED

MAPPING_15_TOPIC=evcc/loadpoints/1/connected
MAPPING_15_MEASUREMENT=my-pv-measurement
MAPPING_15_FIELD=evoque_connect
MAPPING_15_TYPE=boolean

# --- Mapping 16 for WALLBOX_POWER

MAPPING_16_TOPIC=evcc/loadpoints/1/chargePower
MAPPING_16_MEASUREMENT=my-pv-measurement
MAPPING_16_FIELD=wallbox_charge_power
MAPPING_16_TYPE=integer

#
# +----------------------------------------------------------+
# |  Shelly collector                                        |
# +----------------------------------------------------------+
#

# Polling interval in seconds
SHELLY_INTERVAL=5

# Shelly device hostnames (comma-separated)
SHELLY_HOST=10.31.22.95,10.31.22.62,10.31.22.36,10.31.22.42,10.31.22.67,10.31.22.35,10.31.22.90,10.31.22.55

# InfluxDB measurement names (comma-separated)
INFLUX_MEASUREMENT=cooler,dish,dryer,freezer,pctechnik,wash,wine,wztechnik

# InfluxDB write mode (default or essential)
INFLUX_MODE=essential

#
# +----------------------------------------------------------+
# |  Watchtower (automatic Docker image updates)             |
# +----------------------------------------------------------+
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

#
# +----------------------------------------------------------+
# |  Sensor mappings                                         |
# +----------------------------------------------------------+
#

# Sensor: inverter_power
INFLUX_SENSOR_INVERTER_POWER=my-pv-measurement:inverter_power

# Sensor: grid_import_power
INFLUX_SENSOR_GRID_IMPORT_POWER=my-pv-measurement:grid_power_plus

# Sensor: grid_export_power
INFLUX_SENSOR_GRID_EXPORT_POWER=my-pv-measurement:grid_power_minus

# Sensor: grid_export_limit
INFLUX_SENSOR_GRID_EXPORT_LIMIT=my-pv-measurement:power_ratio

# Sensor: house_power
INFLUX_SENSOR_HOUSE_POWER=my-pv-measurement:house_power

# Sensor: battery_charging_power
INFLUX_SENSOR_BATTERY_CHARGING_POWER=my-pv-measurement:bat_power_plus

# Sensor: battery_discharging_power
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=my-pv-measurement:bat_power_minus

# Sensor: battery_soc
INFLUX_SENSOR_BATTERY_SOC=my-pv-measurement:bat_fuel_charge

# Sensor: wallbox_power
INFLUX_SENSOR_WALLBOX_POWER=my-pv-measurement:wallbox_charge_power

# Sensor: wallbox_car_connected
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=my-pv-measurement:evoque_connect

# Sensor: car_battery_soc
INFLUX_SENSOR_CAR_BATTERY_SOC=my-pv-measurement:evoque_soc

# Sensor: heatpump_power
INFLUX_SENSOR_HEATPUMP_POWER=my-pv-measurement:heatpump_power

# Sensor: heatpump_heating_power
INFLUX_SENSOR_HEATPUMP_HEATING_POWER=my-pv-measurement:Buderus_Kompressor_power

# Sensor: heatpump_tank_temp
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=my-pv-measurement:Buderus_warmwasser

# Sensor: heatpump_status
INFLUX_SENSOR_HEATPUMP_STATUS=my-pv-measurement:kompressor_status

# Sensor: case_temp
INFLUX_SENSOR_CASE_TEMP=my-pv-measurement:case_temp

# Sensor: outdoor_temp
INFLUX_SENSOR_OUTDOOR_TEMP=my-pv-measurement:Buderus_outdoortemp

# Sensor: system_status
INFLUX_SENSOR_SYSTEM_STATUS=my-pv-measurement:kompressor_status

# Sensor: system_status_ok
INFLUX_SENSOR_SYSTEM_STATUS_OK=my-pv-measurement:current_state_ok

# Sensor: inverter_power_forecast
INFLUX_SENSOR_INVERTER_POWER_FORECAST=Forecast:watt

# Sensor: inverter_power_forecast_clearsky
INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY=Forecast:watt_clearsky

# Sensor: outdoor_temp_forecast
INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST=Forecast:temp

# Sensor: custom_power_01
INFLUX_SENSOR_CUSTOM_POWER_01=wash:power

# Sensor: custom_power_02
INFLUX_SENSOR_CUSTOM_POWER_02=dryer:power

# Sensor: custom_power_03
INFLUX_SENSOR_CUSTOM_POWER_03=strom:allgemeinstrom

# Sensor: custom_power_04
INFLUX_SENSOR_CUSTOM_POWER_04=dish:power

# Sensor: custom_power_05
INFLUX_SENSOR_CUSTOM_POWER_05=cooler:power

# Sensor: custom_power_06
INFLUX_SENSOR_CUSTOM_POWER_06=wztechnik:power

# Sensor: custom_power_07
INFLUX_SENSOR_CUSTOM_POWER_07=pctechnik:power

# Sensor: custom_power_08
INFLUX_SENSOR_CUSTOM_POWER_08=freezer:power

# Sensor: custom_power_09
INFLUX_SENSOR_CUSTOM_POWER_09=wine:power

#
# +--------------------------------------------------------------+
# |  Unmanaged variables (preserved from existing installation)  |
# +--------------------------------------------------------------+
#

SHELLY_GEN_DRYER=1

SHELLY_GEN_WASH=1

SHELLY_GEN_DISH=2

SHELLY_GEN_COOLER=2

SHELLY_GEN_WZTECHNIK=2

SHELLY_GEN_PCTECHNIK=3

SHELLY_GEN_FREEZER=3

SHELLY_GEN_WINE=3

