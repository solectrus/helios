services:
  traefik:
    image: "traefik:v3"
    command:
      - "--log.level=DEBUG"
      - "--api.insecure=false"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.influxdb.address=:8086"
      - "--entrypoints.pgadmin.address=:8888"
      - "--entrypoints.dozzle.address=:9090"
      - "--entrypoints.mqtt.address=:8883"
      - "--entrypoints.web.http.redirections.entrypoint.to=websecure"
      - "--entrypoints.web.http.redirections.entrypoint.scheme=https"
      - "--certificatesresolvers.myresolver.acme.tlschallenge=true"
      - "--certificatesresolvers.myresolver.acme.email=postmaster@example.com"
      - "--certificatesresolvers.myresolver.acme.storage=/letsencrypt/acme.json"
    ports:
      - "80:80"
      - "443:443"
      - "8086:8086"
      - "9090:9090"
      - "8883:8883"
      - "8888:8888"
    volumes:
      - "./letsencrypt:/letsencrypt"
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
    restart: always
    environment:
      - TZ
    logging:
      options:
        max-size: 10m
        max-file: '3'
    labels:
      - "com.centurylinklabs.watchtower.scope=solectrus"

  dashboard:
    image: ghcr.io/solectrus/solectrus:develop
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.app-solectrus.rule=Host(`solectrus.example.com`)"
      - "traefik.http.routers.app-solectrus.entrypoints=websecure"
      - "traefik.http.routers.app-solectrus.tls.certresolver=myresolver"
      - "traefik.http.middlewares.test-ratelimit.ratelimit.average=100"
      - "traefik.http.middlewares.test-ratelimit.ratelimit.burst=200"
      - "com.centurylinklabs.watchtower.scope=solectrus"
    depends_on:
      traefik:
        condition: service_started
      postgresql:
        condition: service_healthy
      influxdb:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      - TZ
      - APP_HOST
      - FORCE_SSL
      - SECRET_KEY_BASE
      - INSTALLATION_DATE
      - ELECTRICITY_PRICE
      - FEED_IN_TARIFF
      - ADMIN_PASSWORD
      - DB_HOST=postgresql
      - DB_PASSWORD=${POSTGRES_PASSWORD}
      - DB_USER=postgres
      - REDIS_URL=redis://redis:6379/1
      - INFLUX_HOST
      - INFLUX_TOKEN=${INFLUX_TOKEN_READ}
      - INFLUX_ORG
      - INFLUX_BUCKET
      - INFLUX_PORT
      - INFLUX_SCHEMA
      - INFLUX_SENSOR_INVERTER_POWER
      - INFLUX_SENSOR_INVERTER_POWER_1
      - INFLUX_SENSOR_INVERTER_POWER_2
      - INFLUX_SENSOR_INVERTER_POWER_FORECAST
      - INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY
      - INFLUX_SENSOR_HOUSE_POWER
      - INFLUX_SENSOR_GRID_IMPORT_POWER
      - INFLUX_SENSOR_GRID_EXPORT_POWER
      - INFLUX_SENSOR_GRID_EXPORT_LIMIT
      - INFLUX_SENSOR_BATTERY_CHARGING_POWER
      - INFLUX_SENSOR_BATTERY_DISCHARGING_POWER
      - INFLUX_SENSOR_BATTERY_SOC
      - INFLUX_SENSOR_WALLBOX_POWER
      - INFLUX_SENSOR_CASE_TEMP
      - INFLUX_SENSOR_SYSTEM_STATUS
      - INFLUX_SENSOR_SYSTEM_STATUS_OK
      - INFLUX_SENSOR_CAR_BATTERY_SOC
      - INFLUX_SENSOR_WALLBOX_CAR_CONNECTED
      - INFLUX_SENSOR_CUSTOM_POWER_01
      - INFLUX_SENSOR_CUSTOM_POWER_02
      - INFLUX_SENSOR_CUSTOM_POWER_03
      - INFLUX_SENSOR_CUSTOM_POWER_04
      - INFLUX_SENSOR_CUSTOM_POWER_05
      - INFLUX_SENSOR_CUSTOM_POWER_06
      - INFLUX_SENSOR_CUSTOM_POWER_07
      - INFLUX_SENSOR_CUSTOM_POWER_08
      - INFLUX_SENSOR_CUSTOM_POWER_09
      - INFLUX_SENSOR_CUSTOM_POWER_10
      - INFLUX_SENSOR_HEATPUMP_POWER
      - INFLUX_EXCLUDE_FROM_HOUSE_POWER
      - INFLUX_SENSOR_HEATPUMP_HEATING_POWER
      - INFLUX_SENSOR_OUTDOOR_TEMP
      - INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST
      - INFLUX_SENSOR_HEATPUMP_TANK_TEMP

    healthcheck:
      test: ['CMD-SHELL', 'nc -z 127.0.0.1 3000 || exit 1']
    restart: always
    logging:
      options:
        max-size: 10m
        max-file: '3'

  influxdb:
    image: influxdb:2.8-alpine
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.influxdb-solectrus.rule=Host(`solectrus.example.com`)"
      - "traefik.http.routers.influxdb-solectrus.entrypoints=influxdb"
      - "traefik.http.routers.influxdb-solectrus.tls.certresolver=myresolver"
      - "traefik.http.routers.influxdb-solectrus.tls=true"
      - "com.centurylinklabs.watchtower.scope=solectrus"
    volumes:
      - ${INFLUX_VOLUME_PATH}:/var/lib/influxdb2
    environment:
      - TZ
      - DOCKER_INFLUXDB_INIT_MODE=setup
      - DOCKER_INFLUXDB_INIT_USERNAME=${INFLUX_USERNAME}
      - DOCKER_INFLUXDB_INIT_PASSWORD=${INFLUX_PASSWORD}
      - DOCKER_INFLUXDB_INIT_ORG=${INFLUX_ORG}
      - DOCKER_INFLUXDB_INIT_BUCKET=${INFLUX_BUCKET}
      - DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=${INFLUX_ADMIN_TOKEN}
    command: influxd run --bolt-path /var/lib/influxdb2/influxd.bolt --engine-path /var/lib/influxdb2/engine --store disk
    restart: always
    healthcheck:
      test: ['CMD', 'influx', 'ping']
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
    logging:
      options:
        max-size: 10m
        max-file: '3'

  postgresql:
    image: postgres:18-alpine
    environment:
      - TZ
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
    volumes:
      - ${DB_VOLUME_PATH}:/var/lib/postgresql
    restart: always
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U postgres']
      interval: 10s
      timeout: 20s
      retries: 5
      start_period: 60s
    logging:
      options:
        max-size: 10m
        max-file: '3'
    labels:
      - "com.centurylinklabs.watchtower.scope=solectrus"

  dozzle:
    image: amir20/dozzle:latest
    restart: always
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./dozzle/data:/data
    environment:
      DOZZLE_AUTH_PROVIDER: simple
    logging:
      options:
        max-size: 10m
        max-file: '3'
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.dozzle-solectrus.rule=Host(`solectrus.example.com`)"
      - "traefik.http.routers.dozzle-solectrus.entrypoints=dozzle"
      - "traefik.http.routers.dozzle-solectrus.tls.certresolver=myresolver"
      - "traefik.http.routers.dozzle-solectrus.tls=true"
      - "com.centurylinklabs.watchtower.scope=solectrus"

  pgadmin:
    image: dpage/pgadmin4
    restart: always
    environment:
      - TZ
      - PGADMIN_DEFAULT_EMAIL=pgadmin_email
      - PGADMIN_DEFAULT_PASSWORD=pgadmin_password
      - PGADMIN_ENABLE_TLS
    depends_on:
      postgresql:
        condition: service_healthy
    volumes:
      - ./pgAdmin:/var/lib/pgadmin
    logging:
      options:
        max-size: 10m
        max-file: '3'
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.pgadmin-solectrus.rule=Host(`solectrus.example.com`)"
      - "traefik.http.routers.pgadmin-solectrus.entrypoints=pgadmin"
      - "traefik.http.routers.pgadmin-solectrus.tls.certresolver=myresolver"
      - "traefik.http.routers.pgadmin-solectrus.tls=true"
      - "traefik.tcp.routers.pgadmin.service=pgadminservice"
      - "traefik.tcp.services.pgadminservice.loadbalancer.server.port=80"
      - "com.centurylinklabs.watchtower.scope=solectrus"

  redis:
    image: redis:8-alpine
    volumes:
      - ${REDIS_VOLUME_PATH}:/data
    environment:
      - TZ
    restart: always
    healthcheck:
      test: ['CMD', 'redis-cli', 'ping']
      interval: 10s
      timeout: 20s
      retries: 5
      start_period: 60s
    logging:
      options:
        max-size: 10m
        max-file: '3'
    labels:
      - "com.centurylinklabs.watchtower.scope=solectrus"

  forecast-collector:
    image: ghcr.io/solectrus/forecast-collector:latest
    depends_on:
      influxdb:
        condition: service_healthy
    environment:
      - TZ
      - INFLUX_HOST
      - INFLUX_TOKEN=${INFLUX_TOKEN_WRITE}
      - INFLUX_ORG
      - INFLUX_BUCKET
      - INFLUX_MEASUREMENT=${INFLUX_MEASUREMENT_FORECAST}
      - INFLUX_PORT
      - INFLUX_SCHEMA
      - FORECAST_INTERVAL
      - FORECAST_PROVIDER
      - FORECAST_CONFIGURATIONS
      - FORECAST_LATITUDE
      - FORECAST_LONGITUDE
      - FORECAST_DECLINATION
      - FORECAST_0_AZIMUTH
      - FORECAST_1_AZIMUTH
      - FORECAST_0_KWP
      - FORECAST_1_KWP
      - PVNODE_APIKEY
      - PVNODE_EXTRA_PARAMS
      - PVNODE_PAID
    restart: always
    logging:
      options:
        max-size: 10m
        max-file: '3'
    labels:
      - "com.centurylinklabs.watchtower.scope=solectrus"

  power-splitter:
    image: ghcr.io/solectrus/power-splitter:latest
    labels:
      - "com.centurylinklabs.watchtower.scope=solectrus"
    environment:
      - TZ
      - INFLUX_HOST
      - INFLUX_SCHEMA
      - INFLUX_TOKEN=${INFLUX_ADMIN_TOKEN}
      - INFLUX_PORT
      - INFLUX_ORG
      - INFLUX_BUCKET
      - INFLUX_SENSOR_HOUSE_POWER
      - INFLUX_SENSOR_GRID_IMPORT_POWER
      - INFLUX_SENSOR_WALLBOX_POWER
      - INFLUX_SENSOR_HEATPUMP_POWER
      - INFLUX_SENSOR_BATTERY_CHARGING_POWER
      - INFLUX_SENSOR_CUSTOM_POWER_01
      - INFLUX_SENSOR_CUSTOM_POWER_02
      - INFLUX_SENSOR_CUSTOM_POWER_03
      - INFLUX_SENSOR_CUSTOM_POWER_04
      - INFLUX_SENSOR_CUSTOM_POWER_05
      - INFLUX_SENSOR_CUSTOM_POWER_06
      - INFLUX_SENSOR_CUSTOM_POWER_07
      - INFLUX_SENSOR_CUSTOM_POWER_08
      - INFLUX_SENSOR_CUSTOM_POWER_09
      - INFLUX_SENSOR_CUSTOM_POWER_10
      - INFLUX_EXCLUDE_FROM_HOUSE_POWER
      - INSTALLATION_DATE
      - POWER_SPLITTER_INTERVAL
      - REDIS_URL=redis://redis:6379/1
      - DB_HOST=postgresql
      - DB_PASSWORD=${POSTGRES_PASSWORD}
      - DB_USER=postgres
    depends_on:
      influxdb:
        condition: service_healthy
      redis:
        condition: service_healthy
    logging:
      options:
        max-size: 10m
        max-file: '3'
    restart: always

  watchtower:
    image: nickfedor/watchtower
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - TZ
      - WATCHTOWER_CLEANUP
      - WATCHTOWER_SCHEDULE
      - WATCHTOWER_SCOPE
    restart: always
    logging:
      options:
        max-size: 10m
        max-file: '3'
    labels:
      - "com.centurylinklabs.watchtower.scope=solectrus"

  mosquitto:
    image: eclipse-mosquitto
    restart: always
    environment:
      - TZ
    expose:
      - 1883
      - 8883
    volumes:
       - "./mosquitto:/mosquitto"
       - "./mosquitto/data:/mosquitto/data"
    labels:
      - "traefik.enable=true"
      - "traefik.tcp.routers.mqtt.rule=HostSNI(`solectrus.example.com`)"
      - "traefik.tcp.routers.mqtt.entrypoints=mqtt"
      - "traefik.tcp.routers.mqtt.service=mqttservice"
      - "traefik.tcp.routers.mqtt.tls=true"
      - "traefik.tcp.services.mqttservice.loadbalancer.server.port=8883"
      
      - "com.centurylinklabs.watchtower.scope=solectrus"
    logging:
      options:
        max-size: 10m
        max-file: '3'

  mqtt-collector:
    image: ghcr.io/solectrus/mqtt-collector:latest
    privileged: true
    restart: always
    depends_on:
      mosquitto:
        condition: service_started
      influxdb:
        condition: service_healthy
    labels:
      - "com.centurylinklabs.watchtower.scope=solectrus"
    logging:
      options:
        max-size: 10m
        max-file: '3'
    environment:
      - TZ
      - MQTT_HOST
      - MQTT_PORT
      - MQTT_SSL
      - MQTT_USERNAME
      - MQTT_PASSWORD
      - MAPPING_0_TOPIC
      - MAPPING_0_MEASUREMENT
      - MAPPING_0_FIELD
      - MAPPING_0_TYPE
      - MAPPING_1_TOPIC
      - MAPPING_1_MEASUREMENT
      - MAPPING_1_FIELD
      - MAPPING_1_TYPE
      - MAPPING_2_TOPIC
      - MAPPING_2_MEASUREMENT
      - MAPPING_2_FIELD
      - MAPPING_2_TYPE
      - MAPPING_2_JSON_KEY
      - MAPPING_3_TOPIC
      - MAPPING_3_MEASUREMENT
      - MAPPING_3_FIELD
      - MAPPING_3_TYPE
      - MAPPING_3_JSON_KEY
      - MAPPING_4_TOPIC
      - MAPPING_4_MEASUREMENT
      - MAPPING_4_FIELD
      - MAPPING_4_TYPE
      - MAPPING_4_JSON_KEY
      - MAPPING_5_TOPIC
      - MAPPING_5_MEASUREMENT
      - MAPPING_5_FIELD
      - MAPPING_5_TYPE
      - MAPPING_5_JSON_KEY
      - MAPPING_6_TOPIC
      - MAPPING_6_MEASUREMENT
      - MAPPING_6_FIELD
      - MAPPING_6_TYPE
      - MAPPING_6_JSON_KEY
      - MAPPING_7_TOPIC
      - MAPPING_7_MEASUREMENT
      - MAPPING_7_FIELD
      - MAPPING_7_TYPE
      - MAPPING_7_JSON_PATH
      - MAPPING_8_TOPIC
      - MAPPING_8_MEASUREMENT
      - MAPPING_8_FIELD
      - MAPPING_8_TYPE
      - MAPPING_8_JSON_PATH
      - MAPPING_9_TOPIC
      - MAPPING_9_MEASUREMENT
      - MAPPING_9_FIELD
      - MAPPING_9_TYPE
      - MAPPING_9_JSON_KEY
      - MAPPING_10_TOPIC
      - MAPPING_10_MEASUREMENT
      - MAPPING_10_FIELD
      - MAPPING_10_TYPE
      - MAPPING_11_TOPIC
      - MAPPING_11_MEASUREMENT
      - MAPPING_11_FIELD
      - MAPPING_11_TYPE
      - MAPPING_12_TOPIC
      - MAPPING_12_MEASUREMENT
      - MAPPING_12_FIELD
      - MAPPING_12_TYPE
      - MAPPING_13_TOPIC
      - MAPPING_13_MEASUREMENT
      - MAPPING_13_FIELD
      - MAPPING_13_TYPE
      - MAPPING_14_TOPIC
      - MAPPING_14_MEASUREMENT
      - MAPPING_14_FIELD
      - MAPPING_14_TYPE
      - INFLUX_HOST
      - INFLUX_SCHEMA
      - INFLUX_PORT
      - INFLUX_TOKEN=${INFLUX_TOKEN_WRITE}
      - INFLUX_ORG
      - INFLUX_BUCKET
