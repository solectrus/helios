# ============================================================
# DO NOT EDIT THIS FILE.
#
# This file is generated by HELIOS. Any manual change WILL be
# overwritten — silently, without backup — the next time HELIOS
# applies a configuration. In the worst case your edit breaks
# the stack and HELIOS can no longer recover it.
#
# Change every setting through the HELIOS web interface.
#
# Need something HELIOS does not expose? Then HELIOS is no longer
# the right tool for your stack: uninstall HELIOS and manage
# compose.yaml + .env by hand.
# ============================================================

#
# ┌──────────────────────────────────────────────────────────┐
# │  General settings                                        │
# └──────────────────────────────────────────────────────────┘
#

# Timezone for all services (IANA format, e.g. Europe/Berlin)
TZ=Europe/Berlin

# Date of first solar installation (YYYY-MM-DD) — used for statistics and charts
INSTALLATION_DATE=2023-08-01

#
# ┌──────────────────────────────────────────────────────────┐
# │  Security                                                │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — shared by Dashboard and HELIOS
ADMIN_PASSWORD=admin_password

# Secret key for Rails sessions — shared by Dashboard and HELIOS
SECRET_KEY_BASE=745xyz

#
# ┌──────────────────────────────────────────────────────────┐
# │  Dashboard                                               │
# └──────────────────────────────────────────────────────────┘
#

# Hostname for the SOLECTRUS web interface
APP_HOST=solectrus.example.com

# Must be FALSE, unless Traefik terminates TLS in front of the dashboard
FORCE_SSL=true

# Number of Puma worker processes (0 = single-process mode, sufficient for most setups)
WEB_CONCURRENCY=0

# How often the Dashboard polls InfluxDB for live values, in seconds
INFLUX_POLL_INTERVAL=5

# Sensors excluded from house power calculation
INFLUX_EXCLUDE_FROM_HOUSE_POWER=HEATPUMP_POWER

#
# ┌──────────────────────────────────────────────────────────┐
# │  PostgreSQL database                                     │
# └──────────────────────────────────────────────────────────┘
#

# Database password — auto-generated, do not change after first start
POSTGRES_PASSWORD=my-secret-db-password

# Volume path for storing the PostgreSQL data
DB_VOLUME_PATH=./postgresql

#
# ┌──────────────────────────────────────────────────────────┐
# │  InfluxDB time-series database                           │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — auto-generated, do not change after first start
INFLUX_PASSWORD=influx-password

# Organization name
INFLUX_ORG=solectrus

# Bucket (database) name for time-series data
INFLUX_BUCKET=solectrus

# Admin token — used by InfluxDB init and backup
INFLUX_ADMIN_TOKEN=influx-token

# Read+write token — used by power-splitter
INFLUX_TOKEN_READWRITE=influx-token

# Write token — used by all collectors
INFLUX_TOKEN_WRITE=influx-token

# Read token — used by the dashboard
INFLUX_TOKEN_READ=influx-token

# Volume path for storing the InfluxDB data
INFLUX_VOLUME_PATH=./influxdb

#
# ┌──────────────────────────────────────────────────────────┐
# │  Redis cache                                             │
# └──────────────────────────────────────────────────────────┘
#

# Volume path for storing the Redis data
REDIS_VOLUME_PATH=./redis

#
# ┌──────────────────────────────────────────────────────────┐
# │  Reverse Proxy (Traefik)                                 │
# └──────────────────────────────────────────────────────────┘
#

# Domain for HTTPS access via Traefik
APP_DOMAIN=solectrus.example.com

# Email for Let's Encrypt certificate notifications
LETSENCRYPT_EMAIL=webmaster@solectrus.example.com

# Volume path for storing the Let's Encrypt certificates
TRAEFIK_VOLUME_PATH=./traefik

#
# ┌──────────────────────────────────────────────────────────┐
# │  Power Splitter                                          │
# └──────────────────────────────────────────────────────────┘
#

# Recalculation interval in seconds (min 300)
POWER_SPLITTER_INTERVAL=300

#
# ┌──────────────────────────────────────────────────────────┐
# │  Forecast                                                │
# └──────────────────────────────────────────────────────────┘
#

# Forecast provider
FORECAST_PROVIDER=pvnode

# Solar panel latitude
FORECAST_LATITUDE=50

# Solar panel longitude
FORECAST_LONGITUDE=7

# Forecast update interval in seconds
FORECAST_INTERVAL=900

# Number of roof surfaces
FORECAST_CONFIGURATIONS=2

# Roof surface 1 tilt angle
FORECAST_0_DECLINATION=30

# Roof surface 1 orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_0_AZIMUTH=267.5

# Roof surface 1 capacity in kWp
FORECAST_0_KWP=4.45

# Roof surface 2 tilt angle
FORECAST_1_DECLINATION=30

# Roof surface 2 orientation (0=N, 90=E, 180=S, 270=W)
FORECAST_1_AZIMUTH=87.5

# Roof surface 2 capacity in kWp
FORECAST_1_KWP=4.86

# pvnode API key
PVNODE_APIKEY=pvn_apikey

# pvnode paid plan — only set for paid accounts (true = Hobbyist, nowcast = Hobbyist with Nowcast)
PVNODE_PAID=true

# Additional pvnode parameters
PVNODE_EXTRA_PARAMS=diffuse_radiation_model=perez&mounting_type=isol&shading_config=5:3:1:3_2:2:0:1_5:3:1:3&panel_age_years=2

# InfluxDB measurement name for forecasts
INFLUX_MEASUREMENT_FORECAST=Forecast

#
# ┌──────────────────────────────────────────────────────────┐
# │  MQTT broker                                             │
# └──────────────────────────────────────────────────────────┘
#

# MQTT broker hostname
MQTT_HOST=mosquitto

# MQTT broker port
MQTT_PORT=1883

# Enable SSL for MQTT connection
MQTT_SSL=false

# MQTT broker username
MQTT_USERNAME=mqtt-user

# MQTT broker password
MQTT_PASSWORD=mqtt-password

# --- Mapping 0 for CAR_BATTERY_SOC

MAPPING_0_TOPIC=ds3/soc
MAPPING_0_MEASUREMENT=car
MAPPING_0_FIELD=soc
MAPPING_0_TYPE=integer

# --- Mapping 1 for CUSTOM_POWER_01

MAPPING_1_TOPIC=plug3/status/switch:0
MAPPING_1_MEASUREMENT=shellies
MAPPING_1_FIELD=hifi_power
MAPPING_1_TYPE=float
MAPPING_1_JSON_KEY=apower

# --- Mapping 2 for CUSTOM_POWER_02

MAPPING_2_TOPIC=plug1/status/switch:0
MAPPING_2_MEASUREMENT=shellies
MAPPING_2_FIELD=fridge_power
MAPPING_2_TYPE=float
MAPPING_2_JSON_KEY=apower

# --- Mapping 3 for CUSTOM_POWER_03

MAPPING_3_TOPIC=plug2/status/switch:0
MAPPING_3_MEASUREMENT=shellies
MAPPING_3_FIELD=computer_power
MAPPING_3_TYPE=float
MAPPING_3_JSON_KEY=apower

# --- Mapping 4 for CUSTOM_POWER_04

MAPPING_4_TOPIC=tele/tasmota_1/SENSOR
MAPPING_4_MEASUREMENT=shellies
MAPPING_4_FIELD=washing_power
MAPPING_4_TYPE=float
MAPPING_4_JSON_PATH='$.ENERGY.Power'

# --- Mapping 5 for CUSTOM_POWER_05

MAPPING_5_TOPIC=tele/tasmota_2/SENSOR
MAPPING_5_MEASUREMENT=shellies
MAPPING_5_FIELD=dryer_power
MAPPING_5_TYPE=float
MAPPING_5_JSON_PATH='$.ENERGY.Power'

# --- Mapping 6 for CUSTOM_POWER_06

MAPPING_6_TOPIC=plug4/status/switch:0
MAPPING_6_MEASUREMENT=shellies
MAPPING_6_FIELD=freezer_power
MAPPING_6_TYPE=float
MAPPING_6_JSON_KEY=apower

# --- Mapping 7 for CUSTOM_POWER_07

MAPPING_7_TOPIC=plug5/status/switch:0
MAPPING_7_MEASUREMENT=shellies
MAPPING_7_FIELD=fridge2_power
MAPPING_7_TYPE=float
MAPPING_7_JSON_KEY=apower

# --- Mapping 8 for HEATPUMP_HEATING_POWER

MAPPING_8_TOPIC=viessmann/generatedHeat
MAPPING_8_MEASUREMENT=viessmann
MAPPING_8_FIELD=generated_heat
MAPPING_8_TYPE=float

# --- Mapping 9 for HEATPUMP_POWER

MAPPING_9_TOPIC=shellypro3em/status/em:0
MAPPING_9_MEASUREMENT=shellies
MAPPING_9_FIELD=heatpump_power
MAPPING_9_TYPE=float
MAPPING_9_JSON_KEY=total_act_power

# --- Mapping 10 for HEATPUMP_TANK_TEMP

MAPPING_10_TOPIC=viessmann/tankTemp
MAPPING_10_MEASUREMENT=viessmann
MAPPING_10_FIELD=tank_temp
MAPPING_10_TYPE=float

# --- Mapping 11 for OUTDOOR_TEMP

MAPPING_11_TOPIC=viessmann/outsideTemp
MAPPING_11_MEASUREMENT=viessmann
MAPPING_11_FIELD=outside_temp
MAPPING_11_TYPE=float

# --- Mapping 12 (additional)

MAPPING_12_TOPIC=ds3/mileage
MAPPING_12_MEASUREMENT=car
MAPPING_12_FIELD=mileage
MAPPING_12_TYPE=integer

# --- Mapping 13 (additional)

MAPPING_13_TOPIC=viessmann/compressorStarts
MAPPING_13_MEASUREMENT=viessmann
MAPPING_13_FIELD=compressor_starts
MAPPING_13_TYPE=float

# --- Mapping 14 (additional)

MAPPING_14_TOPIC=viessmann/compressorHours
MAPPING_14_MEASUREMENT=viessmann
MAPPING_14_FIELD=compressor_hours
MAPPING_14_TYPE=float

#
# ┌──────────────────────────────────────────────────────────┐
# │  Watchtower (automatic Docker image updates)             │
# └──────────────────────────────────────────────────────────┘
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

#
# ┌──────────────────────────────────────────────────────────┐
# │  Sensor mappings                                         │
# └──────────────────────────────────────────────────────────┘
#

# Sensor: inverter_power_1
INFLUX_SENSOR_INVERTER_POWER_1=SENEC:mpp1_power

# Sensor: inverter_power_2
INFLUX_SENSOR_INVERTER_POWER_2=SENEC:mpp3_power

# Sensor: grid_import_power
INFLUX_SENSOR_GRID_IMPORT_POWER=SENEC:grid_power_plus

# Sensor: grid_export_power
INFLUX_SENSOR_GRID_EXPORT_POWER=SENEC:grid_power_minus

# Sensor: grid_export_limit
INFLUX_SENSOR_GRID_EXPORT_LIMIT=SENEC:power_ratio

# Sensor: house_power
INFLUX_SENSOR_HOUSE_POWER=SENEC:house_power

# Sensor: battery_charging_power
INFLUX_SENSOR_BATTERY_CHARGING_POWER=SENEC:bat_power_plus

# Sensor: battery_discharging_power
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=SENEC:bat_power_minus

# Sensor: battery_soc
INFLUX_SENSOR_BATTERY_SOC=SENEC:bat_fuel_charge

# Sensor: wallbox_power
INFLUX_SENSOR_WALLBOX_POWER=SENEC:wallbox_charge_power

# Sensor: wallbox_car_connected
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=SENEC:ev_connected

# Sensor: car_battery_soc
INFLUX_SENSOR_CAR_BATTERY_SOC=car:soc

# Sensor: heatpump_power
INFLUX_SENSOR_HEATPUMP_POWER=shellies:heatpump_power

# Sensor: heatpump_heating_power
INFLUX_SENSOR_HEATPUMP_HEATING_POWER=viessmann:generated_heat

# Sensor: heatpump_tank_temp
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=viessmann:tank_temp

# Sensor: case_temp
INFLUX_SENSOR_CASE_TEMP=SENEC:case_temp

# Sensor: outdoor_temp
INFLUX_SENSOR_OUTDOOR_TEMP=viessmann:outside_temp

# Sensor: system_status
INFLUX_SENSOR_SYSTEM_STATUS=SENEC:current_state

# Sensor: system_status_ok
INFLUX_SENSOR_SYSTEM_STATUS_OK=SENEC:current_state_ok

# Sensor: inverter_power_forecast
INFLUX_SENSOR_INVERTER_POWER_FORECAST=Forecast:watt

# Sensor: inverter_power_forecast_clearsky
INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY=Forecast:watt_clearsky

# Sensor: outdoor_temp_forecast
INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST=Forecast:temp

# Sensor: custom_power_01
INFLUX_SENSOR_CUSTOM_POWER_01=shellies:hifi_power

# Sensor: custom_power_02
INFLUX_SENSOR_CUSTOM_POWER_02=shellies:fridge_power

# Sensor: custom_power_03
INFLUX_SENSOR_CUSTOM_POWER_03=shellies:computer_power

# Sensor: custom_power_04
INFLUX_SENSOR_CUSTOM_POWER_04=shellies:washing_power

# Sensor: custom_power_05
INFLUX_SENSOR_CUSTOM_POWER_05=shellies:dryer_power

# Sensor: custom_power_06
INFLUX_SENSOR_CUSTOM_POWER_06=shellies:freezer_power

# Sensor: custom_power_07
INFLUX_SENSOR_CUSTOM_POWER_07=shellies:fridge2_power

#
# ┌──────────────────────────────────────────────────────────────┐
# │  Unmanaged variables (preserved from existing installation)  │
# └──────────────────────────────────────────────────────────────┘
#

WATCHTOWER_SCHEDULE='0 5 2 * * *'

