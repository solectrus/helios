##################################################################
# Dashboard application (the main part)
#
# Domain name or IP address of your host
APP_HOST=192.168.178.41
#
# SSL redirect: Use "true" if you want to auto-redirect to https, but ensure that you have a valid SSL certificate
# and a reverse proxy in front of the app!
# In all other cases, the option must be "false"!
FORCE_SSL=false
#
# Secret token to secure cookies, 128 chars long hexadecimal encoded string (don't use this example, make some random changes!)
# Currently there are no cookies in Solectrus, but this may change in the future
SECRET_KEY_BASE=my-secret-key-base
#
# Date of commissioning of your photovoltaic system
INSTALLATION_DATE=2023-01-01
#
# Price you pay for 1kWH (in EUR)
# Can be changed later in the UI when logged in as administrator
ELECTRICITY_PRICE=0.2526
#
# Price you get for 1kWH (in EUR)
# Can be changed later in the UI when logged in as administrator
FEED_IN_TARIFF=0.082
#
# Password for the PostgreSQL database, used by the app to comunicate internally with the database
POSTGRES_PASSWORD=my-postgres-password
# Password to login as administrator, required to manage settings like historical prices
ADMIN_PASSWORD=my-admin-password
##################################################################
# Influx database settings
#
# Influx host (to access from SOLECTRUS dashboard and collectors)
INFLUX_HOST=influxdb
INFLUX_SCHEMA=http
INFLUX_PORT=8086
#
# Credentials for the Influx database, don't change after the first run!
INFLUX_ORG=solectrus
INFLUX_USERNAME=admin
INFLUX_PASSWORD=my-influx-password
INFLUX_ADMIN_TOKEN=my-influx-admin-token
#
# Set these names before first run, they can't be changed later!
INFLUX_BUCKET=my-solectrus-bucket
INFLUX_MEASUREMENT_PV=SENEC
INFLUX_MEASUREMENT_FORECAST=Forecast
#
# To keep things simple, we use ONE token (INFLUX_ADMIN_TOKEN) for both writing and reading.
# For better security, you can use two separate tokens, created via the InfluxDB frontend.
INFLUX_TOKEN_WRITE=my-influx-write-token
INFLUX_TOKEN_READ=my-influx-read-token
#
# Volume path for storing the Influx data
INFLUX_VOLUME_PATH=/volume1/docker/solectrus/influxdb
#
##################################################################
# REDIS settings
#
REDIS_VOLUME_PATH=/volume1/docker/solectrus/redis
#
##################################################################
# PostgreSQL database settings
#
DB_VOLUME_PATH=/volume1/docker/solectrus/postgresql
#
##################################################################
# SENEC Collector
#
# Change this to your own SENEC IP address!
SENEC_HOST=192.168.178.22
SENEC_SCHEMA=https
SENEC_INTERVAL=5
#
##################################################################
SHELLY_HOST_HEATPUMP=192.168.178.134
INFLUX_SENSOR_CUSTOM_POWER_01=heatpump:power
INFLUX_MEASUREMENT_SHELLY_HEATPUMP=heatpump
SHELLY_INTERVAL=10
#
SHELLY_HOST_DISHWASHER=192.168.178.80
INFLUX_SENSOR_CUSTOM_POWER_06=dishwasher:power
INFLUX_MEASUREMENT_SHELLY_DISHWASHER=dishwasher
SHELLY_INTERVAL=10
#
SHELLY_HOST_BEAMER=192.168.178.65
INFLUX_SENSOR_CUSTOM_POWER_02=beamer:power
INFLUX_MEASUREMENT_SHELLY_BEAMER=beamer
SHELLY_INTERVAL=10
#
SHELLY_HOST_WASHINGMASHINE=192.168.178.83
INFLUX_SENSOR_CUSTOM_POWER_03=washingmashine:power
INFLUX_MEASUREMENT_SHELLY_WASHINGMASHINE=washingmashine
SHELLY_INTERVAL=10
#
SHELLY_HOST_DRYER=192.168.178.118
INFLUX_SENSOR_CUSTOM_POWER_04=dryer:power
INFLUX_MEASUREMENT_SHELLY_DRYER=dryer
SHELLY_INTERVAL=10
#
SHELLY_HOST_MICROWAVE=192.168.178.123
INFLUX_SENSOR_CUSTOM_POWER_05=microwave:power
INFLUX_MEASUREMENT_SHELLY_MICROWAVE=microwave
SHELLY_INTERVAL=10
#
##################################################################
# Solar forecasting with https://forecast.solar
# API docs: https://doc.forecast.solar/doku.php?id=api:estimate
#
# Latitude of the plant location
FORECAST_LATITUDE=0.00000
#
# Longitude of the plant location
FORECAST_LONGITUDE=0.00000
#
FORECAST_CONFIGURATIONS=2
FORECAST_0_DECLINATION=40
FORECAST_0_AZIMUTH=-53.6
FORECAST_0_KWP=6.750
FORECAST_1_DECLINATION=40
FORECAST_1_AZIMUTH=126.4
FORECAST_1_KWP=5.250
# FORECAST_2_DECLINATION=10
# FORECAST_2_AZIMUTH=36.4
# FORECAST_2_KWP=1.125
# FORECAST_3_DECLINATION=10
# FORECAST_3_AZIMUTH=-143.6
# FORECAST_3_KWP=1.125
#
# Plane declination: 0 (horizontal) - 90 (vertical)
# FORECAST_DECLINATION=40
# Plane azimuth: -180 ... 180 (-180 = north, -90 = east, 0 = south, 90 = west, 180 = north)
# FORECAST_AZIMUTH=-54
#
# Installed modules power in kilowatt peak (kWp)
# FORECAST_KWP=12
#
# Update interval in seconds, 900s = 15 minutes, the public (and free) API allows a minimum of 900 seconds
FORECAST_INTERVAL=900
#
# Optional damping factors (http://doc.forecast.solar/damping)
FORECAST_DAMPING_MORNING=0.5
FORECAST_DAMPING_EVENING=0.2
#
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=false
INFLUX_SENSOR_CAR_BATTERY_SOC=0
