#
# ┌──────────────────────────────────────────────────────────┐
# │  Shelly collector                                        │
# └──────────────────────────────────────────────────────────┘
#

# Polling interval in seconds
SHELLY_INTERVAL=5

# Shelly device hostnames (comma-separated)
SHELLY_HOST=shelly-heatpump.fritz.box,shelly-dishwasher.fritz.box,shelly-washer.fritz.box,shelly-fridge.fritz.box,shelly-imac.fritz.box,shelly-macstudio.fritz.box,shelly-studiodisplay.fritz.box,shelly-kabelfritz.fritz.box,shelly-synology.fritz.box,shelly-tv.fritz.box,shelly-mini-pc-1.fritz.box

# InfluxDB measurement names (comma-separated)
INFLUX_MEASUREMENT=Consumer,Dishwasher,Washer,Fridge,iMac,Studio,Display,KabelFritz,Synology,TV,Mini-PC-1

# InfluxDB write mode (essential or full)
INFLUX_MODE=essential

# Shelly device password
SHELLY_PASSWORD=secret

#
# ┌──────────────────────────────────────────────────────────┐
# │  Watchtower (automatic Docker image updates)             │
# └──────────────────────────────────────────────────────────┘
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

