# --- Mapping 25

MAPPING_25_TOPIC=espaltherma/ATTR
MAPPING_25_MEASUREMENT=ALTHERMA
MAPPING_25_FIELD=r6t_liquid_pipe_temp
MAPPING_25_TYPE=float
MAPPING_25_JSON_KEY='Liquid pipe temp.(R6T)'

