MAPPING_32_FIELD=water_pump_operation
MAPPING_32_TYPE=boolean
MAPPING_32_JSON_KEY=Water pump operation

MAPPING_33_TOPIC=espaltherma/ATTR
MAPPING_33_MEASUREMENT=ALTHERMA
MAPPING_33_FIELD=space_heating
MAPPING_33_TYPE=boolean
MAPPING_33_JSON_KEY=Space heating Operation ON/OFF

MAPPING_34_TOPIC=espaltherma/ATTR
MAPPING_34_MEASUREMENT=ALTHERMA
MAPPING_34_FIELD=system_off
MAPPING_34_TYPE=boolean
MAPPING_34_JSON_KEY=System OFF (ON:System off)

MAPPING_35_TOPIC=espaltherma/ATTR
MAPPING_35_MEASUREMENT=ALTHERMA
MAPPING_35_FIELD=bypass_valve_output
MAPPING_35_TYPE=boolean
MAPPING_35_JSON_KEY=Bypass Valve Output

MAPPING_36_TOPIC=espaltherma/ATTR
MAPPING_36_MEASUREMENT=ALTHERMA
MAPPING_36_FIELD=target_delta_t
MAPPING_36_TYPE=float
MAPPING_36_JSON_KEY=Target delta T heating

MAPPING_37_TOPIC=espaltherma/ATTR
MAPPING_37_MEASUREMENT=ALTHERMA
