TZ=Europe/Berlin

ADMIN_PASSWORD=secret_admin_password
SECRET_KEY_BASE=very_secret_key_base

SENEC_HOST=senec.fritz.box
SENEC_INTERVAL=5
SENEC_SCHEMA=https
SENEC_LANGUAGE=de

INFLUX_HOST=ingest.example.com
INFLUX_SCHEMA=https
INFLUX_PORT=443
INFLUX_TOKEN=my-external-influx-token
INFLUX_ORG=solectrus
INFLUX_BUCKET=solectrus

SHELLY_INTERVAL=5
SHELLY_HOST_HEATPUMP=shelly-heatpump.fritz.box
SHELLY_HOST_WASHER=shelly-washer.fritz.box
SHELLY_HOST_FRIDGE=shelly-fridge.fritz.box
SHELLY_HOST_IMAC=shelly-imac.fritz.box
SHELLY_HOST_KABELFRITZ=shelly-kabelfritz.fritz.box
SHELLY_HOST_SYNOLOGY=shelly-synology.fritz.box
SHELLY_HOST_DISHWASHER=shelly-dishwasher.fritz.box
SHELLY_HOST_DISPLAY=shelly-studiodisplay.fritz.box
SHELLY_HOST_STUDIO=shelly-macstudio.fritz.box
SHELLY_HOST_TV=shelly-tv.fritz.box
SHELLY_HOST_MINI_PC_1=shelly-mini-pc-1.fritz.box

MQTT_HOST=iobroker.fritz.box
MQTT_PORT=1883
MQTT_SSL=false
MQTT_USERNAME=admin
MQTT_PASSWORD=my-mqtt-password

MAPPING_1_TOPIC=espaltherma/ATTR
MAPPING_1_MEASUREMENT=ALTHERMA
MAPPING_1_FIELD=r1t_leaving_temp
MAPPING_1_TYPE=float
MAPPING_1_JSON_KEY=Leaving water temp. before BUH (R1T)

MAPPING_2_TOPIC=espaltherma/ATTR
MAPPING_2_MEASUREMENT=ALTHERMA
MAPPING_2_FIELD=r2t_leaving_temp
MAPPING_2_TYPE=float
MAPPING_2_JSON_KEY=Leaving water temp. after BUH (R2T)

MAPPING_3_TOPIC=espaltherma/ATTR
MAPPING_3_MEASUREMENT=ALTHERMA
MAPPING_3_FIELD=r3t_refrig_temp
MAPPING_3_TYPE=float
MAPPING_3_JSON_KEY=Refrig. Temp. liquid side (R3T)

MAPPING_4_TOPIC=espaltherma/ATTR
MAPPING_4_MEASUREMENT=ALTHERMA
MAPPING_4_FIELD=r4t_inlet_temp
MAPPING_4_TYPE=float
MAPPING_4_JSON_KEY=Inlet water temp.(R4T)

MAPPING_5_TOPIC=espaltherma/ATTR
MAPPING_5_MEASUREMENT=ALTHERMA
MAPPING_5_FIELD=r5t_tank_temp
MAPPING_5_TYPE=float
MAPPING_5_JSON_KEY=DHW tank temp. (R5T)

MAPPING_6_TOPIC=espaltherma/ATTR
MAPPING_6_MEASUREMENT=ALTHERMA
MAPPING_6_FIELD=r6t_outdoor_temp
MAPPING_6_TYPE=float
MAPPING_6_JSON_KEY=R1T-Outdoor air temp.

MAPPING_7_TOPIC=espaltherma/ATTR
MAPPING_7_MEASUREMENT=ALTHERMA
MAPPING_7_FIELD=r7t_leaving_temp_after_tank
MAPPING_7_TYPE=float
MAPPING_7_JSON_KEY=[HPSU] Mixed leaving water temperature after the tank R7T (DLWA2)

MAPPING_8_TOPIC=espaltherma/ATTR
MAPPING_8_MEASUREMENT=ALTHERMA
MAPPING_8_FIELD=water_flow
MAPPING_8_TYPE=float
MAPPING_8_JSON_KEY=Flow sensor (l/min)

MAPPING_9_TOPIC=espaltherma/ATTR
MAPPING_9_MEASUREMENT=ALTHERMA
MAPPING_9_FIELD=heat
MAPPING_9_TYPE=float
MAPPING_9_JSON_FORMULA=IF({Operation Mode} = 'Heating' AND {Freeze Protection} = 'OFF' AND {Leaving water temp. after BUH (R2T)} > {Inlet water temp.(R4T)}, {Flow sensor (l/min)} * 60.0 * 1.163 * ({Leaving water temp. after BUH (R2T)} - {Inlet water temp.(R4T)}), 0)

MAPPING_10_TOPIC=espaltherma/ATTR
MAPPING_10_MEASUREMENT=ALTHERMA
MAPPING_10_FIELD=water_pressure
MAPPING_10_TYPE=float
MAPPING_10_JSON_PATH=$.Water pressure

MAPPING_11_TOPIC=espaltherma/ATTR
MAPPING_11_MEASUREMENT=ALTHERMA
MAPPING_11_FIELD=operation_mode
MAPPING_11_TYPE=string
MAPPING_11_JSON_KEY=Operation Mode

MAPPING_12_TOPIC=espaltherma/ATTR
MAPPING_12_MEASUREMENT=ALTHERMA
MAPPING_12_FIELD=freeze_protection
MAPPING_12_TYPE=boolean
MAPPING_12_JSON_KEY=Freeze Protection

MAPPING_13_TOPIC=espaltherma/ATTR
MAPPING_13_MEASUREMENT=ALTHERMA
MAPPING_13_FIELD=inverter_frequency
MAPPING_13_TYPE=float
MAPPING_13_JSON_KEY=INV frequency (rps)

MAPPING_14_TOPIC=espaltherma/ATTR
MAPPING_14_MEASUREMENT=ALTHERMA
MAPPING_14_FIELD=valve_tank
MAPPING_14_TYPE=integer
MAPPING_14_JSON_KEY=[HPSU] Tank valve position (0:Bypass 100:Tank)

MAPPING_15_TOPIC=espaltherma/ATTR
MAPPING_15_MEASUREMENT=ALTHERMA
MAPPING_15_FIELD=valve_emitter
MAPPING_15_TYPE=integer
MAPPING_15_JSON_KEY=[HPSU] Bypass valve position (0:Bypass 100:Emitter)

MAPPING_16_TOPIC=espaltherma/ATTR
MAPPING_16_MEASUREMENT=ALTHERMA
MAPPING_16_FIELD=setpoint_leaving_water
MAPPING_16_TYPE=float
MAPPING_16_JSON_KEY=LW setpoint (main)

MAPPING_17_TOPIC=espaltherma/ATTR
MAPPING_17_MEASUREMENT=ALTHERMA
MAPPING_17_FIELD=setpoint_tank_water
MAPPING_17_TYPE=float
MAPPING_17_JSON_KEY=DHW setpoint

MAPPING_18_TOPIC=espaltherma/ATTR
MAPPING_18_MEASUREMENT=ALTHERMA
MAPPING_18_FIELD=startup_control
MAPPING_18_TYPE=boolean
MAPPING_18_JSON_KEY=Startup Control

MAPPING_19_TOPIC=espaltherma/ATTR
MAPPING_19_MEASUREMENT=ALTHERMA
MAPPING_19_FIELD=defrost_operation
MAPPING_19_TYPE=boolean
MAPPING_19_JSON_KEY=Defrost Operation

MAPPING_22_TOPIC=espaltherma/ATTR
MAPPING_22_MEASUREMENT=ALTHERMA
MAPPING_22_FIELD=water_pump_signal
MAPPING_22_TYPE=integer
MAPPING_22_JSON_KEY=Water pump signal (0:max-100:stop)

MAPPING_23_TOPIC=espaltherma/ATTR
MAPPING_23_MEASUREMENT=ALTHERMA
MAPPING_23_FIELD=current_state
MAPPING_23_TYPE=string
MAPPING_23_JSON_FORMULA=IF({Freeze Protection} == 'ON', 'Frostschutz', IF({Defrost Operation} == 'ON', 'Abtauen', IF({[HPSU] Tank valve position (0:Bypass 100:Tank)} > 50, 'Warmwasser', IF({[HPSU] Bypass valve position (0:Bypass 100:Emitter)} > 50 AND {INV frequency (rps)} > 0, 'Heizen', 'Warten'))))

MAPPING_25_TOPIC=data-solectrus/0/consumer/it
MAPPING_25_MEASUREMENT=IT
MAPPING_25_FIELD=power
MAPPING_25_TYPE=integer

MAPPING_26_TOPIC=espaltherma/ATTR
MAPPING_26_MEASUREMENT=ALTHERMA
MAPPING_26_FIELD=thermostat
MAPPING_26_TYPE=boolean
MAPPING_26_JSON_KEY=Thermostat ON/OFF

MAPPING_27_TOPIC=espaltherma/ATTR
MAPPING_27_MEASUREMENT=ALTHERMA
MAPPING_27_FIELD=r4t_heat_exchanger_temp
MAPPING_27_TYPE=float
MAPPING_27_JSON_KEY=O/U Heat Exch. Temp.(R4T)

MAPPING_28_TOPIC=espaltherma/ATTR
MAPPING_28_MEASUREMENT=ALTHERMA
MAPPING_28_FIELD=r6t_liquid_pipe_temp
MAPPING_28_TYPE=float
MAPPING_28_JSON_KEY=Liquid pipe temp.(R6T)

MAPPING_29_TOPIC=espaltherma/ATTR
MAPPING_29_MEASUREMENT=ALTHERMA
MAPPING_29_FIELD=valve_3way
MAPPING_29_TYPE=boolean
MAPPING_29_JSON_KEY=3way valve(On:DHW_Off:Space)

MAPPING_30_TOPIC=espaltherma/ATTR
MAPPING_30_MEASUREMENT=ALTHERMA
MAPPING_30_FIELD=buh_step1
MAPPING_30_TYPE=boolean
MAPPING_30_JSON_KEY=BUH Step1

