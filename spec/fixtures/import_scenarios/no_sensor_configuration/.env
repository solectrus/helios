# ============================================================
# DO NOT EDIT THIS FILE.
#
# This file is generated by HELIOS. Any manual change WILL be
# overwritten — silently, without backup — the next time HELIOS
# applies a configuration. In the worst case your edit breaks
# the stack and HELIOS can no longer recover it.
#
# Change every setting through the HELIOS web interface.
#
# Need something HELIOS does not expose? Then HELIOS is no longer
# the right tool for your stack: uninstall HELIOS and manage
# compose.yaml + .env by hand.
# ============================================================

#
# ┌──────────────────────────────────────────────────────────┐
# │  General settings                                        │
# └──────────────────────────────────────────────────────────┘
#

# Timezone for all services (IANA format, e.g. Europe/Berlin)
TZ=Europe/Berlin

# Date of first solar installation (YYYY-MM-DD) — used for statistics and charts
INSTALLATION_DATE=2024-02-03

#
# ┌──────────────────────────────────────────────────────────┐
# │  Security                                                │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — shared by Dashboard and HELIOS
ADMIN_PASSWORD=xxxx

# Secret key for Rails sessions — shared by Dashboard and HELIOS
SECRET_KEY_BASE=XXXXXXXXX6c0e3f1a5bc028d74e9a6b3c870d92f5e1f6c82549e5d30a71f8b7d39eac57d80a693fcb29e8d3a5f70334e81b6d2f4e91755fb8e84dc69b4

#
# ┌──────────────────────────────────────────────────────────┐
# │  Dashboard                                               │
# └──────────────────────────────────────────────────────────┘
#

# Hostname for the SOLECTRUS web interface
APP_HOST=192.168.178.10

# Must be FALSE, unless Traefik terminates TLS in front of the dashboard
FORCE_SSL=false

# Number of Puma worker processes (0 = single-process mode, sufficient for most setups)
WEB_CONCURRENCY=0

# Allowed frame ancestors for embedding
FRAME_ANCESTORS=https://192.168.178.10:8123

# Sensors excluded from house power calculation
INFLUX_EXCLUDE_FROM_HOUSE_POWER=HEATPUMP_POWER

#
# ┌──────────────────────────────────────────────────────────┐
# │  PostgreSQL database                                     │
# └──────────────────────────────────────────────────────────┘
#

# Database password — auto-generated, do not change after first start
POSTGRES_PASSWORD=XXXXXX

# Volume path for storing the PostgreSQL data
DB_VOLUME_PATH=/volume1/docker/solectrus/postgresql

#
# ┌──────────────────────────────────────────────────────────┐
# │  InfluxDB time-series database                           │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — auto-generated, do not change after first start
INFLUX_PASSWORD=XXXXXXX

# Organization name
INFLUX_ORG=solectrus

# Bucket (database) name for time-series data
INFLUX_BUCKET=klushygel-pv

# API token with full access — auto-generated, do not change after first start
INFLUX_TOKEN=XXXXXX

# Volume path for storing the InfluxDB data
INFLUX_VOLUME_PATH=/volume1/docker/solectrus/influxdb

#
# ┌──────────────────────────────────────────────────────────┐
# │  Redis cache                                             │
# └──────────────────────────────────────────────────────────┘
#

# Volume path for storing the Redis data
REDIS_VOLUME_PATH=/volume1/docker/solectrus/redis

#
# ┌──────────────────────────────────────────────────────────┐
# │  Power Splitter                                          │
# └──────────────────────────────────────────────────────────┘
#

# Recalculation interval in seconds (min 300)
POWER_SPLITTER_INTERVAL=300

#
# ┌──────────────────────────────────────────────────────────┐
# │  MQTT broker                                             │
# └──────────────────────────────────────────────────────────┘
#

# MQTT broker hostname
MQTT_HOST=192.168.178.10

# MQTT broker port
MQTT_PORT=1883

# Enable SSL for MQTT connection
MQTT_SSL=false

# MQTT broker username
MQTT_USERNAME=thomas

# MQTT broker password
MQTT_PASSWORD=lXXXXX

# --- Mapping 0 for INVERTER_POWER

MAPPING_0_TOPIC=evcc/site/pvPower
MAPPING_0_MEASUREMENT=klushygel-pv-messung
MAPPING_0_FIELD=inverter_power
MAPPING_0_TYPE=integer

# --- Mapping 1 for HOUSE_POWER

MAPPING_1_TOPIC=evcc/site/homePower
MAPPING_1_MEASUREMENT=klushygel-pv-messung
MAPPING_1_FIELD=house_power
MAPPING_1_TYPE=integer

# --- Mapping 2 for GRID_IMPORT_POWER

MAPPING_2_TOPIC=evcc/site/gridPower
MAPPING_2_MEASUREMENT=klushygel-pv-messung
MAPPING_2_FIELD=grid_power_plus
MAPPING_2_TYPE=integer
MAPPING_2_FORMULA='IF({value} > 0, {value}, 0)'

# --- Mapping 3 for GRID_EXPORT_POWER

MAPPING_3_TOPIC=evcc/site/gridPower
MAPPING_3_MEASUREMENT=klushygel-pv-messung
MAPPING_3_FIELD=grid_power_minus
MAPPING_3_TYPE=integer
MAPPING_3_FORMULA='IF({value} < 0, -{value}, 0)'

# --- Mapping 4 for BATTERY_CHARGING_POWER

MAPPING_4_TOPIC=evcc/site/batteryPower
MAPPING_4_MEASUREMENT=klushygel-pv-messung
MAPPING_4_FIELD=bat_power_plus
MAPPING_4_TYPE=integer
MAPPING_4_FORMULA='IF({value} < 0, -{value}, 0)'

# --- Mapping 5 for BATTERY_DISCHARGING_POWER

MAPPING_5_TOPIC=evcc/site/batteryPower
MAPPING_5_MEASUREMENT=klushygel-pv-messung
MAPPING_5_FIELD=bat_power_minus
MAPPING_5_TYPE=integer
MAPPING_5_FORMULA='IF({value} > 0, {value}, 0)'

# --- Mapping 6 for BATTERY_SOC

MAPPING_6_TOPIC=evcc/site/batterySoc
MAPPING_6_MEASUREMENT=klushygel-pv-messung
MAPPING_6_FIELD=bat_fuel_charge
MAPPING_6_TYPE=float

# --- Mapping 7 for WALLBOX_POWER

MAPPING_7_TOPIC=evcc/loadpoints/1/chargePower
MAPPING_7_MEASUREMENT=klushygel-pv-messung
MAPPING_7_FIELD=wallbox_charge_power
MAPPING_7_TYPE=integer

#
# ┌──────────────────────────────────────────────────────────┐
# │  Watchtower (automatic Docker image updates)             │
# └──────────────────────────────────────────────────────────┘
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

#
# ┌──────────────────────────────────────────────────────────┐
# │  Sensor mappings                                         │
# └──────────────────────────────────────────────────────────┘
#

# Sensor: inverter_power
INFLUX_SENSOR_INVERTER_POWER=klushygel-pv-messung:inverter_power

# Sensor: grid_import_power
INFLUX_SENSOR_GRID_IMPORT_POWER=klushygel-pv-messung:grid_power_plus

# Sensor: grid_export_power
INFLUX_SENSOR_GRID_EXPORT_POWER=klushygel-pv-messung:grid_power_minus

# Sensor: grid_export_limit
INFLUX_SENSOR_GRID_EXPORT_LIMIT=klushygel-pv-messung:power_ratio

# Sensor: house_power
INFLUX_SENSOR_HOUSE_POWER=klushygel-pv-messung:house_power

# Sensor: battery_charging_power
INFLUX_SENSOR_BATTERY_CHARGING_POWER=klushygel-pv-messung:bat_power_plus

# Sensor: battery_discharging_power
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=klushygel-pv-messung:bat_power_minus

# Sensor: battery_soc
INFLUX_SENSOR_BATTERY_SOC=klushygel-pv-messung:bat_fuel_charge

# Sensor: wallbox_power
INFLUX_SENSOR_WALLBOX_POWER=klushygel-pv-messung:wallbox_charge_power

# Sensor: heatpump_power
INFLUX_SENSOR_HEATPUMP_POWER=klushygel-pv-messung:heatpump_power

# Sensor: case_temp
INFLUX_SENSOR_CASE_TEMP=klushygel-pv-messung:case_temp

# Sensor: system_status
INFLUX_SENSOR_SYSTEM_STATUS=klushygel-pv-messung:current_state

# Sensor: system_status_ok
INFLUX_SENSOR_SYSTEM_STATUS_OK=klushygel-pv-messung:current_state_ok

# Sensor: inverter_power_forecast
INFLUX_SENSOR_INVERTER_POWER_FORECAST=Forecast:watt

