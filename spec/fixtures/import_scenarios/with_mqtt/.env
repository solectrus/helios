# ============================================================
# DO NOT EDIT THIS FILE.
#
# This file is generated by HELIOS. Any manual change WILL be
# overwritten — silently, without backup — the next time HELIOS
# applies a configuration. In the worst case your edit breaks
# the stack and HELIOS can no longer recover it.
#
# Change every setting through the HELIOS web interface.
#
# Need something HELIOS does not expose? Then HELIOS is no longer
# the right tool for your stack: uninstall HELIOS and manage
# compose.yaml + .env by hand.
# ============================================================

#
# ┌──────────────────────────────────────────────────────────┐
# │  General settings                                        │
# └──────────────────────────────────────────────────────────┘
#

# Timezone for all services (IANA format, e.g. Europe/Berlin)
TZ=Europe/Berlin

# Date of first solar installation (YYYY-MM-DD) — used for statistics and charts
INSTALLATION_DATE=2024-01-15

#
# ┌──────────────────────────────────────────────────────────┐
# │  Security                                                │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — shared by Dashboard and HELIOS
ADMIN_PASSWORD=test-admin

# Secret key for Rails sessions — shared by Dashboard and HELIOS
SECRET_KEY_BASE=test-secret-key

#
# ┌──────────────────────────────────────────────────────────┐
# │  Dashboard                                               │
# └──────────────────────────────────────────────────────────┘
#

# Hostname for the SOLECTRUS web interface
APP_HOST=myhost

# Must be FALSE, unless Traefik terminates TLS in front of the dashboard
FORCE_SSL=false

# Number of Puma worker processes (0 = single-process mode, sufficient for most setups)
WEB_CONCURRENCY=0

# How often the Dashboard polls InfluxDB for live values, in seconds
INFLUX_POLL_INTERVAL=5

# CO2 emission factor (g/kWh)
CO2_EMISSION_FACTOR=401

# Sensors excluded from house power calculation
INFLUX_EXCLUDE_FROM_HOUSE_POWER=WALLBOX_POWER

#
# ┌──────────────────────────────────────────────────────────┐
# │  PostgreSQL database                                     │
# └──────────────────────────────────────────────────────────┘
#

# Database password — auto-generated, do not change after first start
POSTGRES_PASSWORD=test-db-password

# Volume path for storing the PostgreSQL data
DB_VOLUME_PATH=./postgresql

#
# ┌──────────────────────────────────────────────────────────┐
# │  InfluxDB time-series database                           │
# └──────────────────────────────────────────────────────────┘
#

# Admin password — auto-generated, do not change after first start
INFLUX_PASSWORD=test-influx-pw

# Organization name
INFLUX_ORG=solectrus

# Bucket (database) name for time-series data
INFLUX_BUCKET=solectrus

# Admin token — used by InfluxDB init and backup
INFLUX_ADMIN_TOKEN=test-influx-token

# Read+write token — used by power-splitter
INFLUX_TOKEN_READWRITE=test-influx-token

# Write token — used by all collectors
INFLUX_TOKEN_WRITE=test-influx-token

# Read token — used by the dashboard
INFLUX_TOKEN_READ=test-influx-token

# Volume path for storing the InfluxDB data
INFLUX_VOLUME_PATH=./influxdb

#
# ┌──────────────────────────────────────────────────────────┐
# │  Redis cache                                             │
# └──────────────────────────────────────────────────────────┘
#

# Volume path for storing the Redis data
REDIS_VOLUME_PATH=./redis

#
# ┌──────────────────────────────────────────────────────────┐
# │  Power Splitter                                          │
# └──────────────────────────────────────────────────────────┘
#

# Recalculation interval in seconds (min 300)
POWER_SPLITTER_INTERVAL=3600

#
# ┌──────────────────────────────────────────────────────────┐
# │  SENEC collector                                         │
# └──────────────────────────────────────────────────────────┘
#

# SENEC adapter type (local or cloud)
SENEC_ADAPTER=local

# SENEC device IP or hostname
SENEC_HOST=192.168.1.42

# Connection protocol
SENEC_SCHEMA=https

# Status text language
SENEC_LANGUAGE=de

# Polling interval in seconds
SENEC_INTERVAL=5

# InfluxDB measurement name for SENEC
INFLUX_MEASUREMENT_SENEC=SENEC

#
# ┌──────────────────────────────────────────────────────────┐
# │  MQTT broker                                             │
# └──────────────────────────────────────────────────────────┘
#

# MQTT broker hostname
MQTT_HOST=mqtt-broker.local

# MQTT broker port
MQTT_PORT=1883

# MQTT broker username
MQTT_USERNAME=mqttuser

# MQTT broker password
MQTT_PASSWORD=mqttpass

# --- Mapping 0 for CAR_BATTERY_SOC

MAPPING_0_TOPIC=tesla/battery
MAPPING_0_MEASUREMENT=MyTesla
MAPPING_0_FIELD=soc
MAPPING_0_TYPE=float
MAPPING_0_JSON_KEY=soc

# --- Mapping 1 for HEATPUMP_HEATING_POWER

MAPPING_1_TOPIC=espaltherma/ATTR
MAPPING_1_MEASUREMENT=ALTHERMA
MAPPING_1_FIELD=heat
MAPPING_1_TYPE=float
MAPPING_1_JSON_FORMULA="IF({Operation Mode} = 'Heating', 1, 0)"

# --- Mapping 2 for HEATPUMP_STATUS

MAPPING_2_TOPIC=espaltherma/ATTR
MAPPING_2_MEASUREMENT=ALTHERMA
MAPPING_2_FIELD=current_state
MAPPING_2_TYPE=string
MAPPING_2_JSON_FORMULA="IF({Freeze Protection} == 'ON', 'Frostschutz', 'Warten')"

# --- Mapping 3 for HEATPUMP_TANK_TEMP

MAPPING_3_TOPIC=espaltherma/ATTR
MAPPING_3_MEASUREMENT=ALTHERMA
MAPPING_3_FIELD=r5t_tank_temp
MAPPING_3_TYPE=float
MAPPING_3_JSON_KEY='DHW tank temp. (R5T)'

# --- Mapping 4 for OUTDOOR_TEMP

MAPPING_4_TOPIC=espaltherma/ATTR
MAPPING_4_MEASUREMENT=ALTHERMA
MAPPING_4_FIELD=r6t_outdoor_temp
MAPPING_4_TYPE=float
MAPPING_4_JSON_KEY='R1T-Outdoor air temp.'

# --- Mapping 5 for WALLBOX_CAR_CONNECTED

MAPPING_5_TOPIC=go-eCharger/123456/car
MAPPING_5_MEASUREMENT=go-eCharger
MAPPING_5_FIELD=car_connected
MAPPING_5_TYPE=integer

# --- Mapping 6 for WALLBOX_POWER

MAPPING_6_TOPIC=go-eCharger/123456/nrg
MAPPING_6_MEASUREMENT=go-eCharger
MAPPING_6_FIELD=power
MAPPING_6_TYPE=float
MAPPING_6_JSON_KEY=p

#
# ┌──────────────────────────────────────────────────────────┐
# │  Watchtower (automatic Docker image updates)             │
# └──────────────────────────────────────────────────────────┘
#

# Interval between update checks (in seconds)
WATCHTOWER_POLL_INTERVAL=86400

# Only update containers tagged with this scope label
WATCHTOWER_SCOPE=solectrus

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

#
# ┌──────────────────────────────────────────────────────────┐
# │  Sensor mappings                                         │
# └──────────────────────────────────────────────────────────┘
#

# Sensor: inverter_power
INFLUX_SENSOR_INVERTER_POWER=SENEC:inverter_power

# Sensor: grid_import_power
INFLUX_SENSOR_GRID_IMPORT_POWER=SENEC:grid_power_plus

# Sensor: grid_export_power
INFLUX_SENSOR_GRID_EXPORT_POWER=SENEC:grid_power_minus

# Sensor: house_power
INFLUX_SENSOR_HOUSE_POWER=SENEC:house_power

# Sensor: battery_charging_power
INFLUX_SENSOR_BATTERY_CHARGING_POWER=SENEC:bat_power_plus

# Sensor: battery_discharging_power
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=SENEC:bat_power_minus

# Sensor: battery_soc
INFLUX_SENSOR_BATTERY_SOC=SENEC:bat_fuel_charge

# Sensor: wallbox_power
INFLUX_SENSOR_WALLBOX_POWER=go-eCharger:power

# Sensor: wallbox_car_connected
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=go-eCharger:car_connected

# Sensor: car_battery_soc
INFLUX_SENSOR_CAR_BATTERY_SOC=MyTesla:soc

# Sensor: heatpump_heating_power
INFLUX_SENSOR_HEATPUMP_HEATING_POWER=ALTHERMA:heat

# Sensor: heatpump_tank_temp
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=ALTHERMA:r5t_tank_temp

# Sensor: heatpump_status
INFLUX_SENSOR_HEATPUMP_STATUS=ALTHERMA:current_state

# Sensor: outdoor_temp
INFLUX_SENSOR_OUTDOOR_TEMP=ALTHERMA:r6t_outdoor_temp

