TZ=Europe/Berlin
INSTALLATION_DATE=2024-01-15

POSTGRES_PASSWORD=test-db-password
SECRET_KEY_BASE=test-secret-key
ADMIN_PASSWORD=test-admin

INFLUX_PASSWORD=test-influx-pw
INFLUX_ORG=solectrus
INFLUX_BUCKET=solectrus
INFLUX_TOKEN=test-influx-token

INFLUX_HOST=influxdb
INFLUX_SCHEMA=http
INFLUX_PORT=8086

MQTT_HOST=mqtt-broker.local
MQTT_PORT=1883
MQTT_USERNAME=mqttuser
MQTT_PASSWORD=mqttpass

INFLUX_SENSOR_INVERTER_POWER=SENEC:inverter_power
INFLUX_SENSOR_HOUSE_POWER=SENEC:house_power
INFLUX_SENSOR_GRID_IMPORT_POWER=SENEC:grid_power_plus
INFLUX_SENSOR_GRID_EXPORT_POWER=SENEC:grid_power_minus
INFLUX_SENSOR_BATTERY_CHARGING_POWER=SENEC:bat_power_plus
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=SENEC:bat_power_minus
INFLUX_SENSOR_BATTERY_SOC=SENEC:bat_fuel_charge
INFLUX_SENSOR_WALLBOX_POWER=go-eCharger:power
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=go-eCharger:car_connected
INFLUX_SENSOR_HEATPUMP_POWER=Heatpump:power
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=Heatpump:tank_temp
INFLUX_SENSOR_CAR_BATTERY_SOC=MyTesla:soc

INFLUX_MEASUREMENT_SENEC=SENEC

SENEC_ADAPTER=local
SENEC_HOST=192.168.1.42
SENEC_SCHEMA=https
SENEC_LANGUAGE=de
SENEC_INTERVAL=5

INFLUX_EXCLUDE_FROM_HOUSE_POWER=WALLBOX_POWER

MAPPING_0_TOPIC=go-eCharger/123456/nrg
MAPPING_0_JSON_KEY=p
MAPPING_0_MEASUREMENT=go-eCharger
MAPPING_0_FIELD=power
MAPPING_0_TYPE=float

MAPPING_1_TOPIC=go-eCharger/123456/car
MAPPING_1_MEASUREMENT=go-eCharger
MAPPING_1_FIELD=car_connected
MAPPING_1_TYPE=integer

MAPPING_2_TOPIC=heatpump/status
MAPPING_2_JSON_KEY=power
MAPPING_2_MEASUREMENT=Heatpump
MAPPING_2_FIELD=power
MAPPING_2_TYPE=float

MAPPING_3_TOPIC=heatpump/tank
MAPPING_3_JSON_KEY=temp
MAPPING_3_MEASUREMENT=Heatpump
MAPPING_3_FIELD=tank_temp
MAPPING_3_TYPE=float

MAPPING_4_TOPIC=tesla/battery
MAPPING_4_JSON_KEY=soc
MAPPING_4_MEASUREMENT=MyTesla
MAPPING_4_FIELD=soc
MAPPING_4_TYPE=float
