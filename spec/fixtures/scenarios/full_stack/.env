#
# ┌──────────────────────────────────────────────────────────┐
# │  General settings                                        │
# └──────────────────────────────────────────────────────────┘
# Timezone for all services (IANA format, e.g. Europe/Berlin)
TZ=Europe/Berlin

# Date of first solar installation (YYYY-MM-DD) — used for statistics and charts
INSTALLATION_DATE=2026-03-18

#
# ┌──────────────────────────────────────────────────────────┐
# │  Security                                                │
# └──────────────────────────────────────────────────────────┘
# Admin password — shared by Dashboard and HELIOS
ADMIN_PASSWORD=secret_admin_password

# Secret key for Rails sessions — shared by Dashboard and HELIOS
SECRET_KEY_BASE=very_secret_key_base

#
# ┌──────────────────────────────────────────────────────────┐
# │  Dashboard                                               │
# └──────────────────────────────────────────────────────────┘
# Hostname for the SOLECTRUS web interface
APP_HOST=localhost

# Number of web server processes (0 = single process)
WEB_CONCURRENCY=0

# InfluxDB polling interval in seconds
INFLUX_POLL_INTERVAL=5

# UI theme (light or dark)
UI_THEME=light

# Codeword for lockup page protection
LOCKUP_CODEWORD=secret

# Sensors excluded from house power calculation
INFLUX_EXCLUDE_FROM_HOUSE_POWER=HEATPUMP_POWER

#
# ┌──────────────────────────────────────────────────────────┐
# │  PostgreSQL database                                     │
# └──────────────────────────────────────────────────────────┘
# Database password — auto-generated, do not change after first start
POSTGRES_PASSWORD=secret_postgres_password

#
# ┌──────────────────────────────────────────────────────────┐
# │  InfluxDB time-series database                           │
# └──────────────────────────────────────────────────────────┘
# Admin password — auto-generated, do not change after first start
INFLUX_PASSWORD=secret_influx_password

# Organization name
INFLUX_ORG=solectrus

# Bucket (database) name for time-series data
INFLUX_BUCKET=solectrus

# API token with full access — auto-generated, do not change after first start
INFLUX_TOKEN=secret_influx_token

#
# ┌──────────────────────────────────────────────────────────┐
# │  SENEC collector                                         │
# └──────────────────────────────────────────────────────────┘
# SENEC adapter type (local or cloud)
SENEC_ADAPTER=local

# SENEC device IP or hostname
SENEC_HOST=senec.fritz.box

# Connection protocol
SENEC_SCHEMA=https

# Status text language
SENEC_LANGUAGE=de

# Polling interval in seconds
SENEC_INTERVAL=60

# InfluxDB measurement name for SENEC
INFLUX_MEASUREMENT_SENEC=SENEC

#
# ┌──────────────────────────────────────────────────────────┐
# │  Forecast                                                │
# └──────────────────────────────────────────────────────────┘
# Forecast provider
FORECAST_PROVIDER=pvnode

# Solar panel latitude
FORECAST_LATITUDE=50.12345

# Solar panel longitude
FORECAST_LONGITUDE=6.12345

# Forecast update interval in seconds
FORECAST_INTERVAL=900

# Roof tilt angle
FORECAST_DECLINATION=27

# Roof orientation
FORECAST_AZIMUTH=0

# System capacity in kWp
FORECAST_KWP=9.24

# pvnode API key
PVNODE_APIKEY=pvn_secret_1234567890abcdef

# InfluxDB measurement name for forecasts
INFLUX_MEASUREMENT_FORECAST=Forecast

#
# ┌──────────────────────────────────────────────────────────┐
# │  MQTT broker                                             │
# └──────────────────────────────────────────────────────────┘
# MQTT broker hostname
MQTT_HOST=iobroker.fritz.box

# MQTT broker port
MQTT_PORT=1883

# MQTT broker username
MQTT_USERNAME=admin

# MQTT broker password
MQTT_PASSWORD=secret_mqtt_password

# MQTT mapping 0: topic
MAPPING_0_TOPIC=renault/0/secret_number/battery-status/batteryLevel

# MQTT mapping 0: measurement
MAPPING_0_MEASUREMENT=renault

# MQTT mapping 0: field
MAPPING_0_FIELD=soc

# MQTT mapping 0: type
MAPPING_0_TYPE=integer

# MQTT mapping 1: topic
MAPPING_1_TOPIC=espaltherma/ATTR

# MQTT mapping 1: measurement
MAPPING_1_MEASUREMENT=ALTHERMA

# MQTT mapping 1: field
MAPPING_1_FIELD=heat

# MQTT mapping 1: type
MAPPING_1_TYPE=float

# MQTT mapping 1: json_formula
MAPPING_1_JSON_FORMULA="IF({Operation Mode} = 'Heating' AND {Freeze Protection} = 'OFF' AND {Leaving water temp. after BUH (R2T)} > {Inlet water temp.(R4T)}, {Flow sensor (l/min)} * 60.0 * 1.163 * ({Leaving water temp. after BUH (R2T)} - {Inlet water temp.(R4T)}), 0)"

# MQTT mapping 2: topic
MAPPING_2_TOPIC=espaltherma/ATTR

# MQTT mapping 2: measurement
MAPPING_2_MEASUREMENT=ALTHERMA

# MQTT mapping 2: field
MAPPING_2_FIELD=tank_temp

# MQTT mapping 2: type
MAPPING_2_TYPE=float

# MQTT mapping 2: json_key
MAPPING_2_JSON_KEY='DHW tank temp. (R5T)'

# MQTT mapping 3: topic
MAPPING_3_TOPIC=espaltherma/ATTR

# MQTT mapping 3: measurement
MAPPING_3_MEASUREMENT=ALTHERMA

# MQTT mapping 3: field
MAPPING_3_FIELD=current_state

# MQTT mapping 3: type
MAPPING_3_TYPE=string

# MQTT mapping 3: json_formula
MAPPING_3_JSON_FORMULA="IF({Freeze Protection} == 'ON', 'Frostschutz', IF({Defrost Operation} == 'ON', 'Abtauen', IF({[HPSU] Tank valve position (0:Bypass 100:Tank)} > 50, 'Warmwasser', IF({[HPSU] Bypass valve position (0:Bypass 100:Emitter)} > 50 AND {INV frequency (rps)} > 0, 'Heizen', 'Warten'))))"

# MQTT mapping 4: topic
MAPPING_4_TOPIC=espaltherma/ATTR

# MQTT mapping 4: measurement
MAPPING_4_MEASUREMENT=ALTHERMA

# MQTT mapping 4: field
MAPPING_4_FIELD=outdoor_temp

# MQTT mapping 4: type
MAPPING_4_TYPE=float

# MQTT mapping 4: json_key
MAPPING_4_JSON_KEY='R1T-Outdoor air temp.'

