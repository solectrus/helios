##################################################################
###                          Generic                           ###
##################################################################

TZ=Europe/Berlin

##################################################################
###                   Dashboard application                    ###
##################################################################

# Domain name or IP address of your host
APP_HOST=192.168.1.91

# Date of commissioning of your photovoltaic system
INSTALLATION_DATE=2022-09-01

# Password to login as administrator, required to manage settings like historical prices
ADMIN_PASSWORD=AAAAA

# Interval in seconds for polling the InfluxDB
INFLUX_POLL_INTERVAL=5

# SSL redirect: Use "true" if you want to auto-redirect to https, but ensure that you have a valid SSL certificate
# and a reverse proxy in front of the app!
# In all other cases, the option must be "false"!
FORCE_SSL=false

# Secret token to secure cookies, 128 chars long hexadecimal encoded string
SECRET_KEY_BASE=BBBBB

# Start web server Puma in single mode (recommended to reduce memory usage)
WEB_CONCURRENCY=0

# Optional: Allow iframe embedding
FRAME_ANCESTORS=http://192.168.1.90:8123

# Password for the PostgreSQL database, used by the app to communicate internally with the database
# Caution: Do not change this after the first run, otherwise the app will no longer be able to connect to the database!
POSTGRES_PASSWORD=CCCCC

##################################################################
###                      Sensor mapping                        ###
##################################################################

# Where to find the data in the InfluxDB
# Each sensor must be mapped to a measurement and a field
# The format is: INFLUX_SENSOR_NAME=MEASUREMENT:FIELD
# Example: INFLUX_SENSOR_INVERTER_POWER=my_pv:inverter_power

INFLUX_SENSOR_INVERTER_POWER=
INFLUX_SENSOR_INVERTER_POWER_1=SENEC:inverter_power
INFLUX_SENSOR_INVERTER_POWER_2=TERRASSE:power_c
INFLUX_SENSOR_INVERTER_POWER_3=
INFLUX_SENSOR_INVERTER_POWER_4=
INFLUX_SENSOR_INVERTER_POWER_5=
#
INFLUX_SENSOR_HOUSE_POWER=SENEC:house_power
INFLUX_SENSOR_GRID_IMPORT_POWER=SENEC:grid_power_plus
INFLUX_SENSOR_GRID_EXPORT_POWER=SENEC:grid_power_minus
INFLUX_SENSOR_BATTERY_CHARGING_POWER=SENEC:bat_power_plus
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=SENEC:bat_power_minus
INFLUX_SENSOR_BATTERY_SOC=SENEC:bat_fuel_charge
INFLUX_SENSOR_CASE_TEMP=SENEC:case_temp
INFLUX_SENSOR_SYSTEM_STATUS=SENEC:current_state
INFLUX_SENSOR_SYSTEM_STATUS_OK=SENEC:current_state_ok
INFLUX_SENSOR_GRID_EXPORT_LIMIT=SENEC:power_ratio
# INFLUX_SENSOR_INVERTER_POWER_FORECAST=Forecast:watt
#
INFLUX_SENSOR_HEATPUMP_HEATING_POWER=
INFLUX_SENSOR_HEATPUMP_STATUS=
INFLUX_SENSOR_OUTDOOR_TEMP=
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=
#
INFLUX_SENSOR_WALLBOX_POWER=
#
# Benutzer definierte Verbraucher
INFLUX_SENSOR_CUSTOM_POWER_01=Gefrierschrank:power
INFLUX_SENSOR_CUSTOM_POWER_02=Waschmaschine:power
INFLUX_SENSOR_CUSTOM_POWER_03=Trockner:power
INFLUX_SENSOR_CUSTOM_POWER_04=Kuehlschrank:power
INFLUX_SENSOR_CUSTOM_POWER_05=Heissluftfritteuse:power
INFLUX_SENSOR_CUSTOM_POWER_06=Spuelmaschine:power
INFLUX_SENSOR_CUSTOM_POWER_07=Wasserkocher:power
INFLUX_SENSOR_CUSTOM_POWER_08=Kaffeemaschine:power
INFLUX_SENSOR_CUSTOM_POWER_09=Backofen:power
INFLUX_SENSOR_CUSTOM_POWER_10=Buegeleisen:power
INFLUX_SENSOR_CUSTOM_POWER_11=AUFZUG:power
INFLUX_SENSOR_CUSTOM_POWER_12=THERME:power
INFLUX_SENSOR_CUSTOM_POWER_13=IT:power
INFLUX_SENSOR_CUSTOM_POWER_14=TERRASSE:power_a
INFLUX_SENSOR_CUSTOM_POWER_15=HERD:power
INFLUX_SENSOR_CUSTOM_POWER_16=Multimedia_Geraete:power
INFLUX_SENSOR_CUSTOM_POWER_17=summe_kameras:power
INFLUX_SENSOR_CUSTOM_POWER_18=senec_eigenverbrauch:power
INFLUX_SENSOR_CUSTOM_POWER_19=summe_l2_terrasse_garage:power

# Optional: Exclude sensors from house power calculation
# Default is HEATPUMP_POWER (if defined)
INFLUX_EXCLUDE_FROM_HOUSE_POWER=

##################################################################
###                      SENEC Collector                       ###
##################################################################

# The adapter to use
# Values: local, cloud
SENEC_ADAPTER=local

# The IP address or hostname of your SENEC device
# Available only when using the local adapter
SENEC_HOST=192.168.108.200

# The schema protocol to use
# Available only when using the local adapter
# Values: http, https
SENEC_SCHEMA=https

# The language to use for status strings
# Available only when using the local adapter
# Values: de, en, it
SENEC_LANGUAGE=de

# The credentials for mein-senec.de
# Available only when using the cloud adapter
# SENEC_USERNAME=me@example.com
# SENEC_PASSWORD=my-senec-password

# The system ID of your SENEC device
# Available only when using the cloud adapter
# Can be empty if there is just one system
# SENEC_SYSTEM_ID=123456

# The interval in seconds for polling
# Minimum for local adapter is 5 seconds
# Minimum for cloud adapter is 30 seconds
SENEC_INTERVAL=5

# Measurement name for InfluxDB
SENEC_INFLUX_MEASUREMENT=SENEC

# Optional: Disable specific fields you do not want to send to InfluxDB.
# This can be useful if you are tracking them from another source.
# Comma separated list of fields, no whitespace. Example:
# SENEC_IGNORE=wallbox_charge_power,grid_power_minus
#
##################################################################
###                     Forecast collector                     ###
##################################################################

FORECAST_PROVIDER=pvnode
PVNODE_APIKEY=DDDDD
PVNODE_PAID=TRUE

# Sensor Mapping
INFLUX_SENSOR_INVERTER_POWER_FORECAST=forecast:watt
INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST=forecast:temp
INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY=forecast:watt_clearsky

# Standort
FORECAST_LATITUDE=48.00000
FORECAST_LONGITUDE=9.00000

# Anzahl der Flaechen (0, 1 und 2)
FORECAST_CONFIGURATIONS=3

# Flaeche 0 (Ost-Ausrichtung)
FORECAST_0_DECLINATION=24
FORECAST_0_AZIMUTH=87
FORECAST_0_KWP=8.910

# Flaeche 1 (West-Ausrichtung)
FORECAST_1_DECLINATION=24
FORECAST_1_AZIMUTH=267
FORECAST_1_KWP=2.835

# Flaeche 2 (Sued-Ausrichtung / BKW)
FORECAST_2_DECLINATION=30
FORECAST_2_AZIMUTH=180
FORECAST_2_KWP=0.820

# Verbindung & Intervall
FORECAST_INTERVAL=3600
INFLUX_MEASUREMENT_FORECAST=forecast
#
#
#################################################################
###             Shelly Collector                              ###
#################################################################
#
SHELLY_INTERVAL=5
SHELLY_HOST_TERRASSE=192.168.1.241
SHELLY_HOST_AUFZUG=192.168.1.243
SHELLY_HOST_THERME=192.168.1.244
SHELLY_HOST_HERD=192.168.1.246
SHELLY_MEASUREMENT_TERRASSE=TERRASSE
SHELLY_MEASUREMENT_AUFZUG=AUFZUG
SHELLY_MEASUREMENT_THERME=THERME
SHELLY_MEASUREMENT_HERD=HERD
#
#################################################################
###             MQTT Collector                                ###
#################################################################
#
MQTT_HOST=192.168.1.90
MQTT_PORT=1883
MQTT_USERNAME=EEEEE
MQTT_PASSWORD=FFFFF
INFLUX_ORG=GGGGG
INFLUX_HOST=influxdb
INFLUX_SCHEMA=http
INFLUX_PORT=8086
INFLUX_TOKEN=HHHHH
#
MAPPING_0_TOPIC=zigbee2mqtt/Gefrierschrank
MAPPING_0_JSON_KEY=power
MAPPING_0_MEASUREMENT=Gefrierschrank
MAPPING_0_FIELD=power
MAPPING_0_TYPE=float
#
MAPPING_1_TOPIC=zigbee2mqtt/Waschmaschine
MAPPING_1_JSON_KEY=power
MAPPING_1_MEASUREMENT=Waschmaschine
MAPPING_1_FIELD=power
MAPPING_1_TYPE=float
#
MAPPING_2_TOPIC=zigbee2mqtt/Trockner
MAPPING_2_JSON_KEY=power
MAPPING_2_MEASUREMENT=Trockner
MAPPING_2_FIELD=power
MAPPING_2_TYPE=float
#
MAPPING_3_TOPIC=zigbee2mqtt/Kuehlschrank
MAPPING_3_JSON_KEY=power
MAPPING_3_MEASUREMENT=Kuehlschrank
MAPPING_3_FIELD=power
MAPPING_3_TYPE=float
#
MAPPING_4_TOPIC=zigbee2mqtt/Heissluftfritteuse
MAPPING_4_JSON_KEY=power
MAPPING_4_MEASUREMENT=Heissluftfritteuse
MAPPING_4_FIELD=power
MAPPING_4_TYPE=float
#
MAPPING_5_TOPIC=zigbee2mqtt/Spuelmaschine
MAPPING_5_JSON_KEY=power
MAPPING_5_MEASUREMENT=Spuelmaschine
MAPPING_5_FIELD=power
MAPPING_5_TYPE=float
#
MAPPING_6_TOPIC=zigbee2mqtt/Wasserkocher
MAPPING_6_JSON_KEY=power
MAPPING_6_MEASUREMENT=Wasserkocher
MAPPING_6_FIELD=power
MAPPING_6_TYPE=float
#
MAPPING_7_TOPIC=zigbee2mqtt/Kaffeemaschine
MAPPING_7_JSON_KEY=power
MAPPING_7_MEASUREMENT=Kaffeemaschine
MAPPING_7_FIELD=power
MAPPING_7_TYPE=float
#
MAPPING_8_TOPIC=zigbee2mqtt/Backofen
MAPPING_8_JSON_KEY=power
MAPPING_8_MEASUREMENT=Backofen
MAPPING_8_FIELD=power
MAPPING_8_TYPE=float
#
MAPPING_9_TOPIC=zigbee2mqtt/Buegeleisen
MAPPING_9_JSON_KEY=power
MAPPING_9_MEASUREMENT=Buegeleisen
MAPPING_9_FIELD=power
MAPPING_9_TYPE=float
#
MAPPING_10_TOPIC=homeassistant/sensor/it_gerate/state
MAPPING_10_MEASUREMENT=IT
MAPPING_10_FIELD=power
MAPPING_10_TYPE=float
#
MAPPING_11_TOPIC=homeassistant/sensor/multimedia_gerate/state
MAPPING_11_MEASUREMENT=Multimedia_Geraete
MAPPING_11_FIELD=power
MAPPING_11_TYPE=float
#
MAPPING_12_TOPIC=homeassistant/sensor/summe_kameras/state
MAPPING_12_MEASUREMENT=summe_kameras
MAPPING_12_FIELD=power
MAPPING_12_TYPE=float
#
MAPPING_13_TOPIC=homeassistant/sensor/senec_eigenverbrauch/state
MAPPING_13_MEASUREMENT=senec_eigenverbrauch
MAPPING_13_FIELD=power
MAPPING_13_TYPE=float
#
MAPPING_14_TOPIC=homeassistant/sensor/summe_l2_terrasse_garage/state
MAPPING_14_MEASUREMENT=summe_l2_terrasse_garage
MAPPING_14_FIELD=power
MAPPING_14_TYPE=float
#
MAPPING_15_TOPIC=homeassistant/sensor/ws2900_v2_01_18_outdoor_temperature/state
MAPPING_15_MEASUREMENT=ws2900_v2_01_18_outdoor_temperature
MAPPING_15_FIELD=temperature
MAPPING_15_TYPE=float
#
##################################################################
###                 InfluxDB time series database              ###
##################################################################

# InfluxDB host
INFLUX_HOST=influxdb

# InfluxDB schema (http or https)
INFLUX_SCHEMA=http

# InfluxDB port
INFLUX_PORT=8086

# Credentials for the InfluxDB, don't change after the first run!
INFLUX_ORG=GGGGG
INFLUX_USERNAME=my-influxdb-username
INFLUX_PASSWORD=IIIII
INFLUX_ADMIN_TOKEN=JJJJJ

# Set these names before first run, they can't be changed later!
INFLUX_BUCKET=KKKKK

# To keep things simple, we use ONE token (INFLUX_ADMIN_TOKEN) for both writing and reading.
# For better security, you can use two separate tokens, created via the InfluxDB frontend.
INFLUX_TOKEN_WRITE=JJJJJ
INFLUX_TOKEN_READ=JJJJJ

# Volume path for storing the InfluxDB data
INFLUX_VOLUME_PATH=/home/pi/solectrus/influxdb

##################################################################
###                    Power-Splitter                          ###
##################################################################
# Berechnungsinterval Power-Splitter (ohne Angabe 3600sec)
POWER_SPLITTER_INTERVAL=300

##################################################################
###                    PostgreSQL database                     ###
##################################################################

# Volume path for storing the PostgreSQL data
DB_VOLUME_PATH=/home/pi/solectrus/postgresql

##################################################################
###                 Redis in-memory database                   ###
##################################################################

# Volume path for storing the database snapshot
REDIS_VOLUME_PATH=/home/pi/solectrus/redis

##################################################################
###                    INGEST SQL DATABASE                     ###
##################################################################

# Volume path for storing the ingest database
INGEST_VOLUME_PATH=/home/pi/solectrus/ingest
