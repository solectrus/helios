##################################################################
# Dashboard application (the main part)

# Domain name or IP address of your host
# APP_HOST=167.235.236.85
APP_HOST=AAAAA

# SSL redirect: Use "true" (which is the default) if you want to auto-redirect to https
FORCE_SSL=true

# Secret token to secure cookies, 128 chars long hexadecimal encoded string (don't use this example, make some random changes!)
# Currently there are no cookies in Soletrus, but this may change in the future
SECRET_KEY_BASE=AAAAA

# Date of commissioning of your photovoltaic system
INSTALLATION_DATE=2023-08-01

# Password to login as administrator, required to manage settings like historical prices
ADMIN_PASSWORD=BBBBB

# Timezone
TZ=Europe/Berlin

##################################################################
# Influx database settings

# Influx host (to access from SOLECTRUS dashboard and collectors)
INFLUX_HOST=influxdb
INFLUX_SCHEMA=http
INFLUX_PORT=8086

# Credentials for the Influx database, don't change after the first run!
INFLUX_ORG=CCCCC
INFLUX_USERNAME=admin
INFLUX_PASSWORD=DDDDD
INFLUX_ADMIN_TOKEN=EEEEE

# Set these names before first run, they can't be changed later!
INFLUX_BUCKET=CCCCC
# INFLUX_MEASUREMENT_PV=SENEC
# INFLUX_MEASUREMENT=SENEC
INFLUX_MEASUREMENT_FORECAST=Forecast

# To keep things simple, we use ONE token (INFLUX_ADMIN_TOKEN) for both writing and reading.
# For better security, you can use two separate tokens, created via the InfluxDB frontend.
INFLUX_TOKEN_WRITE=EEEEE
INFLUX_TOKEN_READ=EEEEE

# Volume path for storing the Influx data
INFLUX_VOLUME_PATH=./influxdb

# Sensor mappings
# INFLUX_SENSOR_INVERTER_POWER=SENEC:inverter_power
# INFLUX_SENSOR_INVERTER_POWER=
INFLUX_SENSOR_INVERTER_POWER_1=SENEC:mpp1_power
INFLUX_SENSOR_INVERTER_POWER_2=SENEC:mpp3_power
INFLUX_SENSOR_HOUSE_POWER=SENEC:house_power
INFLUX_SENSOR_GRID_IMPORT_POWER=SENEC:grid_power_plus
INFLUX_SENSOR_GRID_EXPORT_POWER=SENEC:grid_power_minus
INFLUX_SENSOR_GRID_EXPORT_LIMIT=SENEC:power_ratio
INFLUX_SENSOR_BATTERY_CHARGING_POWER=SENEC:bat_power_plus
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=SENEC:bat_power_minus
INFLUX_SENSOR_BATTERY_SOC=SENEC:bat_fuel_charge
INFLUX_SENSOR_WALLBOX_POWER=SENEC:wallbox_charge_power
INFLUX_SENSOR_CASE_TEMP=SENEC:case_temp
INFLUX_SENSOR_SYSTEM_STATUS=SENEC:current_state
INFLUX_SENSOR_SYSTEM_STATUS_OK=SENEC:current_state_ok
INFLUX_SENSOR_HEATPUMP_POWER=shellies:heatpump_power
INFLUX_EXCLUDE_FROM_HOUSE_POWER=HEATPUMP_POWER

INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=SENEC:ev_connected
INFLUX_SENSOR_CAR_BATTERY_SOC=car:soc

INFLUX_SENSOR_HEATPUMP_HEATING_POWER=viessmann:generated_heat
INFLUX_SENSOR_OUTDOOR_TEMP=viessmann:outside_temp
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=viessmann:tank_temp

INFLUX_SENSOR_INVERTER_POWER_FORECAST=Forecast:watt
INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY=Forecast:watt_clearsky
INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST=Forecast:temp

# see custom sensors, below

##################################################################
# Power Splitter settings

POWER_SPLITTER_INTERVAL=300

##################################################################
# REDIS settings

REDIS_VOLUME_PATH=./redis

##################################################################
# PostgreSQL database settings

DB_VOLUME_PATH=./postgresql
# Password for the PostgreSQL database, used by the app to comunicate internally with the database
POSTGRES_PASSWORD=FFFFF

##############################################################
# Solcast

# FORECAST_PROVIDER=solcast
# FORECAST_INTERVAL=17292
# FORECAST_CONFIGURATIONS=2
# SOLCAST_APIKEY=solcast-apikey
# SOLCAST_0_SITE=c3bf-123
# SOLCAST_1_SITE=0fa2-123

# pvnode
FORECAST_PROVIDER=pvnode
FORECAST_INTERVAL=900
FORECAST_CONFIGURATIONS=2
FORECAST_LATITUDE=GGGGG
FORECAST_LONGITUDE=HHHHH
FORECAST_DECLINATION=30
FORECAST_0_AZIMUTH=267.5 # east
FORECAST_0_KWP=4.45
FORECAST_1_AZIMUTH=87.5  # west
FORECAST_1_KWP=4.86
PVNODE_APIKEY=IIIII
PVNODE_PAID=true
PVNODE_EXTRA_PARAMS="diffuse_radiation_model=perez&mounting_type=isol&shading_config=5:3:1:3_2:2:0:1_5:3:1:3&panel_age_years=2"

# shading config:
#          morgen mittag abend
# winter   5      2      5
# frühl.   3      2      3
# sommer   1      0      1
# herbst   3      2      3
# 5 => 50%
# spaltenweise lesen: morgen => 5 2 1 2 => 5:2:1:2
# spaltenwerte mit _ verbinden => 5:3:1:3_2:2:0:2_5:3:1:3

##############################################################
# Watchtower configuration

WATCHTOWER_CLEANUP=true
WATCHTOWER_SCHEDULE="0 5 2 * * *"
WATCHTOWER_SCOPE=solectrus

##############################################################
# MQTT collector

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_SSL=false
MQTT_USERNAME=JJJJJ
MQTT_PASSWORD=KKKKK

MAPPING_0_TOPIC=ds3/soc
MAPPING_0_MEASUREMENT=car
MAPPING_0_FIELD=soc
MAPPING_0_TYPE=integer

MAPPING_1_TOPIC=ds3/mileage
MAPPING_1_MEASUREMENT=car
MAPPING_1_FIELD=mileage
MAPPING_1_TYPE=integer

MAPPING_2_TOPIC=plug3/status/switch:0
MAPPING_2_MEASUREMENT=shellies
MAPPING_2_FIELD=hifi_power
MAPPING_2_TYPE=float
MAPPING_2_JSON_KEY=apower

MAPPING_3_TOPIC=plug1/status/switch:0
MAPPING_3_MEASUREMENT=shellies
MAPPING_3_FIELD=fridge_power
MAPPING_3_TYPE=float
MAPPING_3_JSON_KEY=apower

MAPPING_4_TOPIC=plug2/status/switch:0
MAPPING_4_MEASUREMENT=shellies
MAPPING_4_FIELD=computer_power
MAPPING_4_TYPE=float
MAPPING_4_JSON_KEY=apower

MAPPING_5_TOPIC=plug4/status/switch:0
MAPPING_5_MEASUREMENT=shellies
MAPPING_5_FIELD=freezer_power
MAPPING_5_TYPE=float
MAPPING_5_JSON_KEY=apower

MAPPING_6_TOPIC=plug5/status/switch:0
MAPPING_6_MEASUREMENT=shellies
MAPPING_6_FIELD=fridge2_power
MAPPING_6_TYPE=float
MAPPING_6_JSON_KEY=apower

MAPPING_7_TOPIC=tele/tasmota_1/SENSOR
MAPPING_7_MEASUREMENT=shellies
MAPPING_7_FIELD=washing_power
MAPPING_7_TYPE=float
MAPPING_7_JSON_PATH="$.ENERGY.Power"

MAPPING_8_TOPIC=tele/tasmota_2/SENSOR
MAPPING_8_MEASUREMENT=shellies
MAPPING_8_FIELD=dryer_power
MAPPING_8_TYPE=float
MAPPING_8_JSON_PATH="$.ENERGY.Power"

MAPPING_9_TOPIC=shellypro3em/status/em:0
MAPPING_9_MEASUREMENT=shellies
MAPPING_9_FIELD=heatpump_power
MAPPING_9_TYPE=float
MAPPING_9_JSON_KEY=total_act_power

MAPPING_10_TOPIC=viessmann/generatedHeat
MAPPING_10_MEASUREMENT=viessmann
MAPPING_10_FIELD=generated_heat
MAPPING_10_TYPE=float

MAPPING_11_TOPIC=viessmann/outsideTemp
MAPPING_11_MEASUREMENT=viessmann
MAPPING_11_FIELD=outside_temp
MAPPING_11_TYPE=float

MAPPING_12_TOPIC=viessmann/tankTemp
MAPPING_12_MEASUREMENT=viessmann
MAPPING_12_FIELD=tank_temp
MAPPING_12_TYPE=float

MAPPING_13_TOPIC=viessmann/compressorStarts
MAPPING_13_MEASUREMENT=viessmann
MAPPING_13_FIELD=compressor_starts
MAPPING_13_TYPE=float

MAPPING_14_TOPIC=viessmann/compressorHours
MAPPING_14_MEASUREMENT=viessmann
MAPPING_14_FIELD=compressor_hours
MAPPING_14_TYPE=float

# custom sensors

INFLUX_SENSOR_CUSTOM_POWER_01=shellies:hifi_power
INFLUX_SENSOR_CUSTOM_POWER_02=shellies:fridge_power
INFLUX_SENSOR_CUSTOM_POWER_03=shellies:computer_power
INFLUX_SENSOR_CUSTOM_POWER_04=shellies:washing_power
INFLUX_SENSOR_CUSTOM_POWER_05=shellies:dryer_power
INFLUX_SENSOR_CUSTOM_POWER_06=shellies:freezer_power
INFLUX_SENSOR_CUSTOM_POWER_07=shellies:fridge2_power
