#SHELLY_GEN_CIRCLE=2
#INFLUX_MEASUREMENT_SHELLY_CIRCLE=circle
#Wohnzimmer Technik
SHELLY_HOST_WZTECHNIK=10.31.22.55
SHELLY_GEN_WZTECHNIK=2
INFLUX_MEASUREMENT_SHELLY_WZTECHNIK=wztechnik
# Büro Technik
SHELLY_HOST_PCTECHNIK=10.31.22.67
SHELLY_GEN_PCTECHNIK=3
INFLUX_MEASUREMENT_SHELLY_PCTECHNIK=pctechnik
# FREEZER - Gefrierschrank
SHELLY_HOST_FREEZER=10.31.22.42
SHELLY_GEN_FREEZER=3
INFLUX_MEASUREMENT_SHELLY_FREEZER=freezer
# WINE = Weinkühlschrank
SHELLY_HOST_WINE=10.31.22.90
SHELLY_GEN_WINE=3
INFLUX_MEASUREMENT_SHELLY_WINE=wine

#Platzhalter
#SHELLY_HOST_CIRCLE=10.31.22.55
#SHELLY_GEN_CIRCLE=2
#INFLUX_MEASUREMENT_SHELLY_CIRCLE=circle



#Washcmaschine und TRockner aus dem Hausverbrauch rausrechnen und einzekn darstekllen - noch zu rpüfen ...!
#INFLUX_EXCLUDE_FROM_HOUSE_POWER=CUSTOM_POWER_01,CUSTOM_POWER_02

POWER_SPLITTER_INTERVAL=300



##################################################################
# REDIS settings
#
REDIS_VOLUME_PATH=/home/pi/solectrus/redis


##################################################################
# PostgreSQL database settings
#
DB_VOLUME_PATH=/home/pi/solectrus/postgresql


##################################################################
# MQTT Collector

# MQTT Broker credentials
MQTT_HOST=10.31.22.46
MQTT_PORT=1883
MQTT_SSL=false
MQTT_USERNAME=HHHHH
MQTT_PASSWORD=JJJJJ

# MQTT topics
# https://docs.evcc.io/docs/reference/api#mqtt-api
# removing old mappings ... 11.10.2024
#MQTT_TOPIC_HOUSE_POW=evcc/site/homePower
#MQTT_TOPIC_GRID_POW=evcc/site/gridPower
#MQTT_TOPIC_BAT_FUEL_CHARGE=evcc/site/batterySoc
#MQTT_TOPIC_BAT_POWER=evcc/site/batteryPower
#MQTT_TOPIC_INVERTER_POWER=evcc/site/pvPower
#MQTT_TOPIC_WALLBOX_CHARGE_POWER=evcc/loadpoints/1/chargePower
#MQTT_TOPIC_HEATPUMP_POWER=evcc/loadpoints/2/chargePower


# MQTT Mappings
MAPPING_0_TOPIC=evcc/site/homePower
MAPPING_0_FIELD=house_power
MAPPING_0_MEASUREMENT=my-pv-measurement
MAPPING_0_TYPE=integer
#### Achtung - geändert mit EVCC 0.200.1 !!!! von evcc/site/gridPower auf evcc/site/grid/power
MAPPING_1_TOPIC=evcc/site/grid/power
MAPPING_1_FIELD_POSITIVE=grid_power_plus
MAPPING_1_FIELD_NEGATIVE=grid_power_minus
MAPPING_1_MEASUREMENT_POSITIVE=my-pv-measurement
MAPPING_1_MEASUREMENT_NEGATIVE=my-pv-measurement
MAPPING_1_TYPE=integer
# MAPPING_2_TOPIC=evcc/site/batterySoc -> geändert mit evcc 0.301
MAPPING_2_TOPIC=evcc/site/battery/devices/1/soc
MAPPING_2_FIELD=bat_fuel_charge
MAPPING_2_MEASUREMENT=my-pv-measurement
MAPPING_2_TYPE=float
# MAPPING_3_TOPIC=evcc/site/batteryPower -> geändert mit evcc 0.301
MAPPING_3_TOPIC=evcc/site/battery/devices/1/power
MAPPING_3_FIELD_POSITIVE=bat_power_minus
MAPPING_3_FIELD_NEGATIVE=bat_power_plus
MAPPING_3_MEASUREMENT_POSITIVE=my-pv-measurement
MAPPING_3_MEASUREMENT_NEGATIVE=my-pv-measurement
MAPPING_3_TYPE=integer
MAPPING_4_TOPIC=evcc/site/pvPower
MAPPING_4_FIELD=inverter_power
MAPPING_4_MEASUREMENT=my-pv-measurement
MAPPING_4_TYPE=integer
MAPPING_5_TOPIC=evcc/loadpoints/1/chargePower
MAPPING_5_FIELD=wallbox_charge_power
MAPPING_5_MEASUREMENT=my-pv-measurement
MAPPING_5_TYPE=integer
MAPPING_6_TOPIC=evcc/loadpoints/2/chargePower
MAPPING_6_FIELD=heatpump_power
MAPPING_6_MEASUREMENT=my-pv-measurement
MAPPING_6_TYPE=integer

# aktuelle Vorlauftemperatur Heizung
MAPPING_7_TOPIC=ems-esp/boiler_data
MAPPING_7_JSON_PATH=$.curflowtemp
MAPPING_7_FIELD=case_temp
MAPPING_7_MEASUREMENT=my-pv-measurement
MAPPING_7_TYPE=float
#Evoque SOC
MAPPING_8_TOPIC=evcc/loadpoints/1/vehicleSoc
MAPPING_8_FIELD=evoque_soc
MAPPING_8_MEASUREMENT=my-pv-measurement
MAPPING_8_TYPE=float
#Evoque connected?
MAPPING_9_TOPIC=evcc/loadpoints/1/connected
MAPPING_9_FIELD=evoque_connect
MAPPING_9_MEASUREMENT=my-pv-measurement
MAPPING_9_TYPE=boolean
######
### Heatpump
######
MAPPING_10_TOPIC=Buderus/curtemp
MAPPING_10_FIELD=Buderus_warmwasser
MAPPING_10_MEASUREMENT=my-pv-measurement
MAPPING_10_TYPE=float

MAPPING_11_TOPIC=Buderus/outdoortemp
MAPPING_11_FIELD=Buderus_outdoortemp
MAPPING_11_MEASUREMENT=my-pv-measurement
MAPPING_11_TYPE=float

MAPPING_12_TOPIC=Buderus/Kompressor_power
MAPPING_12_FIELD=Buderus_Kompressor_power
MAPPING_12_MEASUREMENT=my-pv-measurement
MAPPING_12_TYPE=float

MAPPING_13_TOPIC=Buderus/Kompressor_Status
MAPPING_13_FIELD=kompressor_status
MAPPING_13_MEASUREMENT=my-pv-measurement
MAPPING_13_TYPE=string

MAPPING_14_TOPIC=Buderus/Allgemeinstrom
MAPPING_14_FIELD=allgemeinstrom
MAPPING_14_MEASUREMENT=strom
MAPPING_14_TYPE=float

