##################################################################
# Dashboard application (the main part)
#
TZ=Europe/Berlin
# Domain name or IP address of your host
APP_HOST=10.31.22.46
#
# SSL redirect: Use "true" (which is the default) if you want to auto-redirect to https
FORCE_SSL=false
#
# Secret token to secure cookies, 128 chars long hexadecimal encoded string (don't use this example, make some random changes!)
# Currently there are no cookies in Soletrus, but this may change in the future
SECRET_KEY_BASE=BBBBB
#
# Date of commissioning of your photovoltaic system
INSTALLATION_DATE=2023-08-02
#
# Price you pay for 1kWH (in EUR)
# Can be changed later in the UI when logged in as administrator
ELECTRICITY_PRICE=0.40
#
# Price you get for 1kWH (in EUR)
# Can be changed later in the UI when logged in as administrator
FEED_IN_TARIFF=0.0848
#
# Password for the PostgreSQL database, used by the app to comunicate internally with the database
POSTGRES_PASSWORD=CCCCC
#
# Password to login as administrator, required to manage settings like historical prices
ADMIN_PASSWORD=KKKKK

##################################################################
# Influx database settings
#
# Influx host (to access from SOLECTRUS dashboard and collectors)
INFLUX_POLL_INTERVAL=5
INFLUX_HOST=influxdb
INFLUX_SCHEMA=http
INFLUX_PORT=8086
#
# Credentials for the Influx database, don't change after the first run!
INFLUX_ORG=AAAAA
INFLUX_USERNAME=admin
INFLUX_PASSWORD=DDDDD
INFLUX_ADMIN_TOKEN=FFFFF
#
# Set these names before first run, they can't be changed later!
INFLUX_BUCKET=EEEEE
INFLUX_MEASUREMENT_PV=my-pv-measurement
INFLUX_MEASUREMENT_FORECAST=Forecast
#
# To keep things simple, we use ONE token (INFLUX_ADMIN_TOKEN) for both writing and reading.
# For better security, you can use two separate tokens, created via the InfluxDB frontend.
INFLUX_TOKEN_WRITE=FFFFF
INFLUX_TOKEN_READ=FFFFF
#
# Volume path for storing the Influx data
INFLUX_VOLUME_PATH=/home/pi/solectrus/influxdb
# Neu fuer Waermepumpe und fuer Sensoren
INFLUX_SENSOR_HEATPUMP_POWER=my-pv-measurement:heatpump_power

INFLUX_SENSOR_INVERTER_POWER=my-pv-measurement:inverter_power
# -> geändert mit Balkonkraftwerk
#INFLUX_SENSOR_INVERTER_POWER=
#INFLUX_SENSOR_INVERTER_POWER_1=my-pv-measurement:inverter_power
#INFLUX_SENSOR_INVERTER_POWER_2=my-pv-measurement:inverter_powerbalcony

# Wetter Forecast
INFLUX_SENSOR_INVERTER_POWER_FORECAST=Forecast:watt
INFLUX_SENSOR_OUTDOOR_TEMP_FORECAST=Forecast:temp
INFLUX_SENSOR_INVERTER_POWER_FORECAST_CLEARSKY=Forecast:watt_clearsky
INFLUX_SENSOR_HOUSE_POWER=my-pv-measurement:house_power
INFLUX_SENSOR_GRID_IMPORT_POWER=my-pv-measurement:grid_power_plus
INFLUX_SENSOR_GRID_EXPORT_POWER=my-pv-measurement:grid_power_minus
INFLUX_SENSOR_GRID_EXPORT_LIMIT=my-pv-measurement:power_ratio
INFLUX_SENSOR_GRID_EXPORT_LIMIT=my-pv-measurement:power_ratio
INFLUX_SENSOR_BATTERY_CHARGING_POWER=my-pv-measurement:bat_power_plus
INFLUX_SENSOR_BATTERY_DISCHARGING_POWER=my-pv-measurement:bat_power_minus
INFLUX_SENSOR_BATTERY_SOC=my-pv-measurement:bat_fuel_charge
INFLUX_SENSOR_WALLBOX_POWER=my-pv-measurement:wallbox_charge_power
INFLUX_SENSOR_CASE_TEMP=my-pv-measurement:case_temp
# CHECK hEATpUMPÜ sTATUS ON hOMEPAGE
#INFLUX_SENSOR_SYSTEM_STATUS=my-pv-measurement:current_state
INFLUX_SENSOR_SYSTEM_STATUS=my-pv-measurement:kompressor_status
INFLUX_SENSOR_SYSTEM_STATUS_OK=my-pv-measurement:current_state_ok
#Autostatus 
INFLUX_SENSOR_CAR_BATTERY_SOC=my-pv-measurement:evoque_soc
INFLUX_SENSOR_WALLBOX_CAR_CONNECTED=my-pv-measurement:evoque_connect
# SHELLY Collector STATUS
INFLUX_SENSOR_CUSTOM_POWER_01=wash:power
INFLUX_SENSOR_CUSTOM_POWER_02=dryer:power
#INFLUX_SENSOR_CUSTOM_POWER_03=gas:power - Wechsle auf allgemeinstrom am 03.11.2025
INFLUX_SENSOR_CUSTOM_POWER_03=strom:allgemeinstrom

INFLUX_SENSOR_CUSTOM_POWER_04=dish:power
INFLUX_SENSOR_CUSTOM_POWER_05=cooler:power
INFLUX_SENSOR_CUSTOM_POWER_06=wztechnik:power
INFLUX_SENSOR_CUSTOM_POWER_07=pctechnik:power
INFLUX_SENSOR_CUSTOM_POWER_08=freezer:power
INFLUX_SENSOR_CUSTOM_POWER_09=wine:power

#### Heatpump
INFLUX_SENSOR_OUTDOOR_TEMP=my-pv-measurement:Buderus_outdoortemp
INFLUX_SENSOR_HEATPUMP_HEATING_POWER=my-pv-measurement:Buderus_Kompressor_power
INFLUX_SENSOR_HEATPUMP_STATUS=my-pv-measurement:kompressor_status
INFLUX_SENSOR_HEATPUMP_TANK_TEMP=my-pv-measurement:Buderus_warmwasser



#################################################################
# Shelly settings / Shelly Connector

# Standards
INFLUX_MODE=essential
SHELLY_INTERVAL=5
#Trockner
SHELLY_HOST_DRYER=10.31.22.36
SHELLY_GEN_DRYER=1
INFLUX_MEASUREMENT_SHELLY_DRYER=dryer
#Waschmaschine
SHELLY_HOST_WASH=10.31.22.35
SHELLY_GEN_WASH=1
INFLUX_MEASUREMENT_SHELLY_WASH=wash
#Geschirrspueler
SHELLY_HOST_DISH=10.31.22.62
SHELLY_GEN_DISH=2
INFLUX_MEASUREMENT_SHELLY_DISH=dish
#Gasheizung
#SHELLY_HOST_GAS=10.31.22.85
#SHELLY_GEN_GAS=2
#INFLUX_MEASUREMENT_SHELLY_GAS=gas
#Kühlschrank
SHELLY_HOST_COOLER=10.31.22.95
SHELLY_GEN_COOLER=2
INFLUX_MEASUREMENT_SHELLY_COOLER=cooler
#Zirkulationspumpe - alt - Ersetzt mit WZTECHNIK am 16.01.2025
